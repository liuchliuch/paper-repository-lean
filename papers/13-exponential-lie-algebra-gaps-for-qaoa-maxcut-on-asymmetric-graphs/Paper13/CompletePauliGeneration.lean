import Paper13.PauliSupport
noncomputable section
namespace Paper13
attribute [local instance] Classical.propDecidable

lemma word_ne_zero_of_entry {n : ℕ} (w : Fin n → Fin 4) (i : Fin n) (h : w i≠0) : w≠fun _ => 0 :=
  fun he => h (congrFun he i)
lemma word_ne_one_of_entry {n : ℕ} (w : Fin n → Fin 4) (i : Fin n) (h : w i≠1) : w≠fun _ => 1 :=
  fun he => h (congrFun he i)

/-- Every noncentral even Pauli word is generated by the complete graph's actual controls. -/
theorem complete_generates_admissible (n : ℕ) (w : Fin n → Fin 4) (hw : AdmissiblePauli w) :
    skewPauliWord w ∈ graphMa (⊤ : SimpleGraph (Fin n)) := by
  have main : ∀ m, ∀ z : Fin n → Fin 4, (wordSupport z).card=m → AdmissiblePauli z →
      skewPauliWord z ∈ graphMa (⊤ : SimpleGraph (Fin n)) := by
    intro m
    induction m using Nat.strong_induction_on with
    | h m ih =>
      intro z hm hz
      obtain ⟨hpar,hzero,hone⟩ := hz
      change wordGrade z=1 at hpar
      by_cases hYZ : ∃ j, z j=2 ∨ z j=3
      · obtain ⟨j,hj⟩ := hYZ
        by_cases hX : ∃ i, z i=1
        · obtain ⟨i,hi⟩ := hX
          have hij : i≠j := by intro h; subst j; rcases hj with hj | hj <;> omega
          let u := pairChange z i j 2 0
          have hiS : i ∈ wordSupport z := wordSupport_mem z i |>.mpr (by rw [hi]; decide)
          have hjS : j ∈ wordSupport z := wordSupport_mem z j |>.mpr (by rcases hj with h | h <;> rw [h] <;> decide)
          have huS : wordSupport u=(wordSupport z).erase j := by
            rw [show u=Function.update (Function.update z i 2) j 0 from pairChange_eq_update _ _ _ hij _ _,
              wordSupport_update_zero,wordSupport_update_nonzero _ _ _ (by decide),Finset.insert_eq_of_mem hiS]
          have hsmall : (wordSupport u).card<m := by
            rw [huS,Finset.card_erase_of_mem hjS,←hm]
            exact Nat.sub_lt (Finset.card_pos.mpr ⟨j,hjS⟩) (by omega)
          have hgrade : wordGrade u=1 := by
            dsimp [u]
            rw [wordGrade_pairChange _ _ _ hij,hi,hpar]
            rcases hj with h | h <;> rw [h] <;> norm_num
          have hui : u i=2 := by simp [u,pairChange]
          have humem := ih _ hsmall u rfl ⟨hgrade,
            word_ne_zero_of_entry u i (by rw [hui]; decide),
            word_ne_one_of_entry u i (by rw [hui]; decide)⟩
          have hout := complete_word_X_YZ z i j hij (z j) hj humem
          have he : pairChange z i j 1 (z j)=z := by rw [←hi,pairChange_self]
          rwa [he] at hout
        · have hletter : ∀ v, z v≠0 → z v=2 ∨ z v=3 := by
            intro v hv
            exact yz_of_nonzero_not_X _ hv (fun h => hX ⟨v,h⟩)
          by_cases hb : ∃ b, b≠j ∧ z b≠0
          · obtain ⟨b,hbj,hb⟩ := hb
            have hjb := hbj.symm
            have hbYZ := hletter b hb
            by_cases hc : ∃ c, c≠j ∧ c≠b ∧ z c≠0
            · obtain ⟨c,hcj,hcb,hc⟩ := hc
              have hjc := hcj.symm
              have hbc := hcb.symm
              have hcYZ := hletter c hc
              let u := triplePauli z j b c (z j) 0 0
              have hu : u=Function.update (Function.update z b 0) c 0 := by
                rw [show u=Function.update (Function.update (Function.update z j (z j)) b 0) c 0 from
                  triplePauli_eq_update _ _ _ _ hjb hjc hbc _ _ _,Function.update_eq_self]
              have hsmall : (wordSupport u).card<m := by
                rw [hu,wordSupport_update_zero,wordSupport_update_zero]
                have hle := Finset.card_le_card (Finset.erase_subset c ((wordSupport z).erase b))
                have hbS : b ∈ wordSupport z := (wordSupport_mem z b).mpr hb
                rw [Finset.card_erase_of_mem hbS] at hle
                have hpos : 0 < (wordSupport z).card := Finset.card_pos.mpr ⟨b,hbS⟩
                omega
              have hui : u j=z j := by simp [u,triplePauli]
              have hj0 : z j≠0 := by rcases hj with h | h <;> rw [h] <;> decide
              have hj1 : z j≠1 := by rcases hj with h | h <;> rw [h] <;> decide
              have hgrade : wordGrade u=1 := by
                dsimp [u]
                rw [wordGrade_triple _ _ _ _ hjb hjc hbc,hpar]
                rcases hj with hj | hj <;> rcases hbYZ with hb | hb <;> rcases hcYZ with hc | hc <;>
                  rw [hj,hb,hc] <;> norm_num
              have humem := ih _ hsmall u rfl ⟨hgrade,
                word_ne_zero_of_entry u j (hui ▸ hj0),word_ne_one_of_entry u j (hui ▸ hj1)⟩
              have hout := complete_word_insert_YZ z j b c hjb hjc hbc (z j) (z b) (z c) hj hbYZ hcYZ humem
              rwa [triplePauli_self] at hout
            · have he : z=twoPauli j b (z j) (z b) := by
                funext v
                by_cases hvj : v=j
                · subst v; simp [twoPauli]
                by_cases hvb : v=b
                · subst v; simp [twoPauli,hbj]
                have hv : z v=0 := by by_contra h; exact hc ⟨v,hvj,hvb,h⟩
                simp [twoPauli,hvj,hvb,hv]
              rw [he]
              exact graphMa_two_YZ ⊤ j b hjb _ _ hj hbYZ
          · have he : z=singlePauli j (z j) := by
              funext v
              by_cases hvj : v=j
              · subst v; simp [singlePauli]
              have hv : z v=0 := by by_contra h; exact hb ⟨v,hvj,h⟩
              simp [singlePauli,hvj,hv]
            rw [he,wordGrade_single] at hpar
            rcases hj with h | h <;> rw [h] at hpar <;> norm_num at hpar
      · have hletter : ∀ v, z v=0 ∨ z v=1 := by
          intro v
          have hn : ¬(z v=2 ∨ z v=3) := fun h => hYZ ⟨v,h⟩
          have hv := (z v).isLt
          omega
        obtain ⟨i,hi0⟩ := Function.ne_iff.mp hzero
        have hi : z i=1 := (hletter i).resolve_left hi0
        obtain ⟨k,hk1⟩ := Function.ne_iff.mp hone
        have hk : z k=0 := (hletter k).resolve_right hk1
        have hik : i≠k := by intro h; subst k; omega
        by_cases hb : ∃ b, b≠i ∧ z b=1
        · obtain ⟨b,hbi,hb⟩ := hb
          have hib := hbi.symm
          have hbk : b≠k := by intro h; subst k; omega
          let u := triplePauli z i b k 1 0 0
          have hu : u=Function.update z b 0 := by
            funext v
            by_cases hvi : v=i <;> by_cases hvb : v=b <;> by_cases hvk : v=k <;>
              simp_all [u,triplePauli,Function.update_apply]
          have hbS : b ∈ wordSupport z := (wordSupport_mem z b).mpr (by rw [hb]; decide)
          have hsmall : (wordSupport u).card<m := by
            rw [hu,wordSupport_update_zero,Finset.card_erase_of_mem hbS,←hm]
            exact Nat.sub_lt (Finset.card_pos.mpr ⟨b,hbS⟩) (by omega)
          have hgrade : wordGrade u=1 := by rw [hu,wordGrade_update,hb,hpar]; norm_num
          have hui : u i=1 := by simp [u,triplePauli]
          have huk : u k=0 := by simp [u,triplePauli,hik.symm,hbk.symm]
          have humem := ih _ hsmall u rfl ⟨hgrade,
            word_ne_zero_of_entry u i (by rw [hui]; decide),word_ne_one_of_entry u k (by rw [huk]; decide)⟩
          have hout := complete_word_insert_X z i b k hib hik hbk humem
          have he : triplePauli z i b k 1 1 0=z := by simpa only [hi,hb,hk] using triplePauli_self z i b k
          rwa [he] at hout
        · have he : z=singlePauli i 1 := by
            funext v
            by_cases hvi : v=i
            · subst v; simp [singlePauli,hi]
            have hv : z v=0 := (hletter v).resolve_right (fun h => hb ⟨v,hvi,h⟩)
            simp [singlePauli,hvi,hv]
          rw [he]
          exact graphMa_single_X ⊤ i
  exact main _ w rfl hw
end Paper13
