theorem ShellAccounting_mem_shellEntries_iff : ∀ {ι : Type u_1} [inst : Fintype.{u_1} ι] {freezeTime : ι → Nat} {j : Nat} {p : Prod.{u_1, u_1} ι ι},
  Iff
