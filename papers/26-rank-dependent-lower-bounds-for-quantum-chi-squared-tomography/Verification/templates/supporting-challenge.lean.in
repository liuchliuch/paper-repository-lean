          (@Finset.instMembership.{u_1} (Prod.{u_1, u_1} ι ι))
          (@Paper26.ShellAccounting.frozenEntries.{u_1} ι inst freezeTime L) p)
        (Not
          (And (@Eq.{1} Nat (freezeTime (@Prod.fst.{u_1, u_1} ι ι p)) L)
            (@Eq.{1} Nat (freezeTime (@Prod.snd.{u_1, u_1} ι ι p)) L))) := by
  sorry

