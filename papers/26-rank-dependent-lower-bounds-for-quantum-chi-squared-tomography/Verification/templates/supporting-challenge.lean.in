            (@NonAssocSemiring.toMulZeroOneClass.{u_1} (Matrix.{u_1, u_1, 0} ι ι Complex)
              (@Matrix.nonAssocSemiring.{0, u_1} ι Complex
                (@Semiring.toNonAssocSemiring.{0} Complex
                  (@CommSemiring.toSemiring.{0} Complex (@CommRing.toCommSemiring.{0} Complex Complex.commRing)))
                inst inst_1))))
        (@SetLike.instMembership.{u_1, u_1}
          (@Submonoid.{u_1} (Matrix.{u_1, u_1, 0} ι ι Complex)
            (@MulZeroOneClass.toMulOneClass.{u_1} (Matrix.{u_1, u_1, 0} ι ι Complex)
              (@NonAssocSemiring.toMulZeroOneClass.{u_1} (Matrix.{u_1, u_1, 0} ι ι Complex)
                (@Matrix.nonAssocSemiring.{0, u_1} ι Complex
                  (@Semiring.toNonAssocSemiring.{0} Complex
                    (@CommSemiring.toSemiring.{0} Complex (@CommRing.toCommSemiring.{0} Complex Complex.commRing)))
                  inst inst_1))))
          (Matrix.{u_1, u_1, 0} ι ι Complex)
          (@Submonoid.instSetLike.{u_1} (Matrix.{u_1, u_1, 0} ι ι Complex)
            (@MulZeroOneClass.toMulOneClass.{u_1} (Matrix.{u_1, u_1, 0} ι ι Complex)
              (@NonAssocSemiring.toMulZeroOneClass.{u_1} (Matrix.{u_1, u_1, 0} ι ι Complex)
                (@Matrix.nonAssocSemiring.{0, u_1} ι Complex
                  (@Semiring.toNonAssocSemiring.{0} Complex
                    (@CommSemiring.toSemiring.{0} Complex (@CommRing.toCommSemiring.{0} Complex Complex.commRing)))
                  inst inst_1)))))
        (@Matrix.unitaryGroup.{u_1, 0} ι inst_1 inst Complex Complex.commRing Complex.instStarRing) x)
