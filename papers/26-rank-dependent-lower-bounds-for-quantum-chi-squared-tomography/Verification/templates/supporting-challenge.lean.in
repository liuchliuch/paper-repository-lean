                      (@OfNat.ofNat.{0} Real (nat_lit 1) (@One.toOfNat1.{0} Real Real.instOne)) (x i)))
                (@Nat.cast.{0} Real Real.instNatCast (@Fintype.card.{u_1} ι inst)))
              (@OfNat.ofNat.{0} Nat (nat_lit 2) (instOfNatNat (nat_lit 2))))
