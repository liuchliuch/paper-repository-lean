theorem HaarLossBalls_rotate_density_eq : ∀ {ι : Type u_1} {κ : Type u_2} [inst : Fintype.{u_1} ι] [inst_1 : DecidableEq.{u_1 + 1} ι] [inst_2 : Fintype.{u_2} κ]
  [inst_3 : DecidableEq.{u_2 + 1} κ] [inst_4 : Nonempty.{u_2 + 1} κ]
  (V :
    @Subtype.{u_1 + 1} (Matrix.{u_1, u_1, 0} ι ι Complex) fun (x : Matrix.{u_1, u_1, 0} ι ι Complex) =>
      @Membership.mem.{u_1, u_1} (Matrix.{u_1, u_1, 0} ι ι Complex)
