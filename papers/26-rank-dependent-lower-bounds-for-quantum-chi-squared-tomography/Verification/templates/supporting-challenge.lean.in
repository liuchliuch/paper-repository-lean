      (Matrix.{u_1, u_1, 0} (Fin n → ι) (Fin n → ι) Complex) (Matrix.{u_1, u_1, 0} (Fin n → ι) (Fin n → ι) Complex)
      (@Matrix.instHMulOfFintypeOfMulOfAddCommMonoid.{0, u_1, u_1, u_1} (Fin n → ι) (Fin n → ι) (Fin n → ι) Complex
        (@Pi.instFintype.{0, u_1} (Fin n) (fun (a : Fin n) => ι) (instDecidableEqFin n) (Fin.fintype n)
