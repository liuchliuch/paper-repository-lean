theorem correct_17 : value j_17 = v_17 := by
  rw [value_children j_17 (by decide) (by decide)]
  have hc : children j_17 = [j_17_17, j_17_16, j_17_15, j_17_14, j_17_13, j_17_12, j_17_11, j_17_10, j_17_9, j_17_8, j_17_7, j_17_6, j_17_5, j_17_4, j_17_3, j_17_2, j_17_1] := by decide
  rw [hc]
  simp only [List.map_cons, List.map_nil, correct_17_17, correct_17_16, correct_17_15, correct_17_14, correct_17_13, correct_17_12, correct_17_11, correct_17_10, correct_17_9, correct_17_8, correct_17_7, correct_17_6, correct_17_5, correct_17_4, correct_17_3, correct_17_2, correct_17_1]
  all_goals decide

