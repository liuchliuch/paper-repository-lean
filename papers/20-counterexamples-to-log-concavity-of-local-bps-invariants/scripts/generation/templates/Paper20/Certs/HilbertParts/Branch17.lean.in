def j_17_3 : Job := ⟨[17, 3], 3, 23, 42⟩

def v_17_3 : List ℕ := @@GENERATED_RHS:v_17_3@@

theorem correct_17_3 : value j_17_3 = v_17_3 := by
  rw [value_children j_17_3 (by decide) (by decide)]
  have hc : children j_17_3 = [j_17_3_3, j_17_3_2, j_17_3_1] := by decide
  rw [hc]
  simp only [List.map_cons, List.map_nil, correct_17_3_3, correct_17_3_2, correct_17_3_1]
  all_goals decide

