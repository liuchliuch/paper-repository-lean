def j_18 : Job := ⟨[18], 18, 25, 43⟩

def v_18 : List ℕ := @@GENERATED_RHS:v_18@@

theorem correct_18 : value j_18 = v_18 := by
  rw [value_children j_18 (by decide) (by decide)]
  have hc : children j_18 = [j_18_18, j_18_17, j_18_16, j_18_15, j_18_14, j_18_13, j_18_12, j_18_11, j_18_10, j_18_9, j_18_8, j_18_7, j_18_6, j_18_5, j_18_4, j_18_3, j_18_2, j_18_1] := by decide
  rw [hc]
  simp only [List.map_cons, List.map_nil, correct_18_18, correct_18_17, correct_18_16, correct_18_15, correct_18_14, correct_18_13, correct_18_12, correct_18_11, correct_18_10, correct_18_9, correct_18_8, correct_18_7, correct_18_6, correct_18_5, correct_18_4, correct_18_3, correct_18_2, correct_18_1]
  all_goals decide

