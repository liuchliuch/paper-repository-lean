def numerator20 : List ℤ := @@GENERATED_RHS:numerator20@@
theorem sum20 : sumVectors vectors20 id=numerator20.take (20+1) := by decide +kernel
theorem evaluated20 : evaluateFastVector rootState 20=numerator20.take (20+1) := by
  rw [evaluateFastVector_of_rows rootState 20 vectors20 rows20,sum20]
theorem truncated20 : (List.range 23).all (fun i => decide
    ((numerator20.take (20+1)).getD i 0=numerator20.getD i 0)) = true := by decide +kernel

theorem scaled20 : (List.range 23).all (fun i => decide
    ((numerator20.getD i 0 : ℚ) =
      (FastQ36.denominator 20:ℚ)*((36:ℕ).factorial:ℚ)*
        ((1:ℚ)/Uniform36.Dqval)*(Uniform36.AList.getD i 0:ℚ))) = true := by decide +kernel

theorem evaluated20_getD (i : ℕ) (hi : i < 23) :
    (evaluateFastVector rootState 20).getD i 0 = numerator20.getD i 0 := by
  rw [evaluated20]
  exact of_decide_eq_true (List.all_eq_true.mp truncated20 i (List.mem_range.mpr hi))

theorem scaled20_getD (i : ℕ) (hi : i < 23) :
    (numerator20.getD i 0 : ℚ) =
      (FastQ36.denominator 20:ℚ)*((36:ℕ).factorial:ℚ)*
