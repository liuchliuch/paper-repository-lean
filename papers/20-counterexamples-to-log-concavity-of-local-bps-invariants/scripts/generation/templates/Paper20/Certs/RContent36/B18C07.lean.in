import Paper20.Certs.RContent36.B18C06
set_option maxHeartbeats 0
set_option maxRecDepth 200000
namespace Paper20.Cert.RContent36.Tree
open Paper20.RContent36
open Paper20.HilbertJobs (Job parts children)

def j_18 : Job := ⟨[18], 18, 18, 36⟩

def v_18 : State := @@GENERATED_RHS:v_18@@

theorem correct_18 : Correct j_18 v_18 := by
  have hc : children j_18 = [j_18_18, j_18_17, j_18_16, j_18_15, j_18_14, j_18_13, j_18_12, j_18_11, j_18_10, j_18_9, j_18_8, j_18_7, j_18_6, j_18_5, j_18_4, j_18_3, j_18_2, j_18_1] := by decide +kernel
  have hv : List.Forall₂ Correct (children j_18) [v_18_18, v_18_17, v_18_16, v_18_15, v_18_14, v_18_13, v_18_12, v_18_11, v_18_10, v_18_9, v_18_8, v_18_7, v_18_6, v_18_5, v_18_4, v_18_3, v_18_2, v_18_1] := by
    rw [hc]
    exact (List.Forall₂.cons correct_18_18 (List.Forall₂.cons correct_18_17 (List.Forall₂.cons correct_18_16 (List.Forall₂.cons correct_18_15 (List.Forall₂.cons correct_18_14 (List.Forall₂.cons correct_18_13 (List.Forall₂.cons correct_18_12 (List.Forall₂.cons correct_18_11 (List.Forall₂.cons correct_18_10 (List.Forall₂.cons correct_18_9 (List.Forall₂.cons correct_18_8 (List.Forall₂.cons correct_18_7 (List.Forall₂.cons correct_18_6 (List.Forall₂.cons correct_18_5 (List.Forall₂.cons correct_18_4 (List.Forall₂.cons correct_18_3 (List.Forall₂.cons correct_18_2 (List.Forall₂.cons correct_18_1 List.Forall₂.nil))))))))))))))))))
  have hp := correct_children j_18 (by decide) (by decide) [v_18_18, v_18_17, v_18_16, v_18_15, v_18_14, v_18_13, v_18_12, v_18_11, v_18_10, v_18_9, v_18_8, v_18_7, v_18_6, v_18_5, v_18_4, v_18_3, v_18_2, v_18_1] hv
  have he : combine [v_18_18, v_18_17, v_18_16, v_18_15, v_18_14, v_18_13, v_18_12, v_18_11, v_18_10, v_18_9, v_18_8, v_18_7, v_18_6, v_18_5, v_18_4, v_18_3, v_18_2, v_18_1] = v_18 := by decide +kernel
  rwa [he] at hp

end Paper20.Cert.RContent36.Tree
