def j_6_6_5_4 : Job := ⟨[6, 6, 5, 4], 4, 15, 33⟩

def v_6_6_5_4 : State := @@GENERATED_RHS:v_6_6_5_4@@

theorem correct_6_6_5_4 : Correct j_6_6_5_4 v_6_6_5_4 := by
  have hc : children j_6_6_5_4 = [j_6_6_5_4_4, j_6_6_5_4_3, j_6_6_5_4_2, j_6_6_5_4_1] := by decide +kernel
  have hv : List.Forall₂ Correct (children j_6_6_5_4) [v_6_6_5_4_4, v_6_6_5_4_3, v_6_6_5_4_2, v_6_6_5_4_1] := by
    rw [hc]
    exact (List.Forall₂.cons correct_6_6_5_4_4 (List.Forall₂.cons correct_6_6_5_4_3 (List.Forall₂.cons correct_6_6_5_4_2 (List.Forall₂.cons correct_6_6_5_4_1 List.Forall₂.nil))))
  have hp := correct_children j_6_6_5_4 (by decide) (by decide) [v_6_6_5_4_4, v_6_6_5_4_3, v_6_6_5_4_2, v_6_6_5_4_1] hv
  have he : combine [v_6_6_5_4_4, v_6_6_5_4_3, v_6_6_5_4_2, v_6_6_5_4_1] = v_6_6_5_4 := by decide +kernel
  rwa [he] at hp

