def j_17_10 : Job := ⟨[17, 10], 10, 9, 35⟩

def v_17_10 : State := @@GENERATED_RHS:v_17_10@@

theorem correct_17_10 : Correct j_17_10 v_17_10 := by
  have hc : children j_17_10 = [j_17_10_9, j_17_10_8, j_17_10_7, j_17_10_6, j_17_10_5, j_17_10_4, j_17_10_3, j_17_10_2, j_17_10_1] := by decide +kernel
  have hv : List.Forall₂ Correct (children j_17_10) [v_17_10_9, v_17_10_8, v_17_10_7, v_17_10_6, v_17_10_5, v_17_10_4, v_17_10_3, v_17_10_2, v_17_10_1] := by
    rw [hc]
    exact (List.Forall₂.cons correct_17_10_9 (List.Forall₂.cons correct_17_10_8 (List.Forall₂.cons correct_17_10_7 (List.Forall₂.cons correct_17_10_6 (List.Forall₂.cons correct_17_10_5 (List.Forall₂.cons correct_17_10_4 (List.Forall₂.cons correct_17_10_3 (List.Forall₂.cons correct_17_10_2 (List.Forall₂.cons correct_17_10_1 List.Forall₂.nil)))))))))
  have hp := correct_children j_17_10 (by decide) (by decide) [v_17_10_9, v_17_10_8, v_17_10_7, v_17_10_6, v_17_10_5, v_17_10_4, v_17_10_3, v_17_10_2, v_17_10_1] hv
  have he : combine [v_17_10_9, v_17_10_8, v_17_10_7, v_17_10_6, v_17_10_5, v_17_10_4, v_17_10_3, v_17_10_2, v_17_10_1] = v_17_10 := by decide +kernel
  rwa [he] at hp

