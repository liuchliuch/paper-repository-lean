def j_12_12_6 : Job := ⟨[12, 12, 6], 6, 6, 34⟩

def v_12_12_6 : State := @@GENERATED_RHS:v_12_12_6@@

theorem correct_12_12_6 : Correct j_12_12_6 v_12_12_6 := by
  have hc : children j_12_12_6 = [j_12_12_6_6, j_12_12_6_5, j_12_12_6_4, j_12_12_6_3, j_12_12_6_2, j_12_12_6_1] := by decide +kernel
  have hv : List.Forall₂ Correct (children j_12_12_6) [v_12_12_6_6, v_12_12_6_5, v_12_12_6_4, v_12_12_6_3, v_12_12_6_2, v_12_12_6_1] := by
    rw [hc]
    exact (List.Forall₂.cons correct_12_12_6_6 (List.Forall₂.cons correct_12_12_6_5 (List.Forall₂.cons correct_12_12_6_4 (List.Forall₂.cons correct_12_12_6_3 (List.Forall₂.cons correct_12_12_6_2 (List.Forall₂.cons correct_12_12_6_1 List.Forall₂.nil))))))
  have hp := correct_children j_12_12_6 (by decide) (by decide) [v_12_12_6_6, v_12_12_6_5, v_12_12_6_4, v_12_12_6_3, v_12_12_6_2, v_12_12_6_1] hv
  have he : combine [v_12_12_6_6, v_12_12_6_5, v_12_12_6_4, v_12_12_6_3, v_12_12_6_2, v_12_12_6_1] = v_12_12_6 := by decide +kernel
  rwa [he] at hp

