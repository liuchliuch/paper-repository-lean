def j_10_8_4 : Job := ⟨[10, 8, 4], 4, 14, 34⟩

def v_10_8_4 : State := @@GENERATED_RHS:v_10_8_4@@

theorem correct_10_8_4 : Correct j_10_8_4 v_10_8_4 := by
  have hc : children j_10_8_4 = [j_10_8_4_4, j_10_8_4_3, j_10_8_4_2, j_10_8_4_1] := by decide +kernel
  have hv : List.Forall₂ Correct (children j_10_8_4) [v_10_8_4_4, v_10_8_4_3, v_10_8_4_2, v_10_8_4_1] := by
    rw [hc]
    exact (List.Forall₂.cons correct_10_8_4_4 (List.Forall₂.cons correct_10_8_4_3 (List.Forall₂.cons correct_10_8_4_2 (List.Forall₂.cons correct_10_8_4_1 List.Forall₂.nil))))
  have hp := correct_children j_10_8_4 (by decide) (by decide) [v_10_8_4_4, v_10_8_4_3, v_10_8_4_2, v_10_8_4_1] hv
  have he : combine [v_10_8_4_4, v_10_8_4_3, v_10_8_4_2, v_10_8_4_1] = v_10_8_4 := by decide +kernel
  rwa [he] at hp

