theorem root_correct : Correct Paper20.RContent36.root rootState := by
  have hc : children Paper20.RContent36.root = [j_36, j_35, j_34, j_33, j_32, j_31, j_30, j_29, j_28, j_27, j_26, j_25, j_24, j_23, j_22, j_21, j_20, j_19, j_18, j_17, j_16, j_15, j_14, j_13, j_12, j_11, j_10, j_9, j_8, j_7, j_6, j_5, j_4, j_3, j_2, j_1] := by decide +kernel
  have hv : List.Forall₂ Correct (children Paper20.RContent36.root) [v_36, v_35, v_34, v_33, v_32, v_31, v_30, v_29, v_28, v_27, v_26, v_25, v_24, v_23, v_22, v_21, v_20, v_19, v_18, v_17, v_16, v_15, v_14, v_13, v_12, v_11, v_10, v_9, v_8, v_7, v_6, v_5, v_4, v_3, v_2, v_1] := by
    rw [hc]
    exact (List.Forall₂.cons correct_36 (List.Forall₂.cons correct_35 (List.Forall₂.cons correct_34 (List.Forall₂.cons correct_33 (List.Forall₂.cons correct_32 (List.Forall₂.cons correct_31 (List.Forall₂.cons correct_30 (List.Forall₂.cons correct_29 (List.Forall₂.cons correct_28 (List.Forall₂.cons correct_27 (List.Forall₂.cons correct_26 (List.Forall₂.cons correct_25 (List.Forall₂.cons correct_24 (List.Forall₂.cons correct_23 (List.Forall₂.cons correct_22 (List.Forall₂.cons correct_21 (List.Forall₂.cons correct_20 (List.Forall₂.cons correct_19 (List.Forall₂.cons correct_18 (List.Forall₂.cons correct_17 (List.Forall₂.cons correct_16 (List.Forall₂.cons correct_15 (List.Forall₂.cons correct_14 (List.Forall₂.cons correct_13 (List.Forall₂.cons correct_12 (List.Forall₂.cons correct_11 (List.Forall₂.cons correct_10 (List.Forall₂.cons correct_9 (List.Forall₂.cons correct_8 (List.Forall₂.cons correct_7 (List.Forall₂.cons correct_6 (List.Forall₂.cons correct_5 (List.Forall₂.cons correct_4 (List.Forall₂.cons correct_3 (List.Forall₂.cons correct_2 (List.Forall₂.cons correct_1 List.Forall₂.nil))))))))))))))))))))))))))))))))))))
  have hp := correct_children Paper20.RContent36.root (by decide) (by decide) [v_36, v_35, v_34, v_33, v_32, v_31, v_30, v_29, v_28, v_27, v_26, v_25, v_24, v_23, v_22, v_21, v_20, v_19, v_18, v_17, v_16, v_15, v_14, v_13, v_12, v_11, v_10, v_9, v_8, v_7, v_6, v_5, v_4, v_3, v_2, v_1] hv
  have he : combine [v_36, v_35, v_34, v_33, v_32, v_31, v_30, v_29, v_28, v_27, v_26, v_25, v_24, v_23, v_22, v_21, v_20, v_19, v_18, v_17, v_16, v_15, v_14, v_13, v_12, v_11, v_10, v_9, v_8, v_7, v_6, v_5, v_4, v_3, v_2, v_1] = rootState := by decide +kernel
