def j_18_6_4 : Job := ⟨[18, 6, 4], 4, 8, 34⟩

def v_18_6_4 : State := @@GENERATED_RHS:v_18_6_4@@

theorem correct_18_6_4 : Correct j_18_6_4 v_18_6_4 := by
  have hc : children j_18_6_4 = [j_18_6_4_4, j_18_6_4_3, j_18_6_4_2, j_18_6_4_1] := by decide +kernel
  have hv : List.Forall₂ Correct (children j_18_6_4) [v_18_6_4_4, v_18_6_4_3, v_18_6_4_2, v_18_6_4_1] := by
    rw [hc]
    exact (List.Forall₂.cons correct_18_6_4_4 (List.Forall₂.cons correct_18_6_4_3 (List.Forall₂.cons correct_18_6_4_2 (List.Forall₂.cons correct_18_6_4_1 List.Forall₂.nil))))
  have hp := correct_children j_18_6_4 (by decide) (by decide) [v_18_6_4_4, v_18_6_4_3, v_18_6_4_2, v_18_6_4_1] hv
  have he : combine [v_18_6_4_4, v_18_6_4_3, v_18_6_4_2, v_18_6_4_1] = v_18_6_4 := by decide +kernel
  rwa [he] at hp

