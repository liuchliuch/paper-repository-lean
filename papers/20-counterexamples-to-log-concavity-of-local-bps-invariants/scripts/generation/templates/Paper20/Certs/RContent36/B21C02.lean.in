def j_21_4 : Job := ⟨[21, 4], 4, 11, 35⟩

def v_21_4 : State := @@GENERATED_RHS:v_21_4@@

theorem correct_21_4 : Correct j_21_4 v_21_4 := by
  have hc : children j_21_4 = [j_21_4_4, j_21_4_3, j_21_4_2, j_21_4_1] := by decide +kernel
  have hv : List.Forall₂ Correct (children j_21_4) [v_21_4_4, v_21_4_3, v_21_4_2, v_21_4_1] := by
    rw [hc]
    exact (List.Forall₂.cons correct_21_4_4 (List.Forall₂.cons correct_21_4_3 (List.Forall₂.cons correct_21_4_2 (List.Forall₂.cons correct_21_4_1 List.Forall₂.nil))))
  have hp := correct_children j_21_4 (by decide) (by decide) [v_21_4_4, v_21_4_3, v_21_4_2, v_21_4_1] hv
  have he : combine [v_21_4_4, v_21_4_3, v_21_4_2, v_21_4_1] = v_21_4 := by decide +kernel
  rwa [he] at hp

