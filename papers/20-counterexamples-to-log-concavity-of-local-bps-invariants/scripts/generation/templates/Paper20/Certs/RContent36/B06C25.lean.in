def j_6_5_3 : Job := ⟨[6, 5, 3], 3, 22, 34⟩

def v_6_5_3 : State := @@GENERATED_RHS:v_6_5_3@@

theorem correct_6_5_3 : Correct j_6_5_3 v_6_5_3 := by
  have hc : children j_6_5_3 = [j_6_5_3_3, j_6_5_3_2, j_6_5_3_1] := by decide +kernel
  have hv : List.Forall₂ Correct (children j_6_5_3) [v_6_5_3_3, v_6_5_3_2, v_6_5_3_1] := by
    rw [hc]
    exact (List.Forall₂.cons correct_6_5_3_3 (List.Forall₂.cons correct_6_5_3_2 (List.Forall₂.cons correct_6_5_3_1 List.Forall₂.nil)))
  have hp := correct_children j_6_5_3 (by decide) (by decide) [v_6_5_3_3, v_6_5_3_2, v_6_5_3_1] hv
  have he : combine [v_6_5_3_3, v_6_5_3_2, v_6_5_3_1] = v_6_5_3 := by decide +kernel
  rwa [he] at hp

