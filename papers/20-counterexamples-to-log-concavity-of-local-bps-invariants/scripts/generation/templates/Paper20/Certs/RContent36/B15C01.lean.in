def j_15_12 : Job := ⟨[15, 12], 12, 9, 35⟩

def v_15_12 : State := @@GENERATED_RHS:v_15_12@@

theorem correct_15_12 : Correct j_15_12 v_15_12 := by
  have hc : children j_15_12 = [j_15_12_9, j_15_12_8, j_15_12_7, j_15_12_6, j_15_12_5, j_15_12_4, j_15_12_3, j_15_12_2, j_15_12_1] := by decide +kernel
  have hv : List.Forall₂ Correct (children j_15_12) [v_15_12_9, v_15_12_8, v_15_12_7, v_15_12_6, v_15_12_5, v_15_12_4, v_15_12_3, v_15_12_2, v_15_12_1] := by
    rw [hc]
    exact (List.Forall₂.cons correct_15_12_9 (List.Forall₂.cons correct_15_12_8 (List.Forall₂.cons correct_15_12_7 (List.Forall₂.cons correct_15_12_6 (List.Forall₂.cons correct_15_12_5 (List.Forall₂.cons correct_15_12_4 (List.Forall₂.cons correct_15_12_3 (List.Forall₂.cons correct_15_12_2 (List.Forall₂.cons correct_15_12_1 List.Forall₂.nil)))))))))
  have hp := correct_children j_15_12 (by decide) (by decide) [v_15_12_9, v_15_12_8, v_15_12_7, v_15_12_6, v_15_12_5, v_15_12_4, v_15_12_3, v_15_12_2, v_15_12_1] hv
  have he : combine [v_15_12_9, v_15_12_8, v_15_12_7, v_15_12_6, v_15_12_5, v_15_12_4, v_15_12_3, v_15_12_2, v_15_12_1] = v_15_12 := by decide +kernel
  rwa [he] at hp

