def j_21_9 : Job := ⟨[21, 9], 9, 6, 35⟩

def v_21_9 : State := @@GENERATED_RHS:v_21_9@@

theorem correct_21_9 : Correct j_21_9 v_21_9 := by
  have hc : children j_21_9 = [j_21_9_6, j_21_9_5, j_21_9_4, j_21_9_3, j_21_9_2, j_21_9_1] := by decide +kernel
  have hv : List.Forall₂ Correct (children j_21_9) [v_21_9_6, v_21_9_5, v_21_9_4, v_21_9_3, v_21_9_2, v_21_9_1] := by
    rw [hc]
    exact (List.Forall₂.cons correct_21_9_6 (List.Forall₂.cons correct_21_9_5 (List.Forall₂.cons correct_21_9_4 (List.Forall₂.cons correct_21_9_3 (List.Forall₂.cons correct_21_9_2 (List.Forall₂.cons correct_21_9_1 List.Forall₂.nil))))))
  have hp := correct_children j_21_9 (by decide) (by decide) [v_21_9_6, v_21_9_5, v_21_9_4, v_21_9_3, v_21_9_2, v_21_9_1] hv
  have he : combine [v_21_9_6, v_21_9_5, v_21_9_4, v_21_9_3, v_21_9_2, v_21_9_1] = v_21_9 := by decide +kernel
  rwa [he] at hp

