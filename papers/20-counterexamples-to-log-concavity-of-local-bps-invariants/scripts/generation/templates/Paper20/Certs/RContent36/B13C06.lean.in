def j_13_9_3 : Job := ⟨[13, 9, 3], 3, 11, 34⟩

def v_13_9_3 : State := @@GENERATED_RHS:v_13_9_3@@

theorem correct_13_9_3 : Correct j_13_9_3 v_13_9_3 := by
  have hc : children j_13_9_3 = [j_13_9_3_3, j_13_9_3_2, j_13_9_3_1] := by decide +kernel
  have hv : List.Forall₂ Correct (children j_13_9_3) [v_13_9_3_3, v_13_9_3_2, v_13_9_3_1] := by
    rw [hc]
    exact (List.Forall₂.cons correct_13_9_3_3 (List.Forall₂.cons correct_13_9_3_2 (List.Forall₂.cons correct_13_9_3_1 List.Forall₂.nil)))
  have hp := correct_children j_13_9_3 (by decide) (by decide) [v_13_9_3_3, v_13_9_3_2, v_13_9_3_1] hv
  have he : combine [v_13_9_3_3, v_13_9_3_2, v_13_9_3_1] = v_13_9_3 := by decide +kernel
  rwa [he] at hp

