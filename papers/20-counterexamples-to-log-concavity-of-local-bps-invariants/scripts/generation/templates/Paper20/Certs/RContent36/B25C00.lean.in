def j_25_5 : Job := ⟨[25, 5], 5, 6, 35⟩

def v_25_5 : State := @@GENERATED_RHS:v_25_5@@

theorem correct_25_5 : Correct j_25_5 v_25_5 := by
  have hc : children j_25_5 = [j_25_5_5, j_25_5_4, j_25_5_3, j_25_5_2, j_25_5_1] := by decide +kernel
  have hv : List.Forall₂ Correct (children j_25_5) [v_25_5_5, v_25_5_4, v_25_5_3, v_25_5_2, v_25_5_1] := by
    rw [hc]
    exact (List.Forall₂.cons correct_25_5_5 (List.Forall₂.cons correct_25_5_4 (List.Forall₂.cons correct_25_5_3 (List.Forall₂.cons correct_25_5_2 (List.Forall₂.cons correct_25_5_1 List.Forall₂.nil)))))
  have hp := correct_children j_25_5 (by decide) (by decide) [v_25_5_5, v_25_5_4, v_25_5_3, v_25_5_2, v_25_5_1] hv
  have he : combine [v_25_5_5, v_25_5_4, v_25_5_3, v_25_5_2, v_25_5_1] = v_25_5 := by decide +kernel
  rwa [he] at hp

