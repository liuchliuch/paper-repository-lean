def j_10_2_2_2_2_2 : Job := ⟨[10, 2, 2, 2, 2, 2], 2, 16, 31⟩

def v_10_2_2_2_2_2 : State := @@GENERATED_RHS:v_10_2_2_2_2_2@@

theorem correct_10_2_2_2_2_2 : Correct j_10_2_2_2_2_2 v_10_2_2_2_2_2 := by
  have hc : children j_10_2_2_2_2_2 = [j_10_2_2_2_2_2_2, j_10_2_2_2_2_2_1] := by decide +kernel
  have hv : List.Forall₂ Correct (children j_10_2_2_2_2_2) [v_10_2_2_2_2_2_2, v_10_2_2_2_2_2_1] := by
    rw [hc]
    exact (List.Forall₂.cons correct_10_2_2_2_2_2_2 (List.Forall₂.cons correct_10_2_2_2_2_2_1 List.Forall₂.nil))
  have hp := correct_children j_10_2_2_2_2_2 (by decide) (by decide) [v_10_2_2_2_2_2_2, v_10_2_2_2_2_2_1] hv
  have he : combine [v_10_2_2_2_2_2_2, v_10_2_2_2_2_2_1] = v_10_2_2_2_2_2 := by decide +kernel
  rwa [he] at hp

