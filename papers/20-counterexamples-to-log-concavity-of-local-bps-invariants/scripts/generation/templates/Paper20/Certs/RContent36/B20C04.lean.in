import Paper20.Certs.RContent36.B20C03
set_option maxHeartbeats 0
set_option maxRecDepth 200000
namespace Paper20.Cert.RContent36.Tree
open Paper20.RContent36
open Paper20.HilbertJobs (Job parts children)

def j_20 : Job := ⟨[20], 20, 16, 36⟩

def v_20 : State := @@GENERATED_RHS:v_20@@

theorem correct_20 : Correct j_20 v_20 := by
  have hc : children j_20 = [j_20_16, j_20_15, j_20_14, j_20_13, j_20_12, j_20_11, j_20_10, j_20_9, j_20_8, j_20_7, j_20_6, j_20_5, j_20_4, j_20_3, j_20_2, j_20_1] := by decide +kernel
  have hv : List.Forall₂ Correct (children j_20) [v_20_16, v_20_15, v_20_14, v_20_13, v_20_12, v_20_11, v_20_10, v_20_9, v_20_8, v_20_7, v_20_6, v_20_5, v_20_4, v_20_3, v_20_2, v_20_1] := by
    rw [hc]
    exact (List.Forall₂.cons correct_20_16 (List.Forall₂.cons correct_20_15 (List.Forall₂.cons correct_20_14 (List.Forall₂.cons correct_20_13 (List.Forall₂.cons correct_20_12 (List.Forall₂.cons correct_20_11 (List.Forall₂.cons correct_20_10 (List.Forall₂.cons correct_20_9 (List.Forall₂.cons correct_20_8 (List.Forall₂.cons correct_20_7 (List.Forall₂.cons correct_20_6 (List.Forall₂.cons correct_20_5 (List.Forall₂.cons correct_20_4 (List.Forall₂.cons correct_20_3 (List.Forall₂.cons correct_20_2 (List.Forall₂.cons correct_20_1 List.Forall₂.nil))))))))))))))))
  have hp := correct_children j_20 (by decide) (by decide) [v_20_16, v_20_15, v_20_14, v_20_13, v_20_12, v_20_11, v_20_10, v_20_9, v_20_8, v_20_7, v_20_6, v_20_5, v_20_4, v_20_3, v_20_2, v_20_1] hv
  have he : combine [v_20_16, v_20_15, v_20_14, v_20_13, v_20_12, v_20_11, v_20_10, v_20_9, v_20_8, v_20_7, v_20_6, v_20_5, v_20_4, v_20_3, v_20_2, v_20_1] = v_20 := by decide +kernel
  rwa [he] at hp

end Paper20.Cert.RContent36.Tree
