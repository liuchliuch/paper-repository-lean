def j_16_11 : Job := ⟨[16, 11], 11, 9, 35⟩

def v_16_11 : State := @@GENERATED_RHS:v_16_11@@

theorem correct_16_11 : Correct j_16_11 v_16_11 := by
  have hc : children j_16_11 = [j_16_11_9, j_16_11_8, j_16_11_7, j_16_11_6, j_16_11_5, j_16_11_4, j_16_11_3, j_16_11_2, j_16_11_1] := by decide +kernel
  have hv : List.Forall₂ Correct (children j_16_11) [v_16_11_9, v_16_11_8, v_16_11_7, v_16_11_6, v_16_11_5, v_16_11_4, v_16_11_3, v_16_11_2, v_16_11_1] := by
    rw [hc]
    exact (List.Forall₂.cons correct_16_11_9 (List.Forall₂.cons correct_16_11_8 (List.Forall₂.cons correct_16_11_7 (List.Forall₂.cons correct_16_11_6 (List.Forall₂.cons correct_16_11_5 (List.Forall₂.cons correct_16_11_4 (List.Forall₂.cons correct_16_11_3 (List.Forall₂.cons correct_16_11_2 (List.Forall₂.cons correct_16_11_1 List.Forall₂.nil)))))))))
  have hp := correct_children j_16_11 (by decide) (by decide) [v_16_11_9, v_16_11_8, v_16_11_7, v_16_11_6, v_16_11_5, v_16_11_4, v_16_11_3, v_16_11_2, v_16_11_1] hv
  have he : combine [v_16_11_9, v_16_11_8, v_16_11_7, v_16_11_6, v_16_11_5, v_16_11_4, v_16_11_3, v_16_11_2, v_16_11_1] = v_16_11 := by decide +kernel
  rwa [he] at hp

