def j_13_8_7 : Job := ⟨[13, 8, 7], 7, 8, 34⟩

def v_13_8_7 : State := @@GENERATED_RHS:v_13_8_7@@

theorem correct_13_8_7 : Correct j_13_8_7 v_13_8_7 := by
  have hc : children j_13_8_7 = [j_13_8_7_7, j_13_8_7_6, j_13_8_7_5, j_13_8_7_4, j_13_8_7_3, j_13_8_7_2, j_13_8_7_1] := by decide +kernel
  have hv : List.Forall₂ Correct (children j_13_8_7) [v_13_8_7_7, v_13_8_7_6, v_13_8_7_5, v_13_8_7_4, v_13_8_7_3, v_13_8_7_2, v_13_8_7_1] := by
    rw [hc]
    exact (List.Forall₂.cons correct_13_8_7_7 (List.Forall₂.cons correct_13_8_7_6 (List.Forall₂.cons correct_13_8_7_5 (List.Forall₂.cons correct_13_8_7_4 (List.Forall₂.cons correct_13_8_7_3 (List.Forall₂.cons correct_13_8_7_2 (List.Forall₂.cons correct_13_8_7_1 List.Forall₂.nil)))))))
  have hp := correct_children j_13_8_7 (by decide) (by decide) [v_13_8_7_7, v_13_8_7_6, v_13_8_7_5, v_13_8_7_4, v_13_8_7_3, v_13_8_7_2, v_13_8_7_1] hv
  have he : combine [v_13_8_7_7, v_13_8_7_6, v_13_8_7_5, v_13_8_7_4, v_13_8_7_3, v_13_8_7_2, v_13_8_7_1] = v_13_8_7 := by decide +kernel
  rwa [he] at hp

