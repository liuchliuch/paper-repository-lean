def j_15_15 : Job := ⟨[15, 15], 15, 6, 35⟩

def v_15_15 : State := @@GENERATED_RHS:v_15_15@@

theorem correct_15_15 : Correct j_15_15 v_15_15 := by
  have hc : children j_15_15 = [j_15_15_6, j_15_15_5, j_15_15_4, j_15_15_3, j_15_15_2, j_15_15_1] := by decide +kernel
  have hv : List.Forall₂ Correct (children j_15_15) [v_15_15_6, v_15_15_5, v_15_15_4, v_15_15_3, v_15_15_2, v_15_15_1] := by
    rw [hc]
    exact (List.Forall₂.cons correct_15_15_6 (List.Forall₂.cons correct_15_15_5 (List.Forall₂.cons correct_15_15_4 (List.Forall₂.cons correct_15_15_3 (List.Forall₂.cons correct_15_15_2 (List.Forall₂.cons correct_15_15_1 List.Forall₂.nil))))))
  have hp := correct_children j_15_15 (by decide) (by decide) [v_15_15_6, v_15_15_5, v_15_15_4, v_15_15_3, v_15_15_2, v_15_15_1] hv
  have he : combine [v_15_15_6, v_15_15_5, v_15_15_4, v_15_15_3, v_15_15_2, v_15_15_1] = v_15_15 := by decide +kernel
  rwa [he] at hp

