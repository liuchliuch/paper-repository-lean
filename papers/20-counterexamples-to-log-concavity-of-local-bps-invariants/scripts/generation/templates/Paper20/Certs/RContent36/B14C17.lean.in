def j_14_4 : Job := ⟨[14, 4], 4, 18, 35⟩

def v_14_4 : State := @@GENERATED_RHS:v_14_4@@

theorem correct_14_4 : Correct j_14_4 v_14_4 := by
  have hc : children j_14_4 = [j_14_4_4, j_14_4_3, j_14_4_2, j_14_4_1] := by decide +kernel
  have hv : List.Forall₂ Correct (children j_14_4) [v_14_4_4, v_14_4_3, v_14_4_2, v_14_4_1] := by
    rw [hc]
    exact (List.Forall₂.cons correct_14_4_4 (List.Forall₂.cons correct_14_4_3 (List.Forall₂.cons correct_14_4_2 (List.Forall₂.cons correct_14_4_1 List.Forall₂.nil))))
  have hp := correct_children j_14_4 (by decide) (by decide) [v_14_4_4, v_14_4_3, v_14_4_2, v_14_4_1] hv
  have he : combine [v_14_4_4, v_14_4_3, v_14_4_2, v_14_4_1] = v_14_4 := by decide +kernel
  rwa [he] at hp

