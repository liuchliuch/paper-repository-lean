def j_19_3_3_3 : Job := ⟨[19, 3, 3, 3], 3, 8, 33⟩

def v_19_3_3_3 : State := @@GENERATED_RHS:v_19_3_3_3@@

theorem correct_19_3_3_3 : Correct j_19_3_3_3 v_19_3_3_3 := by
  have hc : children j_19_3_3_3 = [j_19_3_3_3_3, j_19_3_3_3_2, j_19_3_3_3_1] := by decide +kernel
  have hv : List.Forall₂ Correct (children j_19_3_3_3) [v_19_3_3_3_3, v_19_3_3_3_2, v_19_3_3_3_1] := by
    rw [hc]
    exact (List.Forall₂.cons correct_19_3_3_3_3 (List.Forall₂.cons correct_19_3_3_3_2 (List.Forall₂.cons correct_19_3_3_3_1 List.Forall₂.nil)))
  have hp := correct_children j_19_3_3_3 (by decide) (by decide) [v_19_3_3_3_3, v_19_3_3_3_2, v_19_3_3_3_1] hv
  have he : combine [v_19_3_3_3_3, v_19_3_3_3_2, v_19_3_3_3_1] = v_19_3_3_3 := by decide +kernel
  rwa [he] at hp

