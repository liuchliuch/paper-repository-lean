def j_19_5 : Job := ⟨[19, 5], 5, 12, 35⟩

def v_19_5 : State := @@GENERATED_RHS:v_19_5@@

theorem correct_19_5 : Correct j_19_5 v_19_5 := by
  have hc : children j_19_5 = [j_19_5_5, j_19_5_4, j_19_5_3, j_19_5_2, j_19_5_1] := by decide +kernel
  have hv : List.Forall₂ Correct (children j_19_5) [v_19_5_5, v_19_5_4, v_19_5_3, v_19_5_2, v_19_5_1] := by
    rw [hc]
    exact (List.Forall₂.cons correct_19_5_5 (List.Forall₂.cons correct_19_5_4 (List.Forall₂.cons correct_19_5_3 (List.Forall₂.cons correct_19_5_2 (List.Forall₂.cons correct_19_5_1 List.Forall₂.nil)))))
  have hp := correct_children j_19_5 (by decide) (by decide) [v_19_5_5, v_19_5_4, v_19_5_3, v_19_5_2, v_19_5_1] hv
  have he : combine [v_19_5_5, v_19_5_4, v_19_5_3, v_19_5_2, v_19_5_1] = v_19_5 := by decide +kernel
  rwa [he] at hp

