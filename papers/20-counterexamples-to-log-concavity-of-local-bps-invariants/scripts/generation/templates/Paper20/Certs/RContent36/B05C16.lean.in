def j_5_4_4_4_4 : Job := ⟨[5, 4, 4, 4, 4], 4, 15, 32⟩

def v_5_4_4_4_4 : State := @@GENERATED_RHS:v_5_4_4_4_4@@

theorem correct_5_4_4_4_4 : Correct j_5_4_4_4_4 v_5_4_4_4_4 := by
  have hc : children j_5_4_4_4_4 = [j_5_4_4_4_4_4, j_5_4_4_4_4_3, j_5_4_4_4_4_2, j_5_4_4_4_4_1] := by decide +kernel
  have hv : List.Forall₂ Correct (children j_5_4_4_4_4) [v_5_4_4_4_4_4, v_5_4_4_4_4_3, v_5_4_4_4_4_2, v_5_4_4_4_4_1] := by
    rw [hc]
    exact (List.Forall₂.cons correct_5_4_4_4_4_4 (List.Forall₂.cons correct_5_4_4_4_4_3 (List.Forall₂.cons correct_5_4_4_4_4_2 (List.Forall₂.cons correct_5_4_4_4_4_1 List.Forall₂.nil))))
  have hp := correct_children j_5_4_4_4_4 (by decide) (by decide) [v_5_4_4_4_4_4, v_5_4_4_4_4_3, v_5_4_4_4_4_2, v_5_4_4_4_4_1] hv
  have he : combine [v_5_4_4_4_4_4, v_5_4_4_4_4_3, v_5_4_4_4_4_2, v_5_4_4_4_4_1] = v_5_4_4_4_4 := by decide +kernel
  rwa [he] at hp

