def j_23_3 : Job := ⟨[23, 3], 3, 10, 35⟩

def v_23_3 : State := @@GENERATED_RHS:v_23_3@@

theorem correct_23_3 : Correct j_23_3 v_23_3 := by
  have hc : children j_23_3 = [j_23_3_3, j_23_3_2, j_23_3_1] := by decide +kernel
  have hv : List.Forall₂ Correct (children j_23_3) [v_23_3_3, v_23_3_2, v_23_3_1] := by
    rw [hc]
    exact (List.Forall₂.cons correct_23_3_3 (List.Forall₂.cons correct_23_3_2 (List.Forall₂.cons correct_23_3_1 List.Forall₂.nil)))
  have hp := correct_children j_23_3 (by decide) (by decide) [v_23_3_3, v_23_3_2, v_23_3_1] hv
  have he : combine [v_23_3_3, v_23_3_2, v_23_3_1] = v_23_3 := by decide +kernel
  rwa [he] at hp

