  have hv : List.Forall₂ Correct (children j_9_6_3_2) [v_9_6_3_2_2, v_9_6_3_2_1] := by
    rw [hc]
    exact (List.Forall₂.cons correct_9_6_3_2_2 (List.Forall₂.cons correct_9_6_3_2_1 List.Forall₂.nil))
  have hp := correct_children j_9_6_3_2 (by decide) (by decide) [v_9_6_3_2_2, v_9_6_3_2_1] hv
  have he : combine [v_9_6_3_2_2, v_9_6_3_2_1] = v_9_6_3_2 := by decide +kernel
  rwa [he] at hp

