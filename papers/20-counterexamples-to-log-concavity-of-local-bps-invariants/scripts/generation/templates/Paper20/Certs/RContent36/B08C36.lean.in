def j_8_5_2_2_2 : Job := ⟨[8, 5, 2, 2, 2], 2, 17, 32⟩

def v_8_5_2_2_2 : State := @@GENERATED_RHS:v_8_5_2_2_2@@

theorem correct_8_5_2_2_2 : Correct j_8_5_2_2_2 v_8_5_2_2_2 := by
  have hc : children j_8_5_2_2_2 = [j_8_5_2_2_2_2, j_8_5_2_2_2_1] := by decide +kernel
  have hv : List.Forall₂ Correct (children j_8_5_2_2_2) [v_8_5_2_2_2_2, v_8_5_2_2_2_1] := by
    rw [hc]
    exact (List.Forall₂.cons correct_8_5_2_2_2_2 (List.Forall₂.cons correct_8_5_2_2_2_1 List.Forall₂.nil))
  have hp := correct_children j_8_5_2_2_2 (by decide) (by decide) [v_8_5_2_2_2_2, v_8_5_2_2_2_1] hv
  have he : combine [v_8_5_2_2_2_2, v_8_5_2_2_2_1] = v_8_5_2_2_2 := by decide +kernel
  rwa [he] at hp

