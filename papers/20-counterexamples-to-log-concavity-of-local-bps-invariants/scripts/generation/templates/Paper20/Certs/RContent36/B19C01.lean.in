def j_19_8 : Job := ⟨[19, 8], 8, 9, 35⟩

def v_19_8 : State := @@GENERATED_RHS:v_19_8@@

theorem correct_19_8 : Correct j_19_8 v_19_8 := by
  have hc : children j_19_8 = [j_19_8_8, j_19_8_7, j_19_8_6, j_19_8_5, j_19_8_4, j_19_8_3, j_19_8_2, j_19_8_1] := by decide +kernel
  have hv : List.Forall₂ Correct (children j_19_8) [v_19_8_8, v_19_8_7, v_19_8_6, v_19_8_5, v_19_8_4, v_19_8_3, v_19_8_2, v_19_8_1] := by
    rw [hc]
    exact (List.Forall₂.cons correct_19_8_8 (List.Forall₂.cons correct_19_8_7 (List.Forall₂.cons correct_19_8_6 (List.Forall₂.cons correct_19_8_5 (List.Forall₂.cons correct_19_8_4 (List.Forall₂.cons correct_19_8_3 (List.Forall₂.cons correct_19_8_2 (List.Forall₂.cons correct_19_8_1 List.Forall₂.nil))))))))
  have hp := correct_children j_19_8 (by decide) (by decide) [v_19_8_8, v_19_8_7, v_19_8_6, v_19_8_5, v_19_8_4, v_19_8_3, v_19_8_2, v_19_8_1] hv
  have he : combine [v_19_8_8, v_19_8_7, v_19_8_6, v_19_8_5, v_19_8_4, v_19_8_3, v_19_8_2, v_19_8_1] = v_19_8 := by decide +kernel
  rwa [he] at hp

