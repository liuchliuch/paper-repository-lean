def j_16_14 : Job := ⟨[16, 14], 14, 6, 35⟩

def v_16_14 : State := @@GENERATED_RHS:v_16_14@@

theorem correct_16_14 : Correct j_16_14 v_16_14 := by
  have hc : children j_16_14 = [j_16_14_6, j_16_14_5, j_16_14_4, j_16_14_3, j_16_14_2, j_16_14_1] := by decide +kernel
  have hv : List.Forall₂ Correct (children j_16_14) [v_16_14_6, v_16_14_5, v_16_14_4, v_16_14_3, v_16_14_2, v_16_14_1] := by
    rw [hc]
    exact (List.Forall₂.cons correct_16_14_6 (List.Forall₂.cons correct_16_14_5 (List.Forall₂.cons correct_16_14_4 (List.Forall₂.cons correct_16_14_3 (List.Forall₂.cons correct_16_14_2 (List.Forall₂.cons correct_16_14_1 List.Forall₂.nil))))))
  have hp := correct_children j_16_14 (by decide) (by decide) [v_16_14_6, v_16_14_5, v_16_14_4, v_16_14_3, v_16_14_2, v_16_14_1] hv
  have he : combine [v_16_14_6, v_16_14_5, v_16_14_4, v_16_14_3, v_16_14_2, v_16_14_1] = v_16_14 := by decide +kernel
  rwa [he] at hp

