def j_18_9 : Job := ⟨[18, 9], 9, 9, 35⟩

def v_18_9 : State := @@GENERATED_RHS:v_18_9@@

theorem correct_18_9 : Correct j_18_9 v_18_9 := by
  have hc : children j_18_9 = [j_18_9_9, j_18_9_8, j_18_9_7, j_18_9_6, j_18_9_5, j_18_9_4, j_18_9_3, j_18_9_2, j_18_9_1] := by decide +kernel
  have hv : List.Forall₂ Correct (children j_18_9) [v_18_9_9, v_18_9_8, v_18_9_7, v_18_9_6, v_18_9_5, v_18_9_4, v_18_9_3, v_18_9_2, v_18_9_1] := by
    rw [hc]
    exact (List.Forall₂.cons correct_18_9_9 (List.Forall₂.cons correct_18_9_8 (List.Forall₂.cons correct_18_9_7 (List.Forall₂.cons correct_18_9_6 (List.Forall₂.cons correct_18_9_5 (List.Forall₂.cons correct_18_9_4 (List.Forall₂.cons correct_18_9_3 (List.Forall₂.cons correct_18_9_2 (List.Forall₂.cons correct_18_9_1 List.Forall₂.nil)))))))))
  have hp := correct_children j_18_9 (by decide) (by decide) [v_18_9_9, v_18_9_8, v_18_9_7, v_18_9_6, v_18_9_5, v_18_9_4, v_18_9_3, v_18_9_2, v_18_9_1] hv
  have he : combine [v_18_9_9, v_18_9_8, v_18_9_7, v_18_9_6, v_18_9_5, v_18_9_4, v_18_9_3, v_18_9_2, v_18_9_1] = v_18_9 := by decide +kernel
  rwa [he] at hp

