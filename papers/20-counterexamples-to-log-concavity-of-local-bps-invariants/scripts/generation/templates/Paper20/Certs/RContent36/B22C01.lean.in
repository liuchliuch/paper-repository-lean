def j_22_5 : Job := ⟨[22, 5], 5, 9, 35⟩

def v_22_5 : State := @@GENERATED_RHS:v_22_5@@

theorem correct_22_5 : Correct j_22_5 v_22_5 := by
  have hc : children j_22_5 = [j_22_5_5, j_22_5_4, j_22_5_3, j_22_5_2, j_22_5_1] := by decide +kernel
  have hv : List.Forall₂ Correct (children j_22_5) [v_22_5_5, v_22_5_4, v_22_5_3, v_22_5_2, v_22_5_1] := by
    rw [hc]
    exact (List.Forall₂.cons correct_22_5_5 (List.Forall₂.cons correct_22_5_4 (List.Forall₂.cons correct_22_5_3 (List.Forall₂.cons correct_22_5_2 (List.Forall₂.cons correct_22_5_1 List.Forall₂.nil)))))
  have hp := correct_children j_22_5 (by decide) (by decide) [v_22_5_5, v_22_5_4, v_22_5_3, v_22_5_2, v_22_5_1] hv
  have he : combine [v_22_5_5, v_22_5_4, v_22_5_3, v_22_5_2, v_22_5_1] = v_22_5 := by decide +kernel
  rwa [he] at hp

