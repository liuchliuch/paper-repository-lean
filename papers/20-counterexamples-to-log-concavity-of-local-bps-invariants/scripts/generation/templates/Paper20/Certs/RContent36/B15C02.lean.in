def j_15_10_4 : Job := ⟨[15, 10, 4], 4, 7, 34⟩

def v_15_10_4 : State := @@GENERATED_RHS:v_15_10_4@@

theorem correct_15_10_4 : Correct j_15_10_4 v_15_10_4 := by
  have hc : children j_15_10_4 = [j_15_10_4_4, j_15_10_4_3, j_15_10_4_2, j_15_10_4_1] := by decide +kernel
  have hv : List.Forall₂ Correct (children j_15_10_4) [v_15_10_4_4, v_15_10_4_3, v_15_10_4_2, v_15_10_4_1] := by
    rw [hc]
    exact (List.Forall₂.cons correct_15_10_4_4 (List.Forall₂.cons correct_15_10_4_3 (List.Forall₂.cons correct_15_10_4_2 (List.Forall₂.cons correct_15_10_4_1 List.Forall₂.nil))))
  have hp := correct_children j_15_10_4 (by decide) (by decide) [v_15_10_4_4, v_15_10_4_3, v_15_10_4_2, v_15_10_4_1] hv
  have he : combine [v_15_10_4_4, v_15_10_4_3, v_15_10_4_2, v_15_10_4_1] = v_15_10_4 := by decide +kernel
  rwa [he] at hp

