    exact (List.Forall₂.cons correct_9_9_9_9 (List.Forall₂.cons correct_9_9_9_8 (List.Forall₂.cons correct_9_9_9_7 (List.Forall₂.cons correct_9_9_9_6 (List.Forall₂.cons correct_9_9_9_5 (List.Forall₂.cons correct_9_9_9_4 (List.Forall₂.cons correct_9_9_9_3 (List.Forall₂.cons correct_9_9_9_2 (List.Forall₂.cons correct_9_9_9_1 List.Forall₂.nil)))))))))
