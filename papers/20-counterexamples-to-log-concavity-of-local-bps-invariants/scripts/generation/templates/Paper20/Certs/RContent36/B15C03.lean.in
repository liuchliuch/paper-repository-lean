def j_15_9_5 : Job := ⟨[15, 9, 5], 5, 7, 34⟩

def v_15_9_5 : State := @@GENERATED_RHS:v_15_9_5@@

theorem correct_15_9_5 : Correct j_15_9_5 v_15_9_5 := by
  have hc : children j_15_9_5 = [j_15_9_5_5, j_15_9_5_4, j_15_9_5_3, j_15_9_5_2, j_15_9_5_1] := by decide +kernel
  have hv : List.Forall₂ Correct (children j_15_9_5) [v_15_9_5_5, v_15_9_5_4, v_15_9_5_3, v_15_9_5_2, v_15_9_5_1] := by
    rw [hc]
    exact (List.Forall₂.cons correct_15_9_5_5 (List.Forall₂.cons correct_15_9_5_4 (List.Forall₂.cons correct_15_9_5_3 (List.Forall₂.cons correct_15_9_5_2 (List.Forall₂.cons correct_15_9_5_1 List.Forall₂.nil)))))
  have hp := correct_children j_15_9_5 (by decide) (by decide) [v_15_9_5_5, v_15_9_5_4, v_15_9_5_3, v_15_9_5_2, v_15_9_5_1] hv
  have he : combine [v_15_9_5_5, v_15_9_5_4, v_15_9_5_3, v_15_9_5_2, v_15_9_5_1] = v_15_9_5 := by decide +kernel
  rwa [he] at hp

