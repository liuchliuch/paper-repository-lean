def j_13_3 : Job := ⟨[13, 3], 3, 20, 35⟩

def v_13_3 : State := @@GENERATED_RHS:v_13_3@@

theorem correct_13_3 : Correct j_13_3 v_13_3 := by
  have hc : children j_13_3 = [j_13_3_3, j_13_3_2, j_13_3_1] := by decide +kernel
  have hv : List.Forall₂ Correct (children j_13_3) [v_13_3_3, v_13_3_2, v_13_3_1] := by
    rw [hc]
    exact (List.Forall₂.cons correct_13_3_3 (List.Forall₂.cons correct_13_3_2 (List.Forall₂.cons correct_13_3_1 List.Forall₂.nil)))
  have hp := correct_children j_13_3 (by decide) (by decide) [v_13_3_3, v_13_3_2, v_13_3_1] hv
  have he : combine [v_13_3_3, v_13_3_2, v_13_3_1] = v_13_3 := by decide +kernel
  rwa [he] at hp

