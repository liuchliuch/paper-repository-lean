import Paper20.Certs.RContent36.B18C05
set_option maxHeartbeats 0
set_option maxRecDepth 200000
namespace Paper20.Cert.RContent36.Tree
open Paper20.RContent36
open Paper20.HilbertJobs (Job parts children)

def j_18_3 : Job := ⟨[18, 3], 3, 15, 35⟩

def v_18_3 : State := @@GENERATED_RHS:v_18_3@@

theorem correct_18_3 : Correct j_18_3 v_18_3 := by
  have hc : children j_18_3 = [j_18_3_3, j_18_3_2, j_18_3_1] := by decide +kernel
  have hv : List.Forall₂ Correct (children j_18_3) [v_18_3_3, v_18_3_2, v_18_3_1] := by
    rw [hc]
    exact (List.Forall₂.cons correct_18_3_3 (List.Forall₂.cons correct_18_3_2 (List.Forall₂.cons correct_18_3_1 List.Forall₂.nil)))
  have hp := correct_children j_18_3 (by decide) (by decide) [v_18_3_3, v_18_3_2, v_18_3_1] hv
  have he : combine [v_18_3_3, v_18_3_2, v_18_3_1] = v_18_3 := by decide +kernel
  rwa [he] at hp

def j_18_2_2 : Job := ⟨[18, 2, 2], 2, 14, 34⟩

def v_18_2_2 : State := @@GENERATED_RHS:v_18_2_2@@

theorem correct_18_2_2 : Correct j_18_2_2 v_18_2_2 := correct_leaf j_18_2_2 v_18_2_2 (by decide +kernel)

def j_18_2_1 : Job := ⟨[18, 2, 1], 1, 15, 34⟩

def v_18_2_1 : State := @@GENERATED_RHS:v_18_2_1@@

theorem correct_18_2_1 : Correct j_18_2_1 v_18_2_1 := correct_leaf j_18_2_1 v_18_2_1 (by decide +kernel)

def j_18_2 : Job := ⟨[18, 2], 2, 16, 35⟩

def v_18_2 : State := @@GENERATED_RHS:v_18_2@@

theorem correct_18_2 : Correct j_18_2 v_18_2 := by
  have hc : children j_18_2 = [j_18_2_2, j_18_2_1] := by decide +kernel
  have hv : List.Forall₂ Correct (children j_18_2) [v_18_2_2, v_18_2_1] := by
    rw [hc]
    exact (List.Forall₂.cons correct_18_2_2 (List.Forall₂.cons correct_18_2_1 List.Forall₂.nil))
  have hp := correct_children j_18_2 (by decide) (by decide) [v_18_2_2, v_18_2_1] hv
  have he : combine [v_18_2_2, v_18_2_1] = v_18_2 := by decide +kernel
  rwa [he] at hp

def j_18_1 : Job := ⟨[18, 1], 1, 17, 35⟩

def v_18_1 : State := @@GENERATED_RHS:v_18_1@@

theorem correct_18_1 : Correct j_18_1 v_18_1 := correct_leaf j_18_1 v_18_1 (by decide +kernel)

end Paper20.Cert.RContent36.Tree
