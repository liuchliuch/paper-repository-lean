def j_21_6 : Job := ⟨[21, 6], 6, 9, 35⟩

def v_21_6 : State := @@GENERATED_RHS:v_21_6@@

theorem correct_21_6 : Correct j_21_6 v_21_6 := by
  have hc : children j_21_6 = [j_21_6_6, j_21_6_5, j_21_6_4, j_21_6_3, j_21_6_2, j_21_6_1] := by decide +kernel
  have hv : List.Forall₂ Correct (children j_21_6) [v_21_6_6, v_21_6_5, v_21_6_4, v_21_6_3, v_21_6_2, v_21_6_1] := by
    rw [hc]
    exact (List.Forall₂.cons correct_21_6_6 (List.Forall₂.cons correct_21_6_5 (List.Forall₂.cons correct_21_6_4 (List.Forall₂.cons correct_21_6_3 (List.Forall₂.cons correct_21_6_2 (List.Forall₂.cons correct_21_6_1 List.Forall₂.nil))))))
  have hp := correct_children j_21_6 (by decide) (by decide) [v_21_6_6, v_21_6_5, v_21_6_4, v_21_6_3, v_21_6_2, v_21_6_1] hv
  have he : combine [v_21_6_6, v_21_6_5, v_21_6_4, v_21_6_3, v_21_6_2, v_21_6_1] = v_21_6 := by decide +kernel
  rwa [he] at hp

