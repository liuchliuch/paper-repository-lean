theorem correct_9_8_3_3 : Correct j_9_8_3_3 v_9_8_3_3 := by
  have hc : children j_9_8_3_3 = [j_9_8_3_3_3, j_9_8_3_3_2, j_9_8_3_3_1] := by decide +kernel
  have hv : List.Forall₂ Correct (children j_9_8_3_3) [v_9_8_3_3_3, v_9_8_3_3_2, v_9_8_3_3_1] := by
    rw [hc]
