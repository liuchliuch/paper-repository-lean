theorem correct_4_4_4_4_4 : Correct j_4_4_4_4_4 v_4_4_4_4_4 := by
  have hc : children j_4_4_4_4_4 = [j_4_4_4_4_4_4, j_4_4_4_4_4_3, j_4_4_4_4_4_2, j_4_4_4_4_4_1] := by decide +kernel
