def j_20_10 : Job := ⟨[20, 10], 10, 6, 35⟩

def v_20_10 : State := @@GENERATED_RHS:v_20_10@@

theorem correct_20_10 : Correct j_20_10 v_20_10 := by
  have hc : children j_20_10 = [j_20_10_6, j_20_10_5, j_20_10_4, j_20_10_3, j_20_10_2, j_20_10_1] := by decide +kernel
  have hv : List.Forall₂ Correct (children j_20_10) [v_20_10_6, v_20_10_5, v_20_10_4, v_20_10_3, v_20_10_2, v_20_10_1] := by
    rw [hc]
    exact (List.Forall₂.cons correct_20_10_6 (List.Forall₂.cons correct_20_10_5 (List.Forall₂.cons correct_20_10_4 (List.Forall₂.cons correct_20_10_3 (List.Forall₂.cons correct_20_10_2 (List.Forall₂.cons correct_20_10_1 List.Forall₂.nil))))))
  have hp := correct_children j_20_10 (by decide) (by decide) [v_20_10_6, v_20_10_5, v_20_10_4, v_20_10_3, v_20_10_2, v_20_10_1] hv
  have he : combine [v_20_10_6, v_20_10_5, v_20_10_4, v_20_10_3, v_20_10_2, v_20_10_1] = v_20_10 := by decide +kernel
  rwa [he] at hp

