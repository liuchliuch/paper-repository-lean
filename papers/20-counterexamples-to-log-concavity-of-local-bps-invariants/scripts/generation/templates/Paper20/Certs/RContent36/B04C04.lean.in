def j_4_4_4_3 : Job := ⟨[4, 4, 4, 3], 3, 21, 33⟩

def v_4_4_4_3 : State := @@GENERATED_RHS:v_4_4_4_3@@

theorem correct_4_4_4_3 : Correct j_4_4_4_3 v_4_4_4_3 := by
  have hc : children j_4_4_4_3 = [j_4_4_4_3_3, j_4_4_4_3_2, j_4_4_4_3_1] := by decide +kernel
  have hv : List.Forall₂ Correct (children j_4_4_4_3) [v_4_4_4_3_3, v_4_4_4_3_2, v_4_4_4_3_1] := by
    rw [hc]
    exact (List.Forall₂.cons correct_4_4_4_3_3 (List.Forall₂.cons correct_4_4_4_3_2 (List.Forall₂.cons correct_4_4_4_3_1 List.Forall₂.nil)))
  have hp := correct_children j_4_4_4_3 (by decide) (by decide) [v_4_4_4_3_3, v_4_4_4_3_2, v_4_4_4_3_1] hv
  have he : combine [v_4_4_4_3_3, v_4_4_4_3_2, v_4_4_4_3_1] = v_4_4_4_3 := by decide +kernel
  rwa [he] at hp

