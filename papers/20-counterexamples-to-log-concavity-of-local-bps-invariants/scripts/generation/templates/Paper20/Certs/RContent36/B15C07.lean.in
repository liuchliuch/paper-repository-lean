def j_15_7 : Job := ⟨[15, 7], 7, 14, 35⟩

def v_15_7 : State := @@GENERATED_RHS:v_15_7@@

theorem correct_15_7 : Correct j_15_7 v_15_7 := by
  have hc : children j_15_7 = [j_15_7_7, j_15_7_6, j_15_7_5, j_15_7_4, j_15_7_3, j_15_7_2, j_15_7_1] := by decide +kernel
  have hv : List.Forall₂ Correct (children j_15_7) [v_15_7_7, v_15_7_6, v_15_7_5, v_15_7_4, v_15_7_3, v_15_7_2, v_15_7_1] := by
    rw [hc]
    exact (List.Forall₂.cons correct_15_7_7 (List.Forall₂.cons correct_15_7_6 (List.Forall₂.cons correct_15_7_5 (List.Forall₂.cons correct_15_7_4 (List.Forall₂.cons correct_15_7_3 (List.Forall₂.cons correct_15_7_2 (List.Forall₂.cons correct_15_7_1 List.Forall₂.nil)))))))
  have hp := correct_children j_15_7 (by decide) (by decide) [v_15_7_7, v_15_7_6, v_15_7_5, v_15_7_4, v_15_7_3, v_15_7_2, v_15_7_1] hv
  have he : combine [v_15_7_7, v_15_7_6, v_15_7_5, v_15_7_4, v_15_7_3, v_15_7_2, v_15_7_1] = v_15_7 := by decide +kernel
  rwa [he] at hp

