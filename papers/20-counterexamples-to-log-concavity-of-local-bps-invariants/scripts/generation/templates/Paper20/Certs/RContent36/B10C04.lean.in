    exact (List.Forall₂.cons correct_10_9_9_8 (List.Forall₂.cons correct_10_9_9_7 (List.Forall₂.cons correct_10_9_9_6 (List.Forall₂.cons correct_10_9_9_5 (List.Forall₂.cons correct_10_9_9_4 (List.Forall₂.cons correct_10_9_9_3 (List.Forall₂.cons correct_10_9_9_2 (List.Forall₂.cons correct_10_9_9_1 List.Forall₂.nil))))))))
  have hp := correct_children j_10_9_9 (by decide) (by decide) [v_10_9_9_8, v_10_9_9_7, v_10_9_9_6, v_10_9_9_5, v_10_9_9_4, v_10_9_9_3, v_10_9_9_2, v_10_9_9_1] hv
  have he : combine [v_10_9_9_8, v_10_9_9_7, v_10_9_9_6, v_10_9_9_5, v_10_9_9_4, v_10_9_9_3, v_10_9_9_2, v_10_9_9_1] = v_10_9_9 := by decide +kernel
  rwa [he] at hp

