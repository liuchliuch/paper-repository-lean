def v_14_12 : State := @@GENERATED_RHS:v_14_12@@

theorem correct_14_12 : Correct j_14_12 v_14_12 := by
  have hc : children j_14_12 = [j_14_12_10, j_14_12_9, j_14_12_8, j_14_12_7, j_14_12_6, j_14_12_5, j_14_12_4, j_14_12_3, j_14_12_2, j_14_12_1] := by decide +kernel
  have hv : List.Forall₂ Correct (children j_14_12) [v_14_12_10, v_14_12_9, v_14_12_8, v_14_12_7, v_14_12_6, v_14_12_5, v_14_12_4, v_14_12_3, v_14_12_2, v_14_12_1] := by
    rw [hc]
    exact (List.Forall₂.cons correct_14_12_10 (List.Forall₂.cons correct_14_12_9 (List.Forall₂.cons correct_14_12_8 (List.Forall₂.cons correct_14_12_7 (List.Forall₂.cons correct_14_12_6 (List.Forall₂.cons correct_14_12_5 (List.Forall₂.cons correct_14_12_4 (List.Forall₂.cons correct_14_12_3 (List.Forall₂.cons correct_14_12_2 (List.Forall₂.cons correct_14_12_1 List.Forall₂.nil))))))))))
  have hp := correct_children j_14_12 (by decide) (by decide) [v_14_12_10, v_14_12_9, v_14_12_8, v_14_12_7, v_14_12_6, v_14_12_5, v_14_12_4, v_14_12_3, v_14_12_2, v_14_12_1] hv
  have he : combine [v_14_12_10, v_14_12_9, v_14_12_8, v_14_12_7, v_14_12_6, v_14_12_5, v_14_12_4, v_14_12_3, v_14_12_2, v_14_12_1] = v_14_12 := by decide +kernel
  rwa [he] at hp

