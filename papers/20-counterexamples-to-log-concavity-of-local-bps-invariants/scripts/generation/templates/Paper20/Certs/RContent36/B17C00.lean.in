def j_17_13 : Job := ⟨[17, 13], 13, 6, 35⟩

def v_17_13 : State := @@GENERATED_RHS:v_17_13@@

theorem correct_17_13 : Correct j_17_13 v_17_13 := by
  have hc : children j_17_13 = [j_17_13_6, j_17_13_5, j_17_13_4, j_17_13_3, j_17_13_2, j_17_13_1] := by decide +kernel
  have hv : List.Forall₂ Correct (children j_17_13) [v_17_13_6, v_17_13_5, v_17_13_4, v_17_13_3, v_17_13_2, v_17_13_1] := by
    rw [hc]
    exact (List.Forall₂.cons correct_17_13_6 (List.Forall₂.cons correct_17_13_5 (List.Forall₂.cons correct_17_13_4 (List.Forall₂.cons correct_17_13_3 (List.Forall₂.cons correct_17_13_2 (List.Forall₂.cons correct_17_13_1 List.Forall₂.nil))))))
  have hp := correct_children j_17_13 (by decide) (by decide) [v_17_13_6, v_17_13_5, v_17_13_4, v_17_13_3, v_17_13_2, v_17_13_1] hv
  have he : combine [v_17_13_6, v_17_13_5, v_17_13_4, v_17_13_3, v_17_13_2, v_17_13_1] = v_17_13 := by decide +kernel
  rwa [he] at hp

