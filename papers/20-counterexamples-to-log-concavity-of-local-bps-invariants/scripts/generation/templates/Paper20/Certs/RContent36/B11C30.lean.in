theorem correct_11_4_3_3 : Correct j_11_4_3_3 v_11_4_3_3 := by
  have hc : children j_11_4_3_3 = [j_11_4_3_3_3, j_11_4_3_3_2, j_11_4_3_3_1] := by decide +kernel
  have hv : List.Forall₂ Correct (children j_11_4_3_3) [v_11_4_3_3_3, v_11_4_3_3_2, v_11_4_3_3_1] := by
    rw [hc]
    exact (List.Forall₂.cons correct_11_4_3_3_3 (List.Forall₂.cons correct_11_4_3_3_2 (List.Forall₂.cons correct_11_4_3_3_1 List.Forall₂.nil)))
  have hp := correct_children j_11_4_3_3 (by decide) (by decide) [v_11_4_3_3_3, v_11_4_3_3_2, v_11_4_3_3_1] hv
  have he : combine [v_11_4_3_3_3, v_11_4_3_3_2, v_11_4_3_3_1] = v_11_4_3_3 := by decide +kernel
  rwa [he] at hp

