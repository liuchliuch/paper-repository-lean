def j_27 : Job := ⟨[27], 27, 9, 36⟩

def v_27 : State := @@GENERATED_RHS:v_27@@

theorem correct_27 : Correct j_27 v_27 := by
  have hc : children j_27 = [j_27_9, j_27_8, j_27_7, j_27_6, j_27_5, j_27_4, j_27_3, j_27_2, j_27_1] := by decide +kernel
  have hv : List.Forall₂ Correct (children j_27) [v_27_9, v_27_8, v_27_7, v_27_6, v_27_5, v_27_4, v_27_3, v_27_2, v_27_1] := by
    rw [hc]
    exact (List.Forall₂.cons correct_27_9 (List.Forall₂.cons correct_27_8 (List.Forall₂.cons correct_27_7 (List.Forall₂.cons correct_27_6 (List.Forall₂.cons correct_27_5 (List.Forall₂.cons correct_27_4 (List.Forall₂.cons correct_27_3 (List.Forall₂.cons correct_27_2 (List.Forall₂.cons correct_27_1 List.Forall₂.nil)))))))))
  have hp := correct_children j_27 (by decide) (by decide) [v_27_9, v_27_8, v_27_7, v_27_6, v_27_5, v_27_4, v_27_3, v_27_2, v_27_1] hv
  have he : combine [v_27_9, v_27_8, v_27_7, v_27_6, v_27_5, v_27_4, v_27_3, v_27_2, v_27_1] = v_27 := by decide +kernel
  rwa [he] at hp

