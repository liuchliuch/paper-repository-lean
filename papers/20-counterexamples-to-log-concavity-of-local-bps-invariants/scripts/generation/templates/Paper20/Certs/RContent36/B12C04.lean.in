  have hc : children j_12_10_4_4 = [j_12_10_4_4_4, j_12_10_4_4_3, j_12_10_4_4_2, j_12_10_4_4_1] := by decide +kernel
  have hv : List.Forall₂ Correct (children j_12_10_4_4) [v_12_10_4_4_4, v_12_10_4_4_3, v_12_10_4_4_2, v_12_10_4_4_1] := by
    rw [hc]
    exact (List.Forall₂.cons correct_12_10_4_4_4 (List.Forall₂.cons correct_12_10_4_4_3 (List.Forall₂.cons correct_12_10_4_4_2 (List.Forall₂.cons correct_12_10_4_4_1 List.Forall₂.nil))))
  have hp := correct_children j_12_10_4_4 (by decide) (by decide) [v_12_10_4_4_4, v_12_10_4_4_3, v_12_10_4_4_2, v_12_10_4_4_1] hv
  have he : combine [v_12_10_4_4_4, v_12_10_4_4_3, v_12_10_4_4_2, v_12_10_4_4_1] = v_12_10_4_4 := by decide +kernel
