def j_8_4_3 : Job := ⟨[8, 4, 3], 3, 21, 34⟩

def v_8_4_3 : State := @@GENERATED_RHS:v_8_4_3@@

theorem correct_8_4_3 : Correct j_8_4_3 v_8_4_3 := by
  have hc : children j_8_4_3 = [j_8_4_3_3, j_8_4_3_2, j_8_4_3_1] := by decide +kernel
  have hv : List.Forall₂ Correct (children j_8_4_3) [v_8_4_3_3, v_8_4_3_2, v_8_4_3_1] := by
    rw [hc]
    exact (List.Forall₂.cons correct_8_4_3_3 (List.Forall₂.cons correct_8_4_3_2 (List.Forall₂.cons correct_8_4_3_1 List.Forall₂.nil)))
  have hp := correct_children j_8_4_3 (by decide) (by decide) [v_8_4_3_3, v_8_4_3_2, v_8_4_3_1] hv
  have he : combine [v_8_4_3_3, v_8_4_3_2, v_8_4_3_1] = v_8_4_3 := by decide +kernel
  rwa [he] at hp

