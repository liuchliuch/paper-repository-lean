def v_29_5 : State := @@GENERATED_RHS:v_29_5@@

theorem correct_29_5 : Correct j_29_5 v_29_5 := correct_leaf j_29_5 v_29_5 (by decide +kernel)

def j_29_4 : Job := ⟨[29, 4], 4, 3, 35⟩

def v_29_4 : State := @@GENERATED_RHS:v_29_4@@

theorem correct_29_4 : Correct j_29_4 v_29_4 := correct_leaf j_29_4 v_29_4 (by decide +kernel)

