def j_29 : Job := ⟨[29], 29, 7, 36⟩

def v_29 : State := @@GENERATED_RHS:v_29@@

theorem correct_29 : Correct j_29 v_29 := by
  have hc : children j_29 = [j_29_7, j_29_6, j_29_5, j_29_4, j_29_3, j_29_2, j_29_1] := by decide +kernel
  have hv : List.Forall₂ Correct (children j_29) [v_29_7, v_29_6, v_29_5, v_29_4, v_29_3, v_29_2, v_29_1] := by
    rw [hc]
    exact (List.Forall₂.cons correct_29_7 (List.Forall₂.cons correct_29_6 (List.Forall₂.cons correct_29_5 (List.Forall₂.cons correct_29_4 (List.Forall₂.cons correct_29_3 (List.Forall₂.cons correct_29_2 (List.Forall₂.cons correct_29_1 List.Forall₂.nil)))))))
  have hp := correct_children j_29 (by decide) (by decide) [v_29_7, v_29_6, v_29_5, v_29_4, v_29_3, v_29_2, v_29_1] hv
  have he : combine [v_29_7, v_29_6, v_29_5, v_29_4, v_29_3, v_29_2, v_29_1] = v_29 := by decide +kernel
  rwa [he] at hp

end Paper20.Cert.RContent36.Tree
