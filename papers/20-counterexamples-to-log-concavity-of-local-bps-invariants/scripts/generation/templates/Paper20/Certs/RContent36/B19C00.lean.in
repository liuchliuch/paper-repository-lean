def j_19_11 : Job := ⟨[19, 11], 11, 6, 35⟩

def v_19_11 : State := @@GENERATED_RHS:v_19_11@@

theorem correct_19_11 : Correct j_19_11 v_19_11 := by
  have hc : children j_19_11 = [j_19_11_6, j_19_11_5, j_19_11_4, j_19_11_3, j_19_11_2, j_19_11_1] := by decide +kernel
  have hv : List.Forall₂ Correct (children j_19_11) [v_19_11_6, v_19_11_5, v_19_11_4, v_19_11_3, v_19_11_2, v_19_11_1] := by
    rw [hc]
    exact (List.Forall₂.cons correct_19_11_6 (List.Forall₂.cons correct_19_11_5 (List.Forall₂.cons correct_19_11_4 (List.Forall₂.cons correct_19_11_3 (List.Forall₂.cons correct_19_11_2 (List.Forall₂.cons correct_19_11_1 List.Forall₂.nil))))))
  have hp := correct_children j_19_11 (by decide) (by decide) [v_19_11_6, v_19_11_5, v_19_11_4, v_19_11_3, v_19_11_2, v_19_11_1] hv
  have he : combine [v_19_11_6, v_19_11_5, v_19_11_4, v_19_11_3, v_19_11_2, v_19_11_1] = v_19_11 := by decide +kernel
  rwa [he] at hp

