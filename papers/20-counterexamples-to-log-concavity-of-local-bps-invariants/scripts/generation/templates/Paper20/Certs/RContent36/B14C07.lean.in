def j_14_8_3 : Job := ⟨[14, 8, 3], 3, 11, 34⟩

def v_14_8_3 : State := @@GENERATED_RHS:v_14_8_3@@

theorem correct_14_8_3 : Correct j_14_8_3 v_14_8_3 := by
  have hc : children j_14_8_3 = [j_14_8_3_3, j_14_8_3_2, j_14_8_3_1] := by decide +kernel
  have hv : List.Forall₂ Correct (children j_14_8_3) [v_14_8_3_3, v_14_8_3_2, v_14_8_3_1] := by
    rw [hc]
    exact (List.Forall₂.cons correct_14_8_3_3 (List.Forall₂.cons correct_14_8_3_2 (List.Forall₂.cons correct_14_8_3_1 List.Forall₂.nil)))
  have hp := correct_children j_14_8_3 (by decide) (by decide) [v_14_8_3_3, v_14_8_3_2, v_14_8_3_1] hv
  have he : combine [v_14_8_3_3, v_14_8_3_2, v_14_8_3_1] = v_14_8_3 := by decide +kernel
  rwa [he] at hp

