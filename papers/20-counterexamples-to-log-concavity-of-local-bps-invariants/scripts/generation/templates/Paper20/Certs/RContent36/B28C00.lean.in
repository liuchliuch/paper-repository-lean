import Paper20.RContent36
set_option maxHeartbeats 0
set_option maxRecDepth 200000
namespace Paper20.Cert.RContent36.Tree
open Paper20.RContent36
open Paper20.HilbertJobs (Job parts children)

def j_28_8 : Job := ⟨[28, 8], 8, 0, 35⟩

def v_28_8 : State := @@GENERATED_RHS:v_28_8@@

theorem correct_28_8 : Correct j_28_8 v_28_8 := correct_leaf j_28_8 v_28_8 (by decide +kernel)

