def j_28 : Job := ⟨[28], 28, 8, 36⟩

def v_28 : State := @@GENERATED_RHS:v_28@@

theorem correct_28 : Correct j_28 v_28 := by
  have hc : children j_28 = [j_28_8, j_28_7, j_28_6, j_28_5, j_28_4, j_28_3, j_28_2, j_28_1] := by decide +kernel
  have hv : List.Forall₂ Correct (children j_28) [v_28_8, v_28_7, v_28_6, v_28_5, v_28_4, v_28_3, v_28_2, v_28_1] := by
    rw [hc]
    exact (List.Forall₂.cons correct_28_8 (List.Forall₂.cons correct_28_7 (List.Forall₂.cons correct_28_6 (List.Forall₂.cons correct_28_5 (List.Forall₂.cons correct_28_4 (List.Forall₂.cons correct_28_3 (List.Forall₂.cons correct_28_2 (List.Forall₂.cons correct_28_1 List.Forall₂.nil))))))))
  have hp := correct_children j_28 (by decide) (by decide) [v_28_8, v_28_7, v_28_6, v_28_5, v_28_4, v_28_3, v_28_2, v_28_1] hv
  have he : combine [v_28_8, v_28_7, v_28_6, v_28_5, v_28_4, v_28_3, v_28_2, v_28_1] = v_28 := by decide +kernel
  rwa [he] at hp

end Paper20.Cert.RContent36.Tree
