def j_10_5_3_2 : Job := ⟨[10, 5, 3, 2], 2, 16, 33⟩

def v_10_5_3_2 : State := @@GENERATED_RHS:v_10_5_3_2@@

theorem correct_10_5_3_2 : Correct j_10_5_3_2 v_10_5_3_2 := by
  have hc : children j_10_5_3_2 = [j_10_5_3_2_2, j_10_5_3_2_1] := by decide +kernel
  have hv : List.Forall₂ Correct (children j_10_5_3_2) [v_10_5_3_2_2, v_10_5_3_2_1] := by
    rw [hc]
    exact (List.Forall₂.cons correct_10_5_3_2_2 (List.Forall₂.cons correct_10_5_3_2_1 List.Forall₂.nil))
  have hp := correct_children j_10_5_3_2 (by decide) (by decide) [v_10_5_3_2_2, v_10_5_3_2_1] hv
  have he : combine [v_10_5_3_2_2, v_10_5_3_2_1] = v_10_5_3_2 := by decide +kernel
  rwa [he] at hp

