def j_20_7 : Job := ⟨[20, 7], 7, 9, 35⟩

def v_20_7 : State := @@GENERATED_RHS:v_20_7@@

theorem correct_20_7 : Correct j_20_7 v_20_7 := by
  have hc : children j_20_7 = [j_20_7_7, j_20_7_6, j_20_7_5, j_20_7_4, j_20_7_3, j_20_7_2, j_20_7_1] := by decide +kernel
  have hv : List.Forall₂ Correct (children j_20_7) [v_20_7_7, v_20_7_6, v_20_7_5, v_20_7_4, v_20_7_3, v_20_7_2, v_20_7_1] := by
    rw [hc]
    exact (List.Forall₂.cons correct_20_7_7 (List.Forall₂.cons correct_20_7_6 (List.Forall₂.cons correct_20_7_5 (List.Forall₂.cons correct_20_7_4 (List.Forall₂.cons correct_20_7_3 (List.Forall₂.cons correct_20_7_2 (List.Forall₂.cons correct_20_7_1 List.Forall₂.nil)))))))
  have hp := correct_children j_20_7 (by decide) (by decide) [v_20_7_7, v_20_7_6, v_20_7_5, v_20_7_4, v_20_7_3, v_20_7_2, v_20_7_1] hv
  have he : combine [v_20_7_7, v_20_7_6, v_20_7_5, v_20_7_4, v_20_7_3, v_20_7_2, v_20_7_1] = v_20_7 := by decide +kernel
  rwa [he] at hp

