def j_13_6_6 : Job := ⟨[13, 6, 6], 6, 11, 34⟩

def v_13_6_6 : State := @@GENERATED_RHS:v_13_6_6@@

theorem correct_13_6_6 : Correct j_13_6_6 v_13_6_6 := by
  have hc : children j_13_6_6 = [j_13_6_6_6, j_13_6_6_5, j_13_6_6_4, j_13_6_6_3, j_13_6_6_2, j_13_6_6_1] := by decide +kernel
  have hv : List.Forall₂ Correct (children j_13_6_6) [v_13_6_6_6, v_13_6_6_5, v_13_6_6_4, v_13_6_6_3, v_13_6_6_2, v_13_6_6_1] := by
    rw [hc]
    exact (List.Forall₂.cons correct_13_6_6_6 (List.Forall₂.cons correct_13_6_6_5 (List.Forall₂.cons correct_13_6_6_4 (List.Forall₂.cons correct_13_6_6_3 (List.Forall₂.cons correct_13_6_6_2 (List.Forall₂.cons correct_13_6_6_1 List.Forall₂.nil))))))
  have hp := correct_children j_13_6_6 (by decide) (by decide) [v_13_6_6_6, v_13_6_6_5, v_13_6_6_4, v_13_6_6_3, v_13_6_6_2, v_13_6_6_1] hv
  have he : combine [v_13_6_6_6, v_13_6_6_5, v_13_6_6_4, v_13_6_6_3, v_13_6_6_2, v_13_6_6_1] = v_13_6_6 := by decide +kernel
  rwa [he] at hp

