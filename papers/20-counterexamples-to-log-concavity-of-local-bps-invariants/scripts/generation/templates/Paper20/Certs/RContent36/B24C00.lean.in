def j_24_6 : Job := ⟨[24, 6], 6, 6, 35⟩

def v_24_6 : State := @@GENERATED_RHS:v_24_6@@

theorem correct_24_6 : Correct j_24_6 v_24_6 := by
  have hc : children j_24_6 = [j_24_6_6, j_24_6_5, j_24_6_4, j_24_6_3, j_24_6_2, j_24_6_1] := by decide +kernel
  have hv : List.Forall₂ Correct (children j_24_6) [v_24_6_6, v_24_6_5, v_24_6_4, v_24_6_3, v_24_6_2, v_24_6_1] := by
    rw [hc]
    exact (List.Forall₂.cons correct_24_6_6 (List.Forall₂.cons correct_24_6_5 (List.Forall₂.cons correct_24_6_4 (List.Forall₂.cons correct_24_6_3 (List.Forall₂.cons correct_24_6_2 (List.Forall₂.cons correct_24_6_1 List.Forall₂.nil))))))
  have hp := correct_children j_24_6 (by decide) (by decide) [v_24_6_6, v_24_6_5, v_24_6_4, v_24_6_3, v_24_6_2, v_24_6_1] hv
  have he : combine [v_24_6_6, v_24_6_5, v_24_6_4, v_24_6_3, v_24_6_2, v_24_6_1] = v_24_6 := by decide +kernel
  rwa [he] at hp

