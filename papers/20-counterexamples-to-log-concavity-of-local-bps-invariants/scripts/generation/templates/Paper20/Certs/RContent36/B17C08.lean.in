import Paper20.Certs.RContent36.B17C07
set_option maxHeartbeats 0
set_option maxRecDepth 200000
namespace Paper20.Cert.RContent36.Tree
open Paper20.RContent36
open Paper20.HilbertJobs (Job parts children)

def j_17_3 : Job := ⟨[17, 3], 3, 16, 35⟩

def v_17_3 : State := @@GENERATED_RHS:v_17_3@@

theorem correct_17_3 : Correct j_17_3 v_17_3 := by
  have hc : children j_17_3 = [j_17_3_3, j_17_3_2, j_17_3_1] := by decide +kernel
  have hv : List.Forall₂ Correct (children j_17_3) [v_17_3_3, v_17_3_2, v_17_3_1] := by
    rw [hc]
    exact (List.Forall₂.cons correct_17_3_3 (List.Forall₂.cons correct_17_3_2 (List.Forall₂.cons correct_17_3_1 List.Forall₂.nil)))
  have hp := correct_children j_17_3 (by decide) (by decide) [v_17_3_3, v_17_3_2, v_17_3_1] hv
  have he : combine [v_17_3_3, v_17_3_2, v_17_3_1] = v_17_3 := by decide +kernel
  rwa [he] at hp

def j_17_2_2 : Job := ⟨[17, 2, 2], 2, 15, 34⟩

def v_17_2_2 : State := @@GENERATED_RHS:v_17_2_2@@

theorem correct_17_2_2 : Correct j_17_2_2 v_17_2_2 := correct_leaf j_17_2_2 v_17_2_2 (by decide +kernel)

def j_17_2_1 : Job := ⟨[17, 2, 1], 1, 16, 34⟩

def v_17_2_1 : State := @@GENERATED_RHS:v_17_2_1@@

theorem correct_17_2_1 : Correct j_17_2_1 v_17_2_1 := correct_leaf j_17_2_1 v_17_2_1 (by decide +kernel)

def j_17_2 : Job := ⟨[17, 2], 2, 17, 35⟩

def v_17_2 : State := @@GENERATED_RHS:v_17_2@@

theorem correct_17_2 : Correct j_17_2 v_17_2 := by
  have hc : children j_17_2 = [j_17_2_2, j_17_2_1] := by decide +kernel
  have hv : List.Forall₂ Correct (children j_17_2) [v_17_2_2, v_17_2_1] := by
    rw [hc]
    exact (List.Forall₂.cons correct_17_2_2 (List.Forall₂.cons correct_17_2_1 List.Forall₂.nil))
  have hp := correct_children j_17_2 (by decide) (by decide) [v_17_2_2, v_17_2_1] hv
  have he : combine [v_17_2_2, v_17_2_1] = v_17_2 := by decide +kernel
  rwa [he] at hp

def j_17_1 : Job := ⟨[17, 1], 1, 18, 35⟩

def v_17_1 : State := @@GENERATED_RHS:v_17_1@@

theorem correct_17_1 : Correct j_17_1 v_17_1 := correct_leaf j_17_1 v_17_1 (by decide +kernel)

end Paper20.Cert.RContent36.Tree
