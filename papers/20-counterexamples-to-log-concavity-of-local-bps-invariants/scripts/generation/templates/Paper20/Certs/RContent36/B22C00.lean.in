def j_22_8 : Job := ⟨[22, 8], 8, 6, 35⟩

def v_22_8 : State := @@GENERATED_RHS:v_22_8@@

theorem correct_22_8 : Correct j_22_8 v_22_8 := by
  have hc : children j_22_8 = [j_22_8_6, j_22_8_5, j_22_8_4, j_22_8_3, j_22_8_2, j_22_8_1] := by decide +kernel
  have hv : List.Forall₂ Correct (children j_22_8) [v_22_8_6, v_22_8_5, v_22_8_4, v_22_8_3, v_22_8_2, v_22_8_1] := by
    rw [hc]
    exact (List.Forall₂.cons correct_22_8_6 (List.Forall₂.cons correct_22_8_5 (List.Forall₂.cons correct_22_8_4 (List.Forall₂.cons correct_22_8_3 (List.Forall₂.cons correct_22_8_2 (List.Forall₂.cons correct_22_8_1 List.Forall₂.nil))))))
  have hp := correct_children j_22_8 (by decide) (by decide) [v_22_8_6, v_22_8_5, v_22_8_4, v_22_8_3, v_22_8_2, v_22_8_1] hv
  have he : combine [v_22_8_6, v_22_8_5, v_22_8_4, v_22_8_3, v_22_8_2, v_22_8_1] = v_22_8 := by decide +kernel
  rwa [he] at hp

