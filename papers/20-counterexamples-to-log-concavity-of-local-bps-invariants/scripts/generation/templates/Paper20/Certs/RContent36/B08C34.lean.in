  have hc : children j_8_5_4_2 = [j_8_5_4_2_2, j_8_5_4_2_1] := by decide +kernel
  have hv : List.Forall₂ Correct (children j_8_5_4_2) [v_8_5_4_2_2, v_8_5_4_2_1] := by
    rw [hc]
    exact (List.Forall₂.cons correct_8_5_4_2_2 (List.Forall₂.cons correct_8_5_4_2_1 List.Forall₂.nil))
  have hp := correct_children j_8_5_4_2 (by decide) (by decide) [v_8_5_4_2_2, v_8_5_4_2_1] hv
