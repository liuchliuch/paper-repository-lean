import Paper20.Certs.RContent36.B12C27
set_option maxHeartbeats 0
set_option maxRecDepth 200000
namespace Paper20.Cert.RContent36.Tree
open Paper20.RContent36
open Paper20.HilbertJobs (Job parts children)

def j_12_2_1 : Job := ⟨[12, 2, 1], 1, 21, 34⟩

def v_12_2_1 : State := @@GENERATED_RHS:v_12_2_1@@

theorem correct_12_2_1 : Correct j_12_2_1 v_12_2_1 := correct_leaf j_12_2_1 v_12_2_1 (by decide +kernel)

def j_12_2 : Job := ⟨[12, 2], 2, 22, 35⟩

def v_12_2 : State := @@GENERATED_RHS:v_12_2@@

theorem correct_12_2 : Correct j_12_2 v_12_2 := by
  have hc : children j_12_2 = [j_12_2_2, j_12_2_1] := by decide +kernel
  have hv : List.Forall₂ Correct (children j_12_2) [v_12_2_2, v_12_2_1] := by
    rw [hc]
    exact (List.Forall₂.cons correct_12_2_2 (List.Forall₂.cons correct_12_2_1 List.Forall₂.nil))
  have hp := correct_children j_12_2 (by decide) (by decide) [v_12_2_2, v_12_2_1] hv
  have he : combine [v_12_2_2, v_12_2_1] = v_12_2 := by decide +kernel
  rwa [he] at hp

def j_12_1 : Job := ⟨[12, 1], 1, 23, 35⟩

def v_12_1 : State := @@GENERATED_RHS:v_12_1@@

theorem correct_12_1 : Correct j_12_1 v_12_1 := correct_leaf j_12_1 v_12_1 (by decide +kernel)

end Paper20.Cert.RContent36.Tree
