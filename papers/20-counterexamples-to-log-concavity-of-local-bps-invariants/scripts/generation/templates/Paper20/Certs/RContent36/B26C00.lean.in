def j_26 : Job := ⟨[26], 26, 10, 36⟩

def v_26 : State := @@GENERATED_RHS:v_26@@

theorem correct_26 : Correct j_26 v_26 := by
  have hc : children j_26 = [j_26_10, j_26_9, j_26_8, j_26_7, j_26_6, j_26_5, j_26_4, j_26_3, j_26_2, j_26_1] := by decide +kernel
  have hv : List.Forall₂ Correct (children j_26) [v_26_10, v_26_9, v_26_8, v_26_7, v_26_6, v_26_5, v_26_4, v_26_3, v_26_2, v_26_1] := by
    rw [hc]
    exact (List.Forall₂.cons correct_26_10 (List.Forall₂.cons correct_26_9 (List.Forall₂.cons correct_26_8 (List.Forall₂.cons correct_26_7 (List.Forall₂.cons correct_26_6 (List.Forall₂.cons correct_26_5 (List.Forall₂.cons correct_26_4 (List.Forall₂.cons correct_26_3 (List.Forall₂.cons correct_26_2 (List.Forall₂.cons correct_26_1 List.Forall₂.nil))))))))))
  have hp := correct_children j_26 (by decide) (by decide) [v_26_10, v_26_9, v_26_8, v_26_7, v_26_6, v_26_5, v_26_4, v_26_3, v_26_2, v_26_1] hv
  have he : combine [v_26_10, v_26_9, v_26_8, v_26_7, v_26_6, v_26_5, v_26_4, v_26_3, v_26_2, v_26_1] = v_26 := by decide +kernel
  rwa [he] at hp

