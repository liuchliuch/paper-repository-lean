def j_26_4 : Job := ⟨[26, 4], 4, 6, 35⟩

def v_26_4 : State := @@GENERATED_RHS:v_26_4@@

theorem correct_26_4 : Correct j_26_4 v_26_4 := by
  have hc : children j_26_4 = [j_26_4_4, j_26_4_3, j_26_4_2, j_26_4_1] := by decide +kernel
  have hv : List.Forall₂ Correct (children j_26_4) [v_26_4_4, v_26_4_3, v_26_4_2, v_26_4_1] := by
    rw [hc]
    exact (List.Forall₂.cons correct_26_4_4 (List.Forall₂.cons correct_26_4_3 (List.Forall₂.cons correct_26_4_2 (List.Forall₂.cons correct_26_4_1 List.Forall₂.nil))))
  have hp := correct_children j_26_4 (by decide) (by decide) [v_26_4_4, v_26_4_3, v_26_4_2, v_26_4_1] hv
  have he : combine [v_26_4_4, v_26_4_3, v_26_4_2, v_26_4_1] = v_26_4 := by decide +kernel
  rwa [he] at hp

