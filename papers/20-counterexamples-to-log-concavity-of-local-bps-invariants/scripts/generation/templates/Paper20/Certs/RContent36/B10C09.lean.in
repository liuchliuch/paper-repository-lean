def j_10_8_8 : Job := ⟨[10, 8, 8], 8, 10, 34⟩

def v_10_8_8 : State := @@GENERATED_RHS:v_10_8_8@@

theorem correct_10_8_8 : Correct j_10_8_8 v_10_8_8 := by
  have hc : children j_10_8_8 = [j_10_8_8_8, j_10_8_8_7, j_10_8_8_6, j_10_8_8_5, j_10_8_8_4, j_10_8_8_3, j_10_8_8_2, j_10_8_8_1] := by decide +kernel
  have hv : List.Forall₂ Correct (children j_10_8_8) [v_10_8_8_8, v_10_8_8_7, v_10_8_8_6, v_10_8_8_5, v_10_8_8_4, v_10_8_8_3, v_10_8_8_2, v_10_8_8_1] := by
    rw [hc]
    exact (List.Forall₂.cons correct_10_8_8_8 (List.Forall₂.cons correct_10_8_8_7 (List.Forall₂.cons correct_10_8_8_6 (List.Forall₂.cons correct_10_8_8_5 (List.Forall₂.cons correct_10_8_8_4 (List.Forall₂.cons correct_10_8_8_3 (List.Forall₂.cons correct_10_8_8_2 (List.Forall₂.cons correct_10_8_8_1 List.Forall₂.nil))))))))
  have hp := correct_children j_10_8_8 (by decide) (by decide) [v_10_8_8_8, v_10_8_8_7, v_10_8_8_6, v_10_8_8_5, v_10_8_8_4, v_10_8_8_3, v_10_8_8_2, v_10_8_8_1] hv
  have he : combine [v_10_8_8_8, v_10_8_8_7, v_10_8_8_6, v_10_8_8_5, v_10_8_8_4, v_10_8_8_3, v_10_8_8_2, v_10_8_8_1] = v_10_8_8 := by decide +kernel
  rwa [he] at hp

