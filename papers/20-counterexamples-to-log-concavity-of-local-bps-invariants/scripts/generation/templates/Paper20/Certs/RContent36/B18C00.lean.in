def j_18_12 : Job := ⟨[18, 12], 12, 6, 35⟩

def v_18_12 : State := @@GENERATED_RHS:v_18_12@@

theorem correct_18_12 : Correct j_18_12 v_18_12 := by
  have hc : children j_18_12 = [j_18_12_6, j_18_12_5, j_18_12_4, j_18_12_3, j_18_12_2, j_18_12_1] := by decide +kernel
  have hv : List.Forall₂ Correct (children j_18_12) [v_18_12_6, v_18_12_5, v_18_12_4, v_18_12_3, v_18_12_2, v_18_12_1] := by
    rw [hc]
    exact (List.Forall₂.cons correct_18_12_6 (List.Forall₂.cons correct_18_12_5 (List.Forall₂.cons correct_18_12_4 (List.Forall₂.cons correct_18_12_3 (List.Forall₂.cons correct_18_12_2 (List.Forall₂.cons correct_18_12_1 List.Forall₂.nil))))))
  have hp := correct_children j_18_12 (by decide) (by decide) [v_18_12_6, v_18_12_5, v_18_12_4, v_18_12_3, v_18_12_2, v_18_12_1] hv
  have he : combine [v_18_12_6, v_18_12_5, v_18_12_4, v_18_12_3, v_18_12_2, v_18_12_1] = v_18_12 := by decide +kernel
  rwa [he] at hp

