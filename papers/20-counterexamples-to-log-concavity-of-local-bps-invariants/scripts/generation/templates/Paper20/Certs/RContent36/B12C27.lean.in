theorem correct_12_3_3_2 : Correct j_12_3_3_2 v_12_3_3_2 := by
  have hc : children j_12_3_3_2 = [j_12_3_3_2_2, j_12_3_3_2_1] := by decide +kernel
  have hv : List.Forall₂ Correct (children j_12_3_3_2) [v_12_3_3_2_2, v_12_3_3_2_1] := by
    rw [hc]
    exact (List.Forall₂.cons correct_12_3_3_2_2 (List.Forall₂.cons correct_12_3_3_2_1 List.Forall₂.nil))
  have hp := correct_children j_12_3_3_2 (by decide) (by decide) [v_12_3_3_2_2, v_12_3_3_2_1] hv
  have he : combine [v_12_3_3_2_2, v_12_3_3_2_1] = v_12_3_3_2 := by decide +kernel
  rwa [he] at hp

