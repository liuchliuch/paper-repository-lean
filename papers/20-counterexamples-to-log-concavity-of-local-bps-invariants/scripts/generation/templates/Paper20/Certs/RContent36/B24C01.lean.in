import Paper20.Certs.RContent36.B24C00
set_option maxHeartbeats 0
set_option maxRecDepth 200000
namespace Paper20.Cert.RContent36.Tree
open Paper20.RContent36
open Paper20.HilbertJobs (Job parts children)

def j_24 : Job := ⟨[24], 24, 12, 36⟩

def v_24 : State := @@GENERATED_RHS:v_24@@

theorem correct_24 : Correct j_24 v_24 := by
  have hc : children j_24 = [j_24_12, j_24_11, j_24_10, j_24_9, j_24_8, j_24_7, j_24_6, j_24_5, j_24_4, j_24_3, j_24_2, j_24_1] := by decide +kernel
  have hv : List.Forall₂ Correct (children j_24) [v_24_12, v_24_11, v_24_10, v_24_9, v_24_8, v_24_7, v_24_6, v_24_5, v_24_4, v_24_3, v_24_2, v_24_1] := by
    rw [hc]
    exact (List.Forall₂.cons correct_24_12 (List.Forall₂.cons correct_24_11 (List.Forall₂.cons correct_24_10 (List.Forall₂.cons correct_24_9 (List.Forall₂.cons correct_24_8 (List.Forall₂.cons correct_24_7 (List.Forall₂.cons correct_24_6 (List.Forall₂.cons correct_24_5 (List.Forall₂.cons correct_24_4 (List.Forall₂.cons correct_24_3 (List.Forall₂.cons correct_24_2 (List.Forall₂.cons correct_24_1 List.Forall₂.nil))))))))))))
  have hp := correct_children j_24 (by decide) (by decide) [v_24_12, v_24_11, v_24_10, v_24_9, v_24_8, v_24_7, v_24_6, v_24_5, v_24_4, v_24_3, v_24_2, v_24_1] hv
  have he : combine [v_24_12, v_24_11, v_24_10, v_24_9, v_24_8, v_24_7, v_24_6, v_24_5, v_24_4, v_24_3, v_24_2, v_24_1] = v_24 := by decide +kernel
  rwa [he] at hp

end Paper20.Cert.RContent36.Tree
