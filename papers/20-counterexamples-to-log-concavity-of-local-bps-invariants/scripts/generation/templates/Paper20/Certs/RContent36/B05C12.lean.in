def j_5_5_3_3 : Job := ⟨[5, 5, 3, 3], 3, 20, 33⟩

def v_5_5_3_3 : State := @@GENERATED_RHS:v_5_5_3_3@@

theorem correct_5_5_3_3 : Correct j_5_5_3_3 v_5_5_3_3 := by
  have hc : children j_5_5_3_3 = [j_5_5_3_3_3, j_5_5_3_3_2, j_5_5_3_3_1] := by decide +kernel
  have hv : List.Forall₂ Correct (children j_5_5_3_3) [v_5_5_3_3_3, v_5_5_3_3_2, v_5_5_3_3_1] := by
    rw [hc]
    exact (List.Forall₂.cons correct_5_5_3_3_3 (List.Forall₂.cons correct_5_5_3_3_2 (List.Forall₂.cons correct_5_5_3_3_1 List.Forall₂.nil)))
  have hp := correct_children j_5_5_3_3 (by decide) (by decide) [v_5_5_3_3_3, v_5_5_3_3_2, v_5_5_3_3_1] hv
  have he : combine [v_5_5_3_3_3, v_5_5_3_3_2, v_5_5_3_3_1] = v_5_5_3_3 := by decide +kernel
  rwa [he] at hp

