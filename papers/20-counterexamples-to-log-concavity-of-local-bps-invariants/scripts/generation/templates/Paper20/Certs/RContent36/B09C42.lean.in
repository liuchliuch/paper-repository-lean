def j_9_3_3 : Job := ⟨[9, 3, 3], 3, 21, 34⟩

def v_9_3_3 : State := @@GENERATED_RHS:v_9_3_3@@

theorem correct_9_3_3 : Correct j_9_3_3 v_9_3_3 := by
  have hc : children j_9_3_3 = [j_9_3_3_3, j_9_3_3_2, j_9_3_3_1] := by decide +kernel
  have hv : List.Forall₂ Correct (children j_9_3_3) [v_9_3_3_3, v_9_3_3_2, v_9_3_3_1] := by
    rw [hc]
    exact (List.Forall₂.cons correct_9_3_3_3 (List.Forall₂.cons correct_9_3_3_2 (List.Forall₂.cons correct_9_3_3_1 List.Forall₂.nil)))
  have hp := correct_children j_9_3_3 (by decide) (by decide) [v_9_3_3_3, v_9_3_3_2, v_9_3_3_1] hv
  have he : combine [v_9_3_3_3, v_9_3_3_2, v_9_3_3_1] = v_9_3_3 := by decide +kernel
  rwa [he] at hp

