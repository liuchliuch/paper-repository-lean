    rw [hc]
    exact (List.Forall₂.cons correct_14_11_11 (List.Forall₂.cons correct_14_11_10 (List.Forall₂.cons correct_14_11_9 (List.Forall₂.cons correct_14_11_8 (List.Forall₂.cons correct_14_11_7 (List.Forall₂.cons correct_14_11_6 (List.Forall₂.cons correct_14_11_5 (List.Forall₂.cons correct_14_11_4 (List.Forall₂.cons correct_14_11_3 (List.Forall₂.cons correct_14_11_2 (List.Forall₂.cons correct_14_11_1 List.Forall₂.nil)))))))))))
  have hp := correct_children j_14_11 (by decide) (by decide) [v_14_11_11, v_14_11_10, v_14_11_9, v_14_11_8, v_14_11_7, v_14_11_6, v_14_11_5, v_14_11_4, v_14_11_3, v_14_11_2, v_14_11_1] hv
  have he : combine [v_14_11_11, v_14_11_10, v_14_11_9, v_14_11_8, v_14_11_7, v_14_11_6, v_14_11_5, v_14_11_4, v_14_11_3, v_14_11_2, v_14_11_1] = v_14_11 := by decide +kernel
  rwa [he] at hp

