def j_14_11 : Job := ⟨[14, 11], 11, 11, 35⟩

def v_14_11 : State := @@GENERATED_RHS:v_14_11@@

theorem correct_14_11 : Correct j_14_11 v_14_11 := by
  have hc : children j_14_11 = [j_14_11_11, j_14_11_10, j_14_11_9, j_14_11_8, j_14_11_7, j_14_11_6, j_14_11_5, j_14_11_4, j_14_11_3, j_14_11_2, j_14_11_1] := by decide +kernel
