def j_14_14 : Job := ⟨[14, 14], 14, 8, 35⟩

def v_14_14 : State := @@GENERATED_RHS:v_14_14@@

theorem correct_14_14 : Correct j_14_14 v_14_14 := by
  have hc : children j_14_14 = [j_14_14_8, j_14_14_7, j_14_14_6, j_14_14_5, j_14_14_4, j_14_14_3, j_14_14_2, j_14_14_1] := by decide +kernel
  have hv : List.Forall₂ Correct (children j_14_14) [v_14_14_8, v_14_14_7, v_14_14_6, v_14_14_5, v_14_14_4, v_14_14_3, v_14_14_2, v_14_14_1] := by
    rw [hc]
    exact (List.Forall₂.cons correct_14_14_8 (List.Forall₂.cons correct_14_14_7 (List.Forall₂.cons correct_14_14_6 (List.Forall₂.cons correct_14_14_5 (List.Forall₂.cons correct_14_14_4 (List.Forall₂.cons correct_14_14_3 (List.Forall₂.cons correct_14_14_2 (List.Forall₂.cons correct_14_14_1 List.Forall₂.nil))))))))
  have hp := correct_children j_14_14 (by decide) (by decide) [v_14_14_8, v_14_14_7, v_14_14_6, v_14_14_5, v_14_14_4, v_14_14_3, v_14_14_2, v_14_14_1] hv
  have he : combine [v_14_14_8, v_14_14_7, v_14_14_6, v_14_14_5, v_14_14_4, v_14_14_3, v_14_14_2, v_14_14_1] = v_14_14 := by decide +kernel
  rwa [he] at hp

