def j_4_2_2_2_2 : Job := ⟨[4, 2, 2, 2, 2], 2, 24, 32⟩

def v_4_2_2_2_2 : State := @@GENERATED_RHS:v_4_2_2_2_2@@

theorem correct_4_2_2_2_2 : Correct j_4_2_2_2_2 v_4_2_2_2_2 := by
  have hc : children j_4_2_2_2_2 = [j_4_2_2_2_2_2, j_4_2_2_2_2_1] := by decide +kernel
  have hv : List.Forall₂ Correct (children j_4_2_2_2_2) [v_4_2_2_2_2_2, v_4_2_2_2_2_1] := by
    rw [hc]
    exact (List.Forall₂.cons correct_4_2_2_2_2_2 (List.Forall₂.cons correct_4_2_2_2_2_1 List.Forall₂.nil))
  have hp := correct_children j_4_2_2_2_2 (by decide) (by decide) [v_4_2_2_2_2_2, v_4_2_2_2_2_1] hv
  have he : combine [v_4_2_2_2_2_2, v_4_2_2_2_2_1] = v_4_2_2_2_2 := by decide +kernel
  rwa [he] at hp

