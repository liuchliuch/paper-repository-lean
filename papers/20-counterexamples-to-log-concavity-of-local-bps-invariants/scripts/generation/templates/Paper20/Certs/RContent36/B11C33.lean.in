def j_11_3 : Job := ⟨[11, 3], 3, 22, 35⟩

def v_11_3 : State := @@GENERATED_RHS:v_11_3@@

theorem correct_11_3 : Correct j_11_3 v_11_3 := by
  have hc : children j_11_3 = [j_11_3_3, j_11_3_2, j_11_3_1] := by decide +kernel
  have hv : List.Forall₂ Correct (children j_11_3) [v_11_3_3, v_11_3_2, v_11_3_1] := by
    rw [hc]
    exact (List.Forall₂.cons correct_11_3_3 (List.Forall₂.cons correct_11_3_2 (List.Forall₂.cons correct_11_3_1 List.Forall₂.nil)))
  have hp := correct_children j_11_3 (by decide) (by decide) [v_11_3_3, v_11_3_2, v_11_3_1] hv
  have he : combine [v_11_3_3, v_11_3_2, v_11_3_1] = v_11_3 := by decide +kernel
  rwa [he] at hp

