def j_16_7_6 : Job := ⟨[16, 7, 6], 6, 7, 34⟩

def v_16_7_6 : State := @@GENERATED_RHS:v_16_7_6@@

theorem correct_16_7_6 : Correct j_16_7_6 v_16_7_6 := by
  have hc : children j_16_7_6 = [j_16_7_6_6, j_16_7_6_5, j_16_7_6_4, j_16_7_6_3, j_16_7_6_2, j_16_7_6_1] := by decide +kernel
  have hv : List.Forall₂ Correct (children j_16_7_6) [v_16_7_6_6, v_16_7_6_5, v_16_7_6_4, v_16_7_6_3, v_16_7_6_2, v_16_7_6_1] := by
    rw [hc]
    exact (List.Forall₂.cons correct_16_7_6_6 (List.Forall₂.cons correct_16_7_6_5 (List.Forall₂.cons correct_16_7_6_4 (List.Forall₂.cons correct_16_7_6_3 (List.Forall₂.cons correct_16_7_6_2 (List.Forall₂.cons correct_16_7_6_1 List.Forall₂.nil))))))
  have hp := correct_children j_16_7_6 (by decide) (by decide) [v_16_7_6_6, v_16_7_6_5, v_16_7_6_4, v_16_7_6_3, v_16_7_6_2, v_16_7_6_1] hv
  have he : combine [v_16_7_6_6, v_16_7_6_5, v_16_7_6_4, v_16_7_6_3, v_16_7_6_2, v_16_7_6_1] = v_16_7_6 := by decide +kernel
  rwa [he] at hp

