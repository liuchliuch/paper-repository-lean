def j_11_5_4 : Job := ⟨[11, 5, 4], 4, 16, 34⟩

def v_11_5_4 : State := @@GENERATED_RHS:v_11_5_4@@

theorem correct_11_5_4 : Correct j_11_5_4 v_11_5_4 := by
  have hc : children j_11_5_4 = [j_11_5_4_4, j_11_5_4_3, j_11_5_4_2, j_11_5_4_1] := by decide +kernel
  have hv : List.Forall₂ Correct (children j_11_5_4) [v_11_5_4_4, v_11_5_4_3, v_11_5_4_2, v_11_5_4_1] := by
    rw [hc]
    exact (List.Forall₂.cons correct_11_5_4_4 (List.Forall₂.cons correct_11_5_4_3 (List.Forall₂.cons correct_11_5_4_2 (List.Forall₂.cons correct_11_5_4_1 List.Forall₂.nil))))
  have hp := correct_children j_11_5_4 (by decide) (by decide) [v_11_5_4_4, v_11_5_4_3, v_11_5_4_2, v_11_5_4_1] hv
  have he : combine [v_11_5_4_4, v_11_5_4_3, v_11_5_4_2, v_11_5_4_1] = v_11_5_4 := by decide +kernel
  rwa [he] at hp

