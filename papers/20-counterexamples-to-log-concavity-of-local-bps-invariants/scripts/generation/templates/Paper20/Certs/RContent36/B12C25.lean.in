theorem correct_12_4_3_3 : Correct j_12_4_3_3 v_12_4_3_3 := by
  have hc : children j_12_4_3_3 = [j_12_4_3_3_3, j_12_4_3_3_2, j_12_4_3_3_1] := by decide +kernel
  have hv : List.Forall₂ Correct (children j_12_4_3_3) [v_12_4_3_3_3, v_12_4_3_3_2, v_12_4_3_3_1] := by
    rw [hc]
    exact (List.Forall₂.cons correct_12_4_3_3_3 (List.Forall₂.cons correct_12_4_3_3_2 (List.Forall₂.cons correct_12_4_3_3_1 List.Forall₂.nil)))
  have hp := correct_children j_12_4_3_3 (by decide) (by decide) [v_12_4_3_3_3, v_12_4_3_3_2, v_12_4_3_3_1] hv
  have he : combine [v_12_4_3_3_3, v_12_4_3_3_2, v_12_4_3_3_1] = v_12_4_3_3 := by decide +kernel
  rwa [he] at hp

