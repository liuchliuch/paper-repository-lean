def j_9_2_2_2_2_2 : Job := ⟨[9, 2, 2, 2, 2, 2], 2, 17, 31⟩

def v_9_2_2_2_2_2 : State := @@GENERATED_RHS:v_9_2_2_2_2_2@@

theorem correct_9_2_2_2_2_2 : Correct j_9_2_2_2_2_2 v_9_2_2_2_2_2 := by
  have hc : children j_9_2_2_2_2_2 = [j_9_2_2_2_2_2_2, j_9_2_2_2_2_2_1] := by decide +kernel
  have hv : List.Forall₂ Correct (children j_9_2_2_2_2_2) [v_9_2_2_2_2_2_2, v_9_2_2_2_2_2_1] := by
    rw [hc]
    exact (List.Forall₂.cons correct_9_2_2_2_2_2_2 (List.Forall₂.cons correct_9_2_2_2_2_2_1 List.Forall₂.nil))
  have hp := correct_children j_9_2_2_2_2_2 (by decide) (by decide) [v_9_2_2_2_2_2_2, v_9_2_2_2_2_2_1] hv
  have he : combine [v_9_2_2_2_2_2_2, v_9_2_2_2_2_2_1] = v_9_2_2_2_2_2 := by decide +kernel
  rwa [he] at hp

