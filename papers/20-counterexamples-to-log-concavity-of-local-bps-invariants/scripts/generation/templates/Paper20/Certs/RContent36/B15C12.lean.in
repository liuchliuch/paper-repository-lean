def j_15_4_4_3 : Job := ⟨[15, 4, 4, 3], 3, 10, 33⟩

def v_15_4_4_3 : State := @@GENERATED_RHS:v_15_4_4_3@@

theorem correct_15_4_4_3 : Correct j_15_4_4_3 v_15_4_4_3 := by
  have hc : children j_15_4_4_3 = [j_15_4_4_3_3, j_15_4_4_3_2, j_15_4_4_3_1] := by decide +kernel
  have hv : List.Forall₂ Correct (children j_15_4_4_3) [v_15_4_4_3_3, v_15_4_4_3_2, v_15_4_4_3_1] := by
    rw [hc]
    exact (List.Forall₂.cons correct_15_4_4_3_3 (List.Forall₂.cons correct_15_4_4_3_2 (List.Forall₂.cons correct_15_4_4_3_1 List.Forall₂.nil)))
  have hp := correct_children j_15_4_4_3 (by decide) (by decide) [v_15_4_4_3_3, v_15_4_4_3_2, v_15_4_4_3_1] hv
  have he : combine [v_15_4_4_3_3, v_15_4_4_3_2, v_15_4_4_3_1] = v_15_4_4_3 := by decide +kernel
  rwa [he] at hp

