theorem correct_8_7_4_4 : Correct j_8_7_4_4 v_8_7_4_4 := by
  have hc : children j_8_7_4_4 = [j_8_7_4_4_4, j_8_7_4_4_3, j_8_7_4_4_2, j_8_7_4_4_1] := by decide +kernel
  have hv : List.Forall₂ Correct (children j_8_7_4_4) [v_8_7_4_4_4, v_8_7_4_4_3, v_8_7_4_4_2, v_8_7_4_4_1] := by
    rw [hc]
    exact (List.Forall₂.cons correct_8_7_4_4_4 (List.Forall₂.cons correct_8_7_4_4_3 (List.Forall₂.cons correct_8_7_4_4_2 (List.Forall₂.cons correct_8_7_4_4_1 List.Forall₂.nil))))
  have hp := correct_children j_8_7_4_4 (by decide) (by decide) [v_8_7_4_4_4, v_8_7_4_4_3, v_8_7_4_4_2, v_8_7_4_4_1] hv
  have he : combine [v_8_7_4_4_4, v_8_7_4_4_3, v_8_7_4_4_2, v_8_7_4_4_1] = v_8_7_4_4 := by decide +kernel
  rwa [he] at hp

