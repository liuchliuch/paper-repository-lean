/-- Proposition 3.2 at `h=20,21,22`. -/
theorem lead20 : A20 * (Nat.factorial 40 : ℤ) = T20 * Dqval := by decide
theorem lead21 : B21 * (Nat.factorial 42 : ℤ) = T21 * Dqval := by decide
theorem lead22 : C22 * (Nat.factorial 44 : ℤ) = T22 * Dqval := by decide

/-! ## The certified contact polynomials -/

/-- `Q_{36,20}` from the certificate, `= C(1/𝒟_Q) · poly AQ`. -/
def Q20 : ℚ[X] := C ((1:ℚ) / Dqval) * poly AQ
/-- `Q_{36,21}`. -/
def Q21 : ℚ[X] := C ((1:ℚ) / Dqval) * poly BQ
/-- `Q_{36,22}`. -/
def Q22 : ℚ[X] := C ((1:ℚ) / Dqval) * poly CQ

/-- Log-concavity difference `G(u) = Q21(u)^2 - Q20(u) Q22(u)` of (27). -/
def G : ℚ[X] := Q21 ^ 2 - Q20 * Q22

/-- The contact polynomial `Q_{36,h}` for the three certified degrees. -/
def Q (h : ℕ) : ℚ[X] :=
  if h = 20 then Q20 else if h = 21 then Q21 else if h = 22 then Q22 else 0

/-- Evaluation of the certified `Q_{36,h}` at `u` (Prop. 3.1 model). -/
def Qeval (h : ℕ) (u : ℚ) : ℚ := (Q h).eval u

theorem eval_G (u : ℚ) : G.eval u = Q21.eval u ^ 2 - Q20.eval u * Q22.eval u := by
  simp [G, eval_sub, eval_mul, eval_pow]
  try ring

/-! ## Cauchy identities tying `H` to the `Q` polynomials -/

theorem cauchy_id_0 :
    convCoeff BQ BQ 0 - convCoeff AQ CQ 0 = hOf 0 := by
  show convCoeff (BList.map fun z => (z:ℚ)) (BList.map fun z => (z:ℚ)) _
      - convCoeff (AList.map fun z => (z:ℚ)) (CList.map fun z => (z:ℚ)) _ = hOf _
  rw [convCoeff_map_cast, convCoeff_map_cast]
  rw [iconv_B_0, iconv_AC_0]
  have h := conv_id_0
  have hof : hOf 0 = ((iH 0 : ℤ) : ℚ) := by
    show ((HIList.map fun z => (z:ℚ)).getD 0 0) = _
    rw [hOf_eq]
    rfl
  rw [hof, iH]
  simp only [HIList, List.getD]
  exact_mod_cast h.symm
