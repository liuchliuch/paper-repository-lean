open Polynomial Finset

set_option maxHeartbeats 2000000
set_option linter.unusedSimpArgs false

/-- Polynomial of a coefficient list (low degree first). -/
def poly (l : List ℚ) : ℚ[X] := ∑ i ∈ range l.length, C (l.getD i 0) * X ^ i

theorem poly_eval (l : List ℚ) (u : ℚ) :
    (poly l).eval u = ∑ i ∈ range l.length, l.getD i 0 * u ^ i := by
  simp [poly, eval_finset_sum, eval_mul, eval_pow, eval_X]

theorem coeff_poly (l : List ℚ) (i : ℕ) :
    (poly l).coeff i = if i < l.length then l.getD i 0 else 0 := by
  unfold poly
  rw [finset_sum_coeff]
  by_cases hi : i < l.length
  · rw [if_pos hi]
    rw [sum_eq_single i]
    · rw [coeff_C_mul, coeff_X_pow, if_pos rfl, mul_one]
    · intro j hj hij
      rw [coeff_C_mul, coeff_X_pow, if_neg (Ne.symm hij), mul_zero]
    · intro h
      exact absurd (mem_range.mpr hi) h
  · rw [if_neg hi]
    apply sum_eq_zero
    intro j hj
    have hj' : j < l.length := mem_range.mp hj
    have ne : i ≠ j := fun h => hi (h ▸ hj')
    rw [coeff_C_mul, coeff_X_pow, if_neg ne, mul_zero]

/-- Cauchy coefficient of the product of two coefficient lists. -/
def convCoeff (a b : List ℚ) (k : ℕ) : ℚ :=
  ∑ i ∈ range (k + 1), a.getD i 0 * b.getD (k - i) 0

/-- Integer Cauchy coefficient. -/
def iconv (a b : List ℤ) (k : ℕ) : ℤ :=
  ∑ i ∈ range (k + 1), a.getD i 0 * b.getD (k - i) 0

theorem coeff_poly_mul (a b : List ℚ) (n : ℕ) :
    (poly a * poly b).coeff n = convCoeff a b n := by
  rw [coeff_mul, Finset.Nat.sum_antidiagonal_eq_sum_range_succ
      (fun i j => (poly a).coeff i * (poly b).coeff j) n]
  show ∑ k ∈ range n.succ, (poly a).coeff k * (poly b).coeff (n - k) = _
  simp only [convCoeff]
  apply sum_congr rfl
  intro k hk
  have hk' : k ≤ n := by
    have := mem_range.mp hk
    omega
  rw [coeff_poly, coeff_poly]
  by_cases ha : k < a.length
  · by_cases hb : n - k < b.length
    · rw [if_pos ha, if_pos hb]
    · rw [if_pos ha, if_neg hb]
      have : b.getD (n - k) 0 = 0 :=
        List.getD_eq_default b (0:ℚ) (show b.length ≤ n - k by omega)
      rw [this, mul_zero]
  · by_cases hb : n - k < b.length
    · rw [if_neg ha, if_pos hb]
      have : a.getD k 0 = 0 :=
        List.getD_eq_default a (0:ℚ) (show a.length ≤ k by omega)
      rw [this, zero_mul]
    · rw [if_neg ha, if_neg hb]
      have ha0 : a.getD k 0 = 0 :=
        List.getD_eq_default a (0:ℚ) (show a.length ≤ k by omega)
      have hb0 : b.getD (n - k) 0 = 0 :=
        List.getD_eq_default b (0:ℚ) (show b.length ≤ n - k by omega)
      rw [ha0, hb0, mul_zero]

theorem add_pow_left {R : Type} [CommSemiring R] (a x : R) (k : ℕ) :
    (a + x) ^ k = ∑ j ∈ range (k + 1), (k.choose j : R) * a ^ (k - j) * x ^ j := by
  rw [add_pow]
  symm
  refine Finset.sum_bij (fun (j : ℕ) (_ : j ∈ range (k + 1)) => k - j) ?_ ?_ ?_ ?_
  · intro j hj
    simp only [mem_range]
    omega
  · intro j1 hj1 j2 hj2 heq
    change k - j1 = k - j2 at heq
    have h1 : j1 ≤ k := by have := Finset.mem_range.mp hj1; omega
    have h2 : j2 ≤ k := by have := Finset.mem_range.mp hj2; omega
    omega
  · intro m hm
    have hm' : m ≤ k := by have := Finset.mem_range.mp hm; omega
    refine ⟨k - m, ?_, ?_⟩
    · simp only [mem_range]
      omega
    · show k - (k - m) = m
      omega
  · intro j hj
    have hj' : j ≤ k := by have := Finset.mem_range.mp hj; omega
    show (k.choose j : R) * a ^ (k - j) * x ^ j
      = a ^ (k - j) * x ^ (k - (k - j)) * (k.choose (k - j))
    rw [show k - (k - j) = j from by omega, Nat.choose_symm hj']
    ring

theorem sum_pow_shift {R : Type} [CommRing R] (H : ℕ → R) (a x : R) (N : ℕ) :
    (∑ k ∈ range N, H k * (a + x) ^ k)
      = ∑ j ∈ range N, (∑ k ∈ range N, H k * (k.choose j : R) * a ^ (k - j)) * x ^ j := by
  have hpow : ∀ k ∈ range N,
      H k * (a + x) ^ k
        = H k * ∑ j ∈ range N, if j ≤ k then (k.choose j : R) * a ^ (k - j) * x ^ j else 0 := by
    intro k hk
    have hkN : k < N := Finset.mem_range.mp hk
    have hsub : range (k + 1) ⊆ range N := by
      intro x hx
      simp only [mem_range] at hx ⊢
      omega
    congr 1
    rw [add_pow_left]
    symm
    have hss :
        (∑ j ∈ range (k + 1), (if j ≤ k then (k.choose j : R) * a ^ (k - j) * x ^ j else 0))
          = ∑ j ∈ range N, (if j ≤ k then (k.choose j : R) * a ^ (k - j) * x ^ j else 0) :=
      sum_subset hsub fun j _ hj => by
        rw [if_neg]
        intro hjk
        apply hj
        exact mem_range.mpr (by omega)
    rw [← hss]
    apply sum_congr rfl
    intro j hj
    have hj' : j ≤ k := by
      have := Finset.mem_range.mp hj
      omega
    rw [if_pos hj']
  have h1 : (∑ k ∈ range N, H k * (a + x) ^ k)
      = ∑ k ∈ range N, ∑ j ∈ range N,
          H k * (if j ≤ k then (k.choose j : R) * a ^ (k - j) * x ^ j else 0) := by
    apply sum_congr rfl
    intro k hk
    rw [hpow k hk, mul_sum]
  rw [h1, sum_comm]
  have key :
      (∑ j ∈ range N, ∑ k ∈ range N,
          H k * (if j ≤ k then (k.choose j : R) * a ^ (k - j) * x ^ j else 0))
        = ∑ j ∈ range N, (∑ k ∈ range N, H k * (k.choose j : R) * a ^ (k - j)) * x ^ j := by
    apply sum_congr rfl
    intro j hj
    rw [sum_mul]
    apply sum_congr rfl
    intro k hk
    by_cases hjk : j ≤ k
    · rw [if_pos hjk]
      ring
    · rw [if_neg hjk]
      rw [Nat.choose_eq_zero_of_lt (show k < j by omega), Nat.cast_zero]
      ring
  exact key

/-- Integer lists map to rational lists by coercion. -/
theorem getD_map_cast (l : List ℤ) (i : ℕ) :
    (l.map (fun z => (z:ℚ))).getD i 0 = ((l.getD i 0 : ℤ) : ℚ) := by
  induction l generalizing i with
  | nil => simp
  | cons x xs ih =>
    cases i with
    | zero => simp
    | succ j => simpa using ih j

theorem convCoeff_map_cast (a b : List ℤ) (k : ℕ) :
    convCoeff (a.map (fun z => (z:ℚ))) (b.map (fun z => (z:ℚ))) k
      = ((iconv a b k : ℤ) : ℚ) := by
  simp only [convCoeff, iconv]
  push_cast
  apply sum_congr rfl
  intro i hi
  simp only [getD_map_cast]
  try push_cast

theorem sum_range_43 {α : Type} [AddCommMonoid α] (f : ℕ → α) :
    (∑ k ∈ range 43, f k) = f 0 + f 1 + f 2 + f 3 + f 4 + f 5 + f 6 + f 7 + f 8 + f 9
      + f 10 + f 11 + f 12 + f 13 + f 14 + f 15 + f 16 + f 17 + f 18 + f 19
      + f 20 + f 21 + f 22 + f 23 + f 24 + f 25 + f 26 + f 27 + f 28 + f 29
      + f 30 + f 31 + f 32 + f 33 + f 34 + f 35 + f 36 + f 37 + f 38 + f 39
      + f 40 + f 41 + f 42 := by
  simp [Finset.sum_range_succ]

theorem hOf_eq (l : List ℤ) (k : ℕ) :
    ((l.map (fun z => (z:ℚ))).getD k 0) = ((l.getD k 0 : ℤ) : ℚ) := by
  induction l generalizing k with
  | nil => simp
  | cons x xs ih =>
    cases k with
    | zero => simp
    | succ j => simpa using ih j


theorem hOf_eq_iH (k : ℕ) : hOf k = ((iH k : ℤ) : ℚ) := by
  unfold hOf iH HQ
  exact hOf_eq HIList k

