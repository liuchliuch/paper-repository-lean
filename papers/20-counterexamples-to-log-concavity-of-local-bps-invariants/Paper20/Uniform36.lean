theorem convCoeff_BQ_zero (n : ℕ) (hn : 43 ≤ n) : convCoeff BQ BQ n = 0 := by
  unfold convCoeff
  apply sum_eq_zero
  intro i hi
  have hi' : i ≤ n := by have := mem_range.mp hi; omega
  have hlen : BQ.length = 22 := by decide
  by_cases h1 : i < 22
  · by_cases h2 : n - i < 22
    · exfalso
      have : n ≤ 42 := by omega
      omega
    · have hge : BQ.length ≤ n - i := by rw [hlen]; omega
      rw [List.getD_eq_default BQ (0:ℚ) hge, mul_zero]
  · have hge : BQ.length ≤ i := by rw [hlen]; omega
    rw [List.getD_eq_default BQ (0:ℚ) hge, zero_mul]

theorem convCoeff_AC_zero (n : ℕ) (hn : 43 ≤ n) : convCoeff AQ CQ n = 0 := by
  unfold convCoeff
  apply sum_eq_zero
  intro i hi
  have hi' : i ≤ n := by have := mem_range.mp hi; omega
  have hA : AQ.length = 21 := by decide
  have hC : CQ.length = 23 := by decide
  by_cases h1 : i < 21
  · by_cases h2 : n - i < 23
    · exfalso
      have : n ≤ 42 := by omega
      omega
    · have hge : CQ.length ≤ n - i := by rw [hC]; omega
      rw [List.getD_eq_default CQ (0:ℚ) hge, mul_zero]
  · have hge : AQ.length ≤ i := by rw [hA]; omega
    rw [List.getD_eq_default AQ (0:ℚ) hge, zero_mul]

theorem poly_H_eq : (poly BQ) ^ 2 - (poly AQ) * (poly CQ) = poly HQ := by
  apply Polynomial.ext
  intro n
  rw [coeff_sub, pow_two, coeff_poly_mul, coeff_poly_mul, coeff_poly]
  have hlen : HQ.length = 43 := by decide
  rw [hlen]
  by_cases hn : n < 43
  · rw [if_pos hn]
    exact cauchy_id n hn
  · rw [if_neg hn]
    have h1 : convCoeff BQ BQ n = 0 := convCoeff_BQ_zero n (by omega)
    have h2 : convCoeff AQ CQ n = 0 := convCoeff_AC_zero n (by omega)
    have h3 : HQ.getD n 0 = 0 :=
      List.getD_eq_default HQ (0:ℚ) (by
        have : HQ.length = 43 := by decide
        omega)
    rw [h1, h2]
    ring

theorem Q_G_eq : G = C ((1:ℚ) / (Dqval * Dqval)) * poly HQ := by
  have h21 : Q21 ^ 2 = C (((1:ℚ) / Dqval) * ((1:ℚ) / Dqval)) * ((poly BQ) ^ 2) := by
    unfold Q21
    rw [pow_two, pow_two, mul_mul_mul_comm, C_mul]
  have h20 : Q20 * Q22 = C (((1:ℚ) / Dqval) * ((1:ℚ) / Dqval)) * ((poly AQ) * (poly CQ)) := by
    unfold Q20 Q22
    rw [mul_mul_mul_comm, C_mul]
  rw [G, h21, h20, ← mul_sub, poly_H_eq]
  congr 1
  ring_nf

theorem G_eval (u : ℚ) :
    G.eval u = ((1:ℚ) / (Dqval * Dqval)) * ∑ k ∈ range 43, hOf k * u ^ k := by
  rw [Q_G_eq, eval_mul, eval_C, poly_eval]
  have hlen : HQ.length = 43 := by decide
  rw [hlen]
  simp only [hOf, mul_comm]
  try ring_nf

