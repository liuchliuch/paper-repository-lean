theorem G_shift (x : ℚ) :
    G.eval (110 + x) = -(1 / Dval) * ∑ j ∈ range 43, (bOf j : ℚ) * x ^ j := by
  rw [G_eval]
  have hs := sum_pow_shift (fun k => hOf k) (110:ℚ) x 43
  rw [hs]
  have hsum : (∑ j ∈ range 43,
        (∑ k ∈ range 43, hOf k * (k.choose j : ℚ) * (110:ℚ) ^ (k - j)) * x ^ j)
      = (∑ j ∈ range 43, (-((Dqval * Dqval : ℚ) * bOf j / Dval)) * x ^ j) := by
    apply sum_congr rfl
    intro j hj
    have hj' : j < 43 := Finset.mem_range.mp hj
    rw [shift_id_rat j hj']
  rw [hsum]
  have hDq : (Dqval : ℚ) ≠ 0 := by norm_num [Dqval]
  rw [Finset.mul_sum, Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro j hj
  field_simp
  <;> ring

theorem G_shift_neg (x : ℕ) : G.eval (110 + (x:ℚ)) < 0 := by
  have hcast : (110 + (x:ℚ)) = (110:ℚ) + (x:ℚ) := by ring
  rw [hcast, G_shift]
  have hD : (0:ℚ) < Dval := by exact_mod_cast Dval_pos
  have hsum : (0:ℚ) < ∑ j ∈ range 43, (bOf j : ℚ) * (x:ℚ) ^ j := by
    have h0 : (0:ℚ) < bOf 0 := by exact_mod_cast (b_pos 0 (by decide))
    have hle : bOf 0 * (x:ℚ) ^ 0 ≤ ∑ j ∈ range 43, (bOf j : ℚ) * (x:ℚ) ^ j := by
      apply Finset.single_le_sum (f := fun j : ℕ => (bOf j : ℚ) * (x : ℚ)^j)
      · intro j hj
        have hj' : j < 43 := Finset.mem_range.mp hj
        have hb : (0:ℚ) < bOf j := by exact_mod_cast (b_pos j hj')
        have hpow : (0:ℚ) ≤ (x:ℚ) ^ j := pow_nonneg (by positivity) j
        exact mul_nonneg hb.le hpow
      · simp
    have h0' : bOf 0 * (x:ℚ) ^ 0 = bOf 0 := by
      rw [pow_zero, mul_one]
    linarith
  have hpos : (0:ℚ) < (1 / Dval) * ∑ j ∈ range 43, (bOf j : ℚ) * (x:ℚ) ^ j :=
    mul_pos (div_pos (by norm_num) hD) hsum
  linarith

/-- Threshold: `k ≥ 10` implies `k(k+1) ≥ 110`. -/
theorem u_threshold (k : ℕ) (hk : 10 ≤ k) : 110 ≤ k * (k + 1) := by
  have : 10 * 11 ≤ k * (k + 1) := Nat.mul_le_mul hk (Nat.succ_le_succ hk)
  norm_num at this
  exact this

/-! ## Theorem 1.2 -/

/-- **Theorem 1.2** (Q-form).  For every `k ≥ 10`,
`Q21(k(k+1))^2 < Q20(k(k+1)) Q22(k(k+1))`. -/
theorem thm12_Q (k : ℕ) (hk : 10 ≤ k) :
    (Q21.eval ((k : ℚ) * (k + 1))) ^ 2
      < Q20.eval ((k : ℚ) * (k + 1)) * Q22.eval ((k : ℚ) * (k + 1)) := by
  have hu : 110 ≤ k * (k + 1) := u_threshold k hk
  have hneg := G_shift_neg (k * (k + 1) - 110)
  have h110 : (110 + ((k * (k + 1) - 110 : ℕ) : ℚ)) = ((k * (k + 1) : ℕ) : ℚ) := by
    exact_mod_cast (show 110 + (k * (k + 1) - 110) = k * (k + 1) by omega)
  rw [h110] at hneg
  have hcast : ((k:ℚ) * (k + 1)) = ((k * (k + 1) : ℕ) : ℚ) := by
    push_cast
    ring
  rw [hcast]
  rw [eval_G] at hneg
  linarith

/-- **Theorem 1.2** (BPS-interface form). -/
theorem thm12_bps (n : ℕ → ℕ → ℕ → ℚ)
    (hmodel : ∀ (k h : ℕ), n 36 k h = (Q h).eval ((k:ℚ) * (k + 1))) :
    ∀ k : ℕ, 10 ≤ k → (n 36 k 21) ^ 2 < n 36 k 20 * n 36 k 22 := by
  intro k hk
  rw [hmodel k 21, hmodel k 20, hmodel k 22]
  have e21 : (Q 21).eval ((k:ℚ)*(k+1)) = Q21.eval ((k:ℚ)*(k+1)) := by simp [Q]
  have e20 : (Q 20).eval ((k:ℚ)*(k+1)) = Q20.eval ((k:ℚ)*(k+1)) := by simp [Q]
  have e22 : (Q 22).eval ((k:ℚ)*(k+1)) = Q22.eval ((k:ℚ)*(k+1)) := by simp [Q]
  rw [e21, e20, e22]
  exact thm12_Q k hk

/-- Evaluation model of BPS coefficients from the certified `Q`. -/
def bpsCoeffModel (r k h : ℕ) : ℚ := (Q h).eval ((k:ℚ) * (k + 1))

theorem thm12_model (k : ℕ) (hk : 10 ≤ k) :
    (bpsCoeffModel 36 k 21) ^ 2 < bpsCoeffModel 36 k 20 * bpsCoeffModel 36 k 22 := by
  unfold bpsCoeffModel
  exact thm12_bps (fun r k h => (Q h).eval ((k:ℚ)*(k+1))) (fun _ _ => rfl) k hk

/-! ## Leading-coefficient test (26) and condition (23) -/

/-- Equation (26). -/
theorem thm26 :
    (99993 : ℚ) / 100000 < (44 * 43 * (T21 : ℚ) ^ 2) / (42 * 41 * T20 * T22)
      ∧ (44 * 43 * (T21 : ℚ) ^ 2) / (42 * 41 * T20 * T22) < 99994 / 100000 := by
  norm_num [T20, T21, T22]

/-- The necessary condition (23) fails at `(r,h)=(36,21)`. -/
theorem eq23_fails :
    (44 : ℤ) * 43 * T21 * T21 < 42 * 41 * T20 * T22 := by
  have hlt : (44 * 43 * (T21:ℚ) ^ 2) < (42 * 41 * T20 * T22 : ℚ) := by
    have hpos : (0:ℚ) < 42 * 41 * T20 * T22 := by
      norm_num [T20, T21, T22]
    have h1 : (44 * 43 * (T21:ℚ) ^ 2) / (42 * 41 * T20 * T22) < 1 := by
      have := thm26.2
      norm_num at this ⊢
      linarith
    exact (div_lt_one hpos).mp h1
  exact_mod_cast hlt

theorem eq23_concrete_failure :
    ¬ ((44 : ℤ) * 43 * T21 * T21 ≥ 42 * 41 * T20 * T22) := by
  intro h
  exact (Int.not_le).mpr eq23_fails h

/-! ## Positivity (Lemma 2.2, interface) -/

/-- Lemma 2.2 (braid-walk) interface: all BPS coefficients are positive. -/
theorem thm12_pos_of_lemma22 (n : ℕ → ℕ → ℕ → ℚ)
    (hpos : ∀ r k h, 2 ≤ r → 1 ≤ k → h ≤ k * Nat.choose r 2 → 0 < n r k h)
    (k h : ℕ) (hk : 10 ≤ k) (hh : h ≤ k * Nat.choose 36 2) :
    0 < n 36 k h := by
  apply hpos
  · norm_num
  · omega
  · exact hh

