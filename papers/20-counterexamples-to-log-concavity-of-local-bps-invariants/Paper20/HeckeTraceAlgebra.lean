import Paper20.RightHeckeOperators
import Paper20.HeckeFullTwistTrace

namespace Paper20.HeckeTraceAlgebra
open Polynomial Matrix Paper20.HeckeOperators Paper20.HeckeMatrices
open Paper20.BraidWalk Paper20.HalfTwistMatrix
noncomputable section
set_option maxHeartbeats 3000000
set_option maxRecDepth 10000
attribute [local instance] Classical.propDecidable

abbrev State (r : ℕ) := Equiv.Perm (Fin r)
abbrev Mat (r : ℕ) := Matrix (State r) (State r) ℤ[X]

def rightT (r : ℕ) (j : Fin (r-1)) : Mat r :=
  generatorMatrix (rightMove j) (rightDescent j) Polynomial.X

/-- The actual left and right regular Hecke matrices commute. -/
theorem left_right_commute (r : ℕ) (i j : Fin (r-1)) : Commute (T r i) (rightT r j) := by
  change T r i*rightT r j=rightT r j*T r i
  apply matrix_eq_of_mulVec
  intro f
  funext p
  simp only [← Matrix.mulVec_mulVec,T,rightT,generator_mulVec]
  exact left_right_operators_commute i j Polynomial.X f p

/-- The concrete Hecke algebra generated by the proved standard-basis
Hecke matrices over Z[z]. -/
def algebra (r : ℕ) : Subalgebra ℤ[X] (Mat r) := Algebra.adjoin ℤ[X] (Set.range (T r))

theorem algebra_commutes_right (r : ℕ) (j : Fin (r-1)) (A : Mat r)
    (hA : A ∈ algebra r) : Commute A (rightT r j) := by
  induction hA using Algebra.adjoin_induction with
  | mem A hA => obtain ⟨i,rfl⟩ := hA; exact left_right_commute r i j
  | algebraMap a => exact Algebra.commutes a (rightT r j)
  | add A B hA hB ihA ihB => exact ihA.add_left ihB
  | mul A B hA hB ihA ihB => exact ihA.mul_left ihB

lemma T_transpose (r : ℕ) (i : Fin (r-1)) : (T r i).transpose=T r i := by
  simpa only [generator_fin] using generator_transpose r i.val

lemma rightT_transpose (r : ℕ) (j : Fin (r-1)) : (rightT r j).transpose=rightT r j :=
  generatorMatrix_symmetric _ _ (rightMove_involutive j) Polynomial.X

lemma row_one_equal (r : ℕ) (i : Fin (r-1)) (s : State r) :
    T r i 1 s=rightT r i 1 s := by
  have hl : ¬descent i (1 : State r) := by
    change ¬i.val+1 < i.val
    omega
  have hr : ¬rightDescent i (1 : State r) := by
    unfold rightDescent
    simp only [Equiv.Perm.one_apply]
    omega
  simp [T,rightT,generatorMatrix,hl,hr,adjacentMove,rightMove]

lemma column_one_equal (r : ℕ) (i : Fin (r-1)) (s : State r) :
    T r i s 1=rightT r i s 1 := by
  have hl := congrFun (congrFun (T_transpose r i) 1) s
  have hr := congrFun (congrFun (rightT_transpose r i) 1) s
  exact hl.trans ((row_one_equal r i s).trans hr.symm)

/-- The canonical identity coefficient in this actual regular matrix model. -/
def trace (r : ℕ) (A : Mat r) : ℤ[X] := A 1 1

@[simp] theorem trace_one (r : ℕ) : trace r 1=1 := by simp [trace]
@[simp] theorem trace_add (r : ℕ) (A B : Mat r) : trace r (A+B)=trace r A+trace r B := rfl

lemma trace_generator_cycle (r : ℕ) (i : Fin (r-1)) (A : Mat r)
    (hA : Commute A (rightT r i)) : trace r (T r i*A)=trace r (A*T r i) := by
  calc
    _ = trace r (rightT r i*A) := by
      unfold trace
      rw [Matrix.mul_apply,Matrix.mul_apply]
      apply Finset.sum_congr rfl
      intro s hs
      rw [row_one_equal]
    _ = trace r (A*rightT r i) := by rw [hA.eq]
    _ = _ := by
      unfold trace
      rw [Matrix.mul_apply,Matrix.mul_apply]
      apply Finset.sum_congr rfl
      intro s hs
      rw [column_one_equal]

/-- Cyclicity is derived on the complete generated concrete Hecke algebra
from actual commuting left/right actions; it is not postulated as a trace
axiom or restricted to the full-twist subalgebra. -/
theorem trace_mul_comm (r : ℕ) (A B : Mat r) (hA : A ∈ algebra r) (hB : B ∈ algebra r) :
    trace r (A*B)=trace r (B*A) := by
  induction hA using Algebra.adjoin_induction generalizing B with
  | mem A hA =>
    obtain ⟨i,rfl⟩ := hA
    exact trace_generator_cycle r i B (algebra_commutes_right r i B hB)
  | algebraMap a => exact congrArg (trace r) (Algebra.commutes a B)
  | add A C hA hC ihA ihC =>
    rw [add_mul,mul_add,trace_add,trace_add,ihA B hB,ihC B hB]
  | mul A C hA hC ihA ihC =>
    calc
      _ = trace r (A*(C*B)) := by rw [mul_assoc]
      _ = trace r ((C*B)*A) := ihA _ ((algebra r).mul_mem hC hB)
      _ = trace r (C*(B*A)) := by rw [mul_assoc]
      _ = trace r ((B*A)*C) := ihC _ ((algebra r).mul_mem hB hA)
      _ = _ := by rw [mul_assoc]

/-- Actual full-twist trace identity for the concrete walk polynomial.
The further geometric/Hilbert BPS identification remains separate. -/
theorem trace_fullTwist (r k : ℕ) (hr : 1 ≤ r) :
    trace r (fullTwist r^(k+1))=
      Paper20.HeckeWalkExpansion.closedHeckePolynomial r k :=
  Paper20.HeckeFullTwistTrace.fullTwist_identity_entry r k hr

end
end Paper20.HeckeTraceAlgebra
