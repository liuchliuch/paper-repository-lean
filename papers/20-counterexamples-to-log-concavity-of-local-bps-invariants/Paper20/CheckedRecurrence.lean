import Paper20.Semantics

/-! A kernel-reducible checker for (25). The binomial row is generated by
an exact first-order recurrence, proved below from `Nat.choose`. Unlike the
old literal rows, the checker is linked to the actual binomial coefficients. -/
namespace Paper20.CheckedRecurrence
open Finset BigOperators Paper20.Semantics

/-- The signed coefficient of `n_j` in the equation for `n_h`. -/
def weight (h j : ℕ) : ℤ :=
  (-1 : ℤ)^(j-h) * (Nat.choose (2*j) (j-h) : ℤ)

lemma choose_two_step (n k : ℕ) :
    Nat.choose (n+2) (k+1) * ((k+1)*(n+1-k)) =
      Nat.choose n k * ((n+2)*(n+1)) := by
  have ha := Nat.succ_mul_choose_eq (n+1) k
  have hb := Nat.choose_mul_succ_eq n k
  simp only [Nat.succ_eq_add_one, Nat.add_assoc] at ha
  calc
    _ = ((n+2)*Nat.choose (n+1) k)*(n+1-k) := by rw [← Nat.mul_assoc, ← ha]
    _ = (n+2)*(Nat.choose n k*(n+1)) := by rw [hb]; ring
    _ = _ := by ring

lemma weight_start (h : ℕ) : weight h (h+1) = -(2*(h:ℤ)+2) := by
  simp [weight, Nat.choose_one_right]
  ring

lemma weight_step_mul (h j : ℕ) (hj : h ≤ j) :
    weight h (j+1) * (((j-h+1)*(j+h+1) : ℕ) : ℤ) =
      -(weight h j * ((2*j+2 : ℕ) : ℤ) * ((2*j+1 : ℕ) : ℤ)) := by
  have hsub : j+1-h = (j-h)+1 := by omega
  have hn : 2*(j+1) = 2*j+2 := by omega
  have hden : 2*j+1-(j-h) = j+h+1 := by omega
  have hc := choose_two_step (2*j) (j-h)
  rw [hden] at hc
  have hc' : (Nat.choose (2*j+2) (j-h+1) : ℤ) *
      (((j-h+1)*(j+h+1) : ℕ) : ℤ) =
      (Nat.choose (2*j) (j-h) : ℤ) * (((2*j+2)*(2*j+1) : ℕ) : ℤ) := by
    exact_mod_cast hc
  simp only [weight, hsub, hn, pow_succ]
  calc
    _ = -((-1 : ℤ)^(j-h) *
          ((Nat.choose (2*j+2) (j-h+1) : ℤ) *
            (((j-h+1)*(j+h+1) : ℕ) : ℤ))) := by ring
    _ = _ := by rw [hc']; push_cast; ring

/-- Generate the next signed binomial by exact integer division. -/
def nextWeight (h j : ℕ) (c : ℤ) : ℤ :=
  -(c * ((2*j+2 : ℕ) : ℤ) * ((2*j+1 : ℕ) : ℤ)) /
    (((j-h+1)*(j+h+1) : ℕ) : ℤ)

lemma nextWeight_correct (h j : ℕ) (hj : h ≤ j) :
    nextWeight h j (weight h j) = weight h (j+1) := by
  unfold nextWeight
  rw [← weight_step_mul h j hj]
  have hd : (((j-h+1)*(j+h+1) : ℕ) : ℤ) ≠ 0 := by positivity
  exact Int.mul_ediv_cancel _ hd

/-- Dot product of the generated binomial row with a list of coefficients. -/
def rowDot (h j : ℕ) (c : ℤ) : List ℤ → ℤ
  | [] => 0
  | x :: xs => c*x + rowDot h (j+1) (nextWeight h j c) xs

/-- Its specification as a finite sum using the actual binomial coefficients. -/
theorem rowDot_correct (h j : ℕ) (hj : h ≤ j) (xs : List ℤ) :
    rowDot h j (weight h j) xs =
      ∑ t ∈ range xs.length, weight h (j+t) * xs.getD t 0 := by
  induction xs generalizing j with
  | nil => simp [rowDot]
  | cons x xs ih =>
    simp only [rowDot, nextWeight_correct h j hj]
    rw [ih (j+1) (by omega), List.length_cons, Finset.sum_range_succ']
    simp only [Nat.add_zero, List.getD_cons_zero, List.getD_cons_succ]
    rw [add_comm (weight h j * x)]
    congr 1
    apply sum_congr rfl
    intro t ht
    congr 2
    omega

/-- Check one equation, using the tail of the certified sequence. -/
def checkRow (d : ℕ) (F n : List ℤ) (h : ℕ) : Bool :=
  n.getD h 0 == F.getD (d-h) 0 -
    rowDot h (h+1) (-(2*(h:ℤ)+2)) (n.drop (h+1))

/-- Soundness of a checked equation (25). -/
theorem checkRow_sound {d h : ℕ} {F n : List ℤ}
    (hlen : n.length = d+1) (hh : h ≤ d) (hc : checkRow d F n h = true) :
    n.getD h 0 = F.getD (d-h) 0 -
      ∑ j ∈ Ico (h+1) (d+1), weight h j * n.getD j 0 := by
  simp only [checkRow, beq_iff_eq] at hc
  rw [← weight_start h, rowDot_correct h (h+1) (by omega)] at hc
  rw [hc]
  congr 1
  have hlength : (n.drop (h+1)).length = d-h := by simp [hlen, Nat.sub_sub]
  rw [hlength]
  symm
  rw [Finset.sum_Ico_eq_sum_range]
  apply sum_congr (by congr 1; omega)
  intro t ht
  simp only [List.getD_eq_getD_getElem?, List.getElem?_drop]

/-- A batch of consecutive extraction equations. -/
def checkRows (d : ℕ) (F n : List ℤ) (start count : ℕ) : Bool :=
  (List.range count).all (fun i => checkRow d F n (start+i))

lemma checkRows_sound {d start count : ℕ} {F n : List ℤ}
    (hc : checkRows d F n start count = true) {h : ℕ}
    (hh : start ≤ h) (hh' : h < start+count) : checkRow d F n h = true := by
  have he : h = start+(h-start) := by omega
  unfold checkRows at hc
  rw [List.all_eq_true] at hc
  rw [he]
  exact hc (h-start) (List.mem_range.mpr (by omega))

end Paper20.CheckedRecurrence
