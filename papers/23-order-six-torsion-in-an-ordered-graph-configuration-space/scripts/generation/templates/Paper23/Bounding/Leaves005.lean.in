noncomputable def boundingLeaf95Part0 : List (ℕ × ℤ) := @@GENERATED_RHS:boundingLeaf95Part0@@
noncomputable def boundingLeaf95Part1 : List (ℕ × ℤ) := @@GENERATED_RHS:boundingLeaf95Part1@@
noncomputable def boundingLeaf95 : List (ℕ × ℤ) := boundingLeaf95Part0 ++ boundingLeaf95Part1
theorem boundingLeaf95_check :
    collapse 10 (((codeDifferential boundingEntries95) ++ scaleEntries (-6) zEntries95).map
      (fun p => [p])) = [boundingLeaf95] := by decide +kernel
 theorem boundingLeaf95_chain : codeChain boundingLeaf95 =
    boundary (codeChain boundingEntries95) + (-6 : ℤ) • codeChain zEntries95 := by
  simpa only [codeChain_nil] using (leaf_sound 10 boundingEntries95 zEntries95 boundingLeaf95 boundingLeaf95_valid boundingLeaf95_check)
end Paper23.Bounding
