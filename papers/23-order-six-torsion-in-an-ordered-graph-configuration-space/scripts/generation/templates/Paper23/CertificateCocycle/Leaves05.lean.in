import Paper23.CertificateCocycle.Data
set_option maxRecDepth 100000
set_option maxHeartbeats 0
namespace Paper23.CertificateChecks
open Cubical CertificateData
attribute [local irreducible] codeChain
noncomputable def cocycleLeaf80Part0 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleLeaf80Part0@@
noncomputable def cocycleLeaf80Part1 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleLeaf80Part1@@
noncomputable def cocycleLeaf80Part2 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleLeaf80Part2@@
noncomputable def cocycleLeaf80Part3 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleLeaf80Part3@@
noncomputable def cocycleLeaf80Part4 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleLeaf80Part4@@
noncomputable def cocycleLeaf80 : List (ℕ × ℤ) := cocycleLeaf80Part0 ++ cocycleLeaf80Part1 ++ cocycleLeaf80Part2 ++ cocycleLeaf80Part3 ++ cocycleLeaf80Part4
theorem cocycleLeaf80_check :
    modularCollapse 16 ((codeTreeCofaces phiCut80).map (fun p => [p])) = [cocycleLeaf80] := by decide +kernel
theorem cocycleLeaf80_chain : reduceChain (codeChain cocycleLeaf80) =
    reduceChain (restrictCubes 3 (coBoundary (codeChain (treeEntries phiCut80)))) := by
  exact (modularNormalization_sound 16 (codeTreeCofaces phiCut80) cocycleLeaf80 cocycleLeaf80_check).trans
    (congrArg reduceChain (codeTreeCofaces_sound phiCut80))
