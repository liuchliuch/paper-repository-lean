import Paper23.CertificateCocycle.Data
set_option maxRecDepth 100000
set_option maxHeartbeats 0
namespace Paper23.CertificateChecks
open Cubical CertificateData
attribute [local irreducible] codeChain
noncomputable def cocycleLeaf128Part0 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleLeaf128Part0@@
noncomputable def cocycleLeaf128Part1 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleLeaf128Part1@@
noncomputable def cocycleLeaf128Part2 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleLeaf128Part2@@
noncomputable def cocycleLeaf128Part3 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleLeaf128Part3@@
noncomputable def cocycleLeaf128 : List (ℕ × ℤ) := cocycleLeaf128Part0 ++ cocycleLeaf128Part1 ++ cocycleLeaf128Part2 ++ cocycleLeaf128Part3
theorem cocycleLeaf128_check :
    modularCollapse 16 ((codeTreeCofaces phiCut128).map (fun p => [p])) = [cocycleLeaf128] := by decide +kernel
theorem cocycleLeaf128_chain : reduceChain (codeChain cocycleLeaf128) =
    reduceChain (restrictCubes 3 (coBoundary (codeChain (treeEntries phiCut128)))) := by
  exact (modularNormalization_sound 16 (codeTreeCofaces phiCut128) cocycleLeaf128 cocycleLeaf128_check).trans
    (congrArg reduceChain (codeTreeCofaces_sound phiCut128))
