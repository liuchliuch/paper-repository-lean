import Paper23.CertificateCocycle.Leaves16
import Paper23.CertificateCocycle.Leaves17
set_option maxRecDepth 100000
set_option maxHeartbeats 0
namespace Paper23.CertificateChecks
open Cubical CertificateData
attribute [local irreducible] codeChain
noncomputable def cocycleNode1_128Part0 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleNode1_128Part0@@
noncomputable def cocycleNode1_128Part1 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleNode1_128Part1@@
noncomputable def cocycleNode1_128Part2 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleNode1_128Part2@@
noncomputable def cocycleNode1_128 : List (ℕ × ℤ) := cocycleNode1_128Part0 ++ cocycleNode1_128Part1 ++ cocycleNode1_128Part2
noncomputable def cocycleSource1_128 : RawChain := codeChain (treeEntries phiCut256) + codeChain (treeEntries phiCut257)
theorem cocycleNode1_128_check : modularMerge cocycleLeaf256 cocycleLeaf257 = cocycleNode1_128 := by
  exact eq_of_beq (by decide +kernel)
theorem cocycleNode1_128_chain : reduceChain (codeChain cocycleNode1_128) =
    reduceChain (restrictCubes 3 (coBoundary cocycleSource1_128)) := by
  rw [← cocycleNode1_128_check, modularMerge_sound, cocycleLeaf256_chain, cocycleLeaf257_chain]
  simp only [cocycleSource1_128,map_add]
