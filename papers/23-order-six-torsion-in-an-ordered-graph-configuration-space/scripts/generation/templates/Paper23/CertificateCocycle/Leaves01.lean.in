import Paper23.CertificateCocycle.Data
set_option maxRecDepth 100000
set_option maxHeartbeats 0
namespace Paper23.CertificateChecks
open Cubical CertificateData
attribute [local irreducible] codeChain
noncomputable def cocycleLeaf16Part0 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleLeaf16Part0@@
noncomputable def cocycleLeaf16Part1 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleLeaf16Part1@@
noncomputable def cocycleLeaf16Part2 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleLeaf16Part2@@
noncomputable def cocycleLeaf16Part3 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleLeaf16Part3@@
noncomputable def cocycleLeaf16Part4 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleLeaf16Part4@@
noncomputable def cocycleLeaf16Part5 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleLeaf16Part5@@
noncomputable def cocycleLeaf16Part6 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleLeaf16Part6@@
noncomputable def cocycleLeaf16Part7 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleLeaf16Part7@@
noncomputable def cocycleLeaf16 : List (ℕ × ℤ) := cocycleLeaf16Part0 ++ cocycleLeaf16Part1 ++ cocycleLeaf16Part2 ++ cocycleLeaf16Part3 ++ cocycleLeaf16Part4 ++ cocycleLeaf16Part5 ++ cocycleLeaf16Part6 ++ cocycleLeaf16Part7
theorem cocycleLeaf16_check :
    modularCollapse 16 ((codeTreeCofaces phiCut16).map (fun p => [p])) = [cocycleLeaf16] := by decide +kernel
theorem cocycleLeaf16_chain : reduceChain (codeChain cocycleLeaf16) =
    reduceChain (restrictCubes 3 (coBoundary (codeChain (treeEntries phiCut16)))) := by
  exact (modularNormalization_sound 16 (codeTreeCofaces phiCut16) cocycleLeaf16 cocycleLeaf16_check).trans
    (congrArg reduceChain (codeTreeCofaces_sound phiCut16))
