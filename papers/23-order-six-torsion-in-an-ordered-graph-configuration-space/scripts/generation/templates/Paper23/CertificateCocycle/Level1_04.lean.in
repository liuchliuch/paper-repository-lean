attribute [local irreducible] codeChain
noncomputable def cocycleNode1_64Part0 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleNode1_64Part0@@
noncomputable def cocycleNode1_64Part1 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleNode1_64Part1@@
noncomputable def cocycleNode1_64Part2 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleNode1_64Part2@@
noncomputable def cocycleNode1_64Part3 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleNode1_64Part3@@
noncomputable def cocycleNode1_64 : List (ℕ × ℤ) := cocycleNode1_64Part0 ++ cocycleNode1_64Part1 ++ cocycleNode1_64Part2 ++ cocycleNode1_64Part3
noncomputable def cocycleSource1_64 : RawChain := codeChain (treeEntries phiCut128) + codeChain (treeEntries phiCut129)
theorem cocycleNode1_64_check : modularMerge cocycleLeaf128 cocycleLeaf129 = cocycleNode1_64 := by
  exact eq_of_beq (by decide +kernel)
theorem cocycleNode1_64_chain : reduceChain (codeChain cocycleNode1_64) =
    reduceChain (restrictCubes 3 (coBoundary cocycleSource1_64)) := by
  rw [← cocycleNode1_64_check, modularMerge_sound, cocycleLeaf128_chain, cocycleLeaf129_chain]
  simp only [cocycleSource1_64,map_add]
