import Paper23.CertificateCocycle.Data
set_option maxRecDepth 100000
set_option maxHeartbeats 0
namespace Paper23.CertificateChecks
open Cubical CertificateData
attribute [local irreducible] codeChain
noncomputable def cocycleLeaf64Part0 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleLeaf64Part0@@
noncomputable def cocycleLeaf64Part1 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleLeaf64Part1@@
noncomputable def cocycleLeaf64Part2 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleLeaf64Part2@@
noncomputable def cocycleLeaf64 : List (ℕ × ℤ) := cocycleLeaf64Part0 ++ cocycleLeaf64Part1 ++ cocycleLeaf64Part2
theorem cocycleLeaf64_check :
    modularCollapse 16 ((codeTreeCofaces phiCut64).map (fun p => [p])) = [cocycleLeaf64] := by decide +kernel
theorem cocycleLeaf64_chain : reduceChain (codeChain cocycleLeaf64) =
    reduceChain (restrictCubes 3 (coBoundary (codeChain (treeEntries phiCut64)))) := by
  exact (modularNormalization_sound 16 (codeTreeCofaces phiCut64) cocycleLeaf64 cocycleLeaf64_check).trans
    (congrArg reduceChain (codeTreeCofaces_sound phiCut64))
