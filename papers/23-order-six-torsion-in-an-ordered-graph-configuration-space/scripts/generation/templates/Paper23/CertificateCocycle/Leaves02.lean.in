import Paper23.CertificateCocycle.Data
set_option maxRecDepth 100000
set_option maxHeartbeats 0
namespace Paper23.CertificateChecks
open Cubical CertificateData
attribute [local irreducible] codeChain
noncomputable def cocycleLeaf32Part0 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleLeaf32Part0@@
noncomputable def cocycleLeaf32Part1 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleLeaf32Part1@@
noncomputable def cocycleLeaf32Part2 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleLeaf32Part2@@
noncomputable def cocycleLeaf32Part3 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleLeaf32Part3@@
noncomputable def cocycleLeaf32Part4 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleLeaf32Part4@@
noncomputable def cocycleLeaf32Part5 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleLeaf32Part5@@
noncomputable def cocycleLeaf32 : List (ℕ × ℤ) := cocycleLeaf32Part0 ++ cocycleLeaf32Part1 ++ cocycleLeaf32Part2 ++ cocycleLeaf32Part3 ++ cocycleLeaf32Part4 ++ cocycleLeaf32Part5
theorem cocycleLeaf32_check :
    modularCollapse 16 ((codeTreeCofaces phiCut32).map (fun p => [p])) = [cocycleLeaf32] := by decide +kernel
theorem cocycleLeaf32_chain : reduceChain (codeChain cocycleLeaf32) =
    reduceChain (restrictCubes 3 (coBoundary (codeChain (treeEntries phiCut32)))) := by
  exact (modularNormalization_sound 16 (codeTreeCofaces phiCut32) cocycleLeaf32 cocycleLeaf32_check).trans
    (congrArg reduceChain (codeTreeCofaces_sound phiCut32))
