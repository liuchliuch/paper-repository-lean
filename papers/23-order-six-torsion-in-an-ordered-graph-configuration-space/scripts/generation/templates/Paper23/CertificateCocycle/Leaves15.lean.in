import Paper23.CertificateCocycle.Data
set_option maxRecDepth 100000
set_option maxHeartbeats 0
namespace Paper23.CertificateChecks
open Cubical CertificateData
attribute [local irreducible] codeChain
noncomputable def cocycleLeaf240Part0 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleLeaf240Part0@@
noncomputable def cocycleLeaf240Part1 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleLeaf240Part1@@
noncomputable def cocycleLeaf240Part2 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleLeaf240Part2@@
noncomputable def cocycleLeaf240Part3 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleLeaf240Part3@@
noncomputable def cocycleLeaf240 : List (ℕ × ℤ) := cocycleLeaf240Part0 ++ cocycleLeaf240Part1 ++ cocycleLeaf240Part2 ++ cocycleLeaf240Part3
theorem cocycleLeaf240_check :
    modularCollapse 16 ((codeTreeCofaces phiCut240).map (fun p => [p])) = [cocycleLeaf240] := by decide +kernel
theorem cocycleLeaf240_chain : reduceChain (codeChain cocycleLeaf240) =
    reduceChain (restrictCubes 3 (coBoundary (codeChain (treeEntries phiCut240)))) := by
  exact (modularNormalization_sound 16 (codeTreeCofaces phiCut240) cocycleLeaf240 cocycleLeaf240_check).trans
    (congrArg reduceChain (codeTreeCofaces_sound phiCut240))
