noncomputable def cocycleSource1_192 : RawChain := codeChain (treeEntries phiCut384) + codeChain (treeEntries phiCut385)
theorem cocycleNode1_192_check : modularMerge cocycleLeaf384 cocycleLeaf385 = cocycleNode1_192 := by
  exact eq_of_beq (by decide +kernel)
theorem cocycleNode1_192_chain : reduceChain (codeChain cocycleNode1_192) =
    reduceChain (restrictCubes 3 (coBoundary cocycleSource1_192)) := by
  rw [← cocycleNode1_192_check, modularMerge_sound, cocycleLeaf384_chain, cocycleLeaf385_chain]
  simp only [cocycleSource1_192,map_add]
