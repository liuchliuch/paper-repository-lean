import Paper23.CertificateCocycle.Data
set_option maxRecDepth 100000
set_option maxHeartbeats 0
namespace Paper23.CertificateChecks
open Cubical CertificateData
attribute [local irreducible] codeChain
noncomputable def cocycleLeaf400Part0 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleLeaf400Part0@@
noncomputable def cocycleLeaf400Part1 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleLeaf400Part1@@
noncomputable def cocycleLeaf400Part2 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleLeaf400Part2@@
noncomputable def cocycleLeaf400Part3 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleLeaf400Part3@@
noncomputable def cocycleLeaf400Part4 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleLeaf400Part4@@
noncomputable def cocycleLeaf400 : List (ℕ × ℤ) := cocycleLeaf400Part0 ++ cocycleLeaf400Part1 ++ cocycleLeaf400Part2 ++ cocycleLeaf400Part3 ++ cocycleLeaf400Part4
theorem cocycleLeaf400_check :
    modularCollapse 16 ((codeTreeCofaces phiCut400).map (fun p => [p])) = [cocycleLeaf400] := by decide +kernel
theorem cocycleLeaf400_chain : reduceChain (codeChain cocycleLeaf400) =
    reduceChain (restrictCubes 3 (coBoundary (codeChain (treeEntries phiCut400)))) := by
  exact (modularNormalization_sound 16 (codeTreeCofaces phiCut400) cocycleLeaf400 cocycleLeaf400_check).trans
    (congrArg reduceChain (codeTreeCofaces_sound phiCut400))
