import Paper23.CertificateCocycle.Data
set_option maxRecDepth 100000
set_option maxHeartbeats 0
namespace Paper23.CertificateChecks
open Cubical CertificateData
attribute [local irreducible] codeChain
noncomputable def cocycleLeaf368Part0 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleLeaf368Part0@@
noncomputable def cocycleLeaf368Part1 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleLeaf368Part1@@
noncomputable def cocycleLeaf368Part2 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleLeaf368Part2@@
noncomputable def cocycleLeaf368 : List (ℕ × ℤ) := cocycleLeaf368Part0 ++ cocycleLeaf368Part1 ++ cocycleLeaf368Part2
theorem cocycleLeaf368_check :
    modularCollapse 16 ((codeTreeCofaces phiCut368).map (fun p => [p])) = [cocycleLeaf368] := by decide +kernel
theorem cocycleLeaf368_chain : reduceChain (codeChain cocycleLeaf368) =
    reduceChain (restrictCubes 3 (coBoundary (codeChain (treeEntries phiCut368)))) := by
  exact (modularNormalization_sound 16 (codeTreeCofaces phiCut368) cocycleLeaf368 cocycleLeaf368_check).trans
    (congrArg reduceChain (codeTreeCofaces_sound phiCut368))
