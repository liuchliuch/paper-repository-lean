import Paper23.CertificateCocycle.Data
set_option maxRecDepth 100000
set_option maxHeartbeats 0
namespace Paper23.CertificateChecks
open Cubical CertificateData
attribute [local irreducible] codeChain
noncomputable def cocycleLeaf176Part0 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleLeaf176Part0@@
noncomputable def cocycleLeaf176Part1 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleLeaf176Part1@@
noncomputable def cocycleLeaf176Part2 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleLeaf176Part2@@
noncomputable def cocycleLeaf176Part3 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleLeaf176Part3@@
noncomputable def cocycleLeaf176 : List (ℕ × ℤ) := cocycleLeaf176Part0 ++ cocycleLeaf176Part1 ++ cocycleLeaf176Part2 ++ cocycleLeaf176Part3
theorem cocycleLeaf176_check :
    modularCollapse 16 ((codeTreeCofaces phiCut176).map (fun p => [p])) = [cocycleLeaf176] := by decide +kernel
theorem cocycleLeaf176_chain : reduceChain (codeChain cocycleLeaf176) =
    reduceChain (restrictCubes 3 (coBoundary (codeChain (treeEntries phiCut176)))) := by
  exact (modularNormalization_sound 16 (codeTreeCofaces phiCut176) cocycleLeaf176 cocycleLeaf176_check).trans
    (congrArg reduceChain (codeTreeCofaces_sound phiCut176))
