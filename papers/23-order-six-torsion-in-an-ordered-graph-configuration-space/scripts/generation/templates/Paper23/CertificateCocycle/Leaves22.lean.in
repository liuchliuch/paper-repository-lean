import Paper23.CertificateCocycle.Data
set_option maxRecDepth 100000
set_option maxHeartbeats 0
namespace Paper23.CertificateChecks
open Cubical CertificateData
attribute [local irreducible] codeChain
noncomputable def cocycleLeaf352Part0 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleLeaf352Part0@@
noncomputable def cocycleLeaf352Part1 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleLeaf352Part1@@
noncomputable def cocycleLeaf352Part2 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleLeaf352Part2@@
noncomputable def cocycleLeaf352Part3 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleLeaf352Part3@@
noncomputable def cocycleLeaf352 : List (ℕ × ℤ) := cocycleLeaf352Part0 ++ cocycleLeaf352Part1 ++ cocycleLeaf352Part2 ++ cocycleLeaf352Part3
theorem cocycleLeaf352_check :
    modularCollapse 16 ((codeTreeCofaces phiCut352).map (fun p => [p])) = [cocycleLeaf352] := by decide +kernel
theorem cocycleLeaf352_chain : reduceChain (codeChain cocycleLeaf352) =
    reduceChain (restrictCubes 3 (coBoundary (codeChain (treeEntries phiCut352)))) := by
  exact (modularNormalization_sound 16 (codeTreeCofaces phiCut352) cocycleLeaf352 cocycleLeaf352_check).trans
    (congrArg reduceChain (codeTreeCofaces_sound phiCut352))
