noncomputable def cocycleNode1_112 : List (ℕ × ℤ) := cocycleNode1_112Part0 ++ cocycleNode1_112Part1 ++ cocycleNode1_112Part2 ++ cocycleNode1_112Part3 ++ cocycleNode1_112Part4
noncomputable def cocycleSource1_112 : RawChain := codeChain (treeEntries phiCut224) + codeChain (treeEntries phiCut225)
theorem cocycleNode1_112_check : modularMerge cocycleLeaf224 cocycleLeaf225 = cocycleNode1_112 := by
  exact eq_of_beq (by decide +kernel)
theorem cocycleNode1_112_chain : reduceChain (codeChain cocycleNode1_112) =
    reduceChain (restrictCubes 3 (coBoundary cocycleSource1_112)) := by
  rw [← cocycleNode1_112_check, modularMerge_sound, cocycleLeaf224_chain, cocycleLeaf225_chain]
  simp only [cocycleSource1_112,map_add]
