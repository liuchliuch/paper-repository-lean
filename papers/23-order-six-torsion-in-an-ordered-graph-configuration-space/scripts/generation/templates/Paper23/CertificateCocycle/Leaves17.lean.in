import Paper23.CertificateCocycle.Data
set_option maxRecDepth 100000
set_option maxHeartbeats 0
namespace Paper23.CertificateChecks
open Cubical CertificateData
attribute [local irreducible] codeChain
noncomputable def cocycleLeaf272Part0 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleLeaf272Part0@@
noncomputable def cocycleLeaf272Part1 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleLeaf272Part1@@
noncomputable def cocycleLeaf272Part2 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleLeaf272Part2@@
noncomputable def cocycleLeaf272 : List (ℕ × ℤ) := cocycleLeaf272Part0 ++ cocycleLeaf272Part1 ++ cocycleLeaf272Part2
theorem cocycleLeaf272_check :
    modularCollapse 16 ((codeTreeCofaces phiCut272).map (fun p => [p])) = [cocycleLeaf272] := by decide +kernel
theorem cocycleLeaf272_chain : reduceChain (codeChain cocycleLeaf272) =
    reduceChain (restrictCubes 3 (coBoundary (codeChain (treeEntries phiCut272)))) := by
  exact (modularNormalization_sound 16 (codeTreeCofaces phiCut272) cocycleLeaf272 cocycleLeaf272_check).trans
    (congrArg reduceChain (codeTreeCofaces_sound phiCut272))
