import Paper23.CertificateCocycle.Data
set_option maxRecDepth 100000
set_option maxHeartbeats 0
namespace Paper23.CertificateChecks
open Cubical CertificateData
attribute [local irreducible] codeChain
noncomputable def cocycleLeaf224Part0 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleLeaf224Part0@@
noncomputable def cocycleLeaf224Part1 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleLeaf224Part1@@
noncomputable def cocycleLeaf224Part2 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleLeaf224Part2@@
noncomputable def cocycleLeaf224Part3 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleLeaf224Part3@@
noncomputable def cocycleLeaf224Part4 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleLeaf224Part4@@
noncomputable def cocycleLeaf224 : List (ℕ × ℤ) := cocycleLeaf224Part0 ++ cocycleLeaf224Part1 ++ cocycleLeaf224Part2 ++ cocycleLeaf224Part3 ++ cocycleLeaf224Part4
theorem cocycleLeaf224_check :
    modularCollapse 16 ((codeTreeCofaces phiCut224).map (fun p => [p])) = [cocycleLeaf224] := by decide +kernel
theorem cocycleLeaf224_chain : reduceChain (codeChain cocycleLeaf224) =
    reduceChain (restrictCubes 3 (coBoundary (codeChain (treeEntries phiCut224)))) := by
  exact (modularNormalization_sound 16 (codeTreeCofaces phiCut224) cocycleLeaf224 cocycleLeaf224_check).trans
    (congrArg reduceChain (codeTreeCofaces_sound phiCut224))
