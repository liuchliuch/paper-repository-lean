import Paper23.CertificateCocycle.Data
set_option maxRecDepth 100000
set_option maxHeartbeats 0
namespace Paper23.CertificateChecks
open Cubical CertificateData
attribute [local irreducible] codeChain
noncomputable def cocycleLeaf432Part0 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleLeaf432Part0@@
noncomputable def cocycleLeaf432Part1 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleLeaf432Part1@@
noncomputable def cocycleLeaf432Part2 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleLeaf432Part2@@
noncomputable def cocycleLeaf432Part3 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleLeaf432Part3@@
noncomputable def cocycleLeaf432 : List (ℕ × ℤ) := cocycleLeaf432Part0 ++ cocycleLeaf432Part1 ++ cocycleLeaf432Part2 ++ cocycleLeaf432Part3
theorem cocycleLeaf432_check :
    modularCollapse 16 ((codeTreeCofaces phiCut432).map (fun p => [p])) = [cocycleLeaf432] := by decide +kernel
theorem cocycleLeaf432_chain : reduceChain (codeChain cocycleLeaf432) =
    reduceChain (restrictCubes 3 (coBoundary (codeChain (treeEntries phiCut432)))) := by
  exact (modularNormalization_sound 16 (codeTreeCofaces phiCut432) cocycleLeaf432 cocycleLeaf432_check).trans
    (congrArg reduceChain (codeTreeCofaces_sound phiCut432))
