import Paper23.CertificateCocycle.Data
set_option maxRecDepth 100000
set_option maxHeartbeats 0
namespace Paper23.CertificateChecks
open Cubical CertificateData
attribute [local irreducible] codeChain
noncomputable def cocycleLeaf208Part0 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleLeaf208Part0@@
noncomputable def cocycleLeaf208Part1 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleLeaf208Part1@@
noncomputable def cocycleLeaf208Part2 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleLeaf208Part2@@
noncomputable def cocycleLeaf208Part3 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleLeaf208Part3@@
noncomputable def cocycleLeaf208 : List (ℕ × ℤ) := cocycleLeaf208Part0 ++ cocycleLeaf208Part1 ++ cocycleLeaf208Part2 ++ cocycleLeaf208Part3
theorem cocycleLeaf208_check :
    modularCollapse 16 ((codeTreeCofaces phiCut208).map (fun p => [p])) = [cocycleLeaf208] := by decide +kernel
theorem cocycleLeaf208_chain : reduceChain (codeChain cocycleLeaf208) =
    reduceChain (restrictCubes 3 (coBoundary (codeChain (treeEntries phiCut208)))) := by
  exact (modularNormalization_sound 16 (codeTreeCofaces phiCut208) cocycleLeaf208 cocycleLeaf208_check).trans
    (congrArg reduceChain (codeTreeCofaces_sound phiCut208))
