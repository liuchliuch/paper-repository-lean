import Paper23.CertificateCocycle.Data
set_option maxRecDepth 100000
set_option maxHeartbeats 0
namespace Paper23.CertificateChecks
open Cubical CertificateData
attribute [local irreducible] codeChain
noncomputable def cocycleLeaf464Part0 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleLeaf464Part0@@
noncomputable def cocycleLeaf464Part1 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleLeaf464Part1@@
noncomputable def cocycleLeaf464Part2 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleLeaf464Part2@@
noncomputable def cocycleLeaf464Part3 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleLeaf464Part3@@
noncomputable def cocycleLeaf464 : List (ℕ × ℤ) := cocycleLeaf464Part0 ++ cocycleLeaf464Part1 ++ cocycleLeaf464Part2 ++ cocycleLeaf464Part3
theorem cocycleLeaf464_check :
    modularCollapse 16 ((codeTreeCofaces phiCut464).map (fun p => [p])) = [cocycleLeaf464] := by decide +kernel
theorem cocycleLeaf464_chain : reduceChain (codeChain cocycleLeaf464) =
    reduceChain (restrictCubes 3 (coBoundary (codeChain (treeEntries phiCut464)))) := by
  exact (modularNormalization_sound 16 (codeTreeCofaces phiCut464) cocycleLeaf464 cocycleLeaf464_check).trans
    (congrArg reduceChain (codeTreeCofaces_sound phiCut464))
