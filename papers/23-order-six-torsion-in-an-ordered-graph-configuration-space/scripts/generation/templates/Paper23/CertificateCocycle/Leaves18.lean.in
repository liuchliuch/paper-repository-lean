import Paper23.CertificateCocycle.Data
set_option maxRecDepth 100000
set_option maxHeartbeats 0
namespace Paper23.CertificateChecks
open Cubical CertificateData
attribute [local irreducible] codeChain
noncomputable def cocycleLeaf288Part0 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleLeaf288Part0@@
noncomputable def cocycleLeaf288Part1 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleLeaf288Part1@@
noncomputable def cocycleLeaf288Part2 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleLeaf288Part2@@
noncomputable def cocycleLeaf288 : List (ℕ × ℤ) := cocycleLeaf288Part0 ++ cocycleLeaf288Part1 ++ cocycleLeaf288Part2
theorem cocycleLeaf288_check :
    modularCollapse 16 ((codeTreeCofaces phiCut288).map (fun p => [p])) = [cocycleLeaf288] := by decide +kernel
theorem cocycleLeaf288_chain : reduceChain (codeChain cocycleLeaf288) =
    reduceChain (restrictCubes 3 (coBoundary (codeChain (treeEntries phiCut288)))) := by
  exact (modularNormalization_sound 16 (codeTreeCofaces phiCut288) cocycleLeaf288 cocycleLeaf288_check).trans
    (congrArg reduceChain (codeTreeCofaces_sound phiCut288))
