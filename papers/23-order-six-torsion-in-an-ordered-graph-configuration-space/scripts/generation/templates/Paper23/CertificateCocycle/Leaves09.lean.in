import Paper23.CertificateCocycle.Data
set_option maxRecDepth 100000
set_option maxHeartbeats 0
namespace Paper23.CertificateChecks
open Cubical CertificateData
attribute [local irreducible] codeChain
noncomputable def cocycleLeaf144Part0 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleLeaf144Part0@@
noncomputable def cocycleLeaf144Part1 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleLeaf144Part1@@
noncomputable def cocycleLeaf144Part2 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleLeaf144Part2@@
noncomputable def cocycleLeaf144Part3 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleLeaf144Part3@@
noncomputable def cocycleLeaf144Part4 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleLeaf144Part4@@
noncomputable def cocycleLeaf144 : List (ℕ × ℤ) := cocycleLeaf144Part0 ++ cocycleLeaf144Part1 ++ cocycleLeaf144Part2 ++ cocycleLeaf144Part3 ++ cocycleLeaf144Part4
theorem cocycleLeaf144_check :
    modularCollapse 16 ((codeTreeCofaces phiCut144).map (fun p => [p])) = [cocycleLeaf144] := by decide +kernel
theorem cocycleLeaf144_chain : reduceChain (codeChain cocycleLeaf144) =
    reduceChain (restrictCubes 3 (coBoundary (codeChain (treeEntries phiCut144)))) := by
  exact (modularNormalization_sound 16 (codeTreeCofaces phiCut144) cocycleLeaf144 cocycleLeaf144_check).trans
    (congrArg reduceChain (codeTreeCofaces_sound phiCut144))
