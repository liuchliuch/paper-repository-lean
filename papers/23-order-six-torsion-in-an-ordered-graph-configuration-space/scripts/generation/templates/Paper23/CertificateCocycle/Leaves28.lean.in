import Paper23.CertificateCocycle.Data
set_option maxRecDepth 100000
set_option maxHeartbeats 0
namespace Paper23.CertificateChecks
open Cubical CertificateData
attribute [local irreducible] codeChain
noncomputable def cocycleLeaf448Part0 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleLeaf448Part0@@
noncomputable def cocycleLeaf448Part1 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleLeaf448Part1@@
noncomputable def cocycleLeaf448Part2 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleLeaf448Part2@@
noncomputable def cocycleLeaf448Part3 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleLeaf448Part3@@
noncomputable def cocycleLeaf448 : List (ℕ × ℤ) := cocycleLeaf448Part0 ++ cocycleLeaf448Part1 ++ cocycleLeaf448Part2 ++ cocycleLeaf448Part3
theorem cocycleLeaf448_check :
    modularCollapse 16 ((codeTreeCofaces phiCut448).map (fun p => [p])) = [cocycleLeaf448] := by decide +kernel
theorem cocycleLeaf448_chain : reduceChain (codeChain cocycleLeaf448) =
    reduceChain (restrictCubes 3 (coBoundary (codeChain (treeEntries phiCut448)))) := by
  exact (modularNormalization_sound 16 (codeTreeCofaces phiCut448) cocycleLeaf448 cocycleLeaf448_check).trans
    (congrArg reduceChain (codeTreeCofaces_sound phiCut448))
