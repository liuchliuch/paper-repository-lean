import Paper23.CertificateCocycle.Data
set_option maxRecDepth 100000
set_option maxHeartbeats 0
namespace Paper23.CertificateChecks
open Cubical CertificateData
attribute [local irreducible] codeChain
noncomputable def cocycleLeaf160Part0 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleLeaf160Part0@@
noncomputable def cocycleLeaf160Part1 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleLeaf160Part1@@
noncomputable def cocycleLeaf160Part2 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleLeaf160Part2@@
noncomputable def cocycleLeaf160Part3 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleLeaf160Part3@@
noncomputable def cocycleLeaf160 : List (ℕ × ℤ) := cocycleLeaf160Part0 ++ cocycleLeaf160Part1 ++ cocycleLeaf160Part2 ++ cocycleLeaf160Part3
theorem cocycleLeaf160_check :
    modularCollapse 16 ((codeTreeCofaces phiCut160).map (fun p => [p])) = [cocycleLeaf160] := by decide +kernel
theorem cocycleLeaf160_chain : reduceChain (codeChain cocycleLeaf160) =
    reduceChain (restrictCubes 3 (coBoundary (codeChain (treeEntries phiCut160)))) := by
  exact (modularNormalization_sound 16 (codeTreeCofaces phiCut160) cocycleLeaf160 cocycleLeaf160_check).trans
    (congrArg reduceChain (codeTreeCofaces_sound phiCut160))
