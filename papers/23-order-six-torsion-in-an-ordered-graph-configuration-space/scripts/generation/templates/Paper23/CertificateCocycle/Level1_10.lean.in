attribute [local irreducible] codeChain
noncomputable def cocycleNode1_160Part0 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleNode1_160Part0@@
noncomputable def cocycleNode1_160Part1 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleNode1_160Part1@@
noncomputable def cocycleNode1_160Part2 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleNode1_160Part2@@
noncomputable def cocycleNode1_160Part3 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleNode1_160Part3@@
noncomputable def cocycleNode1_160 : List (ℕ × ℤ) := cocycleNode1_160Part0 ++ cocycleNode1_160Part1 ++ cocycleNode1_160Part2 ++ cocycleNode1_160Part3
noncomputable def cocycleSource1_160 : RawChain := codeChain (treeEntries phiCut320) + codeChain (treeEntries phiCut321)
theorem cocycleNode1_160_check : modularMerge cocycleLeaf320 cocycleLeaf321 = cocycleNode1_160 := by
  exact eq_of_beq (by decide +kernel)
theorem cocycleNode1_160_chain : reduceChain (codeChain cocycleNode1_160) =
    reduceChain (restrictCubes 3 (coBoundary cocycleSource1_160)) := by
  rw [← cocycleNode1_160_check, modularMerge_sound, cocycleLeaf320_chain, cocycleLeaf321_chain]
  simp only [cocycleSource1_160,map_add]
