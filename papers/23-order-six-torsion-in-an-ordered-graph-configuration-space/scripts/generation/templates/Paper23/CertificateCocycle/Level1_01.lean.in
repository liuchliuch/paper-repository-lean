noncomputable def cocycleSource1_16 : RawChain := codeChain (treeEntries phiCut32) + codeChain (treeEntries phiCut33)
theorem cocycleNode1_16_check : modularMerge cocycleLeaf32 cocycleLeaf33 = cocycleNode1_16 := by
  exact eq_of_beq (by decide +kernel)
theorem cocycleNode1_16_chain : reduceChain (codeChain cocycleNode1_16) =
    reduceChain (restrictCubes 3 (coBoundary cocycleSource1_16)) := by
  rw [← cocycleNode1_16_check, modularMerge_sound, cocycleLeaf32_chain, cocycleLeaf33_chain]
  simp only [cocycleSource1_16,map_add]
