attribute [local irreducible] codeChain
noncomputable def cocycleNode1_96Part0 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleNode1_96Part0@@
noncomputable def cocycleNode1_96Part1 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleNode1_96Part1@@
noncomputable def cocycleNode1_96Part2 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleNode1_96Part2@@
noncomputable def cocycleNode1_96Part3 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleNode1_96Part3@@
noncomputable def cocycleNode1_96 : List (ℕ × ℤ) := cocycleNode1_96Part0 ++ cocycleNode1_96Part1 ++ cocycleNode1_96Part2 ++ cocycleNode1_96Part3
noncomputable def cocycleSource1_96 : RawChain := codeChain (treeEntries phiCut192) + codeChain (treeEntries phiCut193)
theorem cocycleNode1_96_check : modularMerge cocycleLeaf192 cocycleLeaf193 = cocycleNode1_96 := by
  exact eq_of_beq (by decide +kernel)
theorem cocycleNode1_96_chain : reduceChain (codeChain cocycleNode1_96) =
    reduceChain (restrictCubes 3 (coBoundary cocycleSource1_96)) := by
  rw [← cocycleNode1_96_check, modularMerge_sound, cocycleLeaf192_chain, cocycleLeaf193_chain]
  simp only [cocycleSource1_96,map_add]
