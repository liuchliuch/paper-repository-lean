import Paper23.CertificateCocycle.Data
set_option maxRecDepth 100000
set_option maxHeartbeats 0
namespace Paper23.CertificateChecks
open Cubical CertificateData
attribute [local irreducible] codeChain
noncomputable def cocycleLeaf112Part0 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleLeaf112Part0@@
noncomputable def cocycleLeaf112Part1 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleLeaf112Part1@@
noncomputable def cocycleLeaf112Part2 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleLeaf112Part2@@
noncomputable def cocycleLeaf112Part3 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleLeaf112Part3@@
noncomputable def cocycleLeaf112 : List (ℕ × ℤ) := cocycleLeaf112Part0 ++ cocycleLeaf112Part1 ++ cocycleLeaf112Part2 ++ cocycleLeaf112Part3
theorem cocycleLeaf112_check :
    modularCollapse 16 ((codeTreeCofaces phiCut112).map (fun p => [p])) = [cocycleLeaf112] := by decide +kernel
theorem cocycleLeaf112_chain : reduceChain (codeChain cocycleLeaf112) =
    reduceChain (restrictCubes 3 (coBoundary (codeChain (treeEntries phiCut112)))) := by
  exact (modularNormalization_sound 16 (codeTreeCofaces phiCut112) cocycleLeaf112 cocycleLeaf112_check).trans
    (congrArg reduceChain (codeTreeCofaces_sound phiCut112))
