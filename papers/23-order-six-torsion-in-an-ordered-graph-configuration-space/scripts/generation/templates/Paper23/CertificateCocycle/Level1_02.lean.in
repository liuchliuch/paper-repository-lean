import Paper23.CertificateCocycle.Leaves04
import Paper23.CertificateCocycle.Leaves05
set_option maxRecDepth 100000
set_option maxHeartbeats 0
namespace Paper23.CertificateChecks
open Cubical CertificateData
attribute [local irreducible] codeChain
noncomputable def cocycleNode1_32Part0 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleNode1_32Part0@@
noncomputable def cocycleNode1_32Part1 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleNode1_32Part1@@
noncomputable def cocycleNode1_32Part2 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleNode1_32Part2@@
noncomputable def cocycleNode1_32 : List (ℕ × ℤ) := cocycleNode1_32Part0 ++ cocycleNode1_32Part1 ++ cocycleNode1_32Part2
noncomputable def cocycleSource1_32 : RawChain := codeChain (treeEntries phiCut64) + codeChain (treeEntries phiCut65)
theorem cocycleNode1_32_check : modularMerge cocycleLeaf64 cocycleLeaf65 = cocycleNode1_32 := by
  exact eq_of_beq (by decide +kernel)
theorem cocycleNode1_32_chain : reduceChain (codeChain cocycleNode1_32) =
    reduceChain (restrictCubes 3 (coBoundary cocycleSource1_32)) := by
  rw [← cocycleNode1_32_check, modularMerge_sound, cocycleLeaf64_chain, cocycleLeaf65_chain]
  simp only [cocycleSource1_32,map_add]
