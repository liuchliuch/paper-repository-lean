import Paper23.CertificateCocycle.Data
set_option maxRecDepth 100000
set_option maxHeartbeats 0
namespace Paper23.CertificateChecks
open Cubical CertificateData
attribute [local irreducible] codeChain
noncomputable def cocycleLeaf0 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleLeaf0@@
theorem cocycleLeaf0_check :
    modularCollapse 16 ((codeTreeCofaces phiCut0).map (fun p => [p])) = [cocycleLeaf0] := by decide +kernel
theorem cocycleLeaf0_chain : reduceChain (codeChain cocycleLeaf0) =
    reduceChain (restrictCubes 3 (coBoundary (codeChain (treeEntries phiCut0)))) := by
  exact (modularNormalization_sound 16 (codeTreeCofaces phiCut0) cocycleLeaf0 cocycleLeaf0_check).trans
    (congrArg reduceChain (codeTreeCofaces_sound phiCut0))
