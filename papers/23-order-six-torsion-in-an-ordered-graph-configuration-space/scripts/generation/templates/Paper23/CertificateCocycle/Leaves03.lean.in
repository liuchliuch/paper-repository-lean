import Paper23.CertificateCocycle.Data
set_option maxRecDepth 100000
set_option maxHeartbeats 0
namespace Paper23.CertificateChecks
open Cubical CertificateData
attribute [local irreducible] codeChain
noncomputable def cocycleLeaf48Part0 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleLeaf48Part0@@
noncomputable def cocycleLeaf48Part1 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleLeaf48Part1@@
noncomputable def cocycleLeaf48Part2 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleLeaf48Part2@@
noncomputable def cocycleLeaf48Part3 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleLeaf48Part3@@
noncomputable def cocycleLeaf48 : List (ℕ × ℤ) := cocycleLeaf48Part0 ++ cocycleLeaf48Part1 ++ cocycleLeaf48Part2 ++ cocycleLeaf48Part3
theorem cocycleLeaf48_check :
    modularCollapse 16 ((codeTreeCofaces phiCut48).map (fun p => [p])) = [cocycleLeaf48] := by decide +kernel
theorem cocycleLeaf48_chain : reduceChain (codeChain cocycleLeaf48) =
    reduceChain (restrictCubes 3 (coBoundary (codeChain (treeEntries phiCut48)))) := by
  exact (modularNormalization_sound 16 (codeTreeCofaces phiCut48) cocycleLeaf48 cocycleLeaf48_check).trans
    (congrArg reduceChain (codeTreeCofaces_sound phiCut48))
