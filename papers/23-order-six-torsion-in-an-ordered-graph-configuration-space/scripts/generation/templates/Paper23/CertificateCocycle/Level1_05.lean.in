attribute [local irreducible] codeChain
noncomputable def cocycleNode1_80Part0 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleNode1_80Part0@@
noncomputable def cocycleNode1_80Part1 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleNode1_80Part1@@
noncomputable def cocycleNode1_80Part2 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleNode1_80Part2@@
noncomputable def cocycleNode1_80Part3 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleNode1_80Part3@@
noncomputable def cocycleNode1_80 : List (ℕ × ℤ) := cocycleNode1_80Part0 ++ cocycleNode1_80Part1 ++ cocycleNode1_80Part2 ++ cocycleNode1_80Part3
noncomputable def cocycleSource1_80 : RawChain := codeChain (treeEntries phiCut160) + codeChain (treeEntries phiCut161)
theorem cocycleNode1_80_check : modularMerge cocycleLeaf160 cocycleLeaf161 = cocycleNode1_80 := by
  exact eq_of_beq (by decide +kernel)
theorem cocycleNode1_80_chain : reduceChain (codeChain cocycleNode1_80) =
    reduceChain (restrictCubes 3 (coBoundary cocycleSource1_80)) := by
  rw [← cocycleNode1_80_check, modularMerge_sound, cocycleLeaf160_chain, cocycleLeaf161_chain]
  simp only [cocycleSource1_80,map_add]
