import Paper23.CertificateCocycle.Data
set_option maxRecDepth 100000
set_option maxHeartbeats 0
namespace Paper23.CertificateChecks
open Cubical CertificateData
attribute [local irreducible] codeChain
noncomputable def cocycleLeaf304Part0 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleLeaf304Part0@@
noncomputable def cocycleLeaf304Part1 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleLeaf304Part1@@
noncomputable def cocycleLeaf304Part2 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleLeaf304Part2@@
noncomputable def cocycleLeaf304Part3 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleLeaf304Part3@@
noncomputable def cocycleLeaf304Part4 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleLeaf304Part4@@
noncomputable def cocycleLeaf304 : List (ℕ × ℤ) := cocycleLeaf304Part0 ++ cocycleLeaf304Part1 ++ cocycleLeaf304Part2 ++ cocycleLeaf304Part3 ++ cocycleLeaf304Part4
theorem cocycleLeaf304_check :
    modularCollapse 16 ((codeTreeCofaces phiCut304).map (fun p => [p])) = [cocycleLeaf304] := by decide +kernel
theorem cocycleLeaf304_chain : reduceChain (codeChain cocycleLeaf304) =
    reduceChain (restrictCubes 3 (coBoundary (codeChain (treeEntries phiCut304)))) := by
  exact (modularNormalization_sound 16 (codeTreeCofaces phiCut304) cocycleLeaf304 cocycleLeaf304_check).trans
    (congrArg reduceChain (codeTreeCofaces_sound phiCut304))
