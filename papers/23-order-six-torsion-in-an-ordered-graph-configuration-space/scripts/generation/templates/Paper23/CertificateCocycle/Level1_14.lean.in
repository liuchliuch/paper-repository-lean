attribute [local irreducible] codeChain
noncomputable def cocycleNode1_224Part0 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleNode1_224Part0@@
noncomputable def cocycleNode1_224Part1 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleNode1_224Part1@@
noncomputable def cocycleNode1_224Part2 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleNode1_224Part2@@
noncomputable def cocycleNode1_224Part3 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleNode1_224Part3@@
noncomputable def cocycleNode1_224 : List (ℕ × ℤ) := cocycleNode1_224Part0 ++ cocycleNode1_224Part1 ++ cocycleNode1_224Part2 ++ cocycleNode1_224Part3
noncomputable def cocycleSource1_224 : RawChain := codeChain (treeEntries phiCut448) + codeChain (treeEntries phiCut449)
theorem cocycleNode1_224_check : modularMerge cocycleLeaf448 cocycleLeaf449 = cocycleNode1_224 := by
  exact eq_of_beq (by decide +kernel)
theorem cocycleNode1_224_chain : reduceChain (codeChain cocycleNode1_224) =
    reduceChain (restrictCubes 3 (coBoundary cocycleSource1_224)) := by
  rw [← cocycleNode1_224_check, modularMerge_sound, cocycleLeaf448_chain, cocycleLeaf449_chain]
  simp only [cocycleSource1_224,map_add]
