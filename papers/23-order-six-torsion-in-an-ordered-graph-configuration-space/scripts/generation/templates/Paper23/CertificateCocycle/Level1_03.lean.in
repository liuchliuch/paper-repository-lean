noncomputable def cocycleNode1_48 : List (ℕ × ℤ) := cocycleNode1_48Part0 ++ cocycleNode1_48Part1 ++ cocycleNode1_48Part2 ++ cocycleNode1_48Part3 ++ cocycleNode1_48Part4 ++ cocycleNode1_48Part5
noncomputable def cocycleSource1_48 : RawChain := codeChain (treeEntries phiCut96) + codeChain (treeEntries phiCut97)
theorem cocycleNode1_48_check : modularMerge cocycleLeaf96 cocycleLeaf97 = cocycleNode1_48 := by
  exact eq_of_beq (by decide +kernel)
theorem cocycleNode1_48_chain : reduceChain (codeChain cocycleNode1_48) =
    reduceChain (restrictCubes 3 (coBoundary cocycleSource1_48)) := by
  rw [← cocycleNode1_48_check, modularMerge_sound, cocycleLeaf96_chain, cocycleLeaf97_chain]
  simp only [cocycleSource1_48,map_add]
