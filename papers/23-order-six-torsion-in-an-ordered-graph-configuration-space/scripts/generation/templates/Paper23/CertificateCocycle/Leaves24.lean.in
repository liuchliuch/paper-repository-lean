import Paper23.CertificateCocycle.Data
set_option maxRecDepth 100000
set_option maxHeartbeats 0
namespace Paper23.CertificateChecks
open Cubical CertificateData
attribute [local irreducible] codeChain
noncomputable def cocycleLeaf384Part0 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleLeaf384Part0@@
noncomputable def cocycleLeaf384Part1 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleLeaf384Part1@@
noncomputable def cocycleLeaf384Part2 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleLeaf384Part2@@
noncomputable def cocycleLeaf384 : List (ℕ × ℤ) := cocycleLeaf384Part0 ++ cocycleLeaf384Part1 ++ cocycleLeaf384Part2
theorem cocycleLeaf384_check :
    modularCollapse 16 ((codeTreeCofaces phiCut384).map (fun p => [p])) = [cocycleLeaf384] := by decide +kernel
theorem cocycleLeaf384_chain : reduceChain (codeChain cocycleLeaf384) =
    reduceChain (restrictCubes 3 (coBoundary (codeChain (treeEntries phiCut384)))) := by
  exact (modularNormalization_sound 16 (codeTreeCofaces phiCut384) cocycleLeaf384 cocycleLeaf384_check).trans
    (congrArg reduceChain (codeTreeCofaces_sound phiCut384))
