noncomputable def cocycleNode1_144Part0 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleNode1_144Part0@@
noncomputable def cocycleNode1_144Part1 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleNode1_144Part1@@
noncomputable def cocycleNode1_144Part2 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleNode1_144Part2@@
noncomputable def cocycleNode1_144 : List (ℕ × ℤ) := cocycleNode1_144Part0 ++ cocycleNode1_144Part1 ++ cocycleNode1_144Part2
noncomputable def cocycleSource1_144 : RawChain := codeChain (treeEntries phiCut288) + codeChain (treeEntries phiCut289)
theorem cocycleNode1_144_check : modularMerge cocycleLeaf288 cocycleLeaf289 = cocycleNode1_144 := by
  exact eq_of_beq (by decide +kernel)
theorem cocycleNode1_144_chain : reduceChain (codeChain cocycleNode1_144) =
    reduceChain (restrictCubes 3 (coBoundary cocycleSource1_144)) := by
  rw [← cocycleNode1_144_check, modularMerge_sound, cocycleLeaf288_chain, cocycleLeaf289_chain]
  simp only [cocycleSource1_144,map_add]
