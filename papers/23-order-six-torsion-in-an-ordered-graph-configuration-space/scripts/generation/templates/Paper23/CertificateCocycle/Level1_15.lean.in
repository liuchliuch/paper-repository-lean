noncomputable def cocycleNode1_240Part0 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleNode1_240Part0@@
noncomputable def cocycleNode1_240Part1 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleNode1_240Part1@@
noncomputable def cocycleNode1_240Part2 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleNode1_240Part2@@
noncomputable def cocycleNode1_240 : List (ℕ × ℤ) := cocycleNode1_240Part0 ++ cocycleNode1_240Part1 ++ cocycleNode1_240Part2
noncomputable def cocycleSource1_240 : RawChain := codeChain (treeEntries phiCut480) + codeChain (treeEntries phiCut481)
theorem cocycleNode1_240_check : modularMerge cocycleLeaf480 cocycleLeaf481 = cocycleNode1_240 := by
  exact eq_of_beq (by decide +kernel)
theorem cocycleNode1_240_chain : reduceChain (codeChain cocycleNode1_240) =
    reduceChain (restrictCubes 3 (coBoundary cocycleSource1_240)) := by
  rw [← cocycleNode1_240_check, modularMerge_sound, cocycleLeaf480_chain, cocycleLeaf481_chain]
  simp only [cocycleSource1_240,map_add]
