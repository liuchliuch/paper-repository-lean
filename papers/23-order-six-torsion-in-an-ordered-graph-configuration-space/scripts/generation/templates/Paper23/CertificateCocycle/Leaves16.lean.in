import Paper23.CertificateCocycle.Data
set_option maxRecDepth 100000
set_option maxHeartbeats 0
namespace Paper23.CertificateChecks
open Cubical CertificateData
attribute [local irreducible] codeChain
noncomputable def cocycleLeaf256Part0 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleLeaf256Part0@@
noncomputable def cocycleLeaf256Part1 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleLeaf256Part1@@
noncomputable def cocycleLeaf256Part2 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleLeaf256Part2@@
noncomputable def cocycleLeaf256 : List (ℕ × ℤ) := cocycleLeaf256Part0 ++ cocycleLeaf256Part1 ++ cocycleLeaf256Part2
theorem cocycleLeaf256_check :
    modularCollapse 16 ((codeTreeCofaces phiCut256).map (fun p => [p])) = [cocycleLeaf256] := by decide +kernel
theorem cocycleLeaf256_chain : reduceChain (codeChain cocycleLeaf256) =
    reduceChain (restrictCubes 3 (coBoundary (codeChain (treeEntries phiCut256)))) := by
  exact (modularNormalization_sound 16 (codeTreeCofaces phiCut256) cocycleLeaf256 cocycleLeaf256_check).trans
    (congrArg reduceChain (codeTreeCofaces_sound phiCut256))
