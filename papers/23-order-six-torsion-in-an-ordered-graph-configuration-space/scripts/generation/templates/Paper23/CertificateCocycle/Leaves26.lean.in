import Paper23.CertificateCocycle.Data
set_option maxRecDepth 100000
set_option maxHeartbeats 0
namespace Paper23.CertificateChecks
open Cubical CertificateData
attribute [local irreducible] codeChain
noncomputable def cocycleLeaf416Part0 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleLeaf416Part0@@
noncomputable def cocycleLeaf416Part1 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleLeaf416Part1@@
noncomputable def cocycleLeaf416Part2 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleLeaf416Part2@@
noncomputable def cocycleLeaf416 : List (ℕ × ℤ) := cocycleLeaf416Part0 ++ cocycleLeaf416Part1 ++ cocycleLeaf416Part2
theorem cocycleLeaf416_check :
    modularCollapse 16 ((codeTreeCofaces phiCut416).map (fun p => [p])) = [cocycleLeaf416] := by decide +kernel
theorem cocycleLeaf416_chain : reduceChain (codeChain cocycleLeaf416) =
    reduceChain (restrictCubes 3 (coBoundary (codeChain (treeEntries phiCut416)))) := by
  exact (modularNormalization_sound 16 (codeTreeCofaces phiCut416) cocycleLeaf416 cocycleLeaf416_check).trans
    (congrArg reduceChain (codeTreeCofaces_sound phiCut416))
