noncomputable def cocycleSource1_208 : RawChain := codeChain (treeEntries phiCut416) + codeChain (treeEntries phiCut417)
theorem cocycleNode1_208_check : modularMerge cocycleLeaf416 cocycleLeaf417 = cocycleNode1_208 := by
  exact eq_of_beq (by decide +kernel)
theorem cocycleNode1_208_chain : reduceChain (codeChain cocycleNode1_208) =
    reduceChain (restrictCubes 3 (coBoundary cocycleSource1_208)) := by
  rw [← cocycleNode1_208_check, modularMerge_sound, cocycleLeaf416_chain, cocycleLeaf417_chain]
  simp only [cocycleSource1_208,map_add]
