import Paper23.CertificateCocycle.Data
set_option maxRecDepth 100000
set_option maxHeartbeats 0
namespace Paper23.CertificateChecks
open Cubical CertificateData
attribute [local irreducible] codeChain
noncomputable def cocycleLeaf480Part0 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleLeaf480Part0@@
noncomputable def cocycleLeaf480Part1 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleLeaf480Part1@@
noncomputable def cocycleLeaf480Part2 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleLeaf480Part2@@
noncomputable def cocycleLeaf480 : List (ℕ × ℤ) := cocycleLeaf480Part0 ++ cocycleLeaf480Part1 ++ cocycleLeaf480Part2
theorem cocycleLeaf480_check :
    modularCollapse 16 ((codeTreeCofaces phiCut480).map (fun p => [p])) = [cocycleLeaf480] := by decide +kernel
theorem cocycleLeaf480_chain : reduceChain (codeChain cocycleLeaf480) =
    reduceChain (restrictCubes 3 (coBoundary (codeChain (treeEntries phiCut480)))) := by
  exact (modularNormalization_sound 16 (codeTreeCofaces phiCut480) cocycleLeaf480 cocycleLeaf480_check).trans
    (congrArg reduceChain (codeTreeCofaces_sound phiCut480))
