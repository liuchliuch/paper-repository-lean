import Paper23.CertificateCocycle.Data
set_option maxRecDepth 100000
set_option maxHeartbeats 0
namespace Paper23.CertificateChecks
open Cubical CertificateData
attribute [local irreducible] codeChain
noncomputable def cocycleLeaf96Part0 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleLeaf96Part0@@
noncomputable def cocycleLeaf96Part1 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleLeaf96Part1@@
noncomputable def cocycleLeaf96Part2 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleLeaf96Part2@@
noncomputable def cocycleLeaf96Part3 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleLeaf96Part3@@
noncomputable def cocycleLeaf96Part4 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleLeaf96Part4@@
noncomputable def cocycleLeaf96Part5 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleLeaf96Part5@@
noncomputable def cocycleLeaf96 : List (ℕ × ℤ) := cocycleLeaf96Part0 ++ cocycleLeaf96Part1 ++ cocycleLeaf96Part2 ++ cocycleLeaf96Part3 ++ cocycleLeaf96Part4 ++ cocycleLeaf96Part5
theorem cocycleLeaf96_check :
    modularCollapse 16 ((codeTreeCofaces phiCut96).map (fun p => [p])) = [cocycleLeaf96] := by decide +kernel
theorem cocycleLeaf96_chain : reduceChain (codeChain cocycleLeaf96) =
    reduceChain (restrictCubes 3 (coBoundary (codeChain (treeEntries phiCut96)))) := by
  exact (modularNormalization_sound 16 (codeTreeCofaces phiCut96) cocycleLeaf96 cocycleLeaf96_check).trans
    (congrArg reduceChain (codeTreeCofaces_sound phiCut96))
