import Paper23.CertificateCocycle.Data
set_option maxRecDepth 100000
set_option maxHeartbeats 0
namespace Paper23.CertificateChecks
open Cubical CertificateData
attribute [local irreducible] codeChain
noncomputable def cocycleLeaf496Part0 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleLeaf496Part0@@
noncomputable def cocycleLeaf496Part1 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleLeaf496Part1@@
noncomputable def cocycleLeaf496Part2 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleLeaf496Part2@@
noncomputable def cocycleLeaf496Part3 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleLeaf496Part3@@
noncomputable def cocycleLeaf496 : List (ℕ × ℤ) := cocycleLeaf496Part0 ++ cocycleLeaf496Part1 ++ cocycleLeaf496Part2 ++ cocycleLeaf496Part3
theorem cocycleLeaf496_check :
    modularCollapse 16 ((codeTreeCofaces phiCut496).map (fun p => [p])) = [cocycleLeaf496] := by decide +kernel
theorem cocycleLeaf496_chain : reduceChain (codeChain cocycleLeaf496) =
    reduceChain (restrictCubes 3 (coBoundary (codeChain (treeEntries phiCut496)))) := by
  exact (modularNormalization_sound 16 (codeTreeCofaces phiCut496) cocycleLeaf496 cocycleLeaf496_check).trans
    (congrArg reduceChain (codeTreeCofaces_sound phiCut496))
