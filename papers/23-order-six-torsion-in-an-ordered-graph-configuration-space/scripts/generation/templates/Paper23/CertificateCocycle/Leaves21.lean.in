import Paper23.CertificateCocycle.Data
set_option maxRecDepth 100000
set_option maxHeartbeats 0
namespace Paper23.CertificateChecks
open Cubical CertificateData
attribute [local irreducible] codeChain
noncomputable def cocycleLeaf336Part0 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleLeaf336Part0@@
noncomputable def cocycleLeaf336Part1 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleLeaf336Part1@@
noncomputable def cocycleLeaf336Part2 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleLeaf336Part2@@
noncomputable def cocycleLeaf336Part3 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleLeaf336Part3@@
noncomputable def cocycleLeaf336Part4 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleLeaf336Part4@@
noncomputable def cocycleLeaf336 : List (ℕ × ℤ) := cocycleLeaf336Part0 ++ cocycleLeaf336Part1 ++ cocycleLeaf336Part2 ++ cocycleLeaf336Part3 ++ cocycleLeaf336Part4
theorem cocycleLeaf336_check :
    modularCollapse 16 ((codeTreeCofaces phiCut336).map (fun p => [p])) = [cocycleLeaf336] := by decide +kernel
theorem cocycleLeaf336_chain : reduceChain (codeChain cocycleLeaf336) =
    reduceChain (restrictCubes 3 (coBoundary (codeChain (treeEntries phiCut336)))) := by
  exact (modularNormalization_sound 16 (codeTreeCofaces phiCut336) cocycleLeaf336 cocycleLeaf336_check).trans
    (congrArg reduceChain (codeTreeCofaces_sound phiCut336))
