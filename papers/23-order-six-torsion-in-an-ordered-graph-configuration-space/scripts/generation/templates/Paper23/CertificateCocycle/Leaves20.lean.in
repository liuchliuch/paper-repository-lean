import Paper23.CertificateCocycle.Data
set_option maxRecDepth 100000
set_option maxHeartbeats 0
namespace Paper23.CertificateChecks
open Cubical CertificateData
attribute [local irreducible] codeChain
noncomputable def cocycleLeaf320Part0 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleLeaf320Part0@@
noncomputable def cocycleLeaf320Part1 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleLeaf320Part1@@
noncomputable def cocycleLeaf320Part2 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleLeaf320Part2@@
noncomputable def cocycleLeaf320Part3 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleLeaf320Part3@@
noncomputable def cocycleLeaf320 : List (ℕ × ℤ) := cocycleLeaf320Part0 ++ cocycleLeaf320Part1 ++ cocycleLeaf320Part2 ++ cocycleLeaf320Part3
theorem cocycleLeaf320_check :
    modularCollapse 16 ((codeTreeCofaces phiCut320).map (fun p => [p])) = [cocycleLeaf320] := by decide +kernel
theorem cocycleLeaf320_chain : reduceChain (codeChain cocycleLeaf320) =
    reduceChain (restrictCubes 3 (coBoundary (codeChain (treeEntries phiCut320)))) := by
  exact (modularNormalization_sound 16 (codeTreeCofaces phiCut320) cocycleLeaf320 cocycleLeaf320_check).trans
    (congrArg reduceChain (codeTreeCofaces_sound phiCut320))
