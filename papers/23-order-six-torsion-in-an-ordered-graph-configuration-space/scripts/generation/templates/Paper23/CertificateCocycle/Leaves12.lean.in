import Paper23.CertificateCocycle.Data
set_option maxRecDepth 100000
set_option maxHeartbeats 0
namespace Paper23.CertificateChecks
open Cubical CertificateData
attribute [local irreducible] codeChain
noncomputable def cocycleLeaf192Part0 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleLeaf192Part0@@
noncomputable def cocycleLeaf192Part1 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleLeaf192Part1@@
noncomputable def cocycleLeaf192Part2 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleLeaf192Part2@@
noncomputable def cocycleLeaf192Part3 : List (ℕ × ℤ) := @@GENERATED_RHS:cocycleLeaf192Part3@@
noncomputable def cocycleLeaf192 : List (ℕ × ℤ) := cocycleLeaf192Part0 ++ cocycleLeaf192Part1 ++ cocycleLeaf192Part2 ++ cocycleLeaf192Part3
theorem cocycleLeaf192_check :
    modularCollapse 16 ((codeTreeCofaces phiCut192).map (fun p => [p])) = [cocycleLeaf192] := by decide +kernel
theorem cocycleLeaf192_chain : reduceChain (codeChain cocycleLeaf192) =
    reduceChain (restrictCubes 3 (coBoundary (codeChain (treeEntries phiCut192)))) := by
  exact (modularNormalization_sound 16 (codeTreeCofaces phiCut192) cocycleLeaf192 cocycleLeaf192_check).trans
    (congrArg reduceChain (codeTreeCofaces_sound phiCut192))
