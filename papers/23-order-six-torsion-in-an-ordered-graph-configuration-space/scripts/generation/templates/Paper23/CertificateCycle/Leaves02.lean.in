import Paper23.CertificateSparse
import Paper23.CertificateChecks
set_option maxRecDepth 100000
set_option maxHeartbeats 0
namespace Paper23.CertificateChecks
open Cubical CertificateData
noncomputable def cycleLeaf32 : List (ℕ × ℤ) := @@GENERATED_RHS:cycleLeaf32@@
theorem cycleLeaf32_check :
    collapse 10 ((codeDifferential zEntries32).map (fun p => [p])) = [cycleLeaf32] := by decide +kernel
 theorem cycleLeaf32_chain : codeChain cycleLeaf32 = boundary (codeChain zEntries32) := by
  exact (normalization_sound 10 (codeDifferential zEntries32) cycleLeaf32 cycleLeaf32_check).trans
    (codeChain_codeDifferential zEntries32 (fun p hp => (validChunk32 p hp).1.2))
