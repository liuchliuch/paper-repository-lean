noncomputable def cycleNode1_16Part0 : List (ℕ × ℤ) := @@GENERATED_RHS:cycleNode1_16Part0@@
noncomputable def cycleNode1_16Part1 : List (ℕ × ℤ) := @@GENERATED_RHS:cycleNode1_16Part1@@
noncomputable def cycleNode1_16 : List (ℕ × ℤ) := cycleNode1_16Part0 ++ cycleNode1_16Part1
noncomputable def cycleSource1_16 : RawChain := codeChain zEntries32 + codeChain zEntries33
theorem cycleNode1_16_check : merge cycleLeaf32 cycleLeaf33 = cycleNode1_16 := by decide +kernel
 theorem cycleNode1_16_chain : codeChain cycleNode1_16 = boundary cycleSource1_16 := by
  rw [← cycleNode1_16_check, codeChain_merge, cycleLeaf32_chain, cycleLeaf33_chain]
  exact (map_add boundary _ _).symm
