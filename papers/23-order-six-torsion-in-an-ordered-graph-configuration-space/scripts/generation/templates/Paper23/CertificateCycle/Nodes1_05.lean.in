noncomputable def cycleNode1_80Part1 : List (ℕ × ℤ) := @@GENERATED_RHS:cycleNode1_80Part1@@
noncomputable def cycleNode1_80 : List (ℕ × ℤ) := cycleNode1_80Part0 ++ cycleNode1_80Part1
noncomputable def cycleSource1_80 : RawChain := codeChain zEntries160 + codeChain zEntries161
theorem cycleNode1_80_check : merge cycleLeaf160 cycleLeaf161 = cycleNode1_80 := by decide +kernel
 theorem cycleNode1_80_chain : codeChain cycleNode1_80 = boundary cycleSource1_80 := by
  rw [← cycleNode1_80_check, codeChain_merge, cycleLeaf160_chain, cycleLeaf161_chain]
  exact (map_add boundary _ _).symm
