import Paper23.CertificateSparse
import Paper23.CertificateChecks
set_option maxRecDepth 100000
set_option maxHeartbeats 0
namespace Paper23.CertificateChecks
open Cubical CertificateData
noncomputable def cycleLeaf384 : List (ℕ × ℤ) := @@GENERATED_RHS:cycleLeaf384@@
theorem cycleLeaf384_check :
    collapse 10 ((codeDifferential zEntries384).map (fun p => [p])) = [cycleLeaf384] := by decide +kernel
 theorem cycleLeaf384_chain : codeChain cycleLeaf384 = boundary (codeChain zEntries384) := by
  exact (normalization_sound 10 (codeDifferential zEntries384) cycleLeaf384 cycleLeaf384_check).trans
    (codeChain_codeDifferential zEntries384 (fun p hp => (validChunk384 p hp).1.2))
