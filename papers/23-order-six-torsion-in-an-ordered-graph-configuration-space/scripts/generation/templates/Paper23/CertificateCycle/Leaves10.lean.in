import Paper23.CertificateSparse
import Paper23.CertificateChecks
set_option maxRecDepth 100000
set_option maxHeartbeats 0
namespace Paper23.CertificateChecks
open Cubical CertificateData
noncomputable def cycleLeaf160 : List (ℕ × ℤ) := @@GENERATED_RHS:cycleLeaf160@@
theorem cycleLeaf160_check :
    collapse 10 ((codeDifferential zEntries160).map (fun p => [p])) = [cycleLeaf160] := by decide +kernel
 theorem cycleLeaf160_chain : codeChain cycleLeaf160 = boundary (codeChain zEntries160) := by
  exact (normalization_sound 10 (codeDifferential zEntries160) cycleLeaf160 cycleLeaf160_check).trans
    (codeChain_codeDifferential zEntries160 (fun p hp => (validChunk160 p hp).1.2))
