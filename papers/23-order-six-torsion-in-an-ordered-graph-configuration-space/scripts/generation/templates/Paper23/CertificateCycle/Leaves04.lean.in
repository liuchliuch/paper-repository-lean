import Paper23.CertificateSparse
import Paper23.CertificateChecks
set_option maxRecDepth 100000
set_option maxHeartbeats 0
namespace Paper23.CertificateChecks
open Cubical CertificateData
noncomputable def cycleLeaf64 : List (ℕ × ℤ) := @@GENERATED_RHS:cycleLeaf64@@
theorem cycleLeaf64_check :
    collapse 10 ((codeDifferential zEntries64).map (fun p => [p])) = [cycleLeaf64] := by decide +kernel
 theorem cycleLeaf64_chain : codeChain cycleLeaf64 = boundary (codeChain zEntries64) := by
  exact (normalization_sound 10 (codeDifferential zEntries64) cycleLeaf64 cycleLeaf64_check).trans
    (codeChain_codeDifferential zEntries64 (fun p hp => (validChunk64 p hp).1.2))
