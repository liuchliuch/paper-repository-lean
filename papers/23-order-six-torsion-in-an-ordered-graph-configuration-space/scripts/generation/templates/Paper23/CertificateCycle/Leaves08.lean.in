import Paper23.CertificateSparse
import Paper23.CertificateChecks
set_option maxRecDepth 100000
set_option maxHeartbeats 0
namespace Paper23.CertificateChecks
open Cubical CertificateData
noncomputable def cycleLeaf128 : List (ℕ × ℤ) := @@GENERATED_RHS:cycleLeaf128@@
theorem cycleLeaf128_check :
    collapse 10 ((codeDifferential zEntries128).map (fun p => [p])) = [cycleLeaf128] := by decide +kernel
 theorem cycleLeaf128_chain : codeChain cycleLeaf128 = boundary (codeChain zEntries128) := by
  exact (normalization_sound 10 (codeDifferential zEntries128) cycleLeaf128 cycleLeaf128_check).trans
    (codeChain_codeDifferential zEntries128 (fun p hp => (validChunk128 p hp).1.2))
