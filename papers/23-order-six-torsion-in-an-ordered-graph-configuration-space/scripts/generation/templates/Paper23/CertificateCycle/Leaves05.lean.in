import Paper23.CertificateSparse
import Paper23.CertificateChecks
set_option maxRecDepth 100000
set_option maxHeartbeats 0
namespace Paper23.CertificateChecks
open Cubical CertificateData
noncomputable def cycleLeaf80 : List (ℕ × ℤ) := @@GENERATED_RHS:cycleLeaf80@@
theorem cycleLeaf80_check :
    collapse 10 ((codeDifferential zEntries80).map (fun p => [p])) = [cycleLeaf80] := by decide +kernel
 theorem cycleLeaf80_chain : codeChain cycleLeaf80 = boundary (codeChain zEntries80) := by
  exact (normalization_sound 10 (codeDifferential zEntries80) cycleLeaf80 cycleLeaf80_check).trans
    (codeChain_codeDifferential zEntries80 (fun p hp => (validChunk80 p hp).1.2))
