import Paper23.CertificateSparse
import Paper23.CertificateChecks
set_option maxRecDepth 100000
set_option maxHeartbeats 0
namespace Paper23.CertificateChecks
open Cubical CertificateData
noncomputable def cycleLeaf0 : List (ℕ × ℤ) := @@GENERATED_RHS:cycleLeaf0@@
theorem cycleLeaf0_check :
    collapse 10 ((codeDifferential zEntries0).map (fun p => [p])) = [cycleLeaf0] := by decide +kernel
 theorem cycleLeaf0_chain : codeChain cycleLeaf0 = boundary (codeChain zEntries0) := by
  exact (normalization_sound 10 (codeDifferential zEntries0) cycleLeaf0 cycleLeaf0_check).trans
    (codeChain_codeDifferential zEntries0 (fun p hp => (validChunk0 p hp).1.2))
