import Paper23.CertificateSparse
import Paper23.CertificateChecks
set_option maxRecDepth 100000
set_option maxHeartbeats 0
namespace Paper23.CertificateChecks
open Cubical CertificateData
noncomputable def cycleLeaf288 : List (ℕ × ℤ) := @@GENERATED_RHS:cycleLeaf288@@
theorem cycleLeaf288_check :
    collapse 10 ((codeDifferential zEntries288).map (fun p => [p])) = [cycleLeaf288] := by decide +kernel
 theorem cycleLeaf288_chain : codeChain cycleLeaf288 = boundary (codeChain zEntries288) := by
  exact (normalization_sound 10 (codeDifferential zEntries288) cycleLeaf288 cycleLeaf288_check).trans
    (codeChain_codeDifferential zEntries288 (fun p hp => (validChunk288 p hp).1.2))
