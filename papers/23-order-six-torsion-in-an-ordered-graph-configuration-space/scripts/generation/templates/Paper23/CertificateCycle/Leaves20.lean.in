import Paper23.CertificateSparse
import Paper23.CertificateChecks
set_option maxRecDepth 100000
set_option maxHeartbeats 0
namespace Paper23.CertificateChecks
open Cubical CertificateData
noncomputable def cycleLeaf320 : List (ℕ × ℤ) := @@GENERATED_RHS:cycleLeaf320@@
theorem cycleLeaf320_check :
    collapse 10 ((codeDifferential zEntries320).map (fun p => [p])) = [cycleLeaf320] := by decide +kernel
 theorem cycleLeaf320_chain : codeChain cycleLeaf320 = boundary (codeChain zEntries320) := by
  exact (normalization_sound 10 (codeDifferential zEntries320) cycleLeaf320 cycleLeaf320_check).trans
    (codeChain_codeDifferential zEntries320 (fun p hp => (validChunk320 p hp).1.2))
