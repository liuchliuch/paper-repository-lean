import Paper23.CertificateSparse
import Paper23.CertificateChecks
set_option maxRecDepth 100000
set_option maxHeartbeats 0
namespace Paper23.CertificateChecks
open Cubical CertificateData
noncomputable def cycleLeaf208 : List (ℕ × ℤ) := @@GENERATED_RHS:cycleLeaf208@@
theorem cycleLeaf208_check :
    collapse 10 ((codeDifferential zEntries208).map (fun p => [p])) = [cycleLeaf208] := by decide +kernel
 theorem cycleLeaf208_chain : codeChain cycleLeaf208 = boundary (codeChain zEntries208) := by
  exact (normalization_sound 10 (codeDifferential zEntries208) cycleLeaf208 cycleLeaf208_check).trans
    (codeChain_codeDifferential zEntries208 (fun p hp => (validChunk208 p hp).1.2))
