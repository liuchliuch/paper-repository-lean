import Paper23.CertificateSparse
import Paper23.CertificateChecks
set_option maxRecDepth 100000
set_option maxHeartbeats 0
namespace Paper23.CertificateChecks
open Cubical CertificateData
noncomputable def cycleLeaf192 : List (ℕ × ℤ) := @@GENERATED_RHS:cycleLeaf192@@
theorem cycleLeaf192_check :
    collapse 10 ((codeDifferential zEntries192).map (fun p => [p])) = [cycleLeaf192] := by decide +kernel
 theorem cycleLeaf192_chain : codeChain cycleLeaf192 = boundary (codeChain zEntries192) := by
  exact (normalization_sound 10 (codeDifferential zEntries192) cycleLeaf192 cycleLeaf192_check).trans
    (codeChain_codeDifferential zEntries192 (fun p hp => (validChunk192 p hp).1.2))
