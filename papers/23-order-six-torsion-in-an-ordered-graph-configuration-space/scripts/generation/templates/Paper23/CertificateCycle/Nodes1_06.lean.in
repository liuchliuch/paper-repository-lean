noncomputable def cycleNode1_96 : List (ℕ × ℤ) := cycleNode1_96Part0 ++ cycleNode1_96Part1
noncomputable def cycleSource1_96 : RawChain := codeChain zEntries192 + codeChain zEntries193
theorem cycleNode1_96_check : merge cycleLeaf192 cycleLeaf193 = cycleNode1_96 := by decide +kernel
