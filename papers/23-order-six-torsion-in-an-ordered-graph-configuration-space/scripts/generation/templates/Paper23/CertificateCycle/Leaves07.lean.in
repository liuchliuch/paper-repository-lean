import Paper23.CertificateSparse
import Paper23.CertificateChecks
set_option maxRecDepth 100000
set_option maxHeartbeats 0
namespace Paper23.CertificateChecks
open Cubical CertificateData
noncomputable def cycleLeaf112 : List (ℕ × ℤ) := @@GENERATED_RHS:cycleLeaf112@@
theorem cycleLeaf112_check :
    collapse 10 ((codeDifferential zEntries112).map (fun p => [p])) = [cycleLeaf112] := by decide +kernel
 theorem cycleLeaf112_chain : codeChain cycleLeaf112 = boundary (codeChain zEntries112) := by
  exact (normalization_sound 10 (codeDifferential zEntries112) cycleLeaf112 cycleLeaf112_check).trans
    (codeChain_codeDifferential zEntries112 (fun p hp => (validChunk112 p hp).1.2))
