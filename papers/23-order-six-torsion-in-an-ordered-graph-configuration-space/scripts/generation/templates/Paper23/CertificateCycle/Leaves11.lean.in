import Paper23.CertificateSparse
import Paper23.CertificateChecks
set_option maxRecDepth 100000
set_option maxHeartbeats 0
namespace Paper23.CertificateChecks
open Cubical CertificateData
noncomputable def cycleLeaf176 : List (ℕ × ℤ) := @@GENERATED_RHS:cycleLeaf176@@
theorem cycleLeaf176_check :
    collapse 10 ((codeDifferential zEntries176).map (fun p => [p])) = [cycleLeaf176] := by decide +kernel
 theorem cycleLeaf176_chain : codeChain cycleLeaf176 = boundary (codeChain zEntries176) := by
  exact (normalization_sound 10 (codeDifferential zEntries176) cycleLeaf176 cycleLeaf176_check).trans
    (codeChain_codeDifferential zEntries176 (fun p hp => (validChunk176 p hp).1.2))
