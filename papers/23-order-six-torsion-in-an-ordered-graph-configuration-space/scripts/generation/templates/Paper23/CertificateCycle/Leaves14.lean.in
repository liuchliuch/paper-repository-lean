import Paper23.CertificateSparse
import Paper23.CertificateChecks
set_option maxRecDepth 100000
set_option maxHeartbeats 0
namespace Paper23.CertificateChecks
open Cubical CertificateData
noncomputable def cycleLeaf224 : List (ℕ × ℤ) := @@GENERATED_RHS:cycleLeaf224@@
theorem cycleLeaf224_check :
    collapse 10 ((codeDifferential zEntries224).map (fun p => [p])) = [cycleLeaf224] := by decide +kernel
 theorem cycleLeaf224_chain : codeChain cycleLeaf224 = boundary (codeChain zEntries224) := by
  exact (normalization_sound 10 (codeDifferential zEntries224) cycleLeaf224 cycleLeaf224_check).trans
    (codeChain_codeDifferential zEntries224 (fun p hp => (validChunk224 p hp).1.2))
