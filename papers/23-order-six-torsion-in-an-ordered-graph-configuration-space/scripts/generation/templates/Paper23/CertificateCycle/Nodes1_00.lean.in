noncomputable def cycleNode1_0Part0 : List (ℕ × ℤ) := @@GENERATED_RHS:cycleNode1_0Part0@@
noncomputable def cycleNode1_0Part1 : List (ℕ × ℤ) := @@GENERATED_RHS:cycleNode1_0Part1@@
noncomputable def cycleNode1_0 : List (ℕ × ℤ) := cycleNode1_0Part0 ++ cycleNode1_0Part1
noncomputable def cycleSource1_0 : RawChain := codeChain zEntries0 + codeChain zEntries1
theorem cycleNode1_0_check : merge cycleLeaf0 cycleLeaf1 = cycleNode1_0 := by decide +kernel
 theorem cycleNode1_0_chain : codeChain cycleNode1_0 = boundary cycleSource1_0 := by
  rw [← cycleNode1_0_check, codeChain_merge, cycleLeaf0_chain, cycleLeaf1_chain]
  exact (map_add boundary _ _).symm
