import Paper23.CertificateSparse
import Paper23.CertificateChecks
set_option maxRecDepth 100000
set_option maxHeartbeats 0
namespace Paper23.CertificateChecks
open Cubical CertificateData
noncomputable def cycleLeaf368 : List (ℕ × ℤ) := @@GENERATED_RHS:cycleLeaf368@@
theorem cycleLeaf368_check :
    collapse 10 ((codeDifferential zEntries368).map (fun p => [p])) = [cycleLeaf368] := by decide +kernel
 theorem cycleLeaf368_chain : codeChain cycleLeaf368 = boundary (codeChain zEntries368) := by
  exact (normalization_sound 10 (codeDifferential zEntries368) cycleLeaf368 cycleLeaf368_check).trans
    (codeChain_codeDifferential zEntries368 (fun p hp => (validChunk368 p hp).1.2))
