noncomputable def cycleNode1_128Part1 : List (ℕ × ℤ) := @@GENERATED_RHS:cycleNode1_128Part1@@
noncomputable def cycleNode1_128 : List (ℕ × ℤ) := cycleNode1_128Part0 ++ cycleNode1_128Part1
noncomputable def cycleSource1_128 : RawChain := codeChain zEntries256 + codeChain zEntries257
theorem cycleNode1_128_check : merge cycleLeaf256 cycleLeaf257 = cycleNode1_128 := by decide +kernel
 theorem cycleNode1_128_chain : codeChain cycleNode1_128 = boundary cycleSource1_128 := by
  rw [← cycleNode1_128_check, codeChain_merge, cycleLeaf256_chain, cycleLeaf257_chain]
  exact (map_add boundary _ _).symm
