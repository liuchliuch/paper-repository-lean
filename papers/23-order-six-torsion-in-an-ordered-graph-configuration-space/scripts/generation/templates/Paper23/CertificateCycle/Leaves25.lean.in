import Paper23.CertificateSparse
import Paper23.CertificateChecks
set_option maxRecDepth 100000
set_option maxHeartbeats 0
namespace Paper23.CertificateChecks
open Cubical CertificateData
noncomputable def cycleLeaf400 : List (ℕ × ℤ) := @@GENERATED_RHS:cycleLeaf400@@
theorem cycleLeaf400_check :
    collapse 10 ((codeDifferential zEntries400).map (fun p => [p])) = [cycleLeaf400] := by decide +kernel
 theorem cycleLeaf400_chain : codeChain cycleLeaf400 = boundary (codeChain zEntries400) := by
  exact (normalization_sound 10 (codeDifferential zEntries400) cycleLeaf400 cycleLeaf400_check).trans
    (codeChain_codeDifferential zEntries400 (fun p hp => (validChunk400 p hp).1.2))
