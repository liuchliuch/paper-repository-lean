import Paper23.CertificateSparse
import Paper23.CertificateChecks
set_option maxRecDepth 100000
set_option maxHeartbeats 0
namespace Paper23.CertificateChecks
open Cubical CertificateData
noncomputable def cycleLeaf144 : List (ℕ × ℤ) := @@GENERATED_RHS:cycleLeaf144@@
theorem cycleLeaf144_check :
    collapse 10 ((codeDifferential zEntries144).map (fun p => [p])) = [cycleLeaf144] := by decide +kernel
 theorem cycleLeaf144_chain : codeChain cycleLeaf144 = boundary (codeChain zEntries144) := by
  exact (normalization_sound 10 (codeDifferential zEntries144) cycleLeaf144 cycleLeaf144_check).trans
    (codeChain_codeDifferential zEntries144 (fun p hp => (validChunk144 p hp).1.2))
