import Paper23.CertificateSparse
import Paper23.CertificateChecks
set_option maxRecDepth 100000
set_option maxHeartbeats 0
namespace Paper23.CertificateChecks
open Cubical CertificateData
noncomputable def cycleLeaf16 : List (ℕ × ℤ) := @@GENERATED_RHS:cycleLeaf16@@
theorem cycleLeaf16_check :
    collapse 10 ((codeDifferential zEntries16).map (fun p => [p])) = [cycleLeaf16] := by decide +kernel
 theorem cycleLeaf16_chain : codeChain cycleLeaf16 = boundary (codeChain zEntries16) := by
  exact (normalization_sound 10 (codeDifferential zEntries16) cycleLeaf16 cycleLeaf16_check).trans
    (codeChain_codeDifferential zEntries16 (fun p hp => (validChunk16 p hp).1.2))
