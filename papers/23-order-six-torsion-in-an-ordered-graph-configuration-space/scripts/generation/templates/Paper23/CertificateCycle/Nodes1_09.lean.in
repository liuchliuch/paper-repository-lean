noncomputable def cycleNode1_144 : List (ℕ × ℤ) := cycleNode1_144Part0 ++ cycleNode1_144Part1
noncomputable def cycleSource1_144 : RawChain := codeChain zEntries288 + codeChain zEntries289
theorem cycleNode1_144_check : merge cycleLeaf288 cycleLeaf289 = cycleNode1_144 := by decide +kernel
 theorem cycleNode1_144_chain : codeChain cycleNode1_144 = boundary cycleSource1_144 := by
  rw [← cycleNode1_144_check, codeChain_merge, cycleLeaf288_chain, cycleLeaf289_chain]
  exact (map_add boundary _ _).symm
