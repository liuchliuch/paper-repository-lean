import Paper23.CertificateSparse
import Paper23.CertificateChecks
set_option maxRecDepth 100000
set_option maxHeartbeats 0
namespace Paper23.CertificateChecks
open Cubical CertificateData
noncomputable def cycleLeaf48 : List (ℕ × ℤ) := @@GENERATED_RHS:cycleLeaf48@@
theorem cycleLeaf48_check :
    collapse 10 ((codeDifferential zEntries48).map (fun p => [p])) = [cycleLeaf48] := by decide +kernel
 theorem cycleLeaf48_chain : codeChain cycleLeaf48 = boundary (codeChain zEntries48) := by
  exact (normalization_sound 10 (codeDifferential zEntries48) cycleLeaf48 cycleLeaf48_check).trans
    (codeChain_codeDifferential zEntries48 (fun p hp => (validChunk48 p hp).1.2))
