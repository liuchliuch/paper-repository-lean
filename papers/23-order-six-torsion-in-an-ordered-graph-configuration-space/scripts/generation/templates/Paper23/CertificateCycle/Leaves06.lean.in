import Paper23.CertificateSparse
import Paper23.CertificateChecks
set_option maxRecDepth 100000
set_option maxHeartbeats 0
namespace Paper23.CertificateChecks
open Cubical CertificateData
noncomputable def cycleLeaf96 : List (ℕ × ℤ) := @@GENERATED_RHS:cycleLeaf96@@
theorem cycleLeaf96_check :
    collapse 10 ((codeDifferential zEntries96).map (fun p => [p])) = [cycleLeaf96] := by decide +kernel
 theorem cycleLeaf96_chain : codeChain cycleLeaf96 = boundary (codeChain zEntries96) := by
  exact (normalization_sound 10 (codeDifferential zEntries96) cycleLeaf96 cycleLeaf96_check).trans
    (codeChain_codeDifferential zEntries96 (fun p hp => (validChunk96 p hp).1.2))
