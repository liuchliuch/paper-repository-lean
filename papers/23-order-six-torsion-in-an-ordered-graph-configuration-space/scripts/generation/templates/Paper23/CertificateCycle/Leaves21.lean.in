import Paper23.CertificateSparse
import Paper23.CertificateChecks
set_option maxRecDepth 100000
set_option maxHeartbeats 0
namespace Paper23.CertificateChecks
open Cubical CertificateData
noncomputable def cycleLeaf336 : List (ℕ × ℤ) := @@GENERATED_RHS:cycleLeaf336@@
theorem cycleLeaf336_check :
    collapse 10 ((codeDifferential zEntries336).map (fun p => [p])) = [cycleLeaf336] := by decide +kernel
 theorem cycleLeaf336_chain : codeChain cycleLeaf336 = boundary (codeChain zEntries336) := by
  exact (normalization_sound 10 (codeDifferential zEntries336) cycleLeaf336 cycleLeaf336_check).trans
    (codeChain_codeDifferential zEntries336 (fun p hp => (validChunk336 p hp).1.2))
