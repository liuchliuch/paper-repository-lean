import Paper23.CertificateSparse
import Paper23.CertificateChecks
set_option maxRecDepth 100000
set_option maxHeartbeats 0
namespace Paper23.CertificateChecks
open Cubical CertificateData
noncomputable def cycleLeaf272 : List (ℕ × ℤ) := @@GENERATED_RHS:cycleLeaf272@@
theorem cycleLeaf272_check :
    collapse 10 ((codeDifferential zEntries272).map (fun p => [p])) = [cycleLeaf272] := by decide +kernel
 theorem cycleLeaf272_chain : codeChain cycleLeaf272 = boundary (codeChain zEntries272) := by
  exact (normalization_sound 10 (codeDifferential zEntries272) cycleLeaf272 cycleLeaf272_check).trans
    (codeChain_codeDifferential zEntries272 (fun p hp => (validChunk272 p hp).1.2))
