noncomputable def cycleNode1_64 : List (ℕ × ℤ) := cycleNode1_64Part0 ++ cycleNode1_64Part1
noncomputable def cycleSource1_64 : RawChain := codeChain zEntries128 + codeChain zEntries129
theorem cycleNode1_64_check : merge cycleLeaf128 cycleLeaf129 = cycleNode1_64 := by decide +kernel
