import Paper23.CertificateSparse
import Paper23.CertificateChecks
set_option maxRecDepth 100000
set_option maxHeartbeats 0
namespace Paper23.CertificateChecks
open Cubical CertificateData
noncomputable def cycleLeaf240 : List (ℕ × ℤ) := @@GENERATED_RHS:cycleLeaf240@@
theorem cycleLeaf240_check :
    collapse 10 ((codeDifferential zEntries240).map (fun p => [p])) = [cycleLeaf240] := by decide +kernel
 theorem cycleLeaf240_chain : codeChain cycleLeaf240 = boundary (codeChain zEntries240) := by
  exact (normalization_sound 10 (codeDifferential zEntries240) cycleLeaf240 cycleLeaf240_check).trans
    (codeChain_codeDifferential zEntries240 (fun p hp => (validChunk240 p hp).1.2))
