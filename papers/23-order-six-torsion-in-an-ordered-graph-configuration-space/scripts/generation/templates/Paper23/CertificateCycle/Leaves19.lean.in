import Paper23.CertificateSparse
import Paper23.CertificateChecks
set_option maxRecDepth 100000
set_option maxHeartbeats 0
namespace Paper23.CertificateChecks
open Cubical CertificateData
noncomputable def cycleLeaf304 : List (ℕ × ℤ) := @@GENERATED_RHS:cycleLeaf304@@
theorem cycleLeaf304_check :
    collapse 10 ((codeDifferential zEntries304).map (fun p => [p])) = [cycleLeaf304] := by decide +kernel
 theorem cycleLeaf304_chain : codeChain cycleLeaf304 = boundary (codeChain zEntries304) := by
  exact (normalization_sound 10 (codeDifferential zEntries304) cycleLeaf304 cycleLeaf304_check).trans
    (codeChain_codeDifferential zEntries304 (fun p hp => (validChunk304 p hp).1.2))
