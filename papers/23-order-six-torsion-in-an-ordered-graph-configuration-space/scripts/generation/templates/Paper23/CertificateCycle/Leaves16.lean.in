import Paper23.CertificateSparse
import Paper23.CertificateChecks
set_option maxRecDepth 100000
set_option maxHeartbeats 0
namespace Paper23.CertificateChecks
open Cubical CertificateData
noncomputable def cycleLeaf256 : List (ℕ × ℤ) := @@GENERATED_RHS:cycleLeaf256@@
theorem cycleLeaf256_check :
    collapse 10 ((codeDifferential zEntries256).map (fun p => [p])) = [cycleLeaf256] := by decide +kernel
 theorem cycleLeaf256_chain : codeChain cycleLeaf256 = boundary (codeChain zEntries256) := by
  exact (normalization_sound 10 (codeDifferential zEntries256) cycleLeaf256 cycleLeaf256_check).trans
    (codeChain_codeDifferential zEntries256 (fun p hp => (validChunk256 p hp).1.2))
