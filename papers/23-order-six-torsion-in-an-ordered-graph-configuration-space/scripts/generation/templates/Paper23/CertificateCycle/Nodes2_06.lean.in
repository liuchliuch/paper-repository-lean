noncomputable def cycleNode2_96 : List (ℕ × ℤ) := cycleNode2_96Part0 ++ cycleNode2_96Part1 ++ cycleNode2_96Part2 ++ cycleNode2_96Part3
noncomputable def cycleSource2_96 : RawChain := cycleSource1_192 + cycleSource1_193
theorem cycleNode2_96_check : merge cycleNode1_192 cycleNode1_193 = cycleNode2_96 := by decide +kernel
 theorem cycleNode2_96_chain : codeChain cycleNode2_96 = boundary cycleSource2_96 := by
  rw [← cycleNode2_96_check, codeChain_merge, cycleNode1_192_chain, cycleNode1_193_chain]
  exact (map_add boundary _ _).symm
