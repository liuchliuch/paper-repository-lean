import Paper23.CertificateSparse
import Paper23.CertificateChecks
set_option maxRecDepth 100000
set_option maxHeartbeats 0
namespace Paper23.CertificateChecks
open Cubical CertificateData
noncomputable def cycleLeaf352 : List (ℕ × ℤ) := @@GENERATED_RHS:cycleLeaf352@@
theorem cycleLeaf352_check :
    collapse 10 ((codeDifferential zEntries352).map (fun p => [p])) = [cycleLeaf352] := by decide +kernel
 theorem cycleLeaf352_chain : codeChain cycleLeaf352 = boundary (codeChain zEntries352) := by
  exact (normalization_sound 10 (codeDifferential zEntries352) cycleLeaf352 cycleLeaf352_check).trans
    (codeChain_codeDifferential zEntries352 (fun p hp => (validChunk352 p hp).1.2))
