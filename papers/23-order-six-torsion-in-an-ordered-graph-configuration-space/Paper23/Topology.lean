import Mathlib.AlgebraicTopology.SingularHomology.Basic
import Mathlib.Algebra.Category.ModuleCat.Abelian
import Mathlib.Algebra.Category.ModuleCat.Colimits
import Mathlib.Topology.UnitInterval
import Mathlib.Topology.Homeomorph.Lemmas
import Mathlib.GroupTheory.OrderOfElement

/-!
# The source topological objects of P23

An edge is an independent element of `E`.  In particular, parallel edges are
not identified.  Its geometric realization is the quotient of the disjoint
union of the vertices and closed real unit intervals, one per edge, by the
endpoint attaching relation.  Ordered configurations carry the subspace
topology from the product.  The homology used below is mathlib's singular
homology with integral coefficients, rather than a finite matrix quotient.

This file supplies definitions and elementary functoriality only.  It does
not assert the discretization theorem, a cellular/singular comparison, or the
existence of the order-six class.
-/

namespace Paper23

/-- Oriented incidence data.  Distinct edges may have identical endpoints. -/
structure GraphIncidence (V E : Type) where
  source : E → V
  target : E → V

namespace GraphIncidence

variable {V E : Type} (G : GraphIncidence V E)

/-- The disjoint union before gluing endpoints. -/
abbrev PreRealization (_G : GraphIncidence V E) := V ⊕ (E × unitInterval)

/-- Only the endpoint of an edge is attached to its incident vertex. -/
def Attaching : G.PreRealization → G.PreRealization → Prop := fun x y ↦
  (∃ e, x = Sum.inr (e, 0) ∧ y = Sum.inl (G.source e)) ∨
  (∃ e, x = Sum.inr (e, 1) ∧ y = Sum.inl (G.target e))

/-- Endpoint gluing is the equivalence relation generated by `Attaching`. -/
def realizationSetoid : Setoid G.PreRealization := Relation.EqvGen.setoid G.Attaching

/-- The usual geometric realization of an incidence graph. -/
def Realization := Quotient G.realizationSetoid

instance [TopologicalSpace V] [TopologicalSpace E] : TopologicalSpace G.Realization :=
  inferInstanceAs (TopologicalSpace (Quotient G.realizationSetoid))

/-- Vertex as a point of the quotient realization. -/
def vertex (v : V) : G.Realization := Quotient.mk _ (Sum.inl v)

/-- The characteristic interval of an oriented edge. -/
def edge (e : E) (t : unitInterval) : G.Realization := Quotient.mk _ (Sum.inr (e, t))

@[simp] theorem edge_zero (e : E) : G.edge e 0 = G.vertex (G.source e) := by
  apply Quotient.sound
  exact Relation.EqvGen.rel _ _ (Or.inl ⟨e, rfl, rfl⟩)

@[simp] theorem edge_one (e : E) : G.edge e 1 = G.vertex (G.target e) := by
  apply Quotient.sound
  exact Relation.EqvGen.rel _ _ (Or.inr ⟨e, rfl, rfl⟩)

theorem continuous_vertex [TopologicalSpace V] [TopologicalSpace E] :
    Continuous G.vertex := continuous_quotient_mk'.comp continuous_inl

theorem continuous_edge [TopologicalSpace V] [TopologicalSpace E] (e : E) :
    Continuous (G.edge e) :=
  continuous_quotient_mk'.comp (continuous_inr.comp (continuous_const.prodMk continuous_id))

/-- A set theoretic normal form retaining all interior edge points. -/
noncomputable def normalize : G.PreRealization → G.PreRealization
  | Sum.inl v => Sum.inl v
  | Sum.inr (e, t) =>
      if t = 0 then Sum.inl (G.source e)
      else if t = 1 then Sum.inl (G.target e)
      else Sum.inr (e, t)

theorem normalize_attaching {x y : G.PreRealization} (h : G.Attaching x y) :
    G.normalize x = G.normalize y := by
  rcases h with ⟨e, rfl, rfl⟩ | ⟨e, rfl, rfl⟩ <;> simp [normalize]

theorem normalize_equivalent {x y : G.PreRealization}
    (h : G.realizationSetoid x y) : G.normalize x = G.normalize y := by
  induction h with
  | rel x y h => exact G.normalize_attaching h
  | refl x => rfl
  | symm x y _ ih => exact ih.symm
  | trans x y z _ _ hxy hyz => exact hxy.trans hyz

/-- Gluing endpoints does not collapse distinct original vertices. -/
theorem vertex_injective : Function.Injective G.vertex := by
  intro v w h
  have heq := G.normalize_equivalent (Quotient.exact h)
  exact Sum.inl.inj heq

/-- Interior edge points keep both their edge identity and real coordinate. -/
theorem interior_edge_eq_iff (e f : E) (s t : unitInterval)
    (hs0 : s ≠ 0) (hs1 : s ≠ 1) (ht0 : t ≠ 0) (ht1 : t ≠ 1) :
    G.edge e s = G.edge f t ↔ e = f ∧ s = t := by
  constructor
  · intro h
    have heq := G.normalize_equivalent (Quotient.exact h)
    simp only [normalize, hs0, hs1, ht0, ht1, if_false] at heq
    exact Prod.mk.inj (Sum.inr.inj heq)
  · rintro ⟨rfl, rfl⟩
    rfl

/-- An interior point of an edge is never identified with a graph vertex. -/
theorem interior_edge_ne_vertex (e : E) (t : unitInterval) (ht0 : t ≠ 0) (ht1 : t ≠ 1)
    (v : V) : G.edge e t ≠ G.vertex v := by
  intro h
  have heq := G.normalize_equivalent (Quotient.exact h)
  simp only [normalize, ht0, ht1, if_false] at heq
  exact Sum.noConfusion heq

/-- The zero and one dimensional open cells of a graph. -/
abbrev Cell (_G : GraphIncidence V E) := V ⊕ E

/-- The closed characteristic carrier of a cell. -/
def closedCarrier : G.Cell → Set G.Realization
  | Sum.inl v => {G.vertex v}
  | Sum.inr e => Set.range (G.edge e)

/-- The open cell carrier; edge endpoints are excluded. -/
def openCarrier : G.Cell → Set G.Realization
  | Sum.inl v => {G.vertex v}
  | Sum.inr e => G.edge e '' Set.Ioo 0 1

theorem openCarrier_subset_closedCarrier (c : G.Cell) :
    G.openCarrier c ⊆ G.closedCarrier c := by
  cases c with
  | inl v => exact Set.Subset.rfl
  | inr e =>
    rintro _ ⟨t, _, rfl⟩
    exact ⟨t, rfl⟩

/-- Vertices in the closure of a graph cell, retaining its incidence data. -/
def cellVertices : G.Cell → Set V
  | Sum.inl v => {v}
  | Sum.inr e => {G.source e, G.target e}

/-- A set theoretic selection of an endpoint, used only to detect intersections.
No continuity is asserted or needed for this selection. -/
noncomputable def selectRawVertex : G.PreRealization → V
  | Sum.inl v => v
  | Sum.inr (e, t) => if t = 1 then G.target e else G.source e

theorem selectRawVertex_attaching {x y : G.PreRealization} (h : G.Attaching x y) :
    G.selectRawVertex x = G.selectRawVertex y := by
  rcases h with ⟨e, rfl, rfl⟩ | ⟨e, rfl, rfl⟩ <;> simp [selectRawVertex]

theorem selectRawVertex_equivalent {x y : G.PreRealization}
    (h : G.realizationSetoid x y) : G.selectRawVertex x = G.selectRawVertex y := by
  induction h with
  | rel x y h => exact G.selectRawVertex_attaching h
  | refl x => rfl
  | symm x y _ ih => exact ih.symm
  | trans x y z _ _ hxy hyz => exact hxy.trans hyz

/-- An arbitrary incident vertex associated with every realized point. -/
noncomputable def selectVertex : G.Realization → V :=
  Quotient.lift G.selectRawVertex fun _ _ h ↦ G.selectRawVertex_equivalent h

theorem selectVertex_mem_cellVertices {c : G.Cell} {x : G.Realization}
    (hx : x ∈ G.closedCarrier c) : G.selectVertex x ∈ G.cellVertices c := by
  cases c with
  | inl v =>
    have hx' : x = G.vertex v := hx
    subst x
    exact Set.mem_singleton v
  | inr e =>
    rcases hx with ⟨t, rfl⟩
    change (if t = 1 then G.target e else G.source e) ∈ {G.source e, G.target e}
    split_ifs <;> simp

theorem vertex_mem_closedCarrier {c : G.Cell} {v : V}
    (hv : v ∈ G.cellVertices c) : G.vertex v ∈ G.closedCarrier c := by
  cases c with
  | inl w =>
    have hv' : v = w := hv
    subst v
    exact Set.mem_singleton _
  | inr e =>
    simp only [cellVertices, Set.mem_insert_iff, Set.mem_singleton_iff] at hv
    rcases hv with rfl | rfl
    · exact ⟨0, G.edge_zero e⟩
    · exact ⟨1, G.edge_one e⟩

/-- The combinatorial disjointness test used by the certificate is exactly
disjointness of the closed characteristic carriers in the quotient graph. -/
theorem closedCarrier_disjoint_iff (c d : G.Cell) :
    Disjoint (G.closedCarrier c) (G.closedCarrier d) ↔
      Disjoint (G.cellVertices c) (G.cellVertices d) := by
  constructor
  · intro h
    apply Set.disjoint_left.2
    intro v hv hw
    exact Set.disjoint_left.mp h (G.vertex_mem_closedCarrier hv)
      (G.vertex_mem_closedCarrier hw)
  · intro h
    apply Set.disjoint_left.2
    intro x hx hy
    exact Set.disjoint_left.mp h (G.selectVertex_mem_cellVertices hx)
      (G.selectVertex_mem_cellVertices hy)

end GraphIncidence

/-- Ordered configurations: labelled, pairwise distinct points of `X`. -/
def OrderedConfiguration (n : ℕ) (X : Type) :=
  {x : Fin n → X // Function.Injective x}

instance {n : ℕ} {X : Type} [TopologicalSpace X] :
    TopologicalSpace (OrderedConfiguration n X) :=
  inferInstanceAs (TopologicalSpace {x : Fin n → X // Function.Injective x})

namespace OrderedConfiguration

variable {n : ℕ} {X Y : Type} [TopologicalSpace X] [TopologicalSpace Y]

/-- Homeomorphisms preserve the original, ordered configuration space. -/
def homeomorph (h : X ≃ₜ Y) : OrderedConfiguration n X ≃ₜ OrderedConfiguration n Y :=
  (Homeomorph.piCongrRight fun _ : Fin n ↦ h).subtype fun x ↦ by
    change Function.Injective x ↔ Function.Injective (fun i ↦ h (x i))
    constructor
    · intro hx
      exact h.injective.comp hx
    · intro hx i j hij
      exact hx (congrArg h hij)

end OrderedConfiguration

namespace GraphIncidence

variable {V E : Type} (G : GraphIncidence V E) (n : ℕ)

/-- The defining cell condition of the ordered discretized space `Dₙ(G)`. -/
def IsDiscretized (x : Fin n → G.Realization) : Prop :=
  ∃ c : Fin n → G.Cell,
    (∀ i j, i ≠ j → Disjoint (G.closedCarrier (c i)) (G.closedCarrier (c j))) ∧
    ∀ i, x i ∈ G.openCarrier (c i)

theorem isDiscretized_injective {x : Fin n → G.Realization}
    (hx : G.IsDiscretized n x) : Function.Injective x := by
  rcases hx with ⟨c, hc, hm⟩
  intro i j hij
  by_contra hne
  have hi := G.openCarrier_subset_closedCarrier (c i) (hm i)
  have hj := G.openCarrier_subset_closedCarrier (c j) (hm j)
  exact Set.disjoint_left.mp (hc i j hne) hi (hij ▸ hj)

/-- The actual subspace of the product specified by pairwise disjoint cells. -/
def DiscretizedConfiguration := {x : Fin n → G.Realization // G.IsDiscretized n x}

instance [TopologicalSpace V] [TopologicalSpace E] :
    TopologicalSpace (G.DiscretizedConfiguration n) :=
  inferInstanceAs (TopologicalSpace {x : Fin n → G.Realization // G.IsDiscretized n x})

/-- The canonical inclusion of the discretized space into ordered configurations. -/
def discretizedInclusion : G.DiscretizedConfiguration n → OrderedConfiguration n G.Realization :=
  fun x ↦ ⟨x.val, G.isDiscretized_injective n x.property⟩

theorem discretizedInclusion_injective : Function.Injective (G.discretizedInclusion n) := by
  intro x y h
  exact Subtype.ext (congrArg (fun z : OrderedConfiguration n G.Realization ↦ z.val) h)

theorem continuous_discretizedInclusion [TopologicalSpace V] [TopologicalSpace E] :
    Continuous (G.discretizedInclusion n) :=
  continuous_subtype_val.subtype_mk _

/-- The inclusion has exactly the product subspace topology. -/
theorem isEmbedding_discretizedInclusion [TopologicalSpace V] [TopologicalSpace E] :
    Topology.IsEmbedding (G.discretizedInclusion n) := by
  have hv : Topology.IsEmbedding
      (fun x : OrderedConfiguration n G.Realization ↦ x.val) :=
    Topology.IsEmbedding.subtypeVal
  apply hv.of_comp_iff.mp
  change Topology.IsEmbedding (fun x : G.DiscretizedConfiguration n ↦ x.val)
  exact Topology.IsEmbedding.subtypeVal

end GraphIncidence

/-- Integral singular homology of the specified topological space. -/
noncomputable def IntegralHomology (q : ℕ) (X : Type) [TopologicalSpace X] : ModuleCat ℤ :=
  ((AlgebraicTopology.singularHomologyFunctor (ModuleCat ℤ) q).obj
    (ModuleCat.of ℤ ℤ)).obj (TopCat.of X)

/-- Homeomorphic source spaces have isomorphic integral singular homology. -/
noncomputable def integralHomologyHomeomorph {X Y : Type}
    [TopologicalSpace X] [TopologicalSpace Y] (q : ℕ) (h : X ≃ₜ Y) :
    IntegralHomology q X ≅ IntegralHomology q Y :=
  ((AlgebraicTopology.singularHomologyFunctor (ModuleCat ℤ) q).obj
    (ModuleCat.of ℤ ℤ)).mapIso (TopCat.isoOfHomeo h)

/-- The precise singular-homology conclusion of the paper for incidence data `G`.
This is only the theorem's target proposition, not an assumed or proved result. -/
def HasOrderSixConfigurationClass {V E : Type} [TopologicalSpace V] [TopologicalSpace E]
    (G : GraphIncidence V E) : Prop :=
  ∃ z : IntegralHomology 2 (OrderedConfiguration 4 G.Realization), addOrderOf z = 6

end Paper23
