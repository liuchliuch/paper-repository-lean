/-- The imported detector annihilates boundaries of every original three-chain. -/
theorem cocycle (x : RawChain) (hx : x ∈ Chains 3) : phi (boundary x) = 0 :=
  cocycle_of_modular_transpose projected_transpose_zero x hx

