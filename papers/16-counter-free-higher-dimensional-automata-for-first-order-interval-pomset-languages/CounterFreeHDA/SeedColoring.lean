import CounterFreeHDA.ActualRecognizer
import CounterFreeHDA.IdealExtension

/-! Least colouring generated by the identity value at one actual cell.
Its initial membership needs only the zero-length path; no path-existence
or recognition conclusion is assumed. -/
namespace CounterFreeHDA.Cubical
universe u v w
variable {Lab : Type u} {k : ℕ} (C : FinCat.{u,v} (Cube Lab k)) (ord : C.IsOrdered)
    (image : ∀ {U V}, Step U V → C.Hom U V)
    (X : Precubical.{u,w} Lab k) {S : Cube Lab k} (x₀ : X.Cell S)

/-- Equation (11) with seed ideal down(id), simplified using the identity law. -/
def seedColor {U} (x : X.Cell U) : Set (C.Hom S U) :=
  {a | ∃ p : Word S U, X.Run p x₀ x ∧ ord.homLE a (wordImage C image p)}

def seedColoring : Coloring C ord image X S where
  val := seedColor C ord image X x₀
  lower := by
    rintro U x a b ⟨p,hr,ha⟩ hba
    exact ⟨p,hr,ord.homLE_trans hba ha⟩
  start f hl hd x := by
    intro a ha
    obtain ⟨b,⟨p,hr,hb⟩,hab⟩ := (LowerSetAction.mem_act ord).mp ha
    let q : Word _ _ := .cons (.start f hl hd) (.nil _)
    have hq : X.Run q (X.face f x) x := .start f hl hd (.nil x)
    refine ⟨p.append q,(X.run_append_iff p q x₀ x).mpr ⟨_,hr,hq⟩,?_⟩
    have hm := ord.homLE_trans hab (ord.comp_mono_left b (wordImage C image p) (image (.start f hl hd)) hb)
    simpa only [wordImage_append,q,wordImage,C.comp_id] using hm
  stop f hu hd x := by
    intro a ha
    obtain ⟨b,⟨p,hr,hb⟩,hab⟩ := (LowerSetAction.mem_act ord).mp ha
    let q : Word _ _ := .cons (.stop f hu hd) (.nil _)
    have hq : X.Run q x (X.face f x) := .stop f hu hd (.nil _)
    refine ⟨p.append q,(X.run_append_iff p q x₀ _).mpr ⟨_,hr,hq⟩,?_⟩
    have hm := ord.homLE_trans hab (ord.comp_mono_left b (wordImage C image p) (image (.stop f hu hd)) hb)
    simpa only [wordImage_append,q,wordImage,C.comp_id] using hm

noncomputable def seedMap : Map X (ideal C ord image S) := (seedColoring C ord image X x₀).toMap

theorem seedMap_top {U} (x : X.Cell U) :
    ((seedMap C ord image X x₀).app x).top = seedColor C ord image X x₀ x := by
  change seedColor C ord image X x₀ (X.face (Face.ident U) x) = _
  rw [X.face_ident]

theorem seedMap_initial : C.id S ∈ ((seedMap C ord image X x₀).app x₀).top := by
  rw [seedMap_top]
  exact ⟨.nil S,.nil x₀,ord.homLE_refl _⟩

namespace OrderedPomsetRecognizer
variable {L : Set (IntervalPom Lab)} {h : ℕ} (F : OrderedPomsetRecognizer.{u,v} (k := k) L h)

noncomputable def stepImage {U V : Cube Lab k} (s : Step U V) : F.C.Hom U V := F.map (BoundedArrow.ofStep s)

theorem wordImage_eq {U V : Cube Lab k} (p : Word U V) :
    wordImage F.C F.stepImage p = F.map (BoundedArrow.ofWord p) := by
  induction p with
  | nil U => exact (F.map_id U).symm
  | cons s p ih =>
    change F.C.comp (F.stepImage s) (wordImage F.C F.stepImage p) = _
    rw [ih]
    exact (F.map_comp (BoundedArrow.ofStep s) (BoundedArrow.ofWord p)).symm

/-- At the actual target, every generated colour lies below F(P), by the
proved full characteristic language theorem. -/
theorem seedMap_final {U V : Cube Lab k} (A : BoundedArrow U V) :
    ((seedMap F.C F.order F.stepImage (track A.pom.val) A.toArrow.sourceCell).app A.toArrow.targetCell).top ⊆
      {a | F.order.homLE a (F.map A)} := by
  rw [seedMap_top]
  rintro a ⟨p,hr,ha⟩
  have hsub := RunLabeling.subsumption_complete A.toArrow p hr
  have hm := F.monotone (BoundedArrow.ofWord p) A hsub
  exact F.order.homLE_trans ha (by simpa only [F.wordImage_eq] using hm)

/-- If P is in L, the concrete seed colouring has an accepting target. -/
theorem seedMap_accepting {U V : Cube Lab k} (A : BoundedArrow U V) (ha : A.pom ∈ L) :
    ((seedMap F.C F.order F.stepImage (track A.pom.val) A.toArrow.sourceCell).app A.toArrow.targetCell).top ⊆ F.J := by
  intro a hcol
  exact F.lower U V ((F.recognises A).mp ha) (F.seedMap_final A hcol)

end OrderedPomsetRecognizer
end CounterFreeHDA.Cubical
