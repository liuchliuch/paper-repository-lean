import CounterFreeHDA.Category

/-! Appendix A.1: exhaustive typed relation calculation. The finite closure
tables below are data; Lean checks their identities, generator closure, and
the exponent of every endomorphism using kernel evaluation (`decide`). -/

namespace CounterFreeHDA.Appendix

set_option maxRecDepth 10000
set_option maxHeartbeats 2000000

abbrev BRel (n m : ℕ) := Fin n → Fin m → Bool

def rel (rows : Fin n → ℕ) : BRel n m := fun i j => (rows i).testBit j.val

def comp (r : BRel n m) (s : BRel m l) : BRel n l :=
  fun i j => decide (∃ t, r i t = true ∧ s t j = true)

def ident (n : ℕ) : BRel n n := fun i j => decide (i = j)

def pow (r : BRel n n) : ℕ → BRel n n
  | 0 => ident n
  | k + 1 => comp (pow r k) r

def size : Fin 3 → ℕ := ![2,3,3]

def sigma : BRel 2 3 := rel ![1,6]
def tau : BRel 3 2 := rel ![2,1,2]
def theta : BRel 3 3 := rel ![1,0,6]
def eta : BRel 3 3 := rel ![2,4,2]

def table : (a b : Fin 3) → Finset (BRel (size a) (size b))
  | ⟨0,_⟩, ⟨0,_⟩ => {rel ![0,3], rel ![1,2], rel ![1,3], rel ![2,3], rel ![3,3]}
  | ⟨0,_⟩, ⟨1,_⟩ => {rel ![0,6], rel ![0,7], rel ![1,6], rel ![1,7], rel ![2,6], rel ![6,6], rel ![6,7], rel ![7,7]}
  | ⟨0,_⟩, ⟨2,_⟩ => {rel ![0,6], rel ![0,7], rel ![1,6], rel ![1,7], rel ![6,6], rel ![6,7], rel ![7,7]}
  | ⟨1,_⟩, ⟨0,_⟩ => {rel ![0,0,3], rel ![1,0,3], rel ![2,0,3], rel ![2,1,2], rel ![3,0,3], rel ![3,1,3], rel ![3,2,3], rel ![3,3,3]}
  | ⟨1,_⟩, ⟨1,_⟩ => {rel ![0,0,6], rel ![0,0,7], rel ![1,0,7], rel ![1,2,4], rel ![2,0,6], rel ![6,0,6], rel ![6,0,7], rel ![6,1,6], rel ![6,2,6], rel ![6,6,6], rel ![7,0,7], rel ![7,1,7], rel ![7,6,7], rel ![7,7,7]}
  | ⟨1,_⟩, ⟨2,_⟩ => {rel ![0,0,6], rel ![0,0,7], rel ![1,0,6], rel ![1,0,7], rel ![6,0,6], rel ![6,0,7], rel ![6,1,6], rel ![6,6,6], rel ![7,0,7], rel ![7,1,7], rel ![7,6,7], rel ![7,7,7]}
  | ⟨2,_⟩, ⟨0,_⟩ => {rel ![0,3,0], rel ![1,2,1], rel ![1,3,1], rel ![2,3,2], rel ![3,3,3]}
  | ⟨2,_⟩, ⟨1,_⟩ => {rel ![0,6,0], rel ![0,7,0], rel ![1,6,1], rel ![1,7,1], rel ![2,4,2], rel ![2,6,2], rel ![6,6,6], rel ![6,7,6], rel ![7,7,7]}
  | ⟨2,_⟩, ⟨2,_⟩ => {rel ![0,6,0], rel ![0,7,0], rel ![1,2,4], rel ![1,6,1], rel ![1,7,1], rel ![6,6,6], rel ![6,7,6], rel ![7,7,7]}
  | ⟨n+3,h⟩, _ => False.elim (by omega)
  | _, ⟨n+3,h⟩ => False.elim (by omega)

theorem table_ident : ∀ a : Fin 3, ident (size a) ∈ table a a := by intro a; fin_cases a <;> decide

theorem table_sigma : ∀ a : Fin 3, ∀ r ∈ table a 0, comp r sigma ∈ table a 1 := by
  intro a
  fin_cases a <;> simp only [table, Finset.forall_mem_insert, Finset.mem_singleton, forall_eq]
  all_goals repeat' apply And.intro
  all_goals decide
theorem table_tau : ∀ a : Fin 3, ∀ r ∈ table a 1, comp r tau ∈ table a 0 := by
  intro a
  fin_cases a <;> simp only [table, Finset.forall_mem_insert, Finset.mem_singleton, forall_eq]
  all_goals repeat' apply And.intro
  all_goals decide
theorem table_theta : ∀ a : Fin 3, ∀ r ∈ table a 1, comp r theta ∈ table a 2 := by
  intro a
  fin_cases a <;> simp only [table, Finset.forall_mem_insert, Finset.mem_singleton, forall_eq]
  all_goals repeat' apply And.intro
  all_goals decide
theorem table_eta : ∀ a : Fin 3, ∀ r ∈ table a 2, comp r eta ∈ table a 1 := by
  intro a
  fin_cases a <;> simp only [table, Finset.forall_mem_insert, Finset.mem_singleton, forall_eq]
  all_goals repeat' apply And.intro
  all_goals decide

/-- Every typed elementary execution is generated by precisely the four
relations displayed in A.1 (the two event positions have the same maps). -/
inductive Generated : ∀ {a b : Fin 3}, BRel (size a) (size b) → Prop where
  | nil (a : Fin 3) : Generated (a := a) (b := a) (ident (size a))
  | start0 {a} {r : BRel (size a) 2} : Generated (a := a) (b := 0) r → Generated (a := a) (b := 1) (comp r sigma)
  | stop0 {a} {r : BRel (size a) 3} : Generated (a := a) (b := 1) r → Generated (a := a) (b := 0) (comp r tau)
  | start1 {a} {r : BRel (size a) 3} : Generated (a := a) (b := 1) r → Generated (a := a) (b := 2) (comp r theta)
  | stop1 {a} {r : BRel (size a) 3} : Generated (a := a) (b := 2) r → Generated (a := a) (b := 1) (comp r eta)

theorem generated_mem {a b : Fin 3} {r : BRel (size a) (size b)} (h : Generated (a := a) (b := b) r) :
    r ∈ table a b := by
  induction h with
  | nil => exact table_ident _
  | start0 h ih => exact table_sigma _ _ ih
  | stop0 h ih => exact table_tau _ _ ih
  | start1 h ih => exact table_theta _ _ ih
  | stop1 h ih => exact table_eta _ _ ih

theorem table_exponent : ∀ a : Fin 3, ∀ r ∈ table a a, pow r 3 = pow r 4 := by
  intro a
  fin_cases a <;> simp only [table, Finset.forall_mem_insert, Finset.mem_singleton, forall_eq]
  all_goals repeat' apply And.intro
  all_goals decide

/-- The exhaustive counter-free calculation of Appendix A.1, at every
interface type, including nondeterministic endpoints and all cells. -/
theorem original_counter_free {a : Fin 3} {r : BRel (size a) (size a)}
    (h : Generated (a := a) (b := a) r) : pow r 3 = pow r 4 := table_exponent a r (generated_mem h)

def D : BRel 3 3 := rel ![2,0,6]
def K : BRel 3 3 := rel ![6,1,6]

theorem excursion_relations : comp theta eta = D ∧ comp tau sigma = K := by decide

/-- The residual completion acts on vertices by the genuine period-two
relation of A.2, rather than by the original aperiodic relation. -/
def residualA : BRel 3 3 := rel ![2,5,4]

def evenA : BRel 3 3 := rel ![5,6,4]
def oddA : BRel 3 3 := rel ![6,5,4]

theorem residual_square : pow residualA 2 = evenA := by decide
theorem residual_even_odd : comp evenA residualA = oddA := by decide
theorem residual_odd_even : comp oddA residualA = evenA := by decide

theorem residual_powers (n : ℕ) :
    pow residualA (2*n+2) = evenA ∧ pow residualA (2*n+3) = oddA := by
  induction n with
  | zero => exact ⟨residual_square, by decide⟩
  | succ n ih =>
    constructor
    · have hn : 2*(n+1)+2 = (2*n+3)+1 := by omega
      rw [hn, pow, ih.2, residual_odd_even]
    · have hn : 2*(n+1)+3 = ((2*n+3)+1)+1 := by omega
      rw [hn, pow, pow, ih.2, residual_odd_even, residual_even_odd]

theorem residual_pow_ne_succ (N : ℕ) (hN : 1 ≤ N) :
    pow residualA N ≠ pow residualA (N+1) := by
  rcases Nat.even_or_odd N with h | h
  · obtain ⟨n, rfl⟩ := h
    cases n with
    | zero => omega
    | succ n =>
      have hn : n+1+(n+1) = 2*n+2 := by omega
      rw [hn, (residual_powers n).1, (residual_powers n).2]
      decide
  · obtain ⟨n, hn⟩ := h
    cases n with
    | zero => subst N; decide
    | succ n =>
      have hn' : N = 2*n+3 := by omega
      have hs : N+1 = 2*(n+1)+2 := by omega
      rw [hn', (residual_powers n).2]
      have he : 2*n+3+1 = 2*(n+1)+2 := by omega
      rw [he, (residual_powers (n+1)).1]
      decide

/-- No uniform exponent can make the completed vertex relation stable. -/
theorem residual_not_counter_free : ¬ ∃ N, 1 ≤ N ∧ pow residualA N = pow residualA (N+1) := by
  rintro ⟨N, hN, h⟩
  exact residual_pow_ne_succ N hN h

end CounterFreeHDA.Appendix
