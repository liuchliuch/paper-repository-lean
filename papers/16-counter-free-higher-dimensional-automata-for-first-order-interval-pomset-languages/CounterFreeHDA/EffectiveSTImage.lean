import CounterFreeHDA.EffectiveDiagrams
import CounterFreeHDA.FiniteClosure
import CounterFreeHDA.STCategory

namespace CounterFreeHDA.Cubical.Effective
universe u v
variable {Lab : Type u} {k : ℕ} [Fintype Lab] [DecidableEq Lab]
attribute [local instance] faceFintype faceDecidableEq lowerDecidable upperDecidable

abbrev Elementary :=
  (Σ U : Cube Lab k, Σ V : Cube Lab k, {f : Face U V // f.Lower ∧ V.dim = U.dim+1}) ⊕
  (Σ U : Cube Lab k, Σ V : Cube Lab k, {f : Face U V // f.Upper ∧ V.dim = U.dim+1})

namespace Elementary

def source : Elementary (Lab := Lab) (k := k) → Cube Lab k
  | .inl ⟨U,_,_⟩ => U
  | .inr ⟨_,V,_⟩ => V

def target : Elementary (Lab := Lab) (k := k) → Cube Lab k
  | .inl ⟨_,V,_⟩ => V
  | .inr ⟨U,_,_⟩ => U

def step (e : Elementary (Lab := Lab) (k := k)) : Step e.source e.target :=
  match e with
  | .inl ⟨_,_,f⟩ => .start f.val f.property.1 f.property.2
  | .inr ⟨_,_,f⟩ => .stop f.val f.property.1 f.property.2

end Elementary

variable (C : FinCat.{u,v} (Cube Lab k)) (image : ∀ {U V}, Step U V → C.Hom U V)

abbrev ImageState (S : Cube Lab k) := Σ V : Cube Lab k, C.Hom S V

def ImageNext {S : Cube Lab k} (a b : ImageState C S) : Prop :=
  ∃ e : Elementary (Lab := Lab) (k := k),
    if h : a.1 = e.source then b = ⟨e.target,C.comp (h ▸ a.2) (image e.step)⟩ else False

instance imageNextDecidable {S : Cube Lab k} : DecidableRel (ImageNext C image (S := S)) := by
  intro a b
  unfold ImageNext
  infer_instance

/-- The typed image generated by the finitely many elementary ST arrows,
computed by a bounded saturation of the supplied finite multiplication table. -/
def imageEnum (S : Cube Lab k) : Finset (ImageState C S) :=
  CounterFreeHDA.Effective.closure (ImageNext C image (S := S)) {⟨S,C.id S⟩}

theorem next_step {S U V : Cube Lab k} (a : C.Hom S U) (s : Step U V) :
    ImageNext C image ⟨U,a⟩ ⟨V,C.comp a (image s)⟩ := by
  cases s with
  | start f hl hd =>
    refine ⟨.inl ⟨_,_,f,hl,hd⟩,?_⟩
    simp [Elementary.source,Elementary.target,Elementary.step]
  | stop f hu hd =>
    refine ⟨.inr ⟨_,_,f,hu,hd⟩,?_⟩
    simp [Elementary.source,Elementary.target,Elementary.step]

theorem imageEnum_sound {S : Cube Lab k} (a : ImageState C S) (ha : a ∈ imageEnum C image S) :
    ∃ p : Word S a.1, wordImage C image p = a.2 := by
  unfold imageEnum at ha
  apply CounterFreeHDA.Effective.closure_least (ImageNext C image (S := S)) ({⟨S,C.id S⟩} : Finset (ImageState C S))
    (fun a => ∃ p : Word S a.1, wordImage C image p = a.2) ?_ ?_ a ha
  · intro a ha
    have he := Finset.mem_singleton.mp ha
    subst a
    exact ⟨.nil S,rfl⟩
  · rintro ⟨U,a⟩ ⟨p,hp⟩ b ⟨e,he⟩
    change Word S U at p
    change wordImage C image p = a at hp
    split_ifs at he with h
    · change U = e.source at h
      subst U
      subst b
      refine ⟨p.append (.cons e.step (.nil e.target)),?_⟩
      rw [STCategory.fold_append,hp]
      simp only [wordImage,C.comp_id]

theorem imageEnum_extend {S U V : Cube Lab k} (p : Word U V) (a : C.Hom S U)
    (ha : (⟨U,a⟩ : ImageState C S) ∈ imageEnum C image S) :
    (⟨V,C.comp a (wordImage C image p)⟩ : ImageState C S) ∈ imageEnum C image S := by
  induction p with
  | nil U => simpa only [wordImage,C.comp_id] using ha
  | cons s p ih =>
    unfold imageEnum at ha ⊢
    have hs : (⟨_,C.comp a (image s)⟩ : ImageState C S) ∈ imageEnum C image S := by
      unfold imageEnum
      exact CounterFreeHDA.Effective.closure_step (ImageNext C image (S := S)) ({⟨S,C.id S⟩} : Finset (ImageState C S)) ha (next_step C image a s)
    simpa only [wordImage,← C.assoc] using ih (C.comp a (image s)) hs

theorem imageEnum_complete {S V : Cube Lab k} (p : Word S V) :
    (⟨V,wordImage C image p⟩ : ImageState C S) ∈ imageEnum C image S := by
  have hs : (⟨S,C.id S⟩ : ImageState C S) ∈ imageEnum C image S :=
    CounterFreeHDA.Effective.seed_subset (ImageNext C image (S := S)) ({⟨S,C.id S⟩} : Finset (ImageState C S)) (Finset.mem_singleton_self _)
  simpa only [C.id_comp] using imageEnum_extend C image p (C.id S) hs

theorem imageEnum_iff {S V : Cube Lab k} (a : C.Hom S V) :
    (⟨V,a⟩ : ImageState C S) ∈ imageEnum C image S ↔ ∃ p : Word S V, wordImage C image p = a := by
  constructor
  · exact imageEnum_sound C image ⟨V,a⟩
  · rintro ⟨p,rfl⟩; exact imageEnum_complete C image p

end CounterFreeHDA.Cubical.Effective
