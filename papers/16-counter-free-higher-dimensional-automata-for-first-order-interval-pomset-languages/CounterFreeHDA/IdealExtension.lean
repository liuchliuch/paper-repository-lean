import CounterFreeHDA.IdealPaths

/-! The least extension (11) for the actual directed face graph.  This uses
all labelled runs, including zero-length runs, and retains all parallel arcs.
No acyclicity assumption or path criterion is hidden in the construction. -/

namespace CounterFreeHDA.Cubical

universe u v w

variable {Lab : Type u} {k : ℕ} (C : FinCat.{u,v} (Cube Lab k)) (ord : C.IsOrdered)
variable (image : ∀ {U V}, Step U V → C.Hom U V)

@[simp] theorem wordImage_append {U V W : Cube Lab k} (p : Word U V) (q : Word V W) :
    wordImage C image (p.append q) = C.comp (wordImage C image p) (wordImage C image q) := by
  induction p with
  | nil U => exact (C.id_comp _).symm
  | cons s p ih => simp only [Word.append, wordImage, ih, C.assoc]

variable (X : Precubical.{u,w} Lab k) (S : Cube Lab k)
variable (B : ∀ U, Set (X.Cell U)) (aB : ∀ U, X.Cell U → Set (C.Hom S U))

/-- The lower ideal generated by every path from every prescribed vertex. -/
def leastColor {U} (x : X.Cell U) : Set (C.Hom S U) :=
  {a | ∃ (V : Cube Lab k) (b : X.Cell V), b ∈ B V ∧ ∃ p : Word V U,
    X.Run p b x ∧ a ∈ LowerSetAction.act ord (aB V b) (wordImage C image p)}

theorem leastColor_lower {U} (x : X.Cell U) :
    IsLowerSet ord.homLE (leastColor C ord image X S B aB x) := by
  rintro a b ⟨V, z, hz, p, hr, ha⟩ hba
  exact ⟨V, z, hz, p, hr, LowerSetAction.act_isLowerSet ord ha hba⟩

variable (lowerB : ∀ U (x : X.Cell U), IsLowerSet ord.homLE (aB U x))

/-- The least extension is already arc-compatible, before imposing any
conditions on the prescribed boundary values. -/
def leastColoring : Coloring C ord image X S where
  val := leastColor C ord image X S B aB
  lower := leastColor_lower C ord image X S B aB
  start f hl hd x := by
    intro a ha
    obtain ⟨c, ⟨V,b,hb,p,hr,hc⟩, hac⟩ := (LowerSetAction.mem_act ord).mp ha
    let q : Word _ _ := .cons (.start f hl hd) (.nil _)
    have hq : X.Run q (X.face f x) x := .start f hl hd (.nil x)
    refine ⟨V,b,hb,p.append q, (X.run_append_iff p q b x).mpr ⟨_,hr,hq⟩, ?_⟩
    have hmem : a ∈ LowerSetAction.act ord
        (LowerSetAction.act ord (aB V b) (wordImage C image p)) (image (.start f hl hd)) :=
      (LowerSetAction.mem_act ord).mpr ⟨c,hc,hac⟩
    rw [LowerSetAction.act_comp ord (lowerB V b)] at hmem
    simpa only [wordImage_append, q, wordImage, C.comp_id] using hmem
  stop f hu hd x := by
    intro a ha
    obtain ⟨c, ⟨V,b,hb,p,hr,hc⟩, hac⟩ := (LowerSetAction.mem_act ord).mp ha
    let q : Word _ _ := .cons (.stop f hu hd) (.nil _)
    have hq : X.Run q x (X.face f x) := .stop f hu hd (.nil _)
    refine ⟨V,b,hb,p.append q, (X.run_append_iff p q b _).mpr ⟨_,hr,hq⟩, ?_⟩
    have hmem : a ∈ LowerSetAction.act ord
        (LowerSetAction.act ord (aB V b) (wordImage C image p)) (image (.stop f hu hd)) :=
      (LowerSetAction.mem_act ord).mpr ⟨c,hc,hac⟩
    rw [LowerSetAction.act_comp ord (lowerB V b)] at hmem
    simpa only [wordImage_append, q, wordImage, C.comp_id] using hmem

/-- Equation (10) in the actual labelled face graph. -/
def BoundaryCompatible : Prop :=
  ∀ U V (x : X.Cell U) (y : X.Cell V), x ∈ B U → y ∈ B V →
    ∀ p : Word U V, X.Run p x y →
      LowerSetAction.act ord (aB U x) (wordImage C image p) ⊆ aB V y

include lowerB in
theorem leastColor_boundary
    (hb : BoundaryCompatible C ord image X S B aB)
    {U} (x : X.Cell U) (hx : x ∈ B U) :
    leastColor C ord image X S B aB x = aB U x := by
  apply Set.Subset.antisymm
  · rintro a ⟨V,b,hb',p,hr,ha⟩
    exact hb V U b x hb' hx p hr ha
  · intro a ha
    refine ⟨U,x,hx,.nil U,.nil x, ?_⟩
    simpa only [wordImage, LowerSetAction.act_id ord (lowerB U x)] using ha

/-- The constructive sufficiency direction of the extension criterion,
instantiated in the actual ideal-diagram HDA. -/
def extendingMap
    (hb : BoundaryCompatible C ord image X S B aB) : Map X (ideal C ord image S) :=
  (leastColoring C ord image X S B aB lowerB).toMap

theorem extendingMap_on_boundary
    (hb : BoundaryCompatible C ord image X S B aB)
    {U} (x : X.Cell U) (hx : x ∈ B U) :
    ((extendingMap C ord image X S B aB lowerB hb).app x).top = aB U x := by
  change leastColor C ord image X S B aB (X.face (Face.ident U) x) = _
  rw [X.face_ident]
  exact leastColor_boundary C ord image X S B aB lowerB hb x hx

include lowerB in
/-- The two directions of the actual face-colouring extension criterion.
This is Lemma 3.2 combined with Lemma 3.3, including length-zero paths. -/
theorem exists_extending_map_iff :
    (∃ m : Map X (ideal C ord image S),
      ∀ U (x : X.Cell U), x ∈ B U → (m.app x).top = aB U x) ↔
    BoundaryCompatible C ord image X S B aB := by
  constructor
  · rintro ⟨m,hm⟩ U V x y hx hy p hr a ha
    obtain ⟨b,hb,hab⟩ := (LowerSetAction.mem_act ord).mp ha
    rw [← hm U x hx] at hb
    have hp := IdealDiagram.run_propagates (m.map_run hr) hb
    rw [hm V y hy] at hp
    exact lowerB V y hp hab
  · intro hb
    exact ⟨extendingMap C ord image X S B aB lowerB hb,
      fun _ x hx => extendingMap_on_boundary C ord image X S B aB lowerB hb x hx⟩

end CounterFreeHDA.Cubical
