import Paper17.SimplicialResolution
import Mathlib.Analysis.Convex.Exposed
import Mathlib.Analysis.Normed.Module.FiniteDimension

/-!
# Compatibility of the pieces of a stellar subdivision

All assertions concern the actual cones generated by the integral rows.
Coordinates in a nonsingular original cone characterize each stellar piece.
The intersection of two pieces is the coordinate face obtained by omitting
the other replaced row. In particular the pieces meet along common faces;
this is stronger than just the covering statement used by single-cone descent.
-/
noncomputable section
open scoped BigOperators
namespace Paper17

/-- Real linear synthesis in an integral row basis. -/
def latticeSynthesis {n : ℕ} (A : Matrix (Fin n) (Fin n) ℤ) : V n →ₗ[ℝ] V n :=
  (A.map (fun z => (z : ℝ))).vecMulLinear

@[simp] theorem latticeSynthesis_apply {n : ℕ}
    (A : Matrix (Fin n) (Fin n) ℤ) (c : V n) (j : Fin n) :
    latticeSynthesis A c j = ∑ i, c i * (A i j : ℝ) := rfl

theorem latticeSynthesis_isUnit {n : ℕ} (A : Matrix (Fin n) (Fin n) ℤ)
    (hA : A.det ≠ 0) : IsUnit (A.map (fun z => (z : ℝ))) := by
  apply (Matrix.isUnit_iff_isUnit_det _).mpr
  apply isUnit_iff_ne_zero.mpr
  rw [← Int.cast_det]
  exact_mod_cast hA

theorem latticeSynthesis_injective {n : ℕ} (A : Matrix (Fin n) (Fin n) ℤ)
    (hA : A.det ≠ 0) : Function.Injective (latticeSynthesis A) :=
  Matrix.vecMul_injective_iff_isUnit.mpr (latticeSynthesis_isUnit A hA)

/-- Unique actual real coordinates in the integral row basis. -/
def latticeCoordinateEquiv {n : ℕ} (A : Matrix (Fin n) (Fin n) ℤ)
    (hA : A.det ≠ 0) : V n ≃ₗ[ℝ] V n :=
  LinearEquiv.ofBijective (latticeSynthesis A)
    ⟨latticeSynthesis_injective A hA,
      Matrix.vecMul_surjective_iff_isUnit.mpr (latticeSynthesis_isUnit A hA)⟩

theorem latticeSynthesis_updateRow {n : ℕ}
    (A : Matrix (Fin n) (Fin n) ℤ) (u : Fin n → ℤ) (b c : V n)
    (hu : ∀ j, (u j : ℝ) = ∑ i, b i * (A i j : ℝ)) (k : Fin n) :
    latticeSynthesis (A.updateRow k u) c =
      latticeSynthesis A (fun i => (if i = k then 0 else c i) + c k * b i) := by
  classical
  ext j
  simp only [latticeSynthesis_apply]
  have hleft : ∑ i, c i * ((A.updateRow k u) i j : ℝ) =
      c k * (u j : ℝ) + ∑ i ∈ Finset.univ.erase k, c i * (A i j : ℝ) := by
    rw [← Finset.add_sum_erase Finset.univ _ (Finset.mem_univ k)]
    congr 1
    · simp
    · apply Finset.sum_congr rfl
      intro i hi
      have hik : i ≠ k := (Finset.mem_erase.mp hi).1
      simp [Matrix.updateRow, hik]
  have hright : ∑ i, ((if i = k then 0 else c i) + c k * b i) * (A i j : ℝ) =
      (∑ i ∈ Finset.univ.erase k, c i * (A i j : ℝ)) +
        c k * ∑ i, b i * (A i j : ℝ) := by
    simp only [add_mul, Finset.sum_add_distrib, mul_assoc, ← Finset.mul_sum]
    congr 1
    rw [← Finset.add_sum_erase Finset.univ _ (Finset.mem_univ k)]
    simp only [ite_true, zero_mul, zero_add]
    apply Finset.sum_congr rfl
    intro i hi
    simp [(Finset.mem_erase.mp hi).1]
  rw [hleft, hright, ← hu j, add_comm]

/-- Exact coordinate inequalities for a stellar piece. -/
theorem mem_stellarCone_iff {n : ℕ}
    (A : Matrix (Fin n) (Fin n) ℤ) (hA : A.det ≠ 0)
    (u : Fin n → ℤ) (b c : V n)
    (hu : ∀ j, (u j : ℝ) = ∑ i, b i * (A i j : ℝ))
    (k : Fin n) (hbk : 0 < b k) :
    latticeSynthesis A c ∈ latticeCone (A.updateRow k u) ↔
      0 ≤ c k / b k ∧ ∀ i, i ≠ k → 0 ≤ c i - (c k / b k) * b i := by
  classical
  constructor
  · rintro ⟨t, ht, hx⟩
    have hs : latticeSynthesis A c = latticeSynthesis (A.updateRow k u) t := by
      ext j
      exact hx j
    rw [latticeSynthesis_updateRow A u b t hu k] at hs
    have hc := latticeSynthesis_injective A hA hs
    have hck : c k = t k * b k := by simpa using congrFun hc k
    have hratio : c k / b k = t k := by rw [hck]; exact mul_div_cancel_right₀ _ hbk.ne'
    refine ⟨hratio ▸ ht k, ?_⟩
    intro i hik
    have hci : c i = t i + t k * b i := by simpa [hik] using congrFun hc i
    rw [hci, hratio, add_sub_cancel_right]
    exact ht i
  · rintro ⟨ht, hres⟩
    let t : V n := fun i => if i = k then c k / b k else c i - (c k / b k) * b i
    refine ⟨t, ?_, ?_⟩
    · intro i
      dsimp [t]
      split_ifs with hik
      · exact ht
      · exact hres i hik
    · have heq : latticeSynthesis (A.updateRow k u) t = latticeSynthesis A c := by
        rw [latticeSynthesis_updateRow A u b t hu k]
        congr 1
        funext i
        by_cases hik : i = k
        · subst i
          simp [t, hbk.ne']
        · simp [t, hik]
      intro j
      exact congrFun heq.symm j

/-- The face of an integral simplicial cone that omits one generator. -/
def latticeCoordinateFace {n : ℕ} (A : Matrix (Fin n) (Fin n) ℤ) (k : Fin n) : Set (V n) :=
  {x | ∃ c : V n, (∀ i, 0 ≤ c i) ∧ c k = 0 ∧ x = latticeSynthesis A c}

/-- Distinct stellar pieces meet in the actual face that omits the other
removed original generator. -/
theorem stellarCone_inter_eq_face {n : ℕ}
    (A : Matrix (Fin n) (Fin n) ℤ) (hA : A.det ≠ 0)
    (u : Fin n → ℤ) (b : V n) (hb : ∀ i, 0 ≤ b i)
    (hu : ∀ j, (u j : ℝ) = ∑ i, b i * (A i j : ℝ))
    (k l : Fin n) (hkl : k ≠ l) (hbk : 0 < b k) (hbl : 0 < b l) :
    latticeCone (A.updateRow k u) ∩ latticeCone (A.updateRow l u) =
      latticeCoordinateFace (A.updateRow k u) l := by
  classical
  ext x
  constructor
  · rintro ⟨hxk, hxl⟩
    obtain ⟨c, hc, hx⟩ := latticeCone_updateRow_subset A u b hb hu k hxk
    have hx' : x = latticeSynthesis A c := funext hx
    rw [hx'] at hxk hxl
    have hk := (mem_stellarCone_iff A hA u b c hu k hbk).mp hxk
    have hl := (mem_stellarCone_iff A hA u b c hu l hbl).mp hxl
    have hratio : c k / b k = c l / b l := by
      apply le_antisymm
      · exact (le_div_iff₀ hbl).mpr (sub_nonneg.mp (hk.2 l hkl.symm))
      · exact (le_div_iff₀ hbk).mpr (sub_nonneg.mp (hl.2 k hkl))
    let d : V n := fun i => if i = k then c k / b k else c i - (c k / b k) * b i
    refine ⟨d, ?_, ?_, ?_⟩
    · intro i
      dsimp [d]
      split_ifs with hik
      · exact hk.1
      · exact hk.2 i hik
    · dsimp [d]
      rw [if_neg hkl.symm, hratio, div_mul_cancel₀ _ hbl.ne', sub_self]
    · rw [hx', latticeSynthesis_updateRow A u b d hu k]
      congr 1
      funext i
      by_cases hik : i = k
      · subst i
        simp [d, hbk.ne']
      · simp [d, hik]
  · rintro ⟨d, hd, hdl, hx⟩
    refine ⟨⟨d, hd, fun j => congrFun hx j⟩, ?_⟩
    let e : V n := fun i => if i = l then d k else if i = k then 0 else d i
    have he : ∀ i, 0 ≤ e i := by
      intro i
      dsimp [e]
      split_ifs <;> first | exact hd _ | exact le_refl 0
    have heq : latticeSynthesis (A.updateRow l u) e = latticeSynthesis (A.updateRow k u) d := by
      rw [latticeSynthesis_updateRow A u b e hu l, latticeSynthesis_updateRow A u b d hu k]
      congr 1
      funext i
      by_cases hik : i = k
      · subst i
        simp [e, hkl]
      · by_cases hil : i = l
        · subst i
          simp [e, hkl, hkl.symm, hdl]
        · simp [e, hik, hil, hkl]
    refine ⟨e, he, fun j => ?_⟩
    exact congrFun (hx.trans heq.symm) j

/-- A positive stellar coefficient preserves nonsingularity. -/
theorem stellar_matrix_det_ne_zero {n : ℕ}
    (A : Matrix (Fin n) (Fin n) ℤ) (hA : A.det ≠ 0)
    (u : Fin n → ℤ) (b : V n)
    (hu : ∀ j, (u j : ℝ) = ∑ i, b i * (A i j : ℝ))
    (k : Fin n) (hbk : 0 < b k) : (A.updateRow k u).det ≠ 0 := by
  intro hz
  have heq := determinant_replace_generator A u b hu k
  have hprod : b k * (A.det : ℝ) ≠ 0 := mul_ne_zero hbk.ne' (by exact_mod_cast hA)
  apply hprod
  rw [← heq, hz, Int.cast_zero]

/-- Each coordinate face is exposed by an actual continuous linear
functional. This verifies the geometric face condition, not just containment. -/
theorem latticeCoordinateFace_isExposed {n : ℕ}
    (A : Matrix (Fin n) (Fin n) ℤ) (hA : A.det ≠ 0) (k : Fin n) :
    IsExposed ℝ (latticeCone A) (latticeCoordinateFace A k) := by
  let e := latticeCoordinateEquiv A hA
  let f : V n →ₗ[ℝ] ℝ := (LinearMap.proj k).comp e.symm.toLinearMap
  have hf : ∀ c, f (latticeSynthesis A c) = c k := by
    intro c
    change e.symm (e c) k = c k
    rw [e.symm_apply_apply]
  intro _
  refine ⟨-f.toContinuousLinearMap, ?_⟩
  ext x
  constructor
  · rintro ⟨c, hc, hck, rfl⟩
    refine ⟨⟨c, hc, fun j => rfl⟩, ?_⟩
    rintro y ⟨d, hd, hyd⟩
    have hy : y = latticeSynthesis A d := funext hyd
    change -f y ≤ -f (latticeSynthesis A c)
    rw [hy, hf, hf, hck]
    linarith [hd k]
  · rintro ⟨⟨c, hc, hx⟩, hmax⟩
    have hx' : x = latticeSynthesis A c := funext hx
    have hzero : (0 : V n) ∈ latticeCone A := ⟨0, by simp, by simp⟩
    have hle := hmax 0 hzero
    change -f 0 ≤ -f x at hle
    rw [map_zero, hx', hf] at hle
    exact ⟨c, hc, by linarith [hc k], hx'⟩

/-- Every pair of different pieces of the stellar subdivision meets along
an exposed face of each piece. -/
theorem stellarCone_inter_isExposed {n : ℕ}
    (A : Matrix (Fin n) (Fin n) ℤ) (hA : A.det ≠ 0)
    (u : Fin n → ℤ) (b : V n) (hb : ∀ i, 0 ≤ b i)
    (hu : ∀ j, (u j : ℝ) = ∑ i, b i * (A i j : ℝ))
    (k l : Fin n) (hkl : k ≠ l) (hbk : 0 < b k) (hbl : 0 < b l) :
    IsExposed ℝ (latticeCone (A.updateRow k u))
      (latticeCone (A.updateRow k u) ∩ latticeCone (A.updateRow l u)) ∧
    IsExposed ℝ (latticeCone (A.updateRow l u))
      (latticeCone (A.updateRow k u) ∩ latticeCone (A.updateRow l u)) := by
  constructor
  · rw [stellarCone_inter_eq_face A hA u b hb hu k l hkl hbk hbl]
    exact latticeCoordinateFace_isExposed _ (stellar_matrix_det_ne_zero A hA u b hu k hbk) l
  · rw [Set.inter_comm, stellarCone_inter_eq_face A hA u b hb hu l k hkl.symm hbl hbk]
    exact latticeCoordinateFace_isExposed _ (stellar_matrix_det_ne_zero A hA u b hu l hbl) k

end Paper17
