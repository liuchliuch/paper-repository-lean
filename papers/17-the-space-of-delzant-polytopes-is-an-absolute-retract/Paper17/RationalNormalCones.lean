import Paper17.IntegerConeGenerators
import Paper17.IntegralHalfspacePresentation

/-! Rational finite vertex data yields actual integral normal-cone generators. -/
noncomputable section
open scoped BigOperators Topology
namespace Paper17

/-- A functional constant on a carrier with interior has zero linear part. -/
theorem dot_eq_zero_of_constant_on_interior {n : ℕ} {K : Set (V n)}
    (hK : (interior K).Nonempty) (u : V n) (b : ℝ)
    (hu : ∀ y ∈ K, dot u y = b) : u = 0 := by
  obtain ⟨z, hz⟩ := hK
  let L : V n →ₗ[ℝ] ℝ :=
    { toFun := dot u
      map_add' := dot_add_right u
      map_smul' := fun t x => dot_smul_right t u x }
  let U : Set (V n) := {y | y + z ∈ interior K}
  have hU : IsOpen U := isOpen_interior.preimage (continuous_id.add continuous_const)
  have h0 : (0 : V n) ∈ U := by simpa only [U, Set.mem_setOf_eq, zero_add] using hz
  have hsub : U ⊆ (LinearMap.ker L : Set (V n)) := by
    intro y hy
    change dot u y = 0
    have hh := hu (y + z) (interior_subset hy)
    rw [dot_add_right, hu z (interior_subset hz)] at hh
    linarith
  have htop : LinearMap.ker L = ⊤ :=
    (LinearMap.ker L).eq_top_of_nonempty_interior'
      ⟨0, interior_mono hsub (by rwa [hU.interior_eq])⟩
  ext j
  have hh : Pi.single j 1 ∈ LinearMap.ker L := by rw [htop]; trivial
  change dot u (Pi.single j 1) = 0 at hh
  simpa [dot, Pi.single_apply] using hh

/-- A full-dimensional finite vertex presentation has trivial common kernel
for the homogeneous inequalities defining its normal cone at any point. -/
theorem normal_inequalities_kernel {n : ℕ} (P : Polytope n) (hP : P.IsFullDim)
    (v u : V n) (hu : ∀ y ∈ P.verts, dot (v - y) u = 0) : u = 0 := by
  have hv : ∀ y ∈ P.verts, dot u y = dot u v := by
    intro y hy
    have hh := hu y hy
    rw [dot_comm] at hh
    have hsub : dot u (v - y) = dot u v - dot u y := by
      simp only [dot, Pi.sub_apply, mul_sub, Finset.sum_sub_distrib]
    rw [hsub] at hh
    linarith
  apply dot_eq_zero_of_constant_on_interior hP u (dot u v)
  have hconv : Convex ℝ {y | dot u y = dot u v} := by
    rw [convex_iff_add_mem]
    intro x hx y hy a b ha hb hab
    change dot u (a • x + b • y) = dot u v
    rw [dot_add_right, dot_smul_right, dot_smul_right, hx, hy, ← add_mul, hab, one_mul]
  exact convexHull_min hv hconv

/-- For genuine rational vertices the actual normal cone, including at a
redundant listed vertex, is generated by finitely many integer rays. -/
theorem hasRationalNormalPresentation_of_rational_vertices {n : ℕ} (P : Polytope n)
    (hP : P.IsFullDim) (hr : ∀ v ∈ P.verts, IsRatPoint v) :
    HasRationalNormalPresentation P := by
  classical
  intro v hv
  choose q hq using (fun y : P.verts => hr y.val y.property)
  let a : P.verts → Fin n → ℚ := fun y j => q ⟨v, hv⟩ j - q y j
  have ha : ∀ y : P.verts, ratVector (a y) = v - y.val := by
    intro y
    ext j
    simp only [ratVector, a, Rat.cast_sub, ← hq]
    rfl
  have hk : ∀ u : V n, (∀ y, dot (ratVector (a y)) u = 0) → u = 0 := by
    intro u hu
    apply normal_inequalities_kernel P hP v u
    intro y hy
    simpa only [ha] using hu ⟨y, hy⟩
  obtain ⟨m, rays, hcone⟩ := rationalCone_integer_generators a hk
  refine ⟨m, rays, ?_⟩
  apply Eq.trans _ hcone
  ext u
  have hsub : ∀ y : V n, dot u (v - y) = dot u v - dot u y := by
    intro y
    simp only [dot, Pi.sub_apply, mul_sub, Finset.sum_sub_distrib]
  constructor
  · intro hu y
    rw [ha, dot_comm, hsub]
    exact sub_nonneg.mpr (hu y.val (subset_convexHull ℝ _ y.property))
  · intro hu
    have hconv : Convex ℝ {y | dot u y ≤ dot u v} := by
      rw [convex_iff_add_mem]
      intro x hx y hy a b ha hb hab
      change dot u (a • x + b • y) ≤ dot u v
      rw [dot_add_right, dot_smul_right, dot_smul_right]
      calc a * dot u x + b * dot u y ≤ a * dot u v + b * dot u v :=
          add_le_add (mul_le_mul_of_nonneg_left hx ha) (mul_le_mul_of_nonneg_left hy hb)
        _ = dot u v := by rw [← add_mul, hab, one_mul]
    apply convexHull_min _ hconv
    intro y hy
    have hh := hu ⟨y, hy⟩
    rw [ha, dot_comm, hsub] at hh
    exact sub_nonneg.mp hh

end Paper17
