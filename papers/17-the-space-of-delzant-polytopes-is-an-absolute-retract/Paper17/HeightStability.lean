import Paper17.GenericHeights

/-!
# Active-face stability under small height perturbations

On a fixed compact bounding region, a new feasible active set must already
have had a common old feasible supporting face when the heights are close
enough. Closed projection from the compact spatial factor proves the required
uniform neighborhood; only finitely many active index sets are possible.
-/
noncomputable section
open scoped Topology
open Filter
namespace Paper17
section
variable {ι : Type*} [Fintype ι] [DecidableEq ι] {n : ℕ}

theorem finiteHalfspaces_active_stability (a : ι → V n) (h : ι → ℝ)
    (B : Set (V n)) (hB : IsCompact B) :
    ∃ δ : ℝ, 0 < δ ∧ ∀ h' : ι → ℝ, dist h' h < δ →
      ∀ x ∈ B, x ∈ finiteHalfspaces a h' → ∀ I : Finset ι,
        (∀ i ∈ I, dot (a i) x = h' i) →
        ∃ y ∈ finiteHalfspaces a h, ∀ i ∈ I, dot (a i) y = h i := by
  classical
  letI : CompactSpace B := isCompact_iff_compactSpace.mp hB
  have hlocal : ∀ I : Finset ι, ∀ᶠ h' : ι → ℝ in 𝓝 h,
      (∃ x ∈ B, x ∈ finiteHalfspaces a h' ∧ ∀ i ∈ I, dot (a i) x = h' i) →
        ∃ y ∈ finiteHalfspaces a h, ∀ i ∈ I, dot (a i) y = h i := by
    intro I
    by_cases hold : ∃ y ∈ finiteHalfspaces a h, ∀ i ∈ I, dot (a i) y = h i
    · exact Filter.Eventually.of_forall (fun _ _ => hold)
    · let C : Set (B × (ι → ℝ)) := {p |
        (∀ i, dot (a i) p.1.val ≤ p.2 i) ∧ ∀ i ∈ I, dot (a i) p.1.val = p.2 i}
      have hc1 : IsClosed {p : B × (ι → ℝ) | ∀ i, dot (a i) p.1.val ≤ p.2 i} := by
        simpa only [Set.setOf_forall] using isClosed_iInter (fun i => isClosed_le
          ((continuous_dot (a i)).comp (continuous_subtype_val.comp continuous_fst))
          ((continuous_apply i).comp continuous_snd))
      have hc2 : IsClosed {p : B × (ι → ℝ) | ∀ i ∈ I, dot (a i) p.1.val = p.2 i} := by
        simpa only [Set.setOf_forall] using isClosed_iInter (fun i => isClosed_iInter
          (fun _hi : i ∈ I => isClosed_eq
            ((continuous_dot (a i)).comp (continuous_subtype_val.comp continuous_fst))
            ((continuous_apply i).comp continuous_snd)))
      have hC : IsClosed C := hc1.inter hc2
      have hproj : IsClosed (Prod.snd '' C) := isClosedMap_snd_of_compactSpace C hC
      have hnot : h ∉ Prod.snd '' C := by
        rintro ⟨⟨x, h'⟩, hx, heq⟩
        change h' = h at heq
        subst h'
        exact hold ⟨x.val, hx.1, hx.2⟩
      have hevent : ∀ᶠ h' : ι → ℝ in 𝓝 h, h' ∉ Prod.snd '' C :=
        hproj.isOpen_compl.mem_nhds hnot
      apply hevent.mono
      intro h' hn ⟨x, hxB, hxH, hxI⟩
      exact False.elim (hn ⟨(⟨x, hxB⟩, h'), ⟨hxH, hxI⟩, rfl⟩)
  have hAll := Filter.eventually_all.mpr hlocal
  obtain ⟨δ, hδ, hbound⟩ := Metric.eventually_nhds_iff.mp hAll
  refine ⟨δ, hδ, ?_⟩
  intro h' hh x hxB hxH I hxI
  exact hbound hh I ⟨x, hxB, hxH, hxI⟩

/-- A positive-span cone generated by simultaneously active old constraints
is contained in the actual old normal cone at their common feasible point. -/
theorem raySpan_subset_carrierNormalCone (a : ι → V n) (h : ι → ℝ)
    (I : Finset ι) {y : V n} (hy : y ∈ finiteHalfspaces a h)
    (hactive : ∀ i ∈ I, dot (a i) y = h i) :
    raySpan a I ⊆ carrierNormalCone (finiteHalfspaces a h) y := by
  rintro u ⟨c, hc0, hcs, rfl⟩ x hx
  rw [dot_fintype_sum_smul, dot_fintype_sum_smul]
  apply Finset.sum_le_sum
  intro i _
  by_cases hi : i ∈ I
  · rw [hactive i hi]
    exact mul_le_mul_of_nonneg_left (hx i) (hc0 i)
  · simp [hcs i hi]

end
end Paper17
