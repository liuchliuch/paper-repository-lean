import Verification.Example24PrismSmooth

/-! The genuine three-dimensional obstruction in Example 2.4. -/
noncomputable section
open scoped BigOperators Topology
namespace Paper17.Example24

/-- The product wedge cannot be generated by any integral unimodular basis.
The three extreme directions force three distinct basis rows along those
directions, making the determinant at least two in absolute value. -/
theorem not_smooth_product_wedge (C : Cone 3)
    (hC : (C : Set (V 3)) = {x | 0 ≤ x 1 - x 0 ∧ 0 ≤ x 1 + x 0 ∧ 0 ≤ x 2}) :
    ¬ Fan.IsSmoothCone C := by
  classical
  rintro ⟨v, hvint, hvdet, hvcone⟩
  have hrow : ∀ i, 0 ≤ v i 1 - v i 0 ∧ 0 ≤ v i 1 + v i 0 ∧ 0 ≤ v i 2 := by
    intro i
    have hh : v i ∈ (C : Set (V 3)) := by
      rw [hvcone]
      refine ⟨Pi.single i 1, ?_, ?_⟩
      · intro j
        simp only [Pi.single_apply]
        split_ifs <;> norm_num
      · simp
    rwa [hC] at hh
  have hy : ∀ i, 0 ≤ v i 1 := fun i => by linarith [(hrow i).1, (hrow i).2.1]
  have hspan : ∀ x : V 3, (0 ≤ x 1 - x 0 ∧ 0 ≤ x 1 + x 0 ∧ 0 ≤ x 2) →
      ∃ c : Fin 3 → ℝ, (∀ i, 0 ≤ c i) ∧ x = ∑ i, c i • v i := by
    intro x hx
    have hh : x ∈ (C : Set (V 3)) := by rw [hC]; exact hx
    rwa [hvcone] at hh
  have select : ∀ c a : Fin 3 → ℝ, (∀ l, 0 ≤ c l) → (∀ l, 0 ≤ a l) →
      ∑ l, c l * a l = 1 → ∃ i, 0 < c i ∧ 0 < a i := by
    intro c a hc ha hs
    obtain ⟨i, hi, hp⟩ := (Finset.sum_pos_iff_of_nonneg
      (fun l _ => mul_nonneg (hc l) (ha l))).mp (by rw [hs]; norm_num)
    rcases mul_pos_iff.mp hp with hp | hp
    · exact ⟨i, hp⟩
    · exact False.elim ((not_lt_of_ge (hc i)) hp.1)
  obtain ⟨cp, hcp, hep⟩ := hspan ![1, 1, 0] (by change (0 : ℝ) ≤ 1 - 1 ∧ 0 ≤ 1 + 1 ∧ 0 ≤ 0; norm_num)
  have hpx : ∑ l, cp l * v l 0 = 1 := by
    have hh := congrFun hep 0
    simpa only [Finset.sum_apply, Pi.smul_apply, smul_eq_mul] using hh.symm
  have hpy : ∑ l, cp l * v l 1 = 1 := by
    have hh := congrFun hep 1
    simpa only [Finset.sum_apply, Pi.smul_apply, smul_eq_mul] using hh.symm
  have hpz : ∑ l, cp l * v l 2 = 0 := by
    have hh := congrFun hep 2
    simpa only [Finset.sum_apply, Pi.smul_apply, smul_eq_mul] using hh.symm
  obtain ⟨i, hcpi, hyi⟩ := select cp (fun l => v l 1) hcp hy hpy
  have hpface : ∑ l, cp l * (v l 1 - v l 0) = 0 := by
    simp only [mul_sub, Finset.sum_sub_distrib]
    rw [hpy, hpx, sub_self]
  have hi0 : v i 0 = v i 1 := by
    have hh := (Finset.sum_eq_zero_iff_of_nonneg
      (fun l _ => mul_nonneg (hcp l) (hrow l).1)).mp hpface i (Finset.mem_univ _)
    exact (sub_eq_zero.mp ((mul_eq_zero.mp hh).resolve_left hcpi.ne')).symm
  have hi2 : v i 2 = 0 := by
    have hh := (Finset.sum_eq_zero_iff_of_nonneg
      (fun l _ => mul_nonneg (hcp l) (hrow l).2.2)).mp hpz i (Finset.mem_univ _)
    exact (mul_eq_zero.mp hh).resolve_left hcpi.ne'
  obtain ⟨cm, hcm, hem⟩ := hspan ![-1, 1, 0] (by change (0 : ℝ) ≤ 1 - (-1) ∧ 0 ≤ 1 + (-1) ∧ 0 ≤ 0; norm_num)
  have hmx : ∑ l, cm l * v l 0 = -1 := by
    have hh := congrFun hem 0
    simpa only [Finset.sum_apply, Pi.smul_apply, smul_eq_mul] using hh.symm
  have hmy : ∑ l, cm l * v l 1 = 1 := by
    have hh := congrFun hem 1
    simpa only [Finset.sum_apply, Pi.smul_apply, smul_eq_mul] using hh.symm
  have hmz : ∑ l, cm l * v l 2 = 0 := by
    have hh := congrFun hem 2
    simpa only [Finset.sum_apply, Pi.smul_apply, smul_eq_mul] using hh.symm
  obtain ⟨j, hcmj, hyj⟩ := select cm (fun l => v l 1) hcm hy hmy
  have hmface : ∑ l, cm l * (v l 1 + v l 0) = 0 := by
    simp only [mul_add, Finset.sum_add_distrib]
    rw [hmy, hmx]
    norm_num
  have hj0 : v j 0 = -v j 1 := by
    have hh := (Finset.sum_eq_zero_iff_of_nonneg
      (fun l _ => mul_nonneg (hcm l) (hrow l).2.1)).mp hmface j (Finset.mem_univ _)
    have he := (mul_eq_zero.mp hh).resolve_left hcmj.ne'
    linarith
  have hj2 : v j 2 = 0 := by
    have hh := (Finset.sum_eq_zero_iff_of_nonneg
      (fun l _ => mul_nonneg (hcm l) (hrow l).2.2)).mp hmz j (Finset.mem_univ _)
    exact (mul_eq_zero.mp hh).resolve_left hcmj.ne'
  obtain ⟨cz, hcz, hez⟩ := hspan ![0, 0, 1] (by change (0 : ℝ) ≤ 0 - 0 ∧ 0 ≤ 0 + 0 ∧ 0 ≤ 1; norm_num)
  have hzy : ∑ l, cz l * v l 1 = 0 := by
    have hh := congrFun hez 1
    simpa only [Finset.sum_apply, Pi.smul_apply, smul_eq_mul] using hh.symm
  have hzz : ∑ l, cz l * v l 2 = 1 := by
    have hh := congrFun hez 2
    simpa only [Finset.sum_apply, Pi.smul_apply, smul_eq_mul] using hh.symm
  obtain ⟨k, hczk, hzk⟩ := select cz (fun l => v l 2) hcz (fun l => (hrow l).2.2) hzz
  have hk1 : v k 1 = 0 := by
    have hh := (Finset.sum_eq_zero_iff_of_nonneg
      (fun l _ => mul_nonneg (hcz l) (hy l))).mp hzy k (Finset.mem_univ _)
    exact (mul_eq_zero.mp hh).resolve_left hczk.ne'
  have hk0 : v k 0 = 0 := by linarith [(hrow k).1, (hrow k).2.1]
  have hij : i ≠ j := by intro he; subst j; linarith
  have hik : i ≠ k := by intro he; subst k; linarith
  have hjk : j ≠ k := by intro he; subst k; linarith
  have integer_ge_one : ∀ l m, 0 < v l m → 1 ≤ v l m := by
    intro l m hpos
    obtain ⟨a, ha⟩ := hvint l m
    rw [ha] at hpos ⊢
    have hapos : (0 : ℤ) < a := by exact_mod_cast hpos
    have ha1 : (1 : ℤ) ≤ a := by omega
    exact_mod_cast ha1
  have hi1 := integer_ge_one i 1 hyi
  have hj1 := integer_ge_one j 1 hyj
  have hk2 := integer_ge_one k 2 hzk
  let f : Fin 3 → Fin 3 := ![i, j, k]
  have hf : Function.Injective f := by
    intro r s he
    fin_cases r <;> fin_cases s
    · rfl
    · exact False.elim (hij he)
    · exact False.elim (hik he)
    · exact False.elim (hij he.symm)
    · rfl
    · exact False.elim (hjk he)
    · exact False.elim (hik he.symm)
    · exact False.elim (hjk he.symm)
    · rfl
  let e : Equiv.Perm (Fin 3) := Equiv.ofBijective f ⟨hf, Finite.surjective_of_injective hf⟩
  let M : Matrix (Fin 3) (Fin 3) ℝ := fun l m => v l m
  have hdet : |(M.submatrix e (Equiv.refl _)).det| = 1 :=
    (Matrix.abs_det_submatrix_equiv_equiv e (Equiv.refl _) M).trans hvdet
  have heqM : M.submatrix e (Equiv.refl _) =
      ![![v i 1, v i 1, 0], ![-v j 1, v j 1, 0], ![0, 0, v k 2]] := by
    ext r s
    fin_cases r <;> fin_cases s <;>
      simp [M, e, f, Matrix.submatrix, hi0, hi2, hj0, hj2, hk0, hk1]
  have hcalc : Matrix.det (![![v i 1, v i 1, 0], ![-v j 1, v j 1, 0], ![0, 0, v k 2]] :
      Matrix (Fin 3) (Fin 3) ℝ) = 2 * v i 1 * v j 1 * v k 2 := by
    simp [Matrix.det_fin_three]
    ring
  rw [heqM, hcalc, abs_of_pos (mul_pos (mul_pos (mul_pos (by norm_num) hyi) hyj) hzk)] at hdet
  have hprod2 : 1 ≤ v i 1 * v j 1 := by
    nlinarith [mul_nonneg (sub_nonneg.mpr hi1) (sub_nonneg.mpr hj1)]
  have hprod3 : 1 ≤ v i 1 * v j 1 * v k 2 := by
    nlinarith [mul_nonneg (sub_nonneg.mpr hprod2) (sub_nonneg.mpr hk2)]
  nlinarith

/-- The sum of the two actual triangle prisms has the product wedge as its
actual normal cone at the upper vertex. -/
theorem prism_sum_top_normalCone :
    (normalConeAt ((prism (triangle 1) 1).add (prism (triangle (-1)) 1))
      (prismPoint (vec2 0 1) 1 + prismPoint (vec2 0 1) 1) : Set (V 3)) =
      {u | 0 ≤ u 1 - u 0 ∧ 0 ≤ u 1 + u 0 ∧ 0 ≤ u 2} := by
  classical
  have hp : ∀ s : ℤ, prismPoint (vec2 0 1) 1 ∈ (prism (triangle s) 1).carrier := by
    intro s
    apply subset_convexHull ℝ _
    exact Finset.mem_image.mpr ⟨(vec2 0 1, 1), Finset.mem_product.mpr
      ⟨by simp [triangle], by simp⟩, rfl⟩
  rw [normalConeAt_add (hp 1) (hp (-1))]
  ext u
  change (u ∈ normalConeAt (prism (triangle 1) 1) (prismPoint (vec2 0 1) 1) ∧
      u ∈ normalConeAt (prism (triangle (-1)) 1) (prismPoint (vec2 0 1) 1)) ↔ _
  have hA : (u ∈ normalConeAt (prism (triangle 1) 1) (prismPoint (vec2 0 1) 1)) ↔
      planeProjection u ∈ normalConeAt (triangle 1) (vec2 0 1) ∧ 0 ≤ u 2 :=
    normal_prism_endpoint (triangle 1) (a := 1) (by norm_num)
      (p := vec2 0 1) (by simp [triangle]) true u
  have hB : (u ∈ normalConeAt (prism (triangle (-1)) 1) (prismPoint (vec2 0 1) 1)) ↔
      planeProjection u ∈ normalConeAt (triangle (-1)) (vec2 0 1) ∧ 0 ≤ u 2 :=
    normal_prism_endpoint (triangle (-1)) (a := 1) (by norm_num)
      (p := vec2 0 1) (by simp [triangle]) true u
  rw [hA, hB, normal_triangle_top, normal_triangle_top]
  simp only [planeProjection, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons,
    Int.cast_one, Int.cast_neg, one_mul, neg_one_mul, if_true]
  constructor
  · rintro ⟨⟨⟨hy, hx⟩, hz⟩, ⟨⟨_, hx'⟩, _⟩⟩
    exact ⟨by linarith, by linarith, hz⟩
  · rintro ⟨hp, hm, hz⟩
    exact ⟨⟨⟨by linarith, by linarith⟩, hz⟩, ⟨⟨by linarith, by linarith⟩, hz⟩⟩

/-- The three-dimensional Minkowski sum in the source is genuinely not
Delzant, with no dependence on a chosen finite vertex presentation. -/
theorem prism_triangle_sum_not_isDelzant :
    ¬ IsDelzant ((prism (triangle 1) 1).add (prism (triangle (-1)) 1)) := by
  let R := (prism (triangle 1) 1).add (prism (triangle (-1)) 1)
  let p := prismPoint (vec2 0 1) 1 + prismPoint (vec2 0 1) 1
  have hp : p ∈ R.carrier := by
    apply subset_convexHull ℝ _
    apply Finset.mem_image.mpr
    refine ⟨(prismPoint (vec2 0 1) 1, prismPoint (vec2 0 1) 1),
      Finset.mem_product.mpr ⟨?_, ?_⟩, rfl⟩
    all_goals
      exact Finset.mem_image.mpr ⟨(vec2 0 1, 1), Finset.mem_product.mpr
        ⟨by simp [triangle], by simp⟩, rfl⟩
  have hi : (interior (normalConeAt R p : Set (V 3))).Nonempty := by
    let U : Set (V 3) := {u | u 0 < u 1 ∧ -u 0 < u 1 ∧ 0 < u 2}
    have ho : IsOpen U := (isOpen_lt (continuous_apply 0) (continuous_apply 1)).inter
      ((isOpen_lt (continuous_apply 0).neg (continuous_apply 1)).inter
        (isOpen_lt continuous_const (continuous_apply 2)))
    have hs : U ⊆ (normalConeAt R p : Set (V 3)) := by
      intro u hu
      rw [prism_sum_top_normalCone]
      exact ⟨by linarith [hu.1], by linarith [hu.2.1], hu.2.2.le⟩
    exact ⟨![0, 1, 1], interior_maximal hs ho (by change (0 : ℝ) < 1 ∧ -0 < 1 ∧ 0 < 1; norm_num)⟩
  intro h
  exact not_smooth_product_wedge (normalConeAt R p) prism_sum_top_normalCone
    (normalConeAt_isSmooth_of_fan R h.2 hp hi)

/-- The explicit source perturbations are actual Delzant three-polytopes,
refine both given three-dimensional fans, and have exact Euclidean error 3t. -/
theorem source_prism_perturbation {t : ℝ} (ht : 0 < t) :
    IsDelzant ((prism (triangle 1) 1).add (exampleS.smul t)) ∧
      (NormalFan ((prism (triangle 1) 1).add (exampleS.smul t))).refines
        (NormalFan (prism (triangle 1) 1)) ∧
      (NormalFan ((prism (triangle 1) 1).add (exampleS.smul t))).refines
        (NormalFan (prism (triangle (-1)) 1)) ∧
      P17Contract.euclideanHausdorffDist
        ((prism (triangle 1) 1).add (exampleS.smul t)).carrier
        (prism (triangle 1) 1).carrier = 3 * t := by
  obtain ⟨hP, hQ, hS, hSP, hSQ⟩ := source_prisms_delzant_refinement
  let S : DelzantPolytope 3 := ⟨exampleS, hS⟩
  have hd := add_smul_isDelzant_of_refines (prism (triangle 1) 1) hP.1 S hSP ht
  have hadd := normalFan_add (prism (triangle 1) 1) (exampleS.smul t)
  rw [normalFan_smul_eq exampleS ht] at hadd
  have hmeet := Fan.meet_equiv_of_refines hSP
  have hRS := Fan.refines_trans hadd.1 hmeet.1
  exact ⟨hd, Fan.refines_trans hRS hSP, Fan.refines_trans hRS hSQ,
    example24_exact_euclidean_error (prism (triangle 1) 1) ht⟩

end Paper17.Example24
