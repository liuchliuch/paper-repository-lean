import UniformBorderRank.SetMultilinearPolynomial
import UniformBorderRank.DerivativeSpace
import UniformBorderRank.SupportRank
import UniformBorderRank.FlatteningFacts
import UniformBorderRank.RankAllCuts

/-! The full partial-derivative space of the actual set-multilinear polynomial
has one independent multidegree component for each original tensor cut. -/
noncomputable section
namespace UniformBorderRank
open Finset

variable {N : ℕ} {d : Fin N → ℕ}

/-- The actual coefficient row space at a cut. -/
def derivativeRowSpace (T : Coeffs d) (S : Finset (Fin N)) :
    Submodule ℂ (CutIndex d Sᶜ → ℂ) :=
  Submodule.span ℂ (Set.range (flatCoeff d T S))

/-- The polynomial obtained from one actual flattening row. -/
def cutRowPolynomial (T : Coeffs d) (S : Finset (Fin N)) (a : CutIndex d S) :
    MvPolynomial (GroupVar d) ℂ := groupPolynomial Sᶜ (flatCoeff d T S a)

/-- Sum the polynomial images of all the actual flattening row spaces. -/
def derivativeRowSum (T : Coeffs d) :
    (∀ S : Finset (Fin N), derivativeRowSpace T S) →ₗ[ℂ] MvPolynomial (GroupVar d) ℂ where
  toFun w := ∑ S, groupPolynomial Sᶜ (w S).val
  map_add' x y := by simp [map_add, sum_add_distrib]
  map_smul' c x := by simp [map_smul, smul_sum]

lemma derivativeRowSum_coeff (T : Coeffs d)
    (w : ∀ S : Finset (Fin N), derivativeRowSpace T S)
    (S : Finset (Fin N)) (v : CutIndex d Sᶜ) :
    MvPolynomial.coeff (groupExponent Sᶜ v) (derivativeRowSum T w) = (w S).val v := by
  classical
  change MvPolynomial.coeff (groupExponent Sᶜ v)
    (∑ A : Finset (Fin N), groupPolynomial Aᶜ (w A).val) = _
  calc
    _ = ∑ A : Finset (Fin N), MvPolynomial.coeff (groupExponent Sᶜ v)
        (groupPolynomial Aᶜ (w A).val) :=
      MvPolynomial.coeff_sum univ (fun A : Finset (Fin N) =>
        groupPolynomial Aᶜ (w A).val) (groupExponent Sᶜ v)
    _ = _ := by
      rw [sum_eq_single S]
      · exact groupPolynomial_coeff Sᶜ (w S).val v
      · intro A _ hAS
        exact groupPolynomial_coeff_of_ne Aᶜ Sᶜ (fun h => hAS (compl_injective h)) _ v
      · simp

/-- Different remaining multidegrees are genuinely independent inside the
actual polynomial ring, as witnessed by their monomial coefficients. -/
theorem derivativeRowSum_injective (T : Coeffs d) : Function.Injective (derivativeRowSum T) := by
  intro x y h
  funext S
  apply Subtype.ext
  funext v
  have he := congrArg (MvPolynomial.coeff (groupExponent Sᶜ v)) h
  simpa only [derivativeRowSum_coeff] using he

/-- The dimension of the polynomial image of all cuts is the sum of the
actual flattening ranks; identification with actual derivatives is proved below. -/
theorem derivativeRowSum_finrank (T : Coeffs d) :
    Module.finrank ℂ (LinearMap.range (derivativeRowSum T)) =
      ∑ S : Finset (Fin N), schmidtRank d T S := by
  rw [LinearMap.finrank_range_of_inj (derivativeRowSum_injective T)]
  rw [Module.finrank_pi_fintype]
  rfl

lemma cutRowPolynomial_mem_range (T : Coeffs d) (S : Finset (Fin N)) (a : CutIndex d S) :
    cutRowPolynomial T S a ∈ LinearMap.range (derivativeRowSum T) := by
  classical
  let row : derivativeRowSpace T S := ⟨flatCoeff d T S a, Submodule.subset_span ⟨a, rfl⟩⟩
  refine ⟨Pi.single S row, ?_⟩
  change (∑ A : Finset (Fin N), groupPolynomial Aᶜ
    (((Pi.single S row : ∀ A : Finset (Fin N), derivativeRowSpace T A) A).val)) = _
  rw [sum_eq_single S]
  · simp only [Pi.single_eq_same]
    rfl
  · intro A _ hAS
    rw [Pi.single_eq_of_ne hAS]
    exact (groupPolynomial Aᶜ).map_zero
  · simp

/-- The range is exactly the subspace generated by the displayed cut polynomials. -/
lemma derivativeRowSum_range_le (T : Coeffs d)
    (W : Submodule ℂ (MvPolynomial (GroupVar d) ℂ))
    (h : ∀ S a, cutRowPolynomial T S a ∈ W) :
    LinearMap.range (derivativeRowSum T) ≤ W := by
  rintro _ ⟨w, rfl⟩
  change (∑ S, groupPolynomial Sᶜ (w S).val) ∈ W
  apply Submodule.sum_mem
  intro S _
  have hS : derivativeRowSpace T S ≤ W.comap (groupPolynomial Sᶜ) := by
    apply Submodule.span_le.mpr
    rintro _ ⟨a, rfl⟩
    exact h S a
  exact hS (w S).property

/-- Every cut row is an actual iterated partial derivative of `f_T`. -/
lemma cutPolynomial_mem_fullDerivativeSpace (T : Coeffs d) (S : Finset (Fin N)) :
    ∀ a : CutIndex d S, cutPolynomial T S a ∈ fullDerivativeSpace (tensorPolynomial d T) := by
  classical
  induction S using Finset.induction_on with
  | empty =>
    intro a
    rw [cutPolynomial_empty]
    exact self_mem_fullDerivativeSpace _
  | @insert i S hi ih =>
    intro a
    let a₀ : CutIndex d S := fun j hj => a j (mem_insert_of_mem hj)
    have h := pderiv_mem_fullDerivativeSpace (tensorPolynomial d T)
      (cutPolynomial T S a₀) (ih a₀) (⟨i, a i (mem_insert_self i S)⟩ : GroupVar d)
    rw [pderiv_cutPolynomial_of_not_mem T S a₀ i hi] at h
    have ha : insertCutRow S i a₀ (a i (mem_insert_self i S)) = a := by
      funext j hj
      by_cases hji : j = i
      · subst j; simp [insertCutRow]
      · simp [insertCutRow, hji, a₀]
    rwa [ha] at h

/-- The images of the original flattenings are precisely the actual full
partial-derivative space, rather than merely a dimension surrogate. -/
theorem range_derivativeRowSum_eq (T : Coeffs d) :
    LinearMap.range (derivativeRowSum T) = fullDerivativeSpace (tensorPolynomial d T) := by
  classical
  apply le_antisymm
  · apply derivativeRowSum_range_le
    intro S a
    exact cutPolynomial_mem_fullDerivativeSpace T S a
  · apply fullDerivativeSpace_le
    · let a : CutIndex d ∅ := fun i hi => False.elim (notMem_empty i hi)
      rw [← cutPolynomial_empty T a]
      exact cutRowPolynomial_mem_range T ∅ a
    · intro v q hq
      have hclosed : LinearMap.range (derivativeRowSum T) ≤
          (LinearMap.range (derivativeRowSum T)).comap (MvPolynomial.pderiv v).toLinearMap := by
        apply derivativeRowSum_range_le
        intro S a
        change MvPolynomial.pderiv v (cutPolynomial T S a) ∈ LinearMap.range (derivativeRowSum T)
        obtain ⟨i,x⟩ := v
        by_cases hi : i ∈ S
        · rw [pderiv_cutPolynomial_of_mem T S a i hi x]
          exact Submodule.zero_mem _
        · rw [pderiv_cutPolynomial_of_not_mem T S a i hi x]
          exact cutRowPolynomial_mem_range T (insert i S) (insertCutRow S i a x)
      exact hclosed hq

instance finiteDimensional_fullDerivativeSpace_tensorPolynomial (d : Fin N → ℕ) (T : Coeffs d) :
    FiniteDimensional ℂ (fullDerivativeSpace (tensorPolynomial d T)) := by
  rw [← range_derivativeRowSum_eq]
  infer_instance

/-- Equation (18): the dimension of the actual full formal partial-derivative
space, including order zero, is the sum of all actual tensor flattening ranks. -/
theorem finrank_fullDerivativeSpace_tensorPolynomial (d : Fin N → ℕ) (T : Coeffs d) :
    Module.finrank ℂ (fullDerivativeSpace (tensorPolynomial d T)) =
      ∑ S : Finset (Fin N), schmidtRank d T S := by
  rw [← range_derivativeRowSum_eq]
  exact derivativeRowSum_finrank T

/-- The full derivative dimension under the original maximal-cut hypothesis. -/
theorem finrank_fullDerivativeSpace_le (d : Fin N → ℕ) (hN : 2 ≤ N)
    (T : Coeffs d) (hT : T ≠ 0) :
    Module.finrank ℂ (fullDerivativeSpace (tensorPolynomial d T)) ≤
      2 ^ N * maxSchmidtRank d T := by
  rw [finrank_fullDerivativeSpace_tensorPolynomial]
  calc
    _ ≤ ∑ _S : Finset (Fin N), maxSchmidtRank d T :=
      sum_le_sum (fun S _ => schmidtRank_le_maxSchmidtRank d T hN hT S)
    _ = _ := by simp

/-- Even a nonzero decomposable tensor has full derivative dimension `2^N`. -/
theorem finrank_fullDerivativeSpace_of_isProduct (d : Fin N → ℕ)
    (T : Coeffs d) (hT : T ≠ 0) (hprod : isProduct T) :
    Module.finrank ℂ (fullDerivativeSpace (tensorPolynomial d T)) = 2 ^ N := by
  rw [finrank_fullDerivativeSpace_tensorPolynomial]
  simp_rw [schmidtRank_eq_one_of_isProduct hT hprod]
  simp

end UniformBorderRank
