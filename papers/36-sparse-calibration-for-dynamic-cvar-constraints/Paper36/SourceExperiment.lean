import Paper36.InfiniteExecution
import Paper36.SourceReplay
import Paper36.SourceBlocks
import Mathlib.Probability.Kernel.IonescuTulcea.Traj

/-! A canonical source experiment retains the latent model and the original
infinite row tapes. The learner is generated by measurable Markov kernels; the
infinite process is constructed by Mathlib's proved Ionescu--Tulcea theorem.
No fresh-unused-stack conclusion is an input to this construction. -/
namespace Paper36.SourceExperiment
noncomputable section
open scoped ENNReal
open MeasureTheory ProbabilityTheory

variable {X : Type*} [MeasurableSpace X]

/-- The last available state in a finite history. -/
def last (n : ℕ) (x : Finset.Iic n → X) : X := x ⟨n, Finset.mem_Iic.mpr le_rfl⟩

lemma measurable_last (n : ℕ) : Measurable (last (X := X) n) :=
  measurable_pi_apply _

/-- A homogeneous protocol viewed as a full-history protocol. -/
def historyKernel (κ : ProbabilityTheory.Kernel X X) (n : ℕ) :
    ProbabilityTheory.Kernel (Finset.Iic n → X) X :=
  κ.comap (last n) (measurable_last n)

instance historyKernel_markov (κ : ProbabilityTheory.Kernel X X) [IsMarkovKernel κ] (n : ℕ) :
    IsMarkovKernel (historyKernel κ n) := by
  unfold historyKernel
  infer_instance

def seed (x : X) : Finset.Iic 0 → X := fun _ => x

lemma measurable_seed : Measurable (seed (X := X)) := by
  apply measurable_pi_lambda
  intro i
  exact measurable_id

/-- The actual infinite execution kernel of the original transition protocol. -/
def executionKernel (κ : ProbabilityTheory.Kernel X X) [IsMarkovKernel κ] :
    ProbabilityTheory.Kernel X (ℕ → X) :=
  (ProbabilityTheory.Kernel.traj (X := fun _ => X) (historyKernel κ) 0).comap seed measurable_seed

instance executionKernel_markov (κ : ProbabilityTheory.Kernel X X) [IsMarkovKernel κ] :
    IsMarkovKernel (executionKernel κ) := by
  unfold executionKernel
  infer_instance

/-- The initial draw is retained, rather than discarded after process generation. -/
def experiment (ν : Measure X) (κ : ProbabilityTheory.Kernel X X) [IsMarkovKernel κ] :
    Measure (X × (ℕ → X)) := ν ⊗ₘ executionKernel κ

instance experiment_probability (ν : Measure X) [IsProbabilityMeasure ν]
    (κ : ProbabilityTheory.Kernel X X) [IsMarkovKernel κ] :
    IsProbabilityMeasure (experiment ν κ) := by
  unfold experiment
  infer_instance

theorem experiment_initial (ν : Measure X) [IsProbabilityMeasure ν]
    (κ : ProbabilityTheory.Kernel X X) [IsMarkovKernel κ] :
    (experiment ν κ).map Prod.fst = ν := Measure.fst_compProd _ _

/-- Every finite prefix of the constructed process has the actual iterated
protocol law, by the projective-limit property of `Kernel.traj`. -/
theorem executionKernel_prefix (κ : ProbabilityTheory.Kernel X X) [IsMarkovKernel κ]
    (n : ℕ) :
    (executionKernel κ).map (fun x : ℕ → X => fun i : Finset.Iic n => x i.val) =
      (ProbabilityTheory.Kernel.partialTraj (X := fun _ => X) (historyKernel κ) 0 n).comap seed measurable_seed := by
  rw [executionKernel, ← Kernel.comap_map_comm]
  · congr 1
    exact Kernel.traj_map_frestrictLe (X := fun _ => X) (κ := historyKernel κ) 0 n
  · exact measurable_pi_lambda _ fun i => measurable_pi_apply i.val

/-- In particular, retaining learner randomness does not change the initial
source draw. This is the marginal fact used for the arbitrary-prior tape law. -/
theorem experiment_retains (ν : Measure X) [IsProbabilityMeasure ν]
    (κ : ProbabilityTheory.Kernel X X) [IsMarkovKernel κ]
    {Y : Type*} [MeasurableSpace Y] (f : X → Y) (hf : Measurable f) :
    (experiment ν κ).map (fun z => f z.1) = ν.map f := by
  change (experiment ν κ).map (f ∘ Prod.fst) = ν.map f
  rw [← Measure.map_map hf measurable_fst, experiment_initial]


section Draws
variable {Base D : Type*} [MeasurableSpace Base] [MeasurableSpace D]

/-- Exactly the previous real draws; the state at index zero is only the seed. -/
def previous (n : ℕ) (x : Finset.Iic n → Base × D) : Fin n → D :=
  fun j => (x ⟨j.val+1, Finset.mem_Iic.mpr (by omega)⟩).2

lemma measurable_previous (n : ℕ) : Measurable (previous (Base := Base) (D := D) n) := by
  apply measurable_pi_lambda
  intro j
  exact (measurable_pi_apply _).snd

/-- Source inputs are arbitrary measurable choice kernels on the actual finite
history. The next kernel emits only a private choice; all physical observations
are subsequently deterministic reads of the retained original tapes. -/
def drawHistoryKernel (κ : (n : ℕ) → ProbabilityTheory.Kernel (Base × (Fin n → D)) D)
    (n : ℕ) : ProbabilityTheory.Kernel (Finset.Iic n → Base × D) (Base × D) :=
  (ProbabilityTheory.Kernel.id ×ₖ (κ n).comap
    (fun x => ((x ⟨0, Finset.mem_Iic.mpr (Nat.zero_le _)⟩).1, previous n x))
    (((measurable_pi_apply _).fst).prodMk (measurable_previous n))).map
      (fun z => ((z.1 ⟨0, Finset.mem_Iic.mpr (Nat.zero_le _)⟩).1, z.2))

lemma measurable_drawPair (n : ℕ) :
    Measurable (fun z : (Finset.Iic n → Base × D) × D =>
      ((z.1 ⟨0, Finset.mem_Iic.mpr (Nat.zero_le _)⟩).1,z.2)) :=
  (((measurable_pi_apply (⟨0, Finset.mem_Iic.mpr (Nat.zero_le n)⟩ : Finset.Iic n)).comp measurable_fst).fst).prodMk measurable_snd

instance drawHistoryKernel_markov
    (κ : (n : ℕ) → ProbabilityTheory.Kernel (Base × (Fin n → D)) D)
    [∀ n, IsMarkovKernel (κ n)] (n : ℕ) : IsMarkovKernel (drawHistoryKernel κ n) := by
  unfold drawHistoryKernel
  exact Kernel.IsMarkovKernel.map _ (measurable_drawPair n)

/-- One infinite source execution is constructed from the protocol, without
assuming that its finite histories admit a compatible coupling. -/
def drawExecutionKernel
    (κ : (n : ℕ) → ProbabilityTheory.Kernel (Base × (Fin n → D)) D)
    [∀ n, IsMarkovKernel (κ n)] (dummy : D) : ProbabilityTheory.Kernel Base (ℕ → D) :=
  ((ProbabilityTheory.Kernel.traj (X := fun _ => Base × D) (drawHistoryKernel κ) 0).comap
    (fun base => seed (base,dummy)) (measurable_seed.comp (measurable_id.prodMk measurable_const))).map
      (fun x n => (x (n+1)).2)

instance drawExecutionKernel_markov
    (κ : (n : ℕ) → ProbabilityTheory.Kernel (Base × (Fin n → D)) D)
    [∀ n, IsMarkovKernel (κ n)] (dummy : D) : IsMarkovKernel (drawExecutionKernel κ dummy) := by
  unfold drawExecutionKernel
  apply Kernel.IsMarkovKernel.map
  apply measurable_pi_lambda
  intro n
  exact (measurable_pi_apply (n+1)).snd

/-- The finite prefix of the infinite source process is exactly the iterated
original choice protocol, rather than a separately specified finite law. -/
theorem drawExecutionKernel_prefix
    (κ : (n : ℕ) → ProbabilityTheory.Kernel (Base × (Fin n → D)) D)
    [∀ n, IsMarkovKernel (κ n)] (dummy : D) (n : ℕ) :
    (drawExecutionKernel κ dummy).map (fun d : ℕ → D => fun i : Fin n => d i.val) =
      ((ProbabilityTheory.Kernel.partialTraj (X := fun _ => Base × D)
        (drawHistoryKernel κ) 0 n).comap
          (fun base => seed (base,dummy)) (measurable_seed.comp (measurable_id.prodMk measurable_const))).map
            (previous n) := by
  have hm : Measurable (fun x : ℕ → Base × D => fun n => (x (n+1)).2) :=
    measurable_pi_lambda _ fun j => (measurable_pi_apply (j+1)).snd
  have hp : Measurable (fun d : ℕ → D => fun i : Fin n => d i.val) :=
    measurable_pi_lambda _ fun j => measurable_pi_apply j.val
  have hr : Measurable (fun x : ℕ → Base × D => fun i : Finset.Iic n => x i.val) :=
    measurable_pi_lambda _ fun j => measurable_pi_apply j.val
  rw [drawExecutionKernel, ← Kernel.map_comp_right _ hm hp]
  change (((ProbabilityTheory.Kernel.traj (X := fun _ => Base × D) (drawHistoryKernel κ) 0).comap
    (fun base => seed (base,dummy)) (measurable_seed.comp (measurable_id.prodMk measurable_const))).map
      (previous n ∘ (fun x : ℕ → Base × D => fun i : Finset.Iic n => x i.val))) = _
  rw [Kernel.map_comp_right _ hr (measurable_previous n), ← Kernel.comap_map_comm]
  · have ht := Kernel.traj_map_frestrictLe (X := fun _ => Base × D)
      (κ := drawHistoryKernel κ) 0 n
    change (ProbabilityTheory.Kernel.traj (X := fun _ => Base × D) (drawHistoryKernel κ) 0).map
      (fun x : ℕ → Base × D => fun i : Finset.Iic n => x i.val) = _ at ht
    rw [ht]
  · exact hr

end Draws

section Prior
variable {M Row S D : Type*} [MeasurableSpace M] [Fintype S] [Nonempty S]
  [MeasurableSpace S] [DiscreteMeasurableSpace S] [MeasurableSpace D]

/-- The canonical experiment for any prior and any measurable adaptive source
protocol. Its single sample contains the latent model, the entire original
infinite raw tape and every actual learner draw. -/
def source (ν : Measure M) (P : M → Row → Paper36.CVaR.Law S)
    (hP : ∀ r s, Measurable (fun m => (P m r).mass s))
    (κ : (n : ℕ) → ProbabilityTheory.Kernel ((M × (Row × ℕ → S)) × (Fin n → D)) D)
    [∀ n, IsMarkovKernel (κ n)] (dummy : D) :
    Measure ((M × (Row × ℕ → S)) × (ℕ → D)) :=
  Paper36.InfiniteTapes.priorTapes ν P hP ⊗ₘ drawExecutionKernel κ dummy

instance source_probability (ν : Measure M) [IsProbabilityMeasure ν]
    (P : M → Row → Paper36.CVaR.Law S)
    (hP : ∀ r s, Measurable (fun m => (P m r).mass s))
    (κ : (n : ℕ) → ProbabilityTheory.Kernel ((M × (Row × ℕ → S)) × (Fin n → D)) D)
    [∀ n, IsMarkovKernel (κ n)] (dummy : D) : IsProbabilityMeasure (source ν P hP κ dummy) := by
  unfold source
  infer_instance

/-- The arbitrary original model prior is preserved by the actual learner. -/
theorem source_latent_law (ν : Measure M) [IsProbabilityMeasure ν]
    (P : M → Row → Paper36.CVaR.Law S)
    (hP : ∀ r s, Measurable (fun m => (P m r).mass s))
    (κ : (n : ℕ) → ProbabilityTheory.Kernel ((M × (Row × ℕ → S)) × (Fin n → D)) D)
    [∀ n, IsMarkovKernel (κ n)] (dummy : D) :
    (source ν P hP κ dummy).map (fun ω => ω.1.1) = ν := by
  change (source ν P hP κ dummy).map (Prod.fst ∘ Prod.fst) = ν
  rw [← Measure.map_map measurable_fst measurable_fst]
  rw [show (source ν P hP κ dummy).map Prod.fst = Paper36.InfiniteTapes.priorTapes ν P hP
    from Measure.fst_compProd _ _, Paper36.InfiniteTapes.priorTapes_latent_law]

/-- All raw iid-prefix fields of `Statistical.PosteriorSystem` follow from the
same constructed source measure, for every row and every prefix length. -/
theorem source_tape_model (ν : Measure M) [IsProbabilityMeasure ν]
    (P : M → Row → Paper36.CVaR.Law S)
    (hP : ∀ r s, Measurable (fun m => (P m r).mass s))
    (κ : (n : ℕ) → ProbabilityTheory.Kernel ((M × (Row × ℕ → S)) × (Fin n → D)) D)
    [∀ n, IsMarkovKernel (κ n)] (dummy : D) (r : Row) (n : ℕ) :
    condDistrib (fun ω : (M × (Row × ℕ → S)) × (ℕ → D) =>
      fun i : Fin n => ω.1.2 (r,i.val)) (fun ω => ω.1.1) (source ν P hP κ dummy)
      =ᵐ[ν] Paper36.RowTapes.iidKernel (fun m => P m r) (hP r) n :=
  Paper36.InfiniteTapes.priorTapes_prefix_after_extension ν P hP (drawExecutionKernel κ dummy) r n

end Prior

end
end Paper36.SourceExperiment
