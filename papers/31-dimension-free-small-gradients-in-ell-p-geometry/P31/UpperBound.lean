import P31.ExternalComposite
import P31.AccumulatedProx
import P31.RegularizedMinima
import P31.OuterAnalysis

/-!
# The actual accumulated gradient-query program

The history is generated by finite adaptive `Program.bind`, using only known
parameters and previous gradient replies. The scalar Clarkson theorem and the
complementary-composite objective theorem are the two explicit literature
inputs. Exact regularized minimizers occur only in the correctness proof.
-/

noncomputable section
open scoped BigOperators
namespace P31
open QueryProgram Schedule

/-- Known nondegenerate parameters; no unknown objective is stored here. -/
structure AccumulationData (ι : Type*) where
  p : ℝ
  κ : ℝ
  L : ℝ
  R : ℝ
  ε : ℝ
  initial : ι → ℝ
  hp : 2 ≤ p
  hκ : 1 < κ
  hκhi : κ ≤ 2
  hL : 0 < L
  hR : 0 < R
  hε : 0 < ε

namespace AccumulationData
variable {ι : Type*} [Fintype ι]

def firstWeight (a : AccumulationData ι) : ℝ :=
  initialWeight (vectorBiasCoefficient a.p * a.R^(a.p-1)) (theta a.p) (ratio a.κ) a.ε

def weight (a : AccumulationData ι) (k : ℕ) : ℝ := alpha a.firstWeight (tau a.p a.κ) (k+1)
def modulus (a : AccumulationData ι) (n : ℕ) : ℝ := sigma a.firstWeight (tau a.p a.κ) n

def regularizer (a : AccumulationData ι) (hist : ℕ → ι → ℝ) (n : ℕ) (x : ι → ℝ) : ℝ :=
  ∑ k ∈ Finset.range n, a.weight k * powerAtom a.p (hist k) x

lemma firstWeight_pos (a : AccumulationData ι) : 0 < a.firstWeight :=
  initialWeight_pos (mul_pos (vectorBiasCoefficient_pos a.p) (Real.rpow_pos_of_pos a.hR _))
    (theta_lt_one a.hp) (ratio_lt_one a.hκ) a.hε

lemma weight_pos (a : AccumulationData ι) (k : ℕ) : 0 < a.weight k :=
  alpha_pos a.firstWeight_pos (tau_gt_one a.hp a.hκhi) (by omega)

lemma modulus_pos (a : AccumulationData ι) (n : ℕ) : 0 < a.modulus (n+1) := by
  exact mul_pos a.firstWeight_pos (pow_pos (lt_trans zero_lt_one (tau_gt_one a.hp a.hκhi)) n)

lemma sum_weight (a : AccumulationData ι) (n : ℕ) :
    ∑ k ∈ Finset.range n, a.weight k = a.modulus n := sum_alpha _ _ _

@[simp] lemma regularizer_zero (a : AccumulationData ι) (hist : ℕ → ι → ℝ) (x : ι → ℝ) :
    a.regularizer hist 0 x = 0 := by simp [regularizer]

lemma regularizer_succ (a : AccumulationData ι) (hist : ℕ → ι → ℝ) (n : ℕ) (x : ι → ℝ) :
    a.regularizer hist (n+1) x = a.regularizer hist n x + a.weight n * powerAtom a.p (hist n) x := by
  exact Finset.sum_range_succ _ _

lemma regularizer_congr (a : AccumulationData ι) {hist hist' : ℕ → ι → ℝ} (n : ℕ)
    (h : ∀ k, k < n → hist k = hist' k) : a.regularizer hist n = a.regularizer hist' n := by
  funext x
  apply Finset.sum_congr rfl
  intro k hk
  rw [h k (Finset.mem_range.mp hk)]

lemma regularizer_jensen (a : AccumulationData ι) (hClarkson : ScalarWeightedClarkson a.p)
    (hist : ℕ → ι → ℝ) (n : ℕ) :
    LpPowerJensen a.p (a.modulus n) (a.regularizer hist n) := by
  rw [← a.sum_weight n]
  simpa only [mul_one] using lpPowerJensen_weighted_sum (Finset.range n) a.p (fun _ => 1)
    a.weight (fun k => powerAtom a.p (hist k)) (fun k _ => (a.weight_pos k).le)
    (fun k _ => powerAtom_jensen_of_scalar_clarkson (by linarith [a.hp]) hClarkson (hist k))

/-- The exact internal map depends only on the accumulated known atoms. -/
def prox (a : AccumulationData ι) (hist : ℕ → ι → ℝ) (n : ℕ) : CompositeProx (ι → ℝ) :=
  accumulatedCompositeProx (Finset.range n) a.p a.hp a.weight hist
    (fun k _ => (a.weight_pos k).le) (hist (n-1))

lemma prox_valid (a : AccumulationData ι) (hist : ℕ → ι → ℝ) (n : ℕ) :
    IsCompositeProx a.p (a.regularizer hist n) (hist (n-1)) (a.prox hist n) := by
  intro g A m hA hm y
  exact accumulatedCompositeProx_minimizes (Finset.range n) a.p a.hp a.weight hist
    (fun k _ => (a.weight_pos k).le) (hist (n-1)) g A m hA.le hm y

/-- One stage, including its prescribed warm-start center and radii. -/
def stage {C : ℝ} (a : AccumulationData ι)
    (engine : ExternalComplementaryComposite ι a.p a.κ C) (hist : ℕ → ι → ℝ) (n : ℕ) :
    Program (ι → ℝ) (ι → ℝ) (ι → ℝ) :=
  engine.routine (a.regularizer hist (n+1)) (hist n) a.L (a.modulus (n+1))
    (radius a.R n) (radius a.R (n+1)) (a.prox hist (n+1))

/-- The complete adaptive history. Every stage is appended by `bind`;
`Function.update` stores its reply-dependent output without querying it. -/
def historyProgram {C : ℝ} (a : AccumulationData ι)
    (engine : ExternalComplementaryComposite ι a.p a.κ C) : ℕ →
      Program (ι → ℝ) (ι → ℝ) (ℕ → ι → ℝ)
  | 0 => .pure (fun _ => a.initial)
  | n+1 => (a.historyProgram engine n).bind (fun hist =>
      (a.stage engine hist n).map (fun z => Function.update hist (n+1) z))

/-- A realized history is only used in the analysis of a run. -/
def realizedHistory {C : ℝ} (a : AccumulationData ι)
    (engine : ExternalComplementaryComposite ι a.p a.κ C) (oracle : (ι → ℝ) → ι → ℝ)
    (n : ℕ) : ℕ → ι → ℝ := ((a.historyProgram engine n).run oracle).value

def iterates {C : ℝ} (a : AccumulationData ι)
    (engine : ExternalComplementaryComposite ι a.p a.κ C) (oracle : (ι → ℝ) → ι → ℝ)
    (n : ℕ) : ι → ℝ := a.realizedHistory engine oracle n n

@[simp] lemma realizedHistory_zero {C : ℝ} (a : AccumulationData ι)
    (engine : ExternalComplementaryComposite ι a.p a.κ C) (oracle : (ι → ℝ) → ι → ℝ) :
    a.realizedHistory engine oracle 0 = fun _ => a.initial := rfl

lemma realizedHistory_succ {C : ℝ} (a : AccumulationData ι)
    (engine : ExternalComplementaryComposite ι a.p a.κ C) (oracle : (ι → ℝ) → ι → ℝ) (n : ℕ) :
    a.realizedHistory engine oracle (n+1) = Function.update (a.realizedHistory engine oracle n)
      (n+1) (((a.stage engine (a.realizedHistory engine oracle n) n).run oracle).value) := by
  simp [realizedHistory, historyProgram, Program.map]

lemma history_prefix {C : ℝ} (a : AccumulationData ι)
    (engine : ExternalComplementaryComposite ι a.p a.κ C) (oracle : (ι → ℝ) → ι → ℝ)
    (n k : ℕ) (hk : k ≤ n) : a.realizedHistory engine oracle n k = a.iterates engine oracle k := by
  induction n with
  | zero =>
    have hkzero : k = 0 := by omega
    subst k
    rfl
  | succ n ih =>
    by_cases he : k = n+1
    · subst k; rfl
    · rw [realizedHistory_succ, Function.update_of_ne he]
      exact ih (by omega)

@[simp] lemma iterates_zero {C : ℝ} (a : AccumulationData ι)
    (engine : ExternalComplementaryComposite ι a.p a.κ C) (oracle : (ι → ℝ) → ι → ℝ) :
    a.iterates engine oracle 0 = a.initial := rfl

lemma iterates_succ {C : ℝ} (a : AccumulationData ι)
    (engine : ExternalComplementaryComposite ι a.p a.κ C) (oracle : (ι → ℝ) → ι → ℝ) (n : ℕ) :
    a.iterates engine oracle (n+1) =
      ((a.stage engine (a.realizedHistory engine oracle n) n).run oracle).value := by
  simp [iterates, realizedHistory_succ]

lemma realized_regularizer {C : ℝ} (a : AccumulationData ι)
    (engine : ExternalComplementaryComposite ι a.p a.κ C) (oracle : (ι → ℝ) → ι → ℝ) (n : ℕ) :
    a.regularizer (a.realizedHistory engine oracle n) (n+1) =
      a.regularizer (a.iterates engine oracle) (n+1) :=
  a.regularizer_congr (n+1) (fun k hk => a.history_prefix engine oracle n k (by omega))

lemma norm_sub_reverse (p : ℝ) (x y : ι → ℝ) : lpNorm p (x-y) = lpNorm p (y-x) := by
  rw [show x-y = -(y-x) by abel, lpNorm_neg]

/-- All exact stage minima exist for the actual recursively generated history.
This is an analytical sequence, never an input to `historyProgram`. -/
theorem exists_exactMinima {C : ℝ} (a : AccumulationData ι)
    (engine : ExternalComplementaryComposite ι a.p a.κ C)
    (hClarkson : ScalarWeightedClarkson a.p)
    (f : (ι → ℝ) → ℝ) (grad : (ι → ℝ) → ι → ℝ)
    (hf : ConvexOn ℝ Set.univ f)
    (hg : ∀ x, HasFDerivAt f (coordinateFunctional (grad x)) x)
    (xstar : ι → ℝ) (hstar : ∀ y, f xstar ≤ f y) :
    ∃ exactMin : ℕ → ι → ℝ, exactMin 0 = xstar ∧ ∀ n y,
      f (exactMin n) + a.regularizer (a.iterates engine grad) n (exactMin n) ≤
        f y + a.regularizer (a.iterates engine grad) n y := by
  have hcont : Continuous f := (show Differentiable ℝ f from fun x => (hg x).differentiableAt).continuous
  have hex (n : ℕ) : ∃ z, ∀ y,
      f z + a.regularizer (a.iterates engine grad) (n+1) z ≤
        f y + a.regularizer (a.iterates engine grad) (n+1) y := by
    exact (regularizedObjective_existsUnique_minimizer (Finset.range (n+1)) a.hp hClarkson
      f hcont hf xstar hstar a.weight (a.iterates engine grad)
      (fun k _ => (a.weight_pos k).le) 0 (by simp) (a.weight_pos 0)).exists
  choose z hz using hex
  refine ⟨fun n => match n with | 0 => xstar | k+1 => z k, rfl, ?_⟩
  intro n y
  cases n with
  | zero => simpa using hstar y
  | succ n => exact hz n y

/-- The warm-start transport and objective-to-distance contraction are proved
inductively from true minima and the one-stage objective theorem. -/
theorem generated_stage_certificates {C : ℝ} (a : AccumulationData ι)
    (engine : ExternalComplementaryComposite ι a.p a.κ C)
    (hClarkson : ScalarWeightedClarkson a.p)
    (f : (ι → ℝ) → ℝ) (grad : (ι → ℝ) → ι → ℝ)
    (hf : ConvexOn ℝ Set.univ f)
    (hg : ∀ x, HasFDerivAt f (coordinateFunctional (grad x)) x)
    (hh : ∀ x y, lpNorm (dualExponent a.p) (grad x-grad y) ≤ a.L * lpNorm a.p (x-y)^(a.κ-1))
    (exactMin : ℕ → ι → ℝ)
    (hmin : ∀ n y, f (exactMin n) + a.regularizer (a.iterates engine grad) n (exactMin n) ≤
      f y + a.regularizer (a.iterates engine grad) n y)
    (hbase : lpNorm a.p (a.initial-exactMin 0) ≤ a.R) :
    (∀ n, lpNorm a.p (exactMin (n+1)-a.iterates engine grad n) ≤ radius a.R n) ∧
    (∀ n, lpNorm a.p (a.iterates engine grad n-exactMin n) ≤ radius a.R n) := by
  let x := a.iterates engine grad
  have hp0 : 0 < a.p := by linarith [a.hp]
  have hp1 : 1 < a.p := by linarith [a.hp]
  have hstep (n : ℕ) (hc : lpNorm a.p (x n-exactMin n) ≤ radius a.R n) :
      lpNorm a.p (exactMin (n+1)-x n) ≤ radius a.R n ∧
      lpNorm a.p (x (n+1)-exactMin (n+1)) ≤ radius a.R (n+1) := by
    have hnew : ∀ y,
        (f (exactMin (n+1)) + a.regularizer x n (exactMin (n+1))) +
          a.weight n * powerAtom a.p (x n) (exactMin (n+1)) ≤
        (f y + a.regularizer x n y) + a.weight n * powerAtom a.p (x n) y := by
      intro y
      have hm := hmin (n+1) y
      rw [a.regularizer_succ, a.regularizer_succ] at hm
      linarith
    have ht : lpNorm a.p (exactMin (n+1)-x n) ≤ radius a.R n :=
      (vector_minimizer_transport hp1 (a.weight_pos n)
        (fun y => f y + a.regularizer x n y) (x n) (exactMin n) (exactMin (n+1))
        (hmin n) hnew).trans (by rw [norm_sub_reverse]; exact hc)
    refine ⟨ht, ?_⟩
    rw [show x (n+1) = ((a.stage engine (a.realizedHistory engine grad n) n).run grad).value from
      a.iterates_succ engine grad n]
    apply externalComposite_contraction engine hp0
      (a.regularizer (a.realizedHistory engine grad n) (n+1))
      (a.realizedHistory engine grad n n) (a.prox (a.realizedHistory engine grad n) (n+1))
      a.hL (a.modulus_pos n) (radius_pos a.hR n) (radius_pos a.hR (n+1))
      (by rw [radius_succ]; linarith [radius_pos a.hR n])
      (a.regularizer_jensen hClarkson _ _)
      (by simpa using a.prox_valid (a.realizedHistory engine grad n) (n+1))
      f grad (exactMin (n+1)) hf hg hh
    · rw [a.realized_regularizer engine grad n]
      exact hmin (n+1)
    · change lpNorm a.p (x n-exactMin (n+1)) ≤ radius a.R n
      rw [norm_sub_reverse]
      exact ht
  have hc : ∀ n, lpNorm a.p (x n-exactMin n) ≤ radius a.R n := by
    intro n
    induction n with
    | zero => simpa [x] using hbase
    | succ n ih => exact (hstep n ih).2
  exact ⟨fun n => (hstep n (hc n)).1, hc⟩

lemma stage_budget_eq {C : ℝ} (a : AccumulationData ι) (n : ℕ) :
    compositeQueryBudget C a.p a.κ a.L (a.modulus (n+1)) (radius a.R n) (radius a.R (n+1)) =
      queryBudget C (vectorBiasCoefficient a.p) a.L a.R a.p a.κ a.ε n := by
  have hr : radius a.R n / radius a.R (n+1) = 2 := by
    rw [radius_succ]
    field_simp [(radius_pos a.hR n).ne']
  unfold compositeQueryBudget queryBudget stageScale modulus firstWeight
  rw [hr]
  congr 1
  ring

lemma stage_calls_le {C : ℝ} (a : AccumulationData ι)
    (engine : ExternalComplementaryComposite ι a.p a.κ C) (hist : ℕ → ι → ℝ)
    (oracle : (ι → ℝ) → ι → ℝ) (n : ℕ) :
    ((a.stage engine hist n).run oracle).calls ≤
      queryBudget C (vectorBiasCoefficient a.p) a.L a.R a.p a.κ a.ε n := by
  rw [← a.stage_budget_eq n]
  exact engine.calls_le _ _ _ _ _ _ _ _ a.hL (a.modulus_pos n)
    (radius_pos a.hR n) (radius_pos a.hR (n+1))
    (by rw [radius_succ]; linarith [radius_pos a.hR n])

/-- Calls count the actual adaptive execution, not merely a preselected list
of stage certificates or supplied per-stage query counts. -/
theorem historyProgram_calls_le {C : ℝ} (a : AccumulationData ι)
    (engine : ExternalComplementaryComposite ι a.p a.κ C) (oracle : (ι → ℝ) → ι → ℝ) (n : ℕ) :
    ((a.historyProgram engine n).run oracle).calls ≤
      ∑ k ∈ Finset.range n, queryBudget C (vectorBiasCoefficient a.p) a.L a.R a.p a.κ a.ε k := by
  induction n with
  | zero => simp [historyProgram]
  | succ n ih =>
    simp only [historyProgram, Program.calls_bind, Program.map, Program.run_pure, Nat.add_zero]
    rw [Finset.sum_range_succ]
    exact Nat.add_le_add ih (a.stage_calls_le engine _ oracle n)

/-- The actual finite adaptive output program in the nontrivial regime. -/
def outputProgram {C : ℝ} (a : AccumulationData ι)
    (engine : ExternalComplementaryComposite ι a.p a.κ C) : Program (ι → ℝ) (ι → ℝ) (ι → ℝ) :=
  (a.historyProgram engine (stageCount a.L a.R a.κ a.ε)).map
    (fun hist => hist (stageCount a.L a.R a.κ a.ε))

lemma stageCount_ge_one (a : AccumulationData ι) (hsmall : a.ε < a.L*a.R^(a.κ-1)) :
    1 ≤ stageCount a.L a.R a.κ a.ε := by
  have hq : 1 < 2*a.L*a.R^(a.κ-1)/a.ε := (lt_div_iff₀ a.hε).mpr (by nlinarith [a.hε])
  have hp : 0 < Real.logb 2 (2*a.L*a.R^(a.κ-1)/a.ε)/(a.κ-1) :=
    div_pos (Real.logb_pos (by norm_num) hq) (sub_pos.mpr a.hκ)
  exact Nat.ceil_pos.mpr hp

/-- Theorem 1.2 in the nontrivial regime, derived for the actual adaptive
program. Only the two cited literature inputs remain explicit. -/
theorem outputProgram_accuracy_and_complexity {C : ℝ} (a : AccumulationData ι)
    (hC : 0 ≤ C) (engine : ExternalComplementaryComposite ι a.p a.κ C)
    (hClarkson : ScalarWeightedClarkson a.p)
    (hsmall : a.ε < a.L*a.R^(a.κ-1))
    (f : (ι → ℝ) → ℝ) (grad : (ι → ℝ) → ι → ℝ)
    (hf : ConvexOn ℝ Set.univ f)
    (hg : ∀ x, HasFDerivAt f (coordinateFunctional (grad x)) x)
    (hh : ∀ x y, lpNorm (dualExponent a.p) (grad x-grad y) ≤ a.L * lpNorm a.p (x-y)^(a.κ-1))
    (xstar : ι → ℝ) (hstar : ∀ y, f xstar ≤ f y)
    (hr : lpNorm a.p (a.initial-xstar) ≤ a.R) :
    lpNorm (dualExponent a.p) (grad ((a.outputProgram engine).run grad).value) ≤ a.ε ∧
    (((a.outputProgram engine).run grad).calls : ℝ) ≤
      queryConstant C (vectorBiasCoefficient a.p) a.p a.κ *
        (a.L*a.R^(a.κ-1)/a.ε)^beta a.p a.κ := by
  obtain ⟨exactMin, hzero, hmin⟩ := a.exists_exactMinima engine hClarkson f grad hf hg xstar hstar
  have hbase : lpNorm a.p (a.initial-exactMin 0) ≤ a.R := by simpa [hzero] using hr
  obtain ⟨ht, hc⟩ := a.generated_stage_certificates engine hClarkson f grad hf hg hh exactMin hmin hbase
  constructor
  · have ha := vector_outer_accuracy a.hp a.hκ a.hκhi a.hL a.hR a.hε f grad
      (a.iterates engine grad) exactMin hg hh
      (fun s hs _ => by obtain ⟨n, rfl⟩ := Nat.exists_eq_succ_of_ne_zero (by omega : s ≠ 0); simpa using ht n)
      (fun s _ _ => hc s) (a.stageCount_ge_one hsmall) (hmin _)
    simpa [outputProgram, Program.map, iterates, realizedHistory] using ha
  · have hc : (((a.outputProgram engine).run grad).calls : ℝ) ≤
        ∑ k ∈ Finset.range (stageCount a.L a.R a.κ a.ε),
          (queryBudget C (vectorBiasCoefficient a.p) a.L a.R a.p a.κ a.ε k : ℝ) := by
      have hnat := a.historyProgram_calls_le engine grad (stageCount a.L a.R a.κ a.ε)
      simpa only [outputProgram, Program.map, Program.calls_bind, Program.run_pure,
        Nat.add_zero, Nat.cast_sum] using (show
        (((a.historyProgram engine (stageCount a.L a.R a.κ a.ε)).run grad).calls : ℝ) ≤
          ((∑ k ∈ Finset.range (stageCount a.L a.R a.κ a.ε),
            queryBudget C (vectorBiasCoefficient a.p) a.L a.R a.p a.κ a.ε k : ℕ) : ℝ) from
        Nat.cast_le.mpr hnat)
    exact hc.trans (total_query_budget_le hC (vectorBiasCoefficient_pos a.p)
      a.hL a.hR a.hp a.hκ a.hκhi a.hε hsmall.le)

end AccumulationData

variable {ι : Type*} [Fintype ι]

/-- The all-accuracy method family. Its constructor depends only on known
parameters, the fixed external engine, and the requested accuracy. -/
def vectorGradientMethod {C : ℝ} (p κ L R ε : ℝ) (initial : ι → ℝ)
    (hp : 2 ≤ p) (hκ : 1 < κ) (hκhi : κ ≤ 2)
    (engine : ExternalComplementaryComposite ι p κ C) : Program (ι → ℝ) (ι → ℝ) (ι → ℝ) :=
  if h : 0 < L ∧ 0 < R ∧ 0 < ε ∧ ε < L*R^(κ-1) then
    let a : AccumulationData ι := ⟨p, κ, L, R, ε, initial, hp, hκ, hκhi, h.1, h.2.1, h.2.2.1⟩
    a.outputProgram engine
  else .pure initial

/-- The easy regime really returns the initial point without an oracle call. -/
theorem vectorGradientMethod_zero {C : ℝ} (p κ L R ε : ℝ) (initial : ι → ℝ)
    (hp : 2 ≤ p) (hκ : 1 < κ) (hκhi : κ ≤ 2)
    (engine : ExternalComplementaryComposite ι p κ C)
    (oracle : (ι → ℝ) → ι → ℝ) (heasy : L*R^(κ-1) ≤ ε) :
    ((vectorGradientMethod p κ L R ε initial hp hκ hκhi engine).run oracle).value = initial ∧
    ((vectorGradientMethod p κ L R ε initial hp hκ hκhi engine).run oracle).calls = 0 := by
  have hn : ¬ (0 < L ∧ 0 < R ∧ 0 < ε ∧ ε < L*R^(κ-1)) :=
    fun h => (not_lt_of_ge heasy) h.2.2.2
  simp [vectorGradientMethod, dif_neg hn]

/-- Fermat stationarity gives the actual vector zero gradient at a true
unregularized minimizer. -/
lemma vector_gradient_zero_at_minimizer (f : (ι → ℝ) → ℝ)
    (grad : (ι → ℝ) → ι → ℝ) (z : ι → ℝ)
    (hg : HasFDerivAt f (coordinateFunctional (grad z)) z) (hz : ∀ y, f z ≤ f y) : grad z = 0 := by
  have hm : IsLocalMin f z := Filter.Eventually.of_forall hz
  have hcf := hm.hasFDerivAt_eq_zero hg
  apply coordinateFunctional_injective
  rw [hcf]
  ext h
  simp [coordinateFunctional_apply]

/-- Theorem 1.2 for every positive requested accuracy, including L=0, R=0,
and the exact zero-query branch. The displayed constant depends only on p,
kappa and the dimension-uniform literature constant C. -/
theorem vectorGradientMethod_guarantee {p κ C L R ε : ℝ}
    (hp : 2 ≤ p) (hκ : 1 < κ) (hκhi : κ ≤ 2) (hC : 0 ≤ C)
    (hL : 0 ≤ L) (hR : 0 ≤ R) (hε : 0 < ε)
    (hClarkson : ScalarWeightedClarkson p)
    (engine : ExternalComplementaryComposite ι p κ C)
    (initial : ι → ℝ) (f : (ι → ℝ) → ℝ) (grad : (ι → ℝ) → ι → ℝ)
    (hf : ConvexOn ℝ Set.univ f)
    (hg : ∀ x, HasFDerivAt f (coordinateFunctional (grad x)) x)
    (hh : ∀ x y, lpNorm (dualExponent p) (grad x-grad y) ≤ L * lpNorm p (x-y)^(κ-1))
    (xstar : ι → ℝ) (hstar : ∀ y, f xstar ≤ f y)
    (hr : lpNorm p (initial-xstar) ≤ R) :
    lpNorm (dualExponent p) (grad ((vectorGradientMethod p κ L R ε initial hp hκ hκhi engine).run grad).value) ≤ ε ∧
    (((vectorGradientMethod p κ L R ε initial hp hκ hκhi engine).run grad).calls : ℝ) ≤
      queryConstant C (vectorBiasCoefficient p) p κ * (1 + (L*R^(κ-1)/ε)^beta p κ) := by
  have hK := queryConstant_pos hC (vectorBiasCoefficient_pos p) hp hκ
  by_cases hactive : 0 < L ∧ 0 < R ∧ 0 < ε ∧ ε < L*R^(κ-1)
  · let a : AccumulationData ι := ⟨p, κ, L, R, ε, initial, hp, hκ, hκhi,
      hactive.1, hactive.2.1, hactive.2.2.1⟩
    have h := a.outputProgram_accuracy_and_complexity hC engine hClarkson hactive.2.2.2
      f grad hf hg hh xstar hstar hr
    simp only [vectorGradientMethod, dif_pos hactive]
    refine ⟨h.1, h.2.trans ?_⟩
    exact mul_le_mul_of_nonneg_left (le_add_of_nonneg_left (by norm_num)) hK.le
  · have heasy : L*R^(κ-1) ≤ ε := by
      by_contra hfail
      have hsmall : ε < L*R^(κ-1) := lt_of_not_ge hfail
      have hM : 0 < L*R^(κ-1) := lt_trans hε hsmall
      have hLpos : 0 < L := by
        rcases lt_or_eq_of_le hL with hpos | heq
        · exact hpos
        · rw [← heq, zero_mul] at hM
          linarith
      have hRpos : 0 < R := by
        rcases lt_or_eq_of_le hR with hpos | heq
        · exact hpos
        · rw [← heq, Real.zero_rpow (ne_of_gt (sub_pos.mpr hκ)), mul_zero] at hM
          linarith
      exact hactive ⟨hLpos, hRpos, hε, hsmall⟩
    have hrun := vectorGradientMethod_zero p κ L R ε initial hp hκ hκhi engine grad heasy
    refine ⟨?_, ?_⟩
    · rw [hrun.1]
      exact vector_zero_query_bound (by linarith : 1 < p) grad initial xstar hL
        (sub_pos.mpr hκ).le hh (vector_gradient_zero_at_minimizer f grad xstar (hg _) hstar) hr heasy
    · rw [hrun.2, Nat.cast_zero]
      have hpow : 0 ≤ (L*R^(κ-1)/ε)^beta p κ :=
        Real.rpow_nonneg (div_nonneg (mul_nonneg hL (Real.rpow_nonneg hR _)) hε.le) _
      exact mul_nonneg hK.le (by linarith)

/-- A single constant C from the external theorem gives the same explicit
query constant simultaneously in every positive finite dimension. -/
theorem vector_upper_bound_dimension_uniform {p κ C L R ε : ℝ}
    (hp : 2 ≤ p) (hκ : 1 < κ) (hκhi : κ ≤ 2) (hC : 0 ≤ C)
    (hL : 0 ≤ L) (hR : 0 ≤ R) (hε : 0 < ε)
    (hClarkson : ScalarWeightedClarkson p) (source : ExternalCompositeFamily p κ C)
    (d : ℕ) (hd : 0 < d)
    (initial : Fin d → ℝ) (f : (Fin d → ℝ) → ℝ) (grad : (Fin d → ℝ) → Fin d → ℝ)
    (hf : ConvexOn ℝ Set.univ f)
    (hg : ∀ x, HasFDerivAt f (coordinateFunctional (grad x)) x)
    (hh : ∀ x y, lpNorm (dualExponent p) (grad x-grad y) ≤ L * lpNorm p (x-y)^(κ-1))
    (xstar : Fin d → ℝ) (hstar : ∀ y, f xstar ≤ f y)
    (hr : lpNorm p (initial-xstar) ≤ R) :
    lpNorm (dualExponent p) (grad ((vectorGradientMethod p κ L R ε initial hp hκ hκhi (source d hd)).run grad).value) ≤ ε ∧
    (((vectorGradientMethod p κ L R ε initial hp hκ hκhi (source d hd)).run grad).calls : ℝ) ≤
      queryConstant C (vectorBiasCoefficient p) p κ * (1 + (L*R^(κ-1)/ε)^beta p κ) :=
  vectorGradientMethod_guarantee hp hκ hκhi hC hL hR hε hClarkson (source d hd)
    initial f grad hf hg hh xstar hstar hr

/-- Quantifier-explicit dimension-free formulation: the positive constant K
is fixed before the dimension, problem scales, target accuracy, and unknown
objective are quantified. The method family itself is still the one above. -/
theorem vector_upper_bound_uniform_constant {p κ C : ℝ}
    (hp : 2 ≤ p) (hκ : 1 < κ) (hκhi : κ ≤ 2) (hC : 0 ≤ C)
    (hClarkson : ScalarWeightedClarkson p) (source : ExternalCompositeFamily p κ C) :
    ∃ K : ℝ, 0 < K ∧ ∀ (d : ℕ) (hd : 0 < d) (L R ε : ℝ),
      0 ≤ L → 0 ≤ R → 0 < ε →
      ∀ (initial : Fin d → ℝ) (f : (Fin d → ℝ) → ℝ)
        (grad : (Fin d → ℝ) → Fin d → ℝ),
      ConvexOn ℝ Set.univ f →
      (∀ x, HasFDerivAt f (coordinateFunctional (grad x)) x) →
      (∀ x y, lpNorm (dualExponent p) (grad x-grad y) ≤ L * lpNorm p (x-y)^(κ-1)) →
      ∀ xstar, (∀ y, f xstar ≤ f y) → lpNorm p (initial-xstar) ≤ R →
      lpNorm (dualExponent p)
        (grad ((vectorGradientMethod p κ L R ε initial hp hκ hκhi (source d hd)).run grad).value) ≤ ε ∧
      (((vectorGradientMethod p κ L R ε initial hp hκ hκhi (source d hd)).run grad).calls : ℝ) ≤
        K * (1 + (L*R^(κ-1)/ε)^beta p κ) := by
  refine ⟨queryConstant C (vectorBiasCoefficient p) p κ,
    queryConstant_pos hC (vectorBiasCoefficient_pos p) hp hκ, ?_⟩
  intro d hd L R ε hL hR hε initial f grad hf hg hh xstar hstar hr
  exact vector_upper_bound_dimension_uniform hp hκ hκhi hC hL hR hε hClarkson source
    d hd initial f grad hf hg hh xstar hstar hr

end P31
