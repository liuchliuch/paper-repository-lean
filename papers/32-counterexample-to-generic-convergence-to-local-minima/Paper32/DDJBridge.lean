import Paper32.Counterexample
import Paper32.NoiseConsequences

/-! Source correspondence with Davis--Drusvyatskiy--Jiang,
arXiv:2108.11832v2, Algorithm (4.5), Assumption E1--E4, and Assumption F.
https://arxiv.org/html/2108.11832v2#S5

This file proves the example's own measurable-map, deterministic-step,
conditional-mean, conditional-fourth-moment, and finite-domain facts. It imports
no conjectured convergence theorem and no external theorem interface.
-/
open Set Filter Topology MeasureTheory ProbabilityTheory
namespace Paper32

/-- The map G_alpha(x,nu)=s(x)+nu, extended harmlessly to all real alpha. -/
noncomputable def ddjG (selection : Point → Point) (p : ℝ × (Point × Point)) : Point :=
  selection p.2.1+p.2.2

lemma measurable_ddjG (selection : Point → Point) (hs : Measurable selection) :
    Measurable (ddjG selection) := (hs.comp measurable_snd.fst).add measurable_snd.snd

/-- Exactly the sigma field generated by states through k and perturbations before k. -/
def ddjSigma {Ω : Type*} (z noise : ℕ → Ω → Point) (k : ℕ) : MeasurableSpace Ω :=
  noisePastSigma noise k ⊔ ⨆ j : Fin (k+1), (inferInstance : MeasurableSpace Point).comap (z j)

lemma noisePastSigma_mono {Ω : Type*} (noise : ℕ → Ω → Point) {j k : ℕ} (hjk : j ≤ k) :
    noisePastSigma noise j ≤ noisePastSigma noise k := by
  let historyPrefix : (Fin k → Point) → (Fin j → Point) :=
    fun u i => u ⟨i.val,lt_of_lt_of_le i.isLt hjk⟩
  have hp : Measurable historyPrefix := by unfold historyPrefix; fun_prop
  have hH : Measurable[noisePastSigma noise k] (noisePast noise k) :=
    Measurable.of_comap_le le_rfl
  have h : Measurable[noisePastSigma noise k] (noisePast noise j) := hp.comp hH
  exact h.comap_le

lemma ddjSigma_eq_noisePast {Ω : Type*} (x0 : Point) (a : ℕ → ℝ)
    (selection : Point → Point) (hs : Measurable selection) (noise : ℕ → Ω → Point) (k : ℕ) :
    ddjSigma (noisyRecursion x0 a selection noise) noise k=noisePastSigma noise k := by
  apply sup_eq_left.mpr
  apply iSup_le
  intro j
  exact (measurable_noisyRecursion_adapted x0 a selection hs noise j).comap_le.trans
    (noisePastSigma_mono noise (by omega))

/-- The positive-index schedule used in the published DDJ statement. -/
noncomputable def ddjStep (γ : ℝ) (k : ℕ) := powerStep γ (k-1)

lemma ddj_step_bounds {γ : ℝ} (hlo : (1/2:ℝ) < γ) (hhi : γ < 1) :
    ∃ c₁ c₂ : ℝ, 0 < c₁ ∧ 0 < c₂ ∧ c₁ ≤ c₂ ∧ ∀ k : ℕ, 1 ≤ k →
      c₁*(k:ℝ)^(-γ) ≤ ddjStep γ k ∧ ddjStep γ k ≤ c₂*(k:ℝ)^(-γ) := by
  have hg : 0 ≤ γ := by linarith
  have had := (powerStep_admissible hlo hhi)
  refine ⟨8^(-γ),1,Real.rpow_pos_of_pos (by norm_num) _,by norm_num,?_,?_⟩
  · simpa [powerStep] using powerStep_upper hg 0
  · intro k hk
    have he : ((k-1:ℕ):ℝ)+1=(k:ℝ) := by
      rw [Nat.cast_sub hk,Nat.cast_one]
      ring
    simpa only [ddjStep,he,one_mul] using
      And.intro (powerStep_lower hg (k-1)) (powerStep_upper hg (k-1))

/-- E3 with the literal state-and-noise filtration: martingale differences and
strict conditional fourth moment bound by the constant q(x)=r^4+1. -/
theorem ddj_noise_assumption_E3
    {Ω : Type*} [MeasurableSpace Ω] (μ : Measure Ω) [IsProbabilityMeasure μ]
    (x0 : Point) (a : ℕ → ℝ) (selection : Point → Point) (hs : Measurable selection)
    (noise : ℕ → Ω → Point) (hnoise : ∀ k, Measurable (noise k))
    (hiid : iIndepFun noise μ) {r : ℝ}
    (hu : ∀ k, pdf.IsUniform (noise k) (euclideanDisk r) μ volume) :
    let z := noisyRecursion x0 a selection noise
    ∀ k, (μ[noise k | ddjSigma z noise k] =ᵐ[μ] fun _ => 0) ∧
      ∀ᵐ ω ∂μ, (μ[fun ω => euclideanFourth (noise k ω) | ddjSigma z noise k]) ω < r^4+1 := by
  intro z k
  have heq := ddjSigma_eq_noisePast x0 a selection hs noise k
  change ddjSigma z noise k=noisePastSigma noise k at heq
  rw [heq]
  constructor
  · exact condExp_uniformDisk_noise_zero μ (noisePast noise k) (noise k)
      (measurable_noisePast noise hnoise k) (hnoise k)
      (indepFun_noisePast_current μ noise hnoise hiid k) (hu k)
  · have h := condExp_euclideanFourth_uniformDisk_le μ (noise k) (hnoise k) (hu k)
      (noisePastSigma noise k) (measurable_noisePast noise hnoise k).comap_le
    exact h.mono fun _ h => by linarith

/-- Algorithm (4.5) is the defined recursion, and E4 holds because F_v is real-valued. -/
theorem ddj_algorithm_and_E4 {Ω : Type*} (x0 : Point) (a : ℕ → ℝ)
    (selection : Point → Point) (noise : ℕ → Ω → Point) (v : Point) :
    let z := noisyRecursion x0 a selection noise
    (∀ k ω, z (k+1) ω=z k ω-a k • ddjG selection (a k,z k ω,noise k ω)) ∧
    ∀ k ω, ((tilt v (z k ω) : ℝ) : WithTop ℝ) ≠ ⊤ := by
  exact ⟨fun _ _ => rfl,fun _ _ => WithTop.coe_ne_top⟩

end Paper32
