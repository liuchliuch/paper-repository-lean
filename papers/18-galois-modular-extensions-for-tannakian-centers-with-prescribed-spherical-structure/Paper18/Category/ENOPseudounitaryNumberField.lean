import Paper18.Category.ENOPseudounitaryBounds
import Paper18.Category.ENOPseudounitaryArithmetic
import Mathlib.FieldTheory.IntermediateField.Adjoin.Basic

noncomputable section
open Classical
open scoped BigOperators
universe u

namespace Paper18.PivotalData
variable {ι : Type u} [Fintype ι] {B : FusionBasis ι} (J : PivotalData B)

/-- The finite number field generated by the actual categorical simple
dimensions, inside the complex numbers. -/
def dimensionField : IntermediateField ℚ ℂ := IntermediateField.adjoin ℚ (Set.range J.jdim)

instance dimensionField_finiteDimensional : FiniteDimensional ℚ J.dimensionField := by
  letI := (Set.finite_range J.jdim).fintype
  apply IntermediateField.finiteDimensional_adjoin
  rintro z ⟨i, rfl⟩
  exact (J.jdim_isIntegral i).tower_top

instance dimensionField_numberField : NumberField J.dimensionField where

def fieldDimension (i : ι) : J.dimensionField :=
  ⟨J.jdim i, IntermediateField.subset_adjoin ℚ (Set.range J.jdim) ⟨i, rfl⟩⟩

@[simp] lemma fieldDimension_coe (i : ι) : (J.fieldDimension i : ℂ) = J.jdim i := rfl

@[simp] lemma fieldDimension_one : J.fieldDimension B.one = 1 := by
  apply Subtype.ext
  exact J.jdim_one

lemma fieldDimension_tensor (i j : ι) :
    J.fieldDimension i * J.fieldDimension j =
      ∑ k, (B.N i j k : J.dimensionField) * J.fieldDimension k := by
  apply Subtype.ext
  simpa using J.jdim_tensor i j

/-- Every embedding of the finite dimension field gives another dimension
character of the same actual integer fusion rules. -/
def fieldConjugate (σ : J.dimensionField →ₐ[ℚ] ℂ) : PivotalData B where
  jdim i := σ (J.fieldDimension i)
  jdim_ne_zero i := by
    intro hz
    have he : J.fieldDimension i = 0 := σ.injective (by simpa using hz)
    exact J.jdim_ne_zero i (congrArg Subtype.val he)
  jdim_one := by rw [J.fieldDimension_one, map_one]
  jdim_tensor i j := by
    have h := congrArg σ (J.fieldDimension_tensor i j)
    simpa only [map_mul, map_sum, map_natCast] using h

def fieldGlobalDimension : J.dimensionField :=
  ∑ i, J.fieldDimension i * J.fieldDimension (B.dual i)

@[simp] lemma fieldGlobalDimension_coe :
    (J.fieldGlobalDimension : ℂ) = J.globalDimension := by
  simp [fieldGlobalDimension, globalDimension, ndim]

lemma fieldConjugate_globalDimension (σ : J.dimensionField →ₐ[ℚ] ℂ) :
    (J.fieldConjugate σ).globalDimension = σ J.fieldGlobalDimension := by
  simp [fieldGlobalDimension, globalDimension, ndim, fieldConjugate]

lemma globalDimension_im_eq_zero : J.globalDimension.im = 0 := by
  simp [globalDimension, J.ndim_eq_normSq]

/-- ENO's weak-integrality norm argument, with the categorical
ratio-integrality input isolated explicitly for reuse.
All conjugate bounds and the finite number field are constructed above. -/
theorem globalDimension_eq_of_weakIntegral_and_ratioIntegral
    (hB : B.WeaklyIntegral)
    (hRatio : IsIntegral ℤ (J.globalDimension / (B.totalFPdim : ℂ))) :
    J.globalDimension.re = B.totalFPdim := by
  obtain ⟨N, hN⟩ := hB
  have hΔ : 0 < B.totalFPdim := by
    apply Finset.sum_pos' (fun i _ => sq_nonneg (B.fpdim i))
    exact ⟨B.one, Finset.mem_univ _, by simp⟩
  have hNpos : (0 : ℝ) < N := hN ▸ hΔ
  let a : J.dimensionField := J.fieldGlobalDimension / (N : J.dimensionField)
  have ha : IsIntegral ℤ a := by
    apply (isIntegral_algebraMap_iff (algebraMap J.dimensionField ℂ).injective).mp
    change IsIntegral ℤ ((J.fieldGlobalDimension : ℂ) / (N : ℂ))
    rw [J.fieldGlobalDimension_coe]
    have he : (B.totalFPdim : ℂ) = (N : ℂ) := by exact_mod_cast hN
    rw [← he]
    exact hRatio
  have hσ (σ : J.dimensionField →ₐ[ℚ] ℂ) :
      0 < (σ a).re ∧ (σ a).re ≤ 1 ∧ (σ a).im = 0 := by
    have he : σ a = (J.fieldConjugate σ).globalDimension / ((N : ℝ) : ℂ) := by
      simp [a, J.fieldConjugate_globalDimension]
    rw [he, Complex.div_ofReal_re, Complex.div_ofReal_im]
    refine ⟨div_pos (J.fieldConjugate σ).globalDimension_re_pos hNpos, ?_, ?_⟩
    · apply (div_le_one hNpos).mpr
      exact hN ▸ (J.fieldConjugate σ).globalDimension_re_le_totalFPdim
    · rw [(J.fieldConjugate σ).globalDimension_im_eq_zero, zero_div]
  have ha1 : a = 1 := algebraicInteger_eq_one_of_conjugates_pos_le_one a ha hσ
  have he : J.globalDimension / ((N : ℝ) : ℂ) = 1 := by
    have hc : (J.fieldGlobalDimension : ℂ) / (N : ℂ) = 1 := congrArg Subtype.val ha1
    rw [J.fieldGlobalDimension_coe] at hc
    simpa using hc
  have he' : J.globalDimension = ((N : ℝ) : ℂ) :=
    (div_eq_one_iff_eq (Complex.ofReal_ne_zero.mpr (ne_of_gt hNpos))).mp he
  rw [hN]
  exact congrArg Complex.re he'

end Paper18.PivotalData
