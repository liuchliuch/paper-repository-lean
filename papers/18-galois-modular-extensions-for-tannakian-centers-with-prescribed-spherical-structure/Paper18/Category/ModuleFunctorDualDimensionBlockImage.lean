import Paper18.Category.ModuleComponentConnected
import Paper18.Category.RelativeTensorCentralImage

/-! # Genuine module-functor images are exactly an actual action component

The source is generated by actions on an actual object. Its nonzero image
lies in one target component. Actual fullness and source idempotent splitting,
not an image-classification field, then give equality with that component.
-/
noncomputable section
open Classical CategoryTheory CategoryTheory.Category CategoryTheory.MonoidalCategory
open CategoryTheory.Limits
open scoped BigOperators MonoidalLeftAction
universe v u vM uM vN uN w
namespace Paper18.Category.ModuleFunctor
open MonoidalLeftAction
variable {C : Type u} [Category.{v} C] [MonoidalCategory C] [RightRigidCategory C]
  {M : Type uM} [Category.{vM} M] [Preadditive M] [Linear ℂ M]
  [HasKernels M] [HasFiniteBiproducts M] [∀ X Y : M, FiniteDimensional ℂ (X ⟶ Y)]
  [MonoidalLeftAction C M] [∀ c : C, (actionLeft M c).Additive]
  {N : Type uN} [Category.{vN} N] [Preadditive N] [HasKernels N] [HasFiniteBiproducts N]
  [MonoidalLeftAction C N]
  {κ : Type w} [Fintype κ] (SM : FiniteSemisimpleSkeleton M κ)
  (F : N ⥤ M) [F.Additive] [F.Full] [F.Faithful] [F.LeftLinear C]

/-- The actual image is stable under the actual action, by the genuine lineator. -/
lemma moduleEssImage_action (c : C) {X : M} (hX : F.essImage X) : F.essImage (c ⊙ₗ X) := by
  obtain ⟨Y, ⟨e⟩⟩ := hX
  exact ⟨c ⊙ₗ Y, ⟨(Functor.LeftLinear.μₗIso F c Y).symm ≪≫ (actionLeft M c).mapIso e⟩⟩

/-- The actual image of an actual single-generator module category is one
actual component, provided the actual generating image is nonzero. -/
theorem moduleEssImage_eq_component (Y : N) (j : κ)
    (hdom : ∀ Z : N, ∃ c : C, Nonempty (Retract Z (c ⊙ₗ Y)))
    (hY : ModuleComponent.property (C := C) SM j (F.obj Y))
    (hn : (𝟙 (F.obj Y) : F.obj Y ⟶ F.obj Y) ≠ 0) (X : M) :
    F.essImage X ↔ ModuleComponent.property (C := C) SM j X := by
  constructor
  · rintro ⟨Z, ⟨e⟩⟩
    obtain ⟨c, ⟨r⟩⟩ := hdom Z
    have hFZ : ModuleComponent.property (C := C) SM j (F.obj Z) :=
      IsAdditiveFullProperty.of_retract
        ((r.map F).trans (Retract.ofIso (Functor.LeftLinear.μₗIso F c Y).symm))
        (ModuleComponent.action_mem SM j c hY)
    exact IsAdditiveFullProperty.of_iso (ModuleComponent.property (C := C) SM j) e.symm hFZ
  · intro hX
    letI : IsIdempotentComplete N :=
      (Idempotents.isIdempotentComplete_iff_idempotents_have_kernels (C := N)).mpr
        (fun Z p _ => inferInstance)
    have hp : 0 < Module.finrank ℂ (F.obj Y ⟶ F.obj Y) :=
      Module.finrank_pos_iff_exists_ne_zero.mpr ⟨𝟙 _, hn⟩
    rw [SM.finrank_hom_eq_sum] at hp
    obtain ⟨a, _, ha⟩ := Finset.sum_pos_iff.mp hp
    have hma : 0 < SM.multiplicity (F.obj Y) a := Nat.pos_of_mul_pos_left ha
    have hJa := hY a hma
    have hA : F.essImage (SM.simpleObject a) :=
      essImage_of_retract F (SM.retractOfMultiplicityPos (F.obj Y) a hma)
    have hSimple (k : κ) (hk : ModuleComponent.property (C := C) SM j (SM.simpleObject k)) :
        F.essImage (SM.simpleObject k) := by
      have hak := ModuleComponent.sameComponent_trans SM
        (ModuleComponent.sameComponent_symm SM hJa)
        ((ModuleComponent.property_simple_iff SM j k).mp hk)
      obtain ⟨c, ⟨r⟩⟩ := (ModuleComponent.sameComponent_iff_simpleStep SM a k).mp hak
      obtain ⟨Z, ⟨e⟩⟩ := moduleEssImage_action F c hA
      exact essImage_of_retract F (r.trans (Retract.ofIso e.symm))
    have hl (b : Fin (SM.length X)) : F.essImage (SM.simpleObject (SM.label X b)) :=
      hSimple (SM.label X b)
        (SM.property_label (ModuleComponent.property (C := C) SM j) ⟨X, hX⟩ b)
    let g : Fin (SM.length X) → N := fun b => (hl b).witness
    exact ⟨⨁ g, ⟨F.mapBiproduct g ≪≫ biproduct.mapIso (fun b => (hl b).getIso) ≪≫
      (SM.decomposition X).symm⟩⟩

end Paper18.Category.ModuleFunctor
