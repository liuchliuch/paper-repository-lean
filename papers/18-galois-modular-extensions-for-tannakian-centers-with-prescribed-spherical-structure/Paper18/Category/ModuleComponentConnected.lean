import Paper18.Category.ModuleComponentAction
import Paper18.Category.ModuleFunctorAdjointAction
import Mathlib.CategoryTheory.Adjunction.Additive

/-! # Actual single-object generation of an action component

Rigid adjunction and actual semisimple splittings reverse an action step.
Associativity composes two steps. Hence an equivalence-closure component
is already generated by the action on its chosen actual simple object.
-/
noncomputable section
open Classical CategoryTheory CategoryTheory.MonoidalCategory CategoryTheory.Limits
open scoped MonoidalLeftAction
universe v u vM uM w
namespace Paper18.Category.ModuleComponent
variable {C : Type u} [Category.{v} C] [MonoidalCategory C]
  {M : Type uM} [Category.{vM} M] [Preadditive M] [Linear ℂ M]
  [HasKernels M] [HasFiniteBiproducts M]
  [∀ X Y : M, FiniteDimensional ℂ (X ⟶ Y)]
  [MonoidalLeftAction C M]
  [∀ X : C, (MonoidalLeftAction.actionLeft M X).Additive]
  {ι : Type w} [Fintype ι] (S : FiniteSemisimpleSkeleton M ι)

theorem simpleStep_refl (i : ι) : simpleStep (C := C) S i i :=
  ⟨𝟙_ C, ⟨Retract.ofIso (λₗ[C] (S.simpleObject i)).symm⟩⟩

theorem simpleStep_trans {i j k : ι}
    (h : simpleStep (C := C) S i j) (h' : simpleStep (C := C) S j k) :
    simpleStep (C := C) S i k := by
  obtain ⟨X, ⟨r⟩⟩ := h
  obtain ⟨Y, ⟨r'⟩⟩ := h'
  exact ⟨Y ⊗ X, ⟨(r'.trans (r.map (MonoidalLeftAction.actionLeft M Y))).trans
    (Retract.ofIso (αₗ Y X (S.simpleObject i)).symm)⟩⟩

variable [RightRigidCategory C]

/-- The actual adjunction reverses an action step; the actual semisimple
Hom formula supplies the resulting actual simple retract. -/
theorem simpleStep_symm {i j : ι} (h : simpleStep (C := C) S i j) :
    simpleStep (C := C) S j i := by
  obtain ⟨X, ⟨r⟩⟩ := h
  let adj := ModuleFunctor.actionAdjunction M X Xᘁ
  let g : Xᘁ ⊙ₗ S.simpleObject j ⟶ S.simpleObject i :=
    (adj.homEquiv (S.simpleObject j) (S.simpleObject i)).symm r.i
  have hri : r.i ≠ 0 := by
    intro hz
    have hh := r.retract
    rw [hz, zero_comp] at hh
    exact CategoryTheory.id_nonzero (S.simpleObject j) hh.symm
  have hg : g ≠ 0 := by
    intro hz
    have hh := congrArg (adj.homEquiv (S.simpleObject j) (S.simpleObject i)) hz
    exact hri (by simpa only [g, Equiv.apply_symm_apply, adj.homAddEquiv_zero] using hh)
  have hp : 0 < S.multiplicity (Xᘁ ⊙ₗ S.simpleObject j) i := by
    rw [S.multiplicity_eq_finrank_hom]
    exact Module.finrank_pos_iff_exists_ne_zero.mpr ⟨g, hg⟩
  exact ⟨Xᘁ, (S.multiplicity_pos_iff_retract _ i).mp hp⟩

/-- All simple labels in one component are actual retracts of a single
action on the specified generating simple. -/
theorem sameComponent_iff_simpleStep (i j : ι) :
    sameComponent (C := C) S i j ↔ simpleStep (C := C) S i j := by
  constructor
  · intro h
    induction h with
    | rel a b hab => exact hab
    | refl a => exact simpleStep_refl S a
    | symm a b _ ih => exact simpleStep_symm S ih
    | trans a b c _ _ ih ih' => exact simpleStep_trans S ih ih'
  · exact Relation.EqvGen.rel i j

/-- Actual simple retract generation inside the restricted native action. -/
theorem simple_retract_action_base (i : ι)
    (j : {j : ι // property (C := C) S i (S.simpleObject j)}) :
    ∃ X : C, Nonempty (Retract ((skeleton (C := C) S i).simpleObject j)
      (X ⊙ₗ base (C := C) S i)) := by
  have h := (property_simple_iff S i j.val).mp j.property
  obtain ⟨X, ⟨r⟩⟩ := (sameComponent_iff_simpleStep S i j.val).mp h
  exact ⟨X, ⟨⟨r.i, r.r, r.retract⟩⟩⟩

/-- Actual retract generation of every object in one component by the
action on its specified simple generator. -/
theorem retract_action_base [Preadditive C] [HasFiniteBiproducts C]
    [∀ Y : M, (MonoidalLeftAction.actionRight C Y).Additive]
    (i : ι) (Y : Component (C := C) S i) :
    ∃ X : C, Nonempty (Retract Y (X ⊙ₗ base (C := C) S i)) := by
  let T := skeleton (C := C) S i
  let F := MonoidalLeftAction.actionRight C (base (C := C) S i)
  choose X hX using fun a : Fin (T.length Y) =>
    simple_retract_action_base S i (T.label Y a)
  let r : ∀ a : Fin (T.length Y),
      Retract (T.simpleObject (T.label Y a)) (F.obj (X a)) :=
    fun a => Classical.choice (hX a)
  let rb : Retract (⨁ fun a : Fin (T.length Y) => T.simpleObject (T.label Y a))
      (⨁ fun a : Fin (T.length Y) => F.obj (X a)) :=
    { i := biproduct.map (fun a => (r a).i)
      r := biproduct.map (fun a => (r a).r)
      retract := by
        apply biproduct.hom_ext
        intro a
        simp [Category.assoc] }
  exact ⟨⨁ X, ⟨((Retract.ofIso (T.decomposition Y)).trans rb).trans
    (Retract.ofIso (F.mapBiproduct X).symm)⟩⟩

end Paper18.Category.ModuleComponent
