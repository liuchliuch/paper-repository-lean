import Paper18.Category.FusionSubcategoryBasic
import Paper18.Category.Multiplicity
import Mathlib.CategoryTheory.Monoidal.Action.Basic

/-! # Actual components of a finite semisimple module category

Components are generated by actual simple retracts of action objects.
Their summand and action closure are consequences of actual Hom
multiplicities, rather than component-closure assumptions.
-/
noncomputable section
open Classical CategoryTheory CategoryTheory.MonoidalCategory CategoryTheory.Limits
open scoped BigOperators MonoidalLeftAction
universe v u vM uM w
namespace Paper18.Category.ModuleComponent
variable {C : Type u} [Category.{v} C] [MonoidalCategory C]
  {M : Type uM} [Category.{vM} M] [Preadditive M] [Linear ℂ M]
  [HasKernels M] [HasFiniteBiproducts M]
  [∀ X Y : M, FiniteDimensional ℂ (X ⟶ Y)]
  {ι : Type w} [Fintype ι] (S : FiniteSemisimpleSkeleton M ι)

/-- Objects all of whose actual simple summands have labels in `p`. -/
def supported (p : ι → Prop) : ObjectProperty M :=
  fun X => ∀ i, 0 < S.multiplicity X i → p i

@[simp] theorem supported_simple_iff (p : ι → Prop) (i : ι) :
    supported S p (S.simpleObject i) ↔ p i := by
  constructor
  · intro h
    exact h i (by simp)
  · intro hi j hj
    have hji : j = i := by
      by_contra h
      simpa [S.multiplicity_simple, h] using hj
    simpa [hji] using hi

instance supported_additive (p : ι → Prop) : IsAdditiveFullProperty (supported S p) where
  of_retract r hY i hi := by
    let a := S.retractOfMultiplicityPos _ i hi
    exact hY i ((S.multiplicity_pos_iff_retract _ i).mpr ⟨a.trans r⟩)
  biproduct f hf i hi := by
    rw [S.multiplicity_biproduct] at hi
    obtain ⟨j, _, hj⟩ := Finset.sum_pos_iff.mp hi
    exact hf j i hj

variable [MonoidalLeftAction C M]
  [∀ X : C, (MonoidalLeftAction.actionLeft M X).Additive]

/-- An actual action object contains the target simple as an actual retract. -/
def simpleStep (i j : ι) : Prop :=
  ∃ X : C, Nonempty (Retract (S.simpleObject j) (X ⊙ₗ S.simpleObject i))

/-- Connectivity generated by the actual action on simple objects. -/
def sameComponent (i j : ι) : Prop := Relation.EqvGen (simpleStep (C := C) S) i j

theorem sameComponent_refl (i : ι) : sameComponent (C := C) S i i :=
  Relation.EqvGen.refl i

theorem sameComponent_symm {i j : ι} (h : sameComponent (C := C) S i j) :
    sameComponent (C := C) S j i := Relation.EqvGen.symm i j h

theorem sameComponent_trans {i j k : ι}
    (h : sameComponent (C := C) S i j) (h' : sameComponent (C := C) S j k) :
    sameComponent (C := C) S i k := Relation.EqvGen.trans i j k h h'

/-- The actual additive full subcategory belonging to a chosen simple. -/
def property (i : ι) : ObjectProperty M := supported S (sameComponent (C := C) S i)

instance property_additive (i : ι) : IsAdditiveFullProperty (property (C := C) S i) :=
  supported_additive S _

@[simp] theorem property_simple_iff (i j : ι) :
    property (C := C) S i (S.simpleObject j) ↔ sameComponent (C := C) S i j :=
  supported_simple_iff S _ j

theorem property_base (i : ι) : property (C := C) S i (S.simpleObject i) :=
  (property_simple_iff S i i).mpr (sameComponent_refl S i)

/-- Every actual component is closed under the native action. -/
theorem action_mem (i : ι) (X : C) {Y : M} (hY : property (C := C) S i Y) :
    property (C := C) S i (X ⊙ₗ Y) := by
  intro j hj
  change 0 < S.multiplicity ((MonoidalLeftAction.actionLeft M X).obj Y) j at hj
  rw [S.multiplicity_map S (MonoidalLeftAction.actionLeft M X)] at hj
  obtain ⟨k, _, hk⟩ := Finset.sum_pos_iff.mp hj
  have hkY : 0 < S.multiplicity Y k := Nat.pos_of_mul_pos_right hk
  have hkX : 0 < S.multiplicity (X ⊙ₗ S.simpleObject k) j := Nat.pos_of_mul_pos_left hk
  apply sameComponent_trans S (hY k hkY)
  exact Relation.EqvGen.rel k j ⟨X, (S.multiplicity_pos_iff_retract _ j).mp hkX⟩

/-- The actual full subcategory of one action component. -/
abbrev Component (i : ι) := (property (C := C) S i).FullSubcategory

/-- Actual finite semisimplicity of each action component. -/
def skeleton (i : ι) : FiniteSemisimpleSkeleton (Component (C := C) S i)
    {j : ι // property (C := C) S i (S.simpleObject j)} :=
  S.fullSubcategorySkeleton (property (C := C) S i)

def hasKernels (i : ι) : HasKernels (Component (C := C) S i) :=
  S.fullSubcategoryHasKernels (property (C := C) S i)

instance finiteHom (i : ι) (X Y : Component (C := C) S i) :
    FiniteDimensional ℂ (X ⟶ Y) :=
  inferInstanceAs (FiniteDimensional ℂ (X.obj ⟶ Y.obj))

/-- A nonempty actual simple object of the chosen component. -/
def base (i : ι) : Component (C := C) S i := ⟨S.simpleObject i, property_base S i⟩

instance base_simple (i : ι) : Simple (base (C := C) S i) :=
  S.simple_in_fullSubcategory (property (C := C) S i) _ _

end Paper18.Category.ModuleComponent
