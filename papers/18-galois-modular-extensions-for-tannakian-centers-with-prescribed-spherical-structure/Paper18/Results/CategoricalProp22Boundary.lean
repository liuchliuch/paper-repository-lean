import Paper18.Results.CategoricalProp22
import Paper18.Results.CategoricalPivotalBoundary
import Paper18.Category.InvertibleFunctor
import Paper18.Category.ModuleBalancingPositive

/-! # Actual spherical extension from the fixed-boundary trivialization

This is the spherical part of Proposition 2.2. The input trivialization is
an actual morphism in the fixed-boundary groupoid, and centralizer support
is a property of the actual embedded category.
-/
noncomputable section
open CategoryTheory CategoryTheory.Category CategoryTheory.MonoidalCategory
open CategoryTheory.Limits
universe v u w v' u' w'
namespace Paper18.Category
attribute [local instance 2000] RightRigidCategory.rightDual
variable {C : Type u} [Category.{v} C] [MonoidalCategory C] [BraidedCategory C]
  [RightRigidCategory C] [Preadditive C] [Linear ℂ C]
  [MonoidalPreadditive C] [MonoidalLinear ℂ C] [HasKernels C] [HasFiniteBiproducts C]
  [∀ X Y : C, FiniteDimensional ℂ (X ⟶ Y)] [Simple (𝟙_ C)]
  {ι : Type w} [Fintype ι] (S : FiniteSemisimpleSkeleton C ι)
  {D : Type u'} [Category.{v'} D] [MonoidalCategory D] [BraidedCategory D]
  [RightRigidCategory D] [Preadditive D] [Linear ℂ D]
  [MonoidalPreadditive D] [MonoidalLinear ℂ D] [HasKernels D] [HasFiniteBiproducts D]
  [∀ X Y : D, FiniteDimensional ℂ (X ⟶ Y)] [Simple (𝟙_ D)]
  {κ : Type w'} [Fintype κ] (T : FiniteSemisimpleSkeleton D κ)
  (F : C ⥤ D) [F.Additive] [F.Linear ℂ] [F.Braided] [F.Full] [F.Faithful]
  (J : PivotalStructure C)

/-- Trivial self-braiding is preserved by the actual braided tensorator. -/
lemma selfBraiding_map {f : C} (hf : (β_ f f).hom = 𝟙 (f ⊗ f)) :
    (β_ (F.obj f) (F.obj f)).hom = 𝟙 (F.obj f ⊗ F.obj f) := by
  apply (cancel_mono (Functor.LaxMonoidal.μ F f f)).mp
  have h := Functor.LaxBraided.braided (F := F) f f
  rw [hf, F.map_id] at h
  exact h.symm.trans ((Category.comp_id _).trans (Category.id_comp _).symm)

include S T in
/-- A genuine fixed-boundary trivialization gives an actual spherical
pivotal extension when the actual centralizer is generated by the negative
order-two boson. No pivotal or spherical extension is supplied as input. -/
theorem spherical_of_pivotal_boundary_trivialization
    (hJ : J.Spherical) (hD : IsNondegenerate (C := D))
    {f : C} (E : TensorInverse f) (he : f ⊗ f ≅ 𝟙_ C)
    (hf : (β_ f f).hom = 𝟙 (f ⊗ f)) (hdf : J.rightDim f = -1)
    (hcentralizer : ∀ t : D, Simple t → t ∈ centralizer (Set.range F.obj) →
      Nonempty (t ≅ 𝟙_ D) ∨ Nonempty (t ≅ F.obj f))
    (b : BoundaryIso F (pivotalBoundary F J) (BoundaryAutoequivalence.identity F)) :
    ∃ K : PivotalStructure D, K.Spherical ∧ PreservesPivotal F J K := by
  let K := pivotalOfBoundaryTrivialization F J b
  have hp : PreservesPivotal F J K := pivotalOfBoundaryTrivialization_preserves F J b
  refine ⟨K,?_,hp⟩
  apply spherical_of_negative_boson_centralizer T K hD (Set.range F.obj)
    (E.map F) (TensorInverse.mapSquare F he) (selfBraiding_map F hf)
  · exact (hp.rightDim_scalar f).trans hdf
  · intro Y hY
    obtain ⟨X,rfl⟩ := hY
    exact slope_on_spherical_image S T F J K hp hJ X
  · exact hcentralizer

end Paper18.Category
