/-! The F and zero-reflection position tables are generated by unary arithmetic.
Only the generic classical arithmetic and primitive instruction interfaces are
external inputs; no P25 circuit or position-query generator is assumed. -/
noncomputable section
namespace Paper25.OperationalModel.UniformCompilation
open LocalCompilation SourceCoordinates SourcePreparationPlacement FullReflectionPlacement
attribute [local instance] Classical.propDecidable
set_option maxHeartbeats 2400000
set_option synthInstance.maxSize 512
variable {G : EffectiveGateSet}

lemma polynomial_constant {α : Type} (encode : α → Input) (n : ℕ) :
    PolynomialBoundOn encode (fun _ => n) := by
  exact ⟨n,0,by intro a; simp⟩

lemma negativeIndices_of_arithmetic (classical : FLListClosure)
    (arithmetic : NatArithmeticDescription) : NegativeIndexDescription := by
  constructor
  · apply placement_generated classical arithmetic encodeNat
      (fun q => placementOfEmbedding (LocalCompilation.firstWire q))
    · exact nat_add classical arithmetic encodeNat id (fun _ => 1)
        (classical.strings.identity _) (nat_const classical _ 1)
    · exact nat_const classical _ 1
    · exact polynomial_constant _ 1
    · simpa only [active_placementOfEmbedding, LocalCompilation.firstWire] using
        nat_const classical (indexedInput encodeNat (fun _ => 1)) 0
  · exact nat_sub classical arithmetic positiveWidthInput (fun q => q.1) (fun _ => 1)
      (classical.strings.identity _) (nat_const classical _ 1)
  · apply placement_generated classical arithmetic positiveWidthInput
      (fun q => placementOfEmbedding
        (finCongr (show q.1-1+1=q.1 by have := q.2; omega)).toEmbedding)
    · exact classical.strings.identity _
    · simpa only [show ∀ q : PositiveWidth, q.1-1+1=q.1 from fun q => by have := q.2; omega] using classical.strings.identity positiveWidthInput
    · refine ⟨1,1,?_⟩
      intro q
      simp [positiveWidthInput,encodeNat]
      omega
    · exact indexed_counter_generated classical positiveWidthInput (fun q => q.1-1+1)

lemma zero_controlPrefix_generated (classical : FLListClosure)
    (arithmetic : NatArithmeticDescription) {α : Type} (encode : α → Input) (ell : α → ℕ)
    (hell : LogspaceComputes encode (fun a => encodeNat (ell a)))
    (hpoly : PolynomialBoundOn encode ell)
    (hstates : PolynomialBoundOn encode (fun a => 2^(ell a))) :
    LogspaceComputes encode (fun a => controlPrefix (ell a) (fun _ => 0)) := by
  have hw := arithmetic.bitArray encode ell (fun _ _ => (0 : Bit)) hell hpoly
    (classical.strings.constant _ [0])
  exact classical.strings.concat encode _ _
    (classical.strings.concat encode _ _ hell (nat_two_pow arithmetic encode ell hell hstates)) hw

lemma zeroSmallReflection_generated (classical : FLListClosure)
    (grammar : InstructionDescriptionClosure) {conv : GateConvention G}
    (primitive : PrimitiveDescriptionConvention conv) (arithmetic : NatArithmeticDescription)
    {α : Type} (encode : α → Input) (ell q : α → ℕ)
    (hell : LogspaceComputes encode (fun a => encodeNat (ell a)))
    (hq : LogspaceComputes encode (fun a => encodeNat (q a)))
    (hpoly : PolynomialBoundOn encode ell)
    (hstates : PolynomialBoundOn encode (fun a => 2^(ell a))) :
    GeneratedCircuit encode (fun a => zeroSmallReflectionCircuit conv (ell a) (q a)) := by
  have indices := negativeIndices_of_arithmetic classical arithmetic
  have hn := negativeCircuit_generated classical grammar primitive indices encode q hq
  have hx := flipCircuit_generated classical grammar (conv := conv) indices encode q hq
  have hh := hadamard_generated classical primitive encode q hq
  have hz := append_generated classical encode _ _
    (append_generated classical encode _ _ (append_generated classical encode _ _ hh hx) hh) hn
  have hp := patternCircuit_generated classical primitive encode (fun a _ => 0) _
    (zero_controlPrefix_generated classical arithmetic encode ell hell hpoly hstates) hz
  have hd := tensorCircuit_generated classical grammar encode
    (fun a => ([] : EffectiveCircuit G (ell a))) (fun a => negativeCircuit conv (q a))
    (nil_generated classical encode ell) hn hell
    (nat_add classical arithmetic encode q (fun _ => 1) hq (nat_const classical encode 1))
  exact append_generated classical encode _ _ hp hd

/-- Canonical work coordinate 0 is the declared output position. The remaining
coordinates scan the original positions in increasing order, skipping it. -/
def workPosition (output j : ℕ) : ℕ :=
  if j=0 then output else if j-1<output then j-1 else j

lemma workWire_val (S : EffectiveSourceComputation G) (i : WPos S) :
    (workWire S i).val = workPosition S.outputQubit.val i.val := by
  refine Fin.cases ?_ (fun j => ?_) i
  · rw [workWire_zero]
    simp [workPosition]
  · rw [workWire_succ,otherPositions_val]
    simp [workPosition,Fin.val_succ]

/-- Arithmetic table for the honest native-reflection wire permutation. -/
def reflectionPosition (work catalyst output ell m i : ℕ) : ℕ :=
  if i < m+1 then i else
  if i < m+5+ell then i+1 else
  if i < m+5+ell+work then m+6+ell+workPosition output (i-(m+5+ell)) else
  if i < m+5+ell+work+work then
    m+6+ell+(work+catalyst)+workPosition output (i-(m+5+ell+work)) else
  if i = m+5+ell+work+work then m+1 else
  if i < m+5+ell+work+work+1+catalyst then
    m+6+ell+work+(i-(m+5+ell+work+work+1)) else
    m+6+ell+(work+catalyst)+work+(i-(m+5+ell+work+work+1+catalyst))

lemma reflectionWire_val (S : EffectiveSourceComputation G) (ell m : ℕ)
    (i : Fin (reflectionQubits S ell m)) :
    (reflectionWire S ell m i).val =
      reflectionPosition S.workQubits S.catalystQubits S.outputQubit.val ell m i.val := by
  obtain ⟨p,rfl⟩ := (nativePositionWire S ell m).surjective i
  rw [reflectionWire_apply]
  have hw := restQubits_add_one S
  rcases p with ((a | (c | (wl | wr))) | (h | (cl | cr)))
  · rcases a with p | (r | (b | b))
    · change (allPositions S ell m (.inr (.inl p))).val = _
      rw [allPositions_phase_val]
      change p.val = reflectionPosition _ _ _ _ _ p.val
      have := p.isLt
      simp [reflectionPosition,show p.val<m+1 by omega]
    · fin_cases r
      change (allPositions S ell m (.inr (.inr (.inl 0)))).val = _
      rw [allPositions_rotation_val]
      change m = reflectionPosition _ _ _ _ _ (m+0)
      simp [reflectionPosition]
    · fin_cases b
      change (allPositions S ell m (.inr (.inr (.inr (.inl (.inl 0)))))).val = _
      rw [allPositions_blockOuter_val]
      change m+2 = reflectionPosition _ _ _ _ _ (m+(1+0))
      simp [reflectionPosition]
      omega
    · change (allPositions S ell m (.inr (.inr (.inr (.inl (.inr b)))))).val = _
      rw [allPositions_blockLCU_val]
      change m+3+b.val = reflectionPosition _ _ _ _ _ (m+(1+(1+b.val)))
      have := b.isLt
      simp [reflectionPosition,show ¬m+(1+(1+b.val))<m+1 by omega,
        show m+(1+(1+b.val))<m+5+ell by omega]
      omega
  · change (allPositions S ell m (.inl (.inr (.inl c)))).val = _
    rw [allPositions_clock_val]
    change m+6+c.val = reflectionPosition _ _ _ _ _ ((m+(1+(1+3)))+c.val)
    have := c.isLt
    simp [reflectionPosition,show ¬m+(1+(1+3))+c.val<m+1 by omega,
      show m+(1+(1+3))+c.val<m+5+ell by omega]
    omega
  · change (allPositions S ell m (.inl (.inr (.inr (.inl (.inl wl)))))).val = _
    rw [allPositions_leftWork_val,workWire_val]
    change m+6+ell+workPosition _ wl.val =
      reflectionPosition _ _ _ _ _ ((m+(1+(1+3)))+(ell+wl.val))
    have := wl.isLt
    simp [reflectionPosition,show ¬m+(1+(1+3))+(ell+wl.val)<m+1 by omega,
      show ¬m+(1+(1+3))+(ell+wl.val)<m+5+ell by omega,
      show m+(1+(1+3))+(ell+wl.val)<m+5+ell+S.workQubits by omega,
      show m+(1+(1+3))+(ell+wl.val)-(m+5+ell)=wl.val by omega]
  · change (allPositions S ell m (.inl (.inr (.inr (.inl (.inr wr)))))).val = _
    rw [allPositions_rightWork_val,workWire_val]
    change m+6+ell+SourceTermCompilation.sourceQubits S+workPosition _ wr.val =
      reflectionPosition _ _ _ _ _ ((m+(1+(1+3)))+(ell+((restQubits S+1)+wr.val)))
    have := wr.isLt
    simp [reflectionPosition,SourceTermCompilation.sourceQubits,
      show ¬m+(1+(1+3))+(ell+(restQubits S+1+wr.val))<m+1 by omega,
      show ¬m+(1+(1+3))+(ell+(restQubits S+1+wr.val))<m+5+ell by omega,
      show ¬m+(1+(1+3))+(ell+(restQubits S+1+wr.val))<m+5+ell+S.workQubits by omega,
      show m+(1+(1+3))+(ell+(restQubits S+1+wr.val))<m+5+ell+S.workQubits+S.workQubits by omega,
      show m+(1+(1+3))+(ell+(restQubits S+1+wr.val))-(m+5+ell+S.workQubits)=wr.val by omega]
  · fin_cases h
    change (allPositions S ell m (.inl (.inl 0))).val = _
    rw [allPositions_h_val]
    change m+1 = reflectionPosition _ _ _ _ _ (otherQubits S ell m+0)
    have ho : otherQubits S ell m=m+5+ell+S.workQubits+S.workQubits := by unfold otherQubits; omega
    simp [reflectionPosition,ho,show ¬m+5+ell+S.workQubits+S.workQubits<m+1 by omega,
      show ¬m+5+ell+S.workQubits+S.workQubits<m+5+ell by omega]
  · change (allPositions S ell m (.inr (.inr (.inr (.inr (.inl cl)))))).val = _
    rw [allPositions_leftCatalyst_val]
    change m+6+ell+S.workQubits+cl.val =
      reflectionPosition _ _ _ _ _ (otherQubits S ell m+(cl.val+1))
    have ho : otherQubits S ell m=m+5+ell+S.workQubits+S.workQubits := by unfold otherQubits; omega
    have := cl.isLt
    simp [reflectionPosition,ho,
      show ¬m+5+ell+S.workQubits+S.workQubits+(cl.val+1)<m+1 by omega,
      show ¬m+5+ell+S.workQubits+S.workQubits+(cl.val+1)<m+5+ell by omega,
      show ¬m+5+ell+S.workQubits+S.workQubits+(cl.val+1)<m+5+ell+S.workQubits by omega,
      show ¬m+5+ell+S.workQubits+S.workQubits+(cl.val+1)<m+5+ell+S.workQubits+S.workQubits by omega,
      show ¬m+5+ell+S.workQubits+S.workQubits+(cl.val+1)=m+5+ell+S.workQubits+S.workQubits by omega,
      show m+5+ell+S.workQubits+S.workQubits+(cl.val+1)<m+5+ell+S.workQubits+S.workQubits+1+S.catalystQubits by omega,
      show m+5+ell+S.workQubits+S.workQubits+(cl.val+1)-(m+5+ell+S.workQubits+S.workQubits+1)=cl.val by omega]
  · change (allPositions S ell m (.inr (.inr (.inr (.inr (.inr cr)))))).val = _
    rw [allPositions_rightCatalyst_val]
    change m+6+ell+SourceTermCompilation.sourceQubits S+S.workQubits+cr.val =
      reflectionPosition _ _ _ _ _ (otherQubits S ell m+((S.catalystQubits+cr.val)+1))
    have ho : otherQubits S ell m=m+5+ell+S.workQubits+S.workQubits := by unfold otherQubits; omega
    have := cr.isLt
    simp [reflectionPosition,ho,SourceTermCompilation.sourceQubits,
      show ¬m+5+ell+S.workQubits+S.workQubits+(S.catalystQubits+cr.val+1)<m+1 by omega,
      show ¬m+5+ell+S.workQubits+S.workQubits+(S.catalystQubits+cr.val+1)<m+5+ell by omega,
      show ¬m+5+ell+S.workQubits+S.workQubits+(S.catalystQubits+cr.val+1)<m+5+ell+S.workQubits by omega,
      show ¬m+5+ell+S.workQubits+S.workQubits+(S.catalystQubits+cr.val+1)<m+5+ell+S.workQubits+S.workQubits by omega,
      show ¬m+5+ell+S.workQubits+S.workQubits+(S.catalystQubits+cr.val+1)=m+5+ell+S.workQubits+S.workQubits by omega,
      show ¬m+5+ell+S.workQubits+S.workQubits+(S.catalystQubits+cr.val+1)<m+5+ell+S.workQubits+S.workQubits+1+S.catalystQubits by omega,
      show m+5+ell+S.workQubits+S.workQubits+(S.catalystQubits+cr.val+1)-(m+5+ell+S.workQubits+S.workQubits+1+S.catalystQubits)=cr.val by omega]

lemma nat_ite (classical : FLListClosure) {α : Type} (encode : α → Input)
    (p : α → Prop) [∀ a, Decidable (p a)] (f g : α → ℕ)
    (hp : LogspaceComputes encode (fun a => encodeBool (decide (p a))))
    (hf : LogspaceComputes encode (fun a => encodeNat (f a)))
    (hg : LogspaceComputes encode (fun a => encodeNat (g a))) :
    LogspaceComputes encode (fun a => encodeNat (if p a then f a else g a)) := by
  simpa using nat_if classical encode (fun a => decide (p a)) f g hp hf hg

local syntax "counter_gen" ident ident : tactic
local macro_rules
  | `(tactic| counter_gen $c:ident $r:ident) => `(tactic|
      first
      | assumption
      | exact nat_const $c _ _
      | (apply nat_add $c $r <;> counter_gen $c $r)
      | (apply nat_sub $c $r <;> counter_gen $c $r)
      | (apply nat_mul $c $r <;> counter_gen $c $r)
      | (apply nat_div $c $r <;> counter_gen $c $r)
      | (apply nat_mod $c $r <;> counter_gen $c $r)
      | (apply nat_ite $c <;> counter_gen $c $r)
      | (apply nat_lt $c $r <;> counter_gen $c $r)
      | (apply nat_le $c $r <;> counter_gen $c $r)
      | (apply nat_eq $c $r <;> counter_gen $c $r))

lemma workPosition_generated (classical : FLListClosure)
    (arithmetic : NatArithmeticDescription) {α : Type} (encode : α → Input)
    (output j : α → ℕ)
    (ho : LogspaceComputes encode (fun a => encodeNat (output a)))
    (hj : LogspaceComputes encode (fun a => encodeNat (j a))) :
    LogspaceComputes encode (fun a => encodeNat (workPosition (output a) (j a))) := by
  unfold workPosition
  counter_gen classical arithmetic

lemma reflectionPosition_generated (classical : FLListClosure)
    (arithmetic : NatArithmeticDescription) {α : Type} (encode : α → Input)
    (work catalyst output ell m i : α → ℕ)
    (hw : LogspaceComputes encode (fun a => encodeNat (work a)))
    (hc : LogspaceComputes encode (fun a => encodeNat (catalyst a)))
    (ho : LogspaceComputes encode (fun a => encodeNat (output a)))
    (hell : LogspaceComputes encode (fun a => encodeNat (ell a)))
    (hm : LogspaceComputes encode (fun a => encodeNat (m a)))
    (hi : LogspaceComputes encode (fun a => encodeNat (i a))) :
    LogspaceComputes encode (fun a => encodeNat
      (reflectionPosition (work a) (catalyst a) (output a) (ell a) (m a) (i a))) := by
  unfold reflectionPosition workPosition
  counter_gen classical arithmetic

lemma filterWidth_generated (classical : FLListClosure)
    (arithmetic : NatArithmeticDescription) {α : Type} (encode : α → Input)
    (S : α → EffectiveSourceComputation G) (ell m : α → ℕ)
    (hw : LogspaceComputes encode (fun a => encodeNat (S a).workQubits))
    (hc : LogspaceComputes encode (fun a => encodeNat (S a).catalystQubits))
    (hell : LogspaceComputes encode (fun a => encodeNat (ell a)))
    (hm : LogspaceComputes encode (fun a => encodeNat (m a))) :
    LogspaceComputes encode (fun a => encodeNat (filterQubits (S a) (ell a) (m a))) := by
  unfold filterQubits walkQubits encoderQubits SourceTermCompilation.sourceQubits
  counter_gen classical arithmetic

lemma otherWidth_generated (classical : FLListClosure)
    (arithmetic : NatArithmeticDescription) {α : Type} (encode : α → Input)
    (S : α → EffectiveSourceComputation G) (ell m : α → ℕ)
    (hw : LogspaceComputes encode (fun a => encodeNat (S a).workQubits))
    (hell : LogspaceComputes encode (fun a => encodeNat (ell a)))
    (hm : LogspaceComputes encode (fun a => encodeNat (m a))) :
    LogspaceComputes encode (fun a => encodeNat (otherQubits (S a) (ell a) (m a))) := by
  have he (a : α) : otherQubits (S a) (ell a) (m a)=
      (m a+(1+(1+3)))+(ell a+((S a).workQubits+(S a).workQubits)) := by
    unfold otherQubits
    rw [restQubits_add_one]
  simp only [he]
  counter_gen classical arithmetic

lemma reflection_placement_generated (classical : FLListClosure)
    (arithmetic : NatArithmeticDescription) {α : Type} (encode : α → Input)
    (S : α → EffectiveSourceComputation G) (ell m : α → ℕ)
    (hw : LogspaceComputes encode (fun a => encodeNat (S a).workQubits))
    (hc : LogspaceComputes encode (fun a => encodeNat (S a).catalystQubits))
    (ho : LogspaceComputes encode (fun a => encodeNat (S a).outputQubit.val))
    (hell : LogspaceComputes encode (fun a => encodeNat (ell a)))
    (hm : LogspaceComputes encode (fun a => encodeNat (m a)))
    (hpoly : PolynomialBoundOn encode (fun a => reflectionQubits (S a) (ell a) (m a))) :
    LogspaceComputes encode (fun a =>
      (placementOfEmbedding (reflectionWire (S a) (ell a) (m a)).toEmbedding).encode) := by
  have hother := otherWidth_generated classical arithmetic encode S ell m hw hell hm
  have hwidth : LogspaceComputes encode (fun a => encodeNat (reflectionQubits (S a) (ell a) (m a))) := by
    unfold reflectionQubits
    counter_gen classical arithmetic
  apply placement_generated classical arithmetic encode _
    (filterWidth_generated classical arithmetic encode S ell m hw hc hell hm) hwidth hpoly
  let ctx := indexedInput encode (fun a => reflectionQubits (S a) (ell a) (m a))
  have hin := indexed_input_generated classical encode (fun a => reflectionQubits (S a) (ell a) (m a))
  have hw' := classical.strings.compose ctx encode Sigma.fst _ hin hw
  have hc' := classical.strings.compose ctx encode Sigma.fst _ hin hc
  have ho' := classical.strings.compose ctx encode Sigma.fst _ hin ho
  have hell' := classical.strings.compose ctx encode Sigma.fst _ hin hell
  have hm' := classical.strings.compose ctx encode Sigma.fst _ hin hm
  simpa only [active_placementOfEmbedding,Equiv.toEmbedding_apply,reflectionWire_val] using
    reflectionPosition_generated classical arithmetic ctx _ _ _ _ _ _ hw' hc' ho' hell' hm'
      (indexed_counter_generated classical encode (fun a => reflectionQubits (S a) (ell a) (m a)))

/-- The final reflection list is generated from source headers and the generic
arithmetic interface; its entire quantum gate list is derived here. -/
theorem reflection_generated (classical : FLListClosure)
    (grammar : InstructionDescriptionClosure) {conv : GateConvention G}
    (primitive : PrimitiveDescriptionConvention conv) (arithmetic : NatArithmeticDescription)
    {α : Type} (encode : α → Input) (S : α → EffectiveSourceComputation G) (ell m : α → ℕ)
    (hw : LogspaceComputes encode (fun a => encodeNat (S a).workQubits))
    (hc : LogspaceComputes encode (fun a => encodeNat (S a).catalystQubits))
    (ho : LogspaceComputes encode (fun a => encodeNat (S a).outputQubit.val))
    (hell : LogspaceComputes encode (fun a => encodeNat (ell a)))
    (hm : LogspaceComputes encode (fun a => encodeNat (m a)))
    (hpoly : PolynomialBoundOn encode (fun a => reflectionQubits (S a) (ell a) (m a)))
    (hother : PolynomialBoundOn encode (fun a => otherQubits (S a) (ell a) (m a)))
    (hstates : PolynomialBoundOn encode (fun a => 2^(otherQubits (S a) (ell a) (m a)))) :
    GeneratedCircuit encode (fun a => reflection conv (S a) (ell a) (m a)) := by
  have hq : LogspaceComputes encode (fun a => encodeNat
      ((S a).catalystQubits+(S a).catalystQubits)) := by counter_gen classical arithmetic
  exact rewire_generated classical grammar encode _ _
    (reflection_placement_generated classical arithmetic encode S ell m hw hc ho hell hm hpoly)
    (zeroSmallReflection_generated classical grammar primitive arithmetic encode _ _
      (otherWidth_generated classical arithmetic encode S ell m hw hell hm) hq hother hstates)

lemma clockWire_val (ell : ℕ) (i : Fin ell) :
    (StatePreparationLocal.clockWire ell i).val=i.val := by
  induction ell with
  | zero => exact Fin.elim0 i
  | succ ell ih =>
    refine Fin.cases ?_ (fun j => ?_) i
    · rfl
    · change 1+(StatePreparationLocal.clockWire ell j).val=j.val+1
      rw [ih]
      omega

lemma bellWire_left_val (s : ℕ) (i : Fin s) :
    (StatePreparationLocal.bellWire s (.inl i)).val=2*i.val := by
  induction s with
  | zero => exact Fin.elim0 i
  | succ s ih =>
    refine Fin.cases ?_ (fun j => ?_) i
    · rfl
    · change 2+(StatePreparationLocal.bellWire s (.inl j)).val=2*(j.val+1)
      rw [ih]
      omega

lemma bellWire_right_val (s : ℕ) (i : Fin s) :
    (StatePreparationLocal.bellWire s (.inr i)).val=2*i.val+1 := by
  induction s with
  | zero => exact Fin.elim0 i
  | succ s ih =>
    refine Fin.cases ?_ (fun j => ?_) i
    · rfl
    · change 2+(StatePreparationLocal.bellWire s (.inr j)).val=2*(j.val+1)+1
      rw [ih]
      omega

/-- Arithmetic readout of F's interleaved Bell wire order into the two original
source copies. No unused-complement enumeration enters the output. -/
def preparationPosition (work catalyst output ell m i : ℕ) : ℕ :=
  if i=0 then m+1 else
  if i<1+ell then m+6+(i-1) else
    m+6+ell+(if (i-(1+ell))%2=0 then 0 else work+catalyst)+
      workPosition output ((i-(1+ell))/2)

lemma selectedEmbedding_val (S : EffectiveSourceComputation G) (ell m : ℕ)
    (i : Fin (StatePreparationLocal.physicalSize ell (restQubits S) 0)) :
    (selectedEmbedding S ell m i).val =
      preparationPosition S.workQubits S.catalystQubits S.outputQubit.val ell m i.val := by
  obtain ⟨p,rfl⟩ := (StatePreparationLocal.FWire ell (restQubits S) 0).surjective i
  have he : selectedEmbedding S ell m (StatePreparationLocal.FWire ell (restQubits S) 0 p)=
      allPositions S ell m (.inl p) := by
    simp only [selectedEmbedding,Function.Embedding.coeFn_mk,Equiv.symm_apply_apply]
  rw [he]
  rcases p with h | (c | ((wl | wr) | a))
  · fin_cases h
    change (allPositions S ell m (.inl (.inl 0))).val = preparationPosition _ _ _ _ _ 0
    rw [allPositions_h_val]
    rfl
  · rw [allPositions_clock_val]
    change m+6+c.val = preparationPosition _ _ _ _ _
      (1+(StatePreparationLocal.clockWire ell c).val)
    rw [clockWire_val]
    have := c.isLt
    simp [preparationPosition,show ¬1+c.val=0 by omega,show 1+c.val<1+ell by omega]
  · rw [allPositions_leftWork_val,workWire_val]
    change m+6+ell+workPosition _ wl.val = preparationPosition _ _ _ _ _
      (1+(StatePreparationLocal.clockSize ell+(StatePreparationLocal.bellWire (restQubits S+1) (.inl wl)).val))
    rw [StatePreparationLocal.clockSize_eq,bellWire_left_val]
    simp [preparationPosition,show ¬1+(ell+2*wl.val)=0 by omega,
      show ¬1+(ell+2*wl.val)<1+ell by omega,
      show 1+(ell+2*wl.val)-(1+ell)=2*wl.val by omega,Nat.mul_div_right]
  · rw [allPositions_rightWork_val,workWire_val]
    change m+6+ell+SourceTermCompilation.sourceQubits S+workPosition _ wr.val =
      preparationPosition _ _ _ _ _
        (1+(StatePreparationLocal.clockSize ell+(StatePreparationLocal.bellWire (restQubits S+1) (.inr wr)).val))
    rw [StatePreparationLocal.clockSize_eq,bellWire_right_val]
    simp [preparationPosition,SourceTermCompilation.sourceQubits,
      show ¬1+(ell+(2*wr.val+1))=0 by omega,
      show ¬1+(ell+(2*wr.val+1))<1+ell by omega,
      show 1+(ell+(2*wr.val+1))-(1+ell)=2*wr.val+1 by omega,Nat.add_div,Nat.mul_div_right]
  · exact Fin.elim0 a

lemma preparationPosition_generated (classical : FLListClosure)
    (arithmetic : NatArithmeticDescription) {α : Type} (encode : α → Input)
    (work catalyst output ell m i : α → ℕ)
    (hw : LogspaceComputes encode (fun a => encodeNat (work a)))
    (hc : LogspaceComputes encode (fun a => encodeNat (catalyst a)))
    (ho : LogspaceComputes encode (fun a => encodeNat (output a)))
    (hell : LogspaceComputes encode (fun a => encodeNat (ell a)))
    (hm : LogspaceComputes encode (fun a => encodeNat (m a)))
    (hi : LogspaceComputes encode (fun a => encodeNat (i a))) :
    LogspaceComputes encode (fun a => encodeNat
      (preparationPosition (work a) (catalyst a) (output a) (ell a) (m a) (i a))) := by
  unfold preparationPosition workPosition
  counter_gen classical arithmetic

lemma preparationWidth_generated (classical : FLListClosure)
    (arithmetic : NatArithmeticDescription) {α : Type} (encode : α → Input)
    (S : α → EffectiveSourceComputation G) (ell : α → ℕ)
    (hw : LogspaceComputes encode (fun a => encodeNat (S a).workQubits))
    (hell : LogspaceComputes encode (fun a => encodeNat (ell a))) :
    LogspaceComputes encode (fun a => encodeNat
      (StatePreparationLocal.physicalSize (ell a) (restQubits (S a)) 0)) := by
  simp only [StatePreparationLocal.physicalSize_eq,restQubits_add_one]
  counter_gen classical arithmetic

lemma preparation_placement_generated (classical : FLListClosure)
    (arithmetic : NatArithmeticDescription) {α : Type} (encode : α → Input)
    (S : α → EffectiveSourceComputation G) (ell m : α → ℕ)
    (hw : LogspaceComputes encode (fun a => encodeNat (S a).workQubits))
    (hc : LogspaceComputes encode (fun a => encodeNat (S a).catalystQubits))
    (ho : LogspaceComputes encode (fun a => encodeNat (S a).outputQubit.val))
    (hell : LogspaceComputes encode (fun a => encodeNat (ell a)))
    (hm : LogspaceComputes encode (fun a => encodeNat (m a)))
    (hpoly : PolynomialBoundOn encode (fun a =>
      StatePreparationLocal.physicalSize (ell a) (restQubits (S a)) 0)) :
    LogspaceComputes encode (fun a =>
      (placementOfEmbedding (selectedEmbedding (S a) (ell a) (m a))).encode) := by
  apply placement_generated classical arithmetic encode _
    (filterWidth_generated classical arithmetic encode S ell m hw hc hell hm)
    (preparationWidth_generated classical arithmetic encode S ell hw hell) hpoly
  let count := fun a => StatePreparationLocal.physicalSize (ell a) (restQubits (S a)) 0
  let ctx := indexedInput encode count
  have hin := indexed_input_generated classical encode count
  have hw' := classical.strings.compose ctx encode Sigma.fst _ hin hw
  have hc' := classical.strings.compose ctx encode Sigma.fst _ hin hc
  have ho' := classical.strings.compose ctx encode Sigma.fst _ hin ho
  have hell' := classical.strings.compose ctx encode Sigma.fst _ hin hell
  have hm' := classical.strings.compose ctx encode Sigma.fst _ hin hm
  simpa only [active_placementOfEmbedding,selectedEmbedding_val] using
    preparationPosition_generated classical arithmetic ctx _ _ _ _ _ _ hw' hc' ho' hell' hm'
      (indexed_counter_generated classical encode count)

lemma source_filterWidth_polynomial (F : EffectiveSourceFamily G) :
    PolynomialBound (fun x => filterQubits (F.circuit x)
      (SourceCircuitSimulation.clockBits (F.circuit x)) (FullPrecisionBudget.sourcePhase (F.circuit x))) := by
  apply (SourceCircuitSimulation.mixed_resources F).1.mono
  intro x
  have h := SourceCircuitSimulation.physical_mixed_qubits (F.circuit x)
  rw [FullReflectionPlacement.filterQubits_eq]
  change SourceSimulation.smallQubits _ _
    (SelectedFilter.sourcePhaseBits _ _+4+1)+_+_≤_
  omega

lemma source_reflectionWidth_polynomial (F : EffectiveSourceFamily G) :
    PolynomialBound (fun x => reflectionQubits (F.circuit x)
      (SourceCircuitSimulation.clockBits (F.circuit x)) (FullPrecisionBudget.sourcePhase (F.circuit x))) := by
  have he (S : EffectiveSourceComputation G) (ell m : ℕ) : reflectionQubits S ell m=filterQubits S ell m := by
    simpa only [Fintype.card_fin] using Fintype.card_congr (reflectionWire S ell m)
  simpa only [he] using source_filterWidth_polynomial F

lemma source_preparationWidth_polynomial (F : EffectiveSourceFamily G) :
    PolynomialBound (fun x => StatePreparationLocal.physicalSize
      (SourceCircuitSimulation.clockBits (F.circuit x)) (restQubits (F.circuit x)) 0) := by
  apply (source_filterWidth_polynomial F).mono
  intro x
  simpa only [Fintype.card_fin] using Fintype.card_le_of_injective
    (selectedEmbedding (F.circuit x) (SourceCircuitSimulation.clockBits (F.circuit x))
      (FullPrecisionBudget.sourcePhase (F.circuit x)))
    (selectedEmbedding (F.circuit x) (SourceCircuitSimulation.clockBits (F.circuit x))
      (FullPrecisionBudget.sourcePhase (F.circuit x))).injective

lemma terminalClock_generated (classical : FLListClosure) (binary : BinaryDataDescription)
    {α : Type} (encode : α → Input) (ell T : α → ℕ)
    (valid : ∀ a, T a+1≤Fintype.card (StatePreparation.Bits (ell a)))
    (hell : LogspaceComputes encode (fun a => encodeNat (ell a)))
    (hstates : LogspaceComputes encode (fun a => encodeNat (2^ell a)))
    (hT : LogspaceComputes encode (fun a => encodeNat (T a))) :
    LogspaceComputes encode (fun a => List.ofFn (SourceSimulation.terminalClock (ell a) (T a) (valid a))) := by
  let ix (a : α) : Fin (2^ell a) := ⟨T a,by have hv := valid a; simp only [StatePreparation.Bits,
    Fintype.card_fun,Fintype.card_fin] at hv; omega⟩
  exact index_word_generated classical binary encode ix hell hstates hT

/-- Every source-specific unary query here is obtained by parsing the original
source description emitted by F.uniform; all precision queries are derived. -/
theorem source_reflection_generated (classical : FLListClosure)
    (grammar : InstructionDescriptionClosure) {conv : GateConvention G}
    (primitive : PrimitiveDescriptionConvention conv) (arithmetic : NatArithmeticDescription)
    (parsing : SourceDescriptionParsing G) (F : EffectiveSourceFamily G)
    (hDuration : SimulatorParameterUniform.UnaryComputes (fun x => duration (F.circuit x))) :
    GeneratedCircuit id (fun x => SimulatorCircuit.reflection conv (F.circuit x)) := by
  have parameters := SimulatorParameterUniform.parameters_generated classical arithmetic F
    (source_work_generated classical parsing F) hDuration
  exact reflection_generated classical grammar primitive arithmetic id F.circuit _ _
    (source_work_generated classical parsing F) (source_catalyst_generated classical parsing F)
    (source_output_generated classical parsing F) parameters.ell parameters.m
    (source_reflectionWidth_polynomial F)
    ((FullCompilationResources.source_other_dimension_polynomial F).mono (fun x => Paper25.nat_le_two_pow _))
    (FullCompilationResources.source_other_dimension_polynomial F)

lemma polynomial_on_mono {α : Type} (encode : α → Input) {f g : α → ℕ}
    (hg : PolynomialBoundOn encode g) (h : ∀ a, f a≤g a) : PolynomialBoundOn encode f := by
  obtain ⟨C,d,hg⟩ := hg
  exact ⟨C,d,fun a => (h a).trans (hg a)⟩

/-- Uniform generation of the actual placed preparation. The native Bell,
clock and XZX gate lists are constructed, and every selected position is
computed by the explicit arithmetic table proved above. -/
theorem placedF_generated (classical : FLListClosure)
    (grammar : InstructionDescriptionClosure) (arithmetic : NatArithmeticDescription)
    (conv : GateConvention G) {α : Type} (encode : α → Input)
    (S : α → EffectiveSourceComputation G) (ell m : α → ℕ)
    (t : ∀ a, StatePreparation.Bits (ell a))
    (hw : LogspaceComputes encode (fun a => encodeNat (S a).workQubits))
    (hc : LogspaceComputes encode (fun a => encodeNat (S a).catalystQubits))
    (ho : LogspaceComputes encode (fun a => encodeNat (S a).outputQubit.val))
    (hell : LogspaceComputes encode (fun a => encodeNat (ell a)))
    (hm : LogspaceComputes encode (fun a => encodeNat (m a)))
    (ht : LogspaceComputes encode (fun a => List.ofFn (t a)))
    (hpoly : PolynomialBoundOn encode (fun a =>
      StatePreparationLocal.physicalSize (ell a) (restQubits (S a)) 0)) :
    GeneratedCircuit encode (fun a => placedF conv (S a) (ell a) (m a) (t a)) := by
  have hrest : LogspaceComputes encode (fun a => encodeNat (restQubits (S a))) := by
    have he (a : α) : restQubits (S a)=(S a).workQubits-1 := by
      have := restQubits_add_one (S a)
      omega
    simp only [he]
    exact nat_sub classical arithmetic encode _ _ hw (nat_const classical encode 1)
  have hpolyEll : PolynomialBoundOn encode ell := polynomial_on_mono encode hpoly (by
    intro a
    rw [StatePreparationLocal.physicalSize_eq]
    omega)
  have hpolyRest : PolynomialBoundOn encode (fun a => restQubits (S a)) :=
    polynomial_on_mono encode hpoly (by
      intro a
      rw [StatePreparationLocal.physicalSize_eq]
      omega)
  exact embedCircuit_generated classical grammar encode _ _
    (preparation_placement_generated classical arithmetic encode S ell m hw hc ho hell hm hpoly)
    (nativeF_generated classical grammar arithmetic conv encode ell _ (fun _ => 0) t
      hell hrest (nat_const classical encode 0) ht hpolyEll hpolyRest)

/-- Complete source-family preparation uniformity, including the terminal clock
word and its polynomial padding, from the original source description. -/
theorem source_preparation_generated (classical : FLListClosure)
    (grammar : InstructionDescriptionClosure) (arithmetic : NatArithmeticDescription)
    (binary : BinaryDataDescription) (parsing : SourceDescriptionParsing G)
    (conv : GateConvention G) (F : EffectiveSourceFamily G)
    (hDuration : SimulatorParameterUniform.UnaryComputes (fun x => duration (F.circuit x))) :
    GeneratedCircuit id (fun x => SimulatorCircuit.preparation conv (F.circuit x)) := by
  have parameters := SimulatorParameterUniform.parameters_generated classical arithmetic F
    (source_work_generated classical parsing F) hDuration
  have hword := terminalClock_generated classical binary id
    (fun x => SourceCircuitSimulation.clockBits (F.circuit x))
    (fun x => duration (F.circuit x)) (fun x => SourceCircuitSimulation.clock_valid (F.circuit x))
    parameters.ell parameters.J hDuration
  exact placedF_generated classical grammar arithmetic conv id F.circuit _ _ _
    (source_work_generated classical parsing F) (source_catalyst_generated classical parsing F)
    (source_output_generated classical parsing F) parameters.ell parameters.m hword
    (source_preparationWidth_polynomial F)

