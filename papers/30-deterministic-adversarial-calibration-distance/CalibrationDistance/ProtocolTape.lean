import CalibrationDistance.ProtocolUniform
import Mathlib.MeasureTheory.Constructions.Pi
import Mathlib.Probability.Kernel.Composition.MeasureComp

open MeasureTheory ProbabilityTheory
open scoped ENNReal ProbabilityTheory

namespace CalibrationDistance.Protocol
noncomputable section

/-- Independent seed coordinates, sampled once before the game. -/
def finiteTapeMeasure (ν : Measure Probability) (T : ℕ) : Measure (FiniteTape T) :=
  Measure.pi (fun _ : Fin T => ν)

instance finiteTapeMeasure_probability (ν : Measure Probability) [IsProbabilityMeasure ν] (T : ℕ) :
    IsProbabilityMeasure (finiteTapeMeasure ν T) := by unfold finiteTapeMeasure; infer_instance

/-- The randomized threshold rule generated by one fresh seed. -/
def seedThresholdKernel {H : Type*} [MeasurableSpace H] (ν : Measure Probability)
    (q : H → ℝ) (hq : Measurable q) : Kernel H Bool :=
  Kernel.deterministic (fun z : H × Probability =>
    if (z.2 : ℝ) ≤ q z.1 then true else false)
    (Measurable.ite (measurableSet_le (measurable_subtype_coe.comp measurable_snd)
      (hq.comp measurable_fst)) measurable_const measurable_const) ∘ₖ
    (Kernel.id ×ₖ Kernel.const H ν)

instance seedThresholdKernel_markov {H : Type*} [MeasurableSpace H]
    (ν : Measure Probability) [IsProbabilityMeasure ν] (q : H → ℝ) (hq : Measurable q) :
    IsMarkovKernel (seedThresholdKernel ν q hq) := by unfold seedThresholdKernel; infer_instance

def seedThresholdAdversary (ν : Measure Probability) [IsProbabilityMeasure ν]
    (q : (n : ℕ) → History n → ℝ) (hq : ∀ n, Measurable (q n)) : RandomizedAdversary where
  kernel n := seedThresholdKernel ν (q n) (hq n)
  markov _ := inferInstance

theorem seedThresholdKernel_apply {H : Type*} [MeasurableSpace H]
    (ν : Measure Probability) [SFinite ν] (q : H → ℝ) (hq : Measurable q) (h : H) :
    seedThresholdKernel ν q hq h =
      ν.map (fun u : Probability => if (u : ℝ) ≤ q h then true else false) := by
  have ht : Measurable (fun z : H × Probability =>
      if (z.2 : ℝ) ≤ q z.1 then true else false) :=
    Measurable.ite (measurableSet_le (measurable_subtype_coe.comp measurable_snd)
      (hq.comp measurable_fst)) measurable_const measurable_const
  unfold seedThresholdKernel
  rw [Kernel.deterministic_comp_eq_map, Kernel.map_apply _ ht,
    Kernel.prod_apply, Kernel.id_apply, Kernel.const_apply, Measure.dirac_prod,
    Measure.map_map ht measurable_prodMk_left]
  rfl

/-- Mixing a fixed-history simultaneous transition over its fresh seed is exactly
forecast-kernel × randomized-threshold-kernel. -/
theorem freshSeed_transition_average (ν : Measure Probability) [IsProbabilityMeasure ν]
    (K : BehavioralForecaster) (q : (n : ℕ) → History n → ℝ)
    (hq : ∀ n, Measurable (q n)) (n : ℕ) (h : History n)
    (s : Set Round) (hs : MeasurableSet s) :
    (∫⁻ u : Probability, ((K.kernel n h).prod
      (Measure.dirac (if (u : ℝ) ≤ q n h then true else false))) s ∂ν) =
      transition K (seedThresholdAdversary ν q hq) n h s := by
  have ht : Measurable (fun u : Probability =>
      if (u : ℝ) ≤ q n h then true else false) :=
    Measurable.ite (measurableSet_le measurable_subtype_coe measurable_const)
      measurable_const measurable_const
  let out : Kernel Probability Bool := Kernel.deterministic _ ht
  have he := congrArg (fun k : Kernel Unit Round => k () s)
    (Kernel.const_prod_comp (Kernel.const Unit ν) (K.kernel n h) out)
  dsimp only at he
  rw [Kernel.comp_apply' _ _ _ hs] at he
  simp only [Kernel.prod_apply, Kernel.const_apply, out, Kernel.deterministic_apply] at he
  rw [transition_apply]
  change _ = ((K.kernel n h).prod (seedThresholdKernel ν (q n) (hq n) h)) s
  rw [seedThresholdKernel_apply]
  convert he using 1
  congr 2
  rw [Kernel.deterministic_comp_eq_map, Kernel.map_apply _ ht, Kernel.const_apply]

/-- Changing only the proof of measurability does not change a deterministic
transition. Keeping this equality at kernel level avoids expanding nested
history measures when comparing two finite recursions. -/
theorem deterministic_transition_congr (K : BehavioralForecaster) (A B : Adversary)
    (n : ℕ) (hab : A.action n = B.action n) :
    transition K A.randomized n = transition K B.randomized n := by
  have he : Kernel.deterministic (A.action n) (A.measurable_action n) =
      Kernel.deterministic (B.action n) (B.measurable_action n) := by
    exact Kernel.deterministic_congr hab
  exact congrArg (fun b : Kernel (History n) Bool => K.kernel n ×ₖ b) he

/-- A single equality step in the finite recursion. -/
theorem law_succ_congr (K : BehavioralForecaster) (A B : Adversary) (n : ℕ)
    (hp : law K A.randomized n = law K B.randomized n)
    (ht : transition K A.randomized n = transition K B.randomized n) :
    law K A.randomized (n+1) = law K B.randomized (n+1) := by
  calc
    law K A.randomized (n+1) = (law K A.randomized n).compProd
        (transition K A.randomized n) := law_succ K A.randomized n
    _ = (law K B.randomized n).compProd (transition K B.randomized n) :=
      congrArg₂ (fun (μ : Measure (History n)) (κ : Kernel (History n) Round) => μ.compProd κ) hp ht
    _ = law K B.randomized (n+1) := (law_succ K B.randomized n).symm

/-- A law through round `N` depends only on the first `N` past-adaptive actions. -/
theorem law_congr_adversary_prefix (K : BehavioralForecaster) (A B : Adversary) (N : ℕ)
    (hab : ∀ n, n < N → A.action n = B.action n) :
    law K A.randomized N = law K B.randomized N := by
  induction N with
  | zero => exact (law_zero K A.randomized).trans (law_zero K B.randomized).symm
  | succ n ih =>
      exact law_succ_congr K A B n
        (ih (fun k hk => hab k (Nat.lt_succ_of_lt hk)))
        (deterministic_transition_congr K A B n (hab n (Nat.lt_succ_self n)))

/-- Adding the final seed does not change the law of the preceding rounds. -/
theorem finiteThreshold_prefix_snoc (K : BehavioralForecaster)
    (q : (n : ℕ) → History n → ℝ) (hq : ∀ n, Measurable (q n))
    (N : ℕ) (w : FiniteTape N) (u : Probability) :
    parameterLaw K (finiteThresholdAdversary (N+1) q hq) N (Fin.snoc w u) =
      parameterLaw K (finiteThresholdAdversary N q hq) N w := by
  rw [parameterLaw_apply, parameterLaw_apply]
  apply law_congr_adversary_prefix
  intro n hn
  funext h
  simp only [ParametricAdversary.section, finiteThresholdAdversary, dif_pos hn,
    dif_pos (show n < N+1 by omega)]
  have hs : (⟨n, show n < N+1 by omega⟩ : Fin (N+1)) = (⟨n,hn⟩ : Fin N).castSucc := rfl
  simp only [hs, Fin.snoc_castSucc]

/-- Splitting a product tape into its past coordinates and its fresh last seed preserves law. -/
theorem measurePreserving_tape_snoc (ν : Measure Probability) [IsProbabilityMeasure ν] (N : ℕ) :
    MeasurePreserving (fun z : FiniteTape N × Probability => Fin.snoc z.1 z.2)
      ((finiteTapeMeasure ν N).prod ν) (finiteTapeMeasure ν (N+1)) := by
  have hp := measurePreserving_piFinSuccAbove (fun _ : Fin (N+1) => ν) (Fin.last N)
  have hp' := (MeasurePreserving.symm
    (MeasurableEquiv.piFinSuccAbove (fun _ : Fin (N+1) => Probability) (Fin.last N)) hp).comp
      (Measure.measurePreserving_swap (μ := finiteTapeMeasure ν N) (ν := ν))
  convert hp' using 1
  funext z
  simp [Function.comp_def, MeasurableEquiv.piFinSuccAbove_symm_apply, Fin.insertNth_last']
  rfl

/-- Current transition with an explicit single seed, independent of the forecaster draw. -/
def seedTransition (K : BehavioralForecaster)
    (q : (n : ℕ) → History n → ℝ) (hq : ∀ n, Measurable (q n)) (n : ℕ) :
    Kernel (Probability × History n) Round :=
  (K.kernel n).comap Prod.snd measurable_snd ×ₖ
    Kernel.deterministic (fun z : Probability × History n =>
      if (z.1 : ℝ) ≤ q n z.2 then true else false)
      (Measurable.ite (measurableSet_le (measurable_subtype_coe.comp measurable_fst)
        ((hq n).comp measurable_snd)) measurable_const measurable_const)

instance seedTransition_markov (K : BehavioralForecaster)
    (q : (n : ℕ) → History n → ℝ) (hq : ∀ n, Measurable (q n)) (n : ℕ) :
    IsMarkovKernel (seedTransition K q hq n) := by unfold seedTransition; infer_instance

/-- The exact final transition of a frozen extended tape. -/
theorem finiteThreshold_succ_snoc (K : BehavioralForecaster)
    (q : (n : ℕ) → History n → ℝ) (hq : ∀ n, Measurable (q n))
    (N : ℕ) (w : FiniteTape N) (u : Probability) :
    parameterLaw K (finiteThresholdAdversary (N+1) q hq) (N+1) (Fin.snoc w u) =
      (parameterLaw K (finiteThresholdAdversary N q hq) N w).compProd
        ((seedTransition K q hq N).sectR u) := by
  change (parameterLaw K (finiteThresholdAdversary (N+1) q hq) N ⊗ₖ
    parameterTransition K (finiteThresholdAdversary (N+1) q hq) N) (Fin.snoc w u) = _
  rw [Kernel.compProd_apply_eq_compProd_sectR, finiteThreshold_prefix_snoc]
  congr 1
  ext h s hs
  simp [Kernel.sectR_apply, parameterTransition, seedTransition,
    finiteThresholdAdversary, Kernel.prod_apply, Kernel.deterministic_apply]
  have hlast : (⟨N, show N < N+1 by omega⟩ : Fin (N+1)) = Fin.last N := rfl
  simp only [hlast, Fin.snoc_last]

private theorem measurable_kernel_reindexed_section
    {A B C : Type*} [MeasurableSpace A] [MeasurableSpace B] [MeasurableSpace C]
    (κ : Kernel A C) [IsSFiniteKernel κ] (f : A → B) (hf : Measurable f)
    {s : Set (B × C)} (hs : MeasurableSet s) :
    Measurable (fun a => κ a (Prod.mk (f a) ⁻¹' s)) := by
  let t : Set (A × C) := (fun z => (f z.1, z.2)) ⁻¹' s
  have ht : MeasurableSet t := hs.preimage ((hf.comp measurable_fst).prodMk measurable_snd)
  have hh : Measurable (fun a => κ a (Prod.mk a ⁻¹' t)) :=
    Kernel.measurable_kernel_prodMk_left ht
  have heq : (fun a => κ a (Prod.mk (f a) ⁻¹' s)) =
      (fun a => κ a (Prod.mk a ⁻¹' t)) := rfl
  rw [heq]
  exact hh

private theorem measurable_seedTransition_section (K : BehavioralForecaster)
    (q : (n : ℕ) → History n → ℝ) (hq : ∀ n, Measurable (q n))
    (N : ℕ) {s : Set (History N × Round)} (hs : MeasurableSet s) :
    Measurable (fun z : Probability × History N =>
      seedTransition K q hq N z (Prod.mk z.2 ⁻¹' s)) :=
  measurable_kernel_reindexed_section (seedTransition K q hq N) Prod.snd measurable_snd hs

/-- The marginal history law when a complete independent finite tape is frozen first. -/
def finiteTapeMixture (ν : Measure Probability) (K : BehavioralForecaster)
    (q : (n : ℕ) → History n → ℝ) (hq : ∀ n, Measurable (q n)) (T : ℕ) :
    Measure (History T) :=
  parameterLaw K (finiteThresholdAdversary T q hq) T ∘ₘ finiteTapeMeasure ν T

instance finiteTapeMixture_probability (ν : Measure Probability) [IsProbabilityMeasure ν]
    (K : BehavioralForecaster) (q : (n : ℕ) → History n → ℝ)
    (hq : ∀ n, Measurable (q n)) (T : ℕ) :
    IsProbabilityMeasure (finiteTapeMixture ν K q hq T) := by
  unfold finiteTapeMixture
  infer_instance

/-- Independence of the unused last tape coordinate gives the exact law recursion. -/
theorem finiteTapeMixture_succ (ν : Measure Probability) [IsProbabilityMeasure ν]
    (K : BehavioralForecaster) (q : (n : ℕ) → History n → ℝ)
    (hq : ∀ n, Measurable (q n)) (N : ℕ) :
    finiteTapeMixture ν K q hq (N+1) =
      (finiteTapeMixture ν K q hq N).compProd
        (transition K (seedThresholdAdversary ν q hq) N) := by
  ext s hs
  have hm : Measurable (fun w : FiniteTape (N+1) =>
      parameterLaw K (finiteThresholdAdversary (N+1) q hq) (N+1) w s) :=
    (parameterLaw K (finiteThresholdAdversary (N+1) q hq) (N+1)).measurable_coe hs
  have hsN : Measurable (fun h : History N =>
      transition K (seedThresholdAdversary ν q hq) N h (Prod.mk h ⁻¹' s)) :=
    Kernel.measurable_kernel_prodMk_left hs
  rw [finiteTapeMixture, Measure.bind_apply hs (Kernel.aemeasurable _),
    ← (measurePreserving_tape_snoc ν N).lintegral_comp hm]
  have hprod : Measurable (fun z : FiniteTape N × Probability =>
      parameterLaw K (finiteThresholdAdversary (N+1) q hq) (N+1) (Fin.snoc z.1 z.2) s) :=
    hm.comp (measurePreserving_tape_snoc ν N).measurable
  rw [MeasureTheory.lintegral_prod _ hprod.aemeasurable]
  simp only [finiteThreshold_succ_snoc]
  have hcomp (w : FiniteTape N) (u : Probability) :
      (parameterLaw K (finiteThresholdAdversary N q hq) N w).compProd
        ((seedTransition K q hq N).sectR u) s =
      ∫⁻ h, seedTransition K q hq N (u,h) (Prod.mk h ⁻¹' s)
        ∂parameterLaw K (finiteThresholdAdversary N q hq) N w :=
    Measure.compProd_apply hs
  calc
    _ = ∫⁻ w : FiniteTape N, ∫⁻ u : Probability,
        ∫⁻ h, seedTransition K q hq N (u,h) (Prod.mk h ⁻¹' s)
          ∂parameterLaw K (finiteThresholdAdversary N q hq) N w ∂ν ∂finiteTapeMeasure ν N := by
      apply lintegral_congr
      intro w
      apply lintegral_congr
      intro u
      exact hcomp w u
    _ = ∫⁻ h, transition K (seedThresholdAdversary ν q hq) N h
        (Prod.mk h ⁻¹' s) ∂finiteTapeMixture ν K q hq N := by
      have hbind :
          (∫⁻ h, transition K (seedThresholdAdversary ν q hq) N h
            (Prod.mk h ⁻¹' s) ∂finiteTapeMixture ν K q hq N) =
          ∫⁻ w : FiniteTape N, ∫⁻ h, transition K (seedThresholdAdversary ν q hq) N h
            (Prod.mk h ⁻¹' s) ∂parameterLaw K (finiteThresholdAdversary N q hq) N w
            ∂finiteTapeMeasure ν N :=
        Measure.lintegral_bind (Kernel.aemeasurable _) hsN.aemeasurable
      apply Eq.trans ?_ hbind.symm
      apply lintegral_congr
      intro w
      calc
        _ = ∫⁻ h, ∫⁻ u : Probability, seedTransition K q hq N (u,h)
            (Prod.mk h ⁻¹' s) ∂ν
              ∂parameterLaw K (finiteThresholdAdversary N q hq) N w :=
          lintegral_lintegral_swap (measurable_seedTransition_section K q hq N hs).aemeasurable
        _ = _ := by
          apply lintegral_congr
          intro h
          simp only [seedTransition, Kernel.prod_apply, Kernel.comap_apply,
            Kernel.deterministic_apply]
          exact freshSeed_transition_average ν K q hq N h (Prod.mk h ⁻¹' s)
            (hs.preimage measurable_prodMk_left)
    _ = _ := (Measure.compProd_apply hs).symm

/-- Sampling the independent tape first and freezing it has exactly the same history
law as drawing the threshold seed afresh at each simultaneous round. -/
theorem finiteTapeMixture_eq_law (ν : Measure Probability) [IsProbabilityMeasure ν]
    (K : BehavioralForecaster) (q : (n : ℕ) → History n → ℝ)
    (hq : ∀ n, Measurable (q n)) :
    ∀ T, finiteTapeMixture ν K q hq T = law K (seedThresholdAdversary ν q hq) T
  | 0 => by
      ext s hs
      simp [finiteTapeMixture, parameterLaw, law, Measure.bind_apply hs,
        Kernel.const_apply, measure_univ]
  | T+1 => by rw [finiteTapeMixture_succ, finiteTapeMixture_eq_law ν K q hq T, law_succ]

/-- The source tape-first joint construction has the same public-history marginal. -/
theorem finiteTapeJointLaw_snd (ν : Measure Probability) [IsProbabilityMeasure ν]
    (K : BehavioralForecaster) (q : (n : ℕ) → History n → ℝ)
    (hq : ∀ n, Measurable (q n)) (T : ℕ) :
    (parameterJointLaw (finiteTapeMeasure ν T) K (finiteThresholdAdversary T q hq) T).snd =
      law K (seedThresholdAdversary ν q hq) T := by
  rw [parameterJointLaw, Measure.snd_compProd]
  exact finiteTapeMixture_eq_law ν K q hq T

/-- In particular, independent unit-uniform seeds implement exactly the Bernoulli
product transitions of (5.4). -/
theorem uniformTapeJointLaw_snd (K : BehavioralForecaster)
    (q : (n : ℕ) → History n → ℝ) (hq : ∀ n, Measurable (q n)) (T : ℕ) :
    (parameterJointLaw (finiteTapeMeasure unitUniform T) K
      (finiteThresholdAdversary T q hq) T).snd = law K (bernoulliAdversary q hq) T := by
  have he : seedThresholdAdversary unitUniform q hq = bernoulliAdversary q hq := rfl
  rw [← he]
  exact finiteTapeJointLaw_snd unitUniform K q hq T

end
